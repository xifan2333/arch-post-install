#!/bin/bash
# Setup virtual record mix: microphone + system audio (+ optional ducking)
# Usage: setup-record-audio [enable|disable|status|help]

set -e

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
print_ok() { echo -e "${GREEN}[OK]${NC} $1"; }
print_err() { echo -e "${RED}[ERROR]${NC} $1" >&2; }
print_warn() { echo -e "${YELLOW}[WARNING]${NC} $1"; }

cmd="${1:-enable}"

case "$cmd" in
    enable|up|start)
        print_info "Enabling record_mix (mic + system, optional ducking)"
        record-audio-enable
        print_ok "Capture source for record/live: record_mix.monitor"
        print_info "Config: ~/.config/screenrecord/audio.conf"
        ;;
    disable|down|stop)
        print_info "Disabling record_mix"
        record-audio-disable
        print_ok "Disabled"
        ;;
    status)
        record-audio-status
        ;;
    help|-h|--help)
        cat <<EOF
Usage: $0 [enable|disable|status|help]

Creates a clean PipeWire virtual sink/source graph:

  rnnoise_source  ──┐
                    ├──> record_mix ──> record_mix.monitor  (used by screenrecord/bilive)
  sink.monitor   ──┘
         │
    optional ducking while speaking

Commands:
  enable   Create mix + start daemon (default)
  disable  Stop daemon and unload modules
  status   Show current state
  help     This help

Notes:
  - Does not change your desktop default input/output
  - screenrecord/bilive auto-prefer record_mix.monitor when available
  - Tune volumes/ducking in ~/.config/screenrecord/audio.conf
EOF
        ;;
    *)
        print_err "Unknown command: $cmd"
        echo "Try: $0 help"
        exit 1
        ;;
esac
