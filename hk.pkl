amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

min_hk_version = "2.0.0"

fail_fast = false

// hk 2.4 does not recognize env -S Python or LuaJIT shebangs.
local python_selectors = List(
  new FileSelector { types = List("python") },
  new FileSelector { glob = List("dotfiles/.local/bin/x-camera", "dotfiles/.local/bin/x-captions") }
)
local lua_selectors = List(
  new FileSelector { types = List("lua") },
  new FileSelector { glob = List("dotfiles/.local/bin/x-blue", "dotfiles/.local/bin/x-wifi", "dotfiles/.local/bin/x-theme") }
)
local zsh_selectors = List(
  new FileSelector { types = List("zsh") },
  new FileSelector { glob = List("dotfiles/.zshrc") }
)

local lint_steps = new Mapping<String, Step> {
  ["ruff"] = (Builtins.ruff) {
    glob = null
    types = null
    match_any = python_selectors
    check = new CommandSpec {
      command = new Command { argv = List("ruff", "check", "--force-exclude", "--no-fix", "{{files}}") }
      effect = "read"
    }
  }
  ["ruff_format"] = (Builtins.ruff_format) {
    glob = null
    types = null
    match_any = python_selectors
  }

  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = (Builtins.shfmt) {
    match_any = Builtins.shfmt.match_any + zsh_selectors
  }

  ["zsh"] {
    match_any = zsh_selectors
    check = new CommandSpec {
      command = new Command {
        argv = List("bash", "-c", #"for file in "$@"; do zsh -f -n -- "$file" || exit; done"#, "zsh-syntax", "{{files}}")
      }
      effect = "read"
    }
  }

  ["stylua"] = (Builtins.stylua) {
    glob = null
    types = null
    match_any = lua_selectors
  }
  ["luac"] {
    match_any = lua_selectors
    check = new CommandSpec {
      command = new Command { argv = List("luac", "-p", "{{files}}") }
      effect = "read"
    }
  }

  ["taplo"] = (Builtins.taplo) {
    check = new CommandSpec {
      command = new Command { argv = List("taplo", "lint", "--no-schema", "{{files}}") }
      effect = "read"
    }
  }
  ["taplo_format"] = Builtins.taplo_format

  ["prettier"] = (Builtins.prettier) {
    glob = List("*.json", "*.jsonc", "*.yaml", "*.yml")
  }

  ["oxlint"] {
    glob = List("*.js")
    check = new CommandSpec {
      command = new Command { argv = List("oxlint", "{{files}}") }
      effect = "read"
    }
  }
}

local conventional_types = "build,chore,docs,feat,fix,perf,refactor,revert,style,test"

local commit_msg_steps = new Mapping<String, Step> {
  ["conventional-commit"] = (Builtins.check_conventional_commit) {
    check = new CommandSpec {
      command = "hk util check-conventional-commit --allowed-types \(conventional_types) {{commit_msg_file}}"
      effect = "read"
    }
  }

  ["commit-header-length"] {
    check = new CommandSpec {
      command = #"
        set -euo pipefail

        header=$(head -n 1 "{{commit_msg_file}}")

        # `git rebase --autosquash` temporary commits skip validation.
        case "$header" in
          "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
        esac

        if [ "$(printf '%s' "$header" | wc -m)" -gt 100 ]; then
          printf 'commit header exceeds 100 characters: %s\n' "$header" >&2
          exit 1
        fi
      "#
      effect = "read"
    }
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = lint_steps
  }
  ["commit-msg"] {
    steps = commit_msg_steps
  }
  ["check"] {
    fix = false
    steps = lint_steps
  }
  ["fix"] {
    fix = true
    stash = "none"
    steps = lint_steps
  }
}
