#!/bin/sh
# River & xrwm keybindings configuration
set -eu

mod="Mod4"

# ---------------------------------------------------------------------------
# Core Applications
# ---------------------------------------------------------------------------

# Terminal: ftty (ultra-lightweight Wayland terminal)
riverctl map normal $mod Return spawn ftty

# Application launcher: fuzzel
riverctl map normal $mod Space spawn fuzzel
riverctl map normal $mod D spawn fuzzel

# Browser & File Manager
riverctl map normal $mod B spawn "${BROWSER:-chromium}"
riverctl map normal $mod E spawn "${FILE_MANAGER:-nautilus}"
riverctl map normal $mod+Shift E spawn "ftty -e yazi"

# Network Control Center
riverctl map normal $mod+Control W spawn arch-net-menu
riverctl map normal $mod N spawn arch-net-menu

# ---------------------------------------------------------------------------
# Window Management & Focus (Vim keys)
# ---------------------------------------------------------------------------

riverctl map normal $mod Q close
riverctl map normal $mod W close
riverctl map normal $mod F toggle-fullscreen
riverctl map normal $mod P toggle-float
riverctl map normal $mod+Shift Space toggle-float
riverctl map normal $mod M zoom
riverctl map normal $mod+Shift Q exit

# Focus navigation (HJKL)
riverctl map normal $mod H focus-view left
riverctl map normal $mod J focus-view next
riverctl map normal $mod K focus-view previous
riverctl map normal $mod L focus-view right

# Window swapping (HJKL)
riverctl map normal $mod+Shift H swap left
riverctl map normal $mod+Shift J swap next
riverctl map normal $mod+Shift K swap previous
riverctl map normal $mod+Shift L swap right

# ---------------------------------------------------------------------------
# Layout Controls (xrwm & rivertile compatible)
# ---------------------------------------------------------------------------

# Layout orientation: Y (horizontal / main left), U (vertical / main top)
riverctl map normal $mod Y send-layout-cmd rivertile "main-location left"
riverctl map normal $mod U send-layout-cmd rivertile "main-location top"

# Ratio adjustments: I (-0.05), O (+0.05)
riverctl map normal $mod I send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal $mod O send-layout-cmd rivertile "main-ratio +0.05"
riverctl map normal $mod Left send-layout-cmd rivertile "main-ratio -0.05"
riverctl map normal $mod Right send-layout-cmd rivertile "main-ratio +0.05"

# ---------------------------------------------------------------------------
# Multi-Monitor (Outputs)
# ---------------------------------------------------------------------------

riverctl map normal $mod Period focus-output next
riverctl map normal $mod Comma focus-output previous
riverctl map normal $mod+Shift Period send-to-output next
riverctl map normal $mod+Shift Comma send-to-output previous

# ---------------------------------------------------------------------------
# Lockscreen & Screenshots
# ---------------------------------------------------------------------------

# Screen locker: hyprlock
riverctl map normal $mod Escape spawn hyprlock

# Screenshots: grim + slurp
# shellcheck disable=SC2016
riverctl map normal $mod+Shift S spawn 'sh -c "grim -g \"\$(slurp)\" - | wl-copy"'
# shellcheck disable=SC2016
riverctl map normal None Print spawn 'sh -c "grim - | wl-copy"'

# ---------------------------------------------------------------------------
# Hardware & Multimedia Controls
# ---------------------------------------------------------------------------

# Volume control via PipeWire wpctl
riverctl map -repeat normal None XF86AudioRaiseVolume spawn "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+"
riverctl map -repeat normal None XF86AudioLowerVolume spawn "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
riverctl map normal None XF86AudioMute spawn "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
riverctl map normal None XF86AudioMicMute spawn "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"

# Backlight control via brightnessctl
riverctl map -repeat normal None XF86MonBrightnessUp spawn "brightnessctl set +5%"
riverctl map -repeat normal None XF86MonBrightnessDown spawn "brightnessctl set 5%-"

# Media playback controls
riverctl map normal None XF86AudioPlay spawn "playerctl play-pause"
riverctl map normal None XF86AudioNext spawn "playerctl next"
riverctl map normal None XF86AudioPrev spawn "playerctl previous"

# ---------------------------------------------------------------------------
# Workspace Tags (1 - 9)
# ---------------------------------------------------------------------------

for i in $(seq 1 9); do
	tags=$((1 << (i - 1)))
	riverctl map normal $mod "$i" set-focused-tags "$tags"
	riverctl map normal $mod+Shift "$i" set-view-tags "$tags"
	riverctl map normal $mod+Control "$i" toggle-focused-tags "$tags"
	riverctl map normal $mod+Shift+Control "$i" toggle-view-tags "$tags"
done

# Focus all tags (Super+0)
all_tags=$(((1 << 32) - 1))
riverctl map normal $mod 0 set-focused-tags "$all_tags"
riverctl map normal $mod+Shift 0 set-view-tags "$all_tags"

# ---------------------------------------------------------------------------
# Pointer Bindings (Mouse)
# ---------------------------------------------------------------------------

riverctl map-pointer normal $mod BTN_LEFT move-view
riverctl map-pointer normal $mod BTN_RIGHT resize-view
riverctl map-pointer normal $mod BTN_MIDDLE toggle-float
