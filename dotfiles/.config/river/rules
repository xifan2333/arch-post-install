#!/bin/sh
# xrwm window rules configuration for River desktop
set -eu

rule() {
	if command -v xrwm >/dev/null 2>&1; then
		xrwm rule-add "$@" 2>/dev/null || true
	fi
	riverctl rule-add "$@" 2>/dev/null || true
}

# Server-side decorations (SSD) for all client windows
rule -app-id "*" ssd

# Utility floating dialogs & terminal popups
rule -app-id "ftty-float" float
rule -app-id "ftty-float" dimensions 960 540

rule -app-id "scratchpad" float
rule -app-id "scratchpad" dimensions 960 540

rule -app-id "lxqt-openssh-askpass" float
rule -app-id "lxqt-openssh-askpass" dimensions 400 200

# Media viewers & previews
rule -app-id "imv" float
rule -app-id "imv" dimensions 960 540

rule -app-id "mpv" float
rule -app-id "mpv" dimensions 960 540

rule -title "Screenshot Preview" float
rule -title "Screenshot Preview" dimensions 600 400
