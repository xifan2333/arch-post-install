#!/bin/sh
# River 0.4 initialization script - Modular architecture
# Author: xifan
set -eu

RIVER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/river"

# 1. Hardware input repeat rate
riverctl set-repeat 50 300

# 2. Window manager lifecycle: start custom xrwm manager
if command -v xrwm >/dev/null 2>&1; then
	xrwm &
fi

# 3. Source modular configurations (rules and bindings)
if [ -f "$RIVER_CONFIG/rules" ]; then
	# shellcheck source=/dev/null
	. "$RIVER_CONFIG/rules"
fi

if [ -f "$RIVER_CONFIG/bindings" ]; then
	# shellcheck source=/dev/null
	. "$RIVER_CONFIG/bindings"
fi

# 4. Apply active desktop semantic theme colors to xrwm
theme_xrwm="${XDG_STATE_HOME:-$HOME/.local/state}/theme/xrwm.sh"
if [ -x "$theme_xrwm" ]; then
	"$theme_xrwm" &
fi

# 5. Background desktop services
command -v fcitx5 >/dev/null 2>&1 && fcitx5 -d --replace &
command -v mako >/dev/null 2>&1 && mako &
command -v waybar >/dev/null 2>&1 && waybar &

# Wallpaper: restore or fallback to dark background
if command -v swaybg >/dev/null 2>&1; then
	swaybg -c "#1a1b26" &
fi

# 6. Finalize UWSM environment if running under uwsm session
if command -v uwsm >/dev/null 2>&1; then
	uwsm finalize 2>/dev/null || true
fi
