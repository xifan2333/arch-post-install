#!/bin/bash
# Restore the user-owned Waybar include wrapper after Omarchy migrations.

set -euo pipefail

source_file="$HOME/.config/waybar/capture-wrapper.jsonc"
target_file="$HOME/.config/waybar/config.jsonc"

[[ -f "$source_file" ]] || exit 0
cmp -s "$source_file" "$target_file" && exit 0

mkdir -p "$(dirname "$target_file")"
tmp=$(mktemp "$(dirname "$target_file")/.capture-wrapper.XXXXXX")
trap 'rm -f "$tmp"' EXIT
install -m 0644 "$source_file" "$tmp"
mv -f "$tmp" "$target_file"
trap - EXIT

# Migrations may have restarted Waybar before post-update hooks run.
if command -v omarchy >/dev/null 2>&1; then
    omarchy restart waybar
fi
