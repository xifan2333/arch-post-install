#!/bin/bash
# Keep WezTerm font.lua in sync with `omarchy font set`.
# Args: $1 = font family name from omarchy-font-set
set -euo pipefail

font_name="${1:-}"
[[ -n $font_name ]] || exit 0

font_file="${XDG_CONFIG_HOME:-$HOME/.config}/wezterm/font.lua"
[[ -d "${XDG_CONFIG_HOME:-$HOME/.config}/wezterm" ]] || mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/wezterm"

# Preserve size if already configured; default matches kitty/alacritty (9.0).
font_size="9.0"
if [[ -f $font_file ]]; then
    existing=$(grep -E 'font_size\s*=' "$font_file" | head -1 | grep -oE '[0-9]+(\.[0-9]+)?' || true)
    if [[ -n ${existing:-} ]]; then
        font_size="$existing"
    fi
fi

# Escape backslashes and quotes for a Lua double-quoted string.
lua_escape() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    printf '%s' "$s"
}

cat >"$font_file" <<EOF
-- Auto-generated by omarchy font-set hook (wezterm-sync.hook).
-- Prefer \`omarchy font set "<name>"\` over editing this by hand.
return {
  font_family = "$(lua_escape "$font_name")",
  font_size = ${font_size},
}
EOF

# WezTerm watches font.lua; touch main config as a fallback reload kick.
if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/wezterm/wezterm.lua" ]]; then
    touch "${XDG_CONFIG_HOME:-$HOME/.config}/wezterm/wezterm.lua"
fi
