#!/bin/bash
# Keep the concrete-family fontconfig alias in sync with `omarchy font set`.
#
# omarchy-font-set rewrites only the <string> inside the monospace match
# block (plus the terminal configs), so this hook mirrors the chosen font
# into the alias that terminals (kitty etc.) hit when they request the
# concrete family name directly. That keeps the Sarasa CJK fallback working
# across font switches without hardcoding a family name.
set -e

CONF="$HOME/.config/fontconfig/fonts.conf"
FONT="${1:-}"

[[ -f $CONF ]] || exit 0

# Fall back to the current monospace entry if invoked without an argument.
if [[ -z $FONT ]]; then
  FONT=$(xmlstarlet sel -t -v \
    '//match[@target="pattern"][test/string="monospace"]/edit[@name="family"]/string[1]' \
    "$CONF" 2>/dev/null || true)
fi
[[ -n $FONT ]] || exit 0

# Update the "direct request" alias only: its <family> is not the generic
# "monospace", so it is the one concrete-font terminals resolve through.
xmlstarlet ed -L \
  -u '//alias[prefer/family[1]="Sarasa Mono SC"][family[1]!="monospace"]/family[1]' \
  -v "$FONT" "$CONF"
