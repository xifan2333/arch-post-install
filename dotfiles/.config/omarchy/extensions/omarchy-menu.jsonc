{
  // Livestream submenu under Capture. Portal handles region/window selection.
  "trigger.capture.livestream": {
    "icon": "󰻒",
    "label": "Livestream",
    "aliases": ["livestream", "stream", "live"],
  },
  "trigger.capture.livestream.stop": {
    "icon": "󰓛",
    "label": "Stop livestream",
    "when": "livestream is-active",
    "action": "livestream stop",
  },
  "trigger.capture.livestream.start": {
    "icon": "󰻒",
    "label": "Start livestream",
    "when": "! livestream is-active",
    "action": "livestream start portal",
  },
  "trigger.capture.livestream.config": {
    "icon": "󰒓",
    "label": "Configuration",
    "action": "livestream config",
  },
  "trigger.capture.text": {
    "icon": "󰴑",
    "label": "Text",
    "action": "capture-text-extraction",
  },
}
