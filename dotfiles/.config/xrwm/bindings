#!/usr/bin/env bash
# arch:summary=Configure xrwm keyboard and pointer bindings
# xrwm keybindings and pointer configuration
set -euo pipefail

# ===========================================================================
# 1. Core Applications (Super + Key)
# ===========================================================================

# Terminal (Return)
xrwm map normal Super Return spawn custom-session launch -- ftty
xrwm map normal "Super+Shift" Return zoom

# Application Launcher (Space) & Floating / Scratchpad Controls
xrwm map normal Super Space spawn custom-session toggle custom-launcher.service -s a -- fuzzel
xrwm map normal "Super+Alt" Space toggle-focused-tags 2147483648
xrwm map normal Alt Space toggle-floating-views

# Browser (B)
xrwm map normal Super B spawn custom-session launch -- "${BROWSER:-chromium}"

# File Manager (E)
xrwm map normal Super E spawn custom-session launch -- pcmanfm
xrwm map normal "Super+Shift" E spawn custom-session launch -- ftty -e yazi

# Clipboard (V)
xrwm map normal Super V spawn custom-session launch -- custom-clipboard

# Network (N)
xrwm map normal Super N spawn custom-session launch -- x-wifi

# ===========================================================================
# 2. Window Lifecycle & Layout Management
# ===========================================================================

# Window Close (Q / W) & Session Exit
xrwm map normal Super Q close
xrwm map normal Super W close
xrwm map normal "Super+Shift" Q spawn uwsm stop

# Fullscreen & Floating (F = Fullscreen, P = Pin / Float)
xrwm map normal Super F toggle-fullscreen
xrwm map normal None F11 toggle-fullscreen
xrwm map normal Super P toggle-float

# Window Manager Reload (R = Reload)
xrwm map normal "Super+Shift" R reload

# Layout Placement Orientation (Instant response)
xrwm map normal Super Y main-location left
xrwm map normal Super U main-location top

# ===========================================================================
# 3. Window Navigation & Geometry (Directional Arrow Keys)
# ===========================================================================

# Focus Navigation (Super + Arrow Keys / Vim HJKL)
xrwm map normal Super Left focus-view left
xrwm map normal Super Right focus-view right
xrwm map normal Super Up focus-view previous
xrwm map normal Super Down focus-view next
xrwm map normal Super H focus-view left
xrwm map normal Super J focus-view next
xrwm map normal Super K focus-view previous
xrwm map normal Super L focus-view right

# Layout Proportions (Super + Alt + Arrow Keys)
xrwm map normal "Super+Alt" Left main-ratio -0.05
xrwm map normal "Super+Alt" Right main-ratio +0.05
xrwm map normal "Super+Alt" Up stack-ratio +0.05
xrwm map normal "Super+Alt" Down stack-ratio -0.05

# Window Swapping (Super + Control + Arrow Keys / Vim HJKL)
xrwm map normal "Super+Control" Left swap left
xrwm map normal "Super+Control" Right swap right
xrwm map normal "Super+Control" Up swap up
xrwm map normal "Super+Control" Down swap down
xrwm map normal "Super+Control" H swap left
xrwm map normal "Super+Control" J swap down
xrwm map normal "Super+Control" K swap up
xrwm map normal "Super+Control" L swap right

# Multi-Monitor Output Management
xrwm map normal Super Period focus-output next
xrwm map normal Super Comma focus-output previous
xrwm map normal "Super+Shift" Period send-to-output next
xrwm map normal "Super+Shift" Comma send-to-output previous

# ===========================================================================
# 4. Pop-up Menus & Selectors (Super + Control + Key)
# ===========================================================================

# Recording Options Menu
xrwm map normal "Super+Control" G spawn custom-session launch -- custom-record menu

# ===========================================================================
# 5. On-Screen Overlay HUD Suite (Super + Alt + Key)
# ===========================================================================

# Keys Overlay (K = Keystrokes)
xrwm map normal "Super+Alt" K spawn custom-session launch -- custom-keystrokes toggle

# Camera PIP Overlay (V = Video / Camera)
xrwm map normal "Super+Alt" V spawn custom-session launch -- x-camera toggle

# Captions Overlay (C = Captions)
xrwm map normal "Super+Alt" C spawn custom-session launch -- x-captions toggle

# Title Overlay (T = Title)
xrwm map normal "Super+Alt" T spawn custom-session launch -- custom-stream-title toggle

# ===========================================================================
# 6. Screen Recording & Live Streaming (G = Grab / Record / Stream)
# ===========================================================================

# Screen Recording via Portal
xrwm map normal Super G spawn custom-session launch -- custom-record toggle

# Live Stream Push via Portal
xrwm map normal "Super+Shift" G spawn custom-session launch -- x-live toggle

# ===========================================================================
# 7. Title HUD Direct Actions (T)
# ===========================================================================

xrwm map normal Super T spawn custom-session launch -- custom-stream-title edit
xrwm map normal "Super+Shift" T spawn custom-session launch -- custom-stream-title clear

# ===========================================================================
# 8. Workspace Tags (1 - 9, 0, Tab)
# ===========================================================================

for i in $(seq 1 9); do
	tags=$((1 << (i - 1)))
	xrwm map normal Super "$i" set-focused-tags "$tags"
	xrwm map normal "Super+Shift" "$i" set-view-tags "$tags"
done

# Quick Tag Toggle (Super + Tab)
xrwm map normal Super Tab focus-previous-tags
xrwm map normal "Super+Shift" Tab send-to-previous-tags

# View All Tags (Super + =)
xrwm map normal Super equal set-focused-tags 511

# Pin Window to All Tags (Super + -)
xrwm map normal Super minus set-view-tags 511

# Scratchpad Tag 32 (Super + 0)
xrwm map normal Super 0 toggle-focused-tags 2147483648
xrwm map normal "Super+Shift" 0 set-view-tags 2147483648

# ===========================================================================
# 9. Pointer Bindings (Mouse)
# ===========================================================================

xrwm map-pointer normal Super BTN_LEFT move-view
xrwm map-pointer normal Super BTN_RIGHT resize-view
xrwm map-pointer normal Super BTN_MIDDLE toggle-float

# ===========================================================================
# 10. Hardware, Multimedia & Screenshots
# ===========================================================================

# Screen Locker & Power Menu
xrwm map normal Super Escape spawn custom-power lock
xrwm map normal "Super+Shift" Escape spawn custom-session launch -- custom-power

# Screenshots (Print family)
xrwm map normal None Print spawn custom-session launch -- custom-capture area
xrwm map normal Shift Print spawn custom-session launch -- custom-capture full
xrwm map normal Super Print spawn custom-session launch -- custom-capture
xrwm map normal "Super+Shift" S spawn custom-session launch -- custom-capture edit
xrwm map normal "Super+Shift" Print spawn custom-session launch -- custom-capture color
xrwm map normal Control Print spawn custom-session launch -- custom-capture preview

# Volume Controls via PipeWire
xrwm map normal None XF86AudioRaiseVolume spawn wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
xrwm map normal None XF86AudioLowerVolume spawn wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
xrwm map normal None XF86AudioMute spawn wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
xrwm map normal None XF86AudioMicMute spawn wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Backlight Controls via brightnessctl
xrwm map normal None XF86MonBrightnessUp spawn brightnessctl set +5%
xrwm map normal None XF86MonBrightnessDown spawn brightnessctl set 5%-

# Media Playback Controls
xrwm map normal None XF86AudioPlay spawn playerctl play-pause
xrwm map normal None XF86AudioNext spawn playerctl next
xrwm map normal None XF86AudioPrev spawn playerctl previous
