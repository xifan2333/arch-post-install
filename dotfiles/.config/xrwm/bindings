#!/usr/bin/env bash
# arch:summary=Configure xrwm keyboard and pointer bindings
# xrwm keybindings and pointer configuration
set -euo pipefail

# ---------------------------------------------------------------------------
# Core Applications
# ---------------------------------------------------------------------------

# Terminal: ftty (ultra-lightweight Wayland terminal)
xrwm map normal Super Return spawn ftty

# Application launcher: fuzzel
xrwm map normal Super Space spawn fuzzel
xrwm map normal Super D spawn fuzzel

# Wallpaper picker
xrwm map normal "Super+Shift" W spawn arch-wallpaper-menu

# Browser & File Manager
xrwm map normal Super B spawn "${BROWSER:-chromium}"
xrwm map normal Super E spawn "${FILE_MANAGER:-nautilus}"
xrwm map normal "Super+Shift" E spawn ftty -e yazi

# Network Control Center
xrwm map normal "Super+Control" W spawn arch-net-menu
xrwm map normal Super N spawn arch-net-menu

# ---------------------------------------------------------------------------
# Window Management Actions
# ---------------------------------------------------------------------------

xrwm map normal Super Q close
xrwm map normal Super W close
xrwm map normal Super F toggle-fullscreen
xrwm map normal None F11 toggle-fullscreen
xrwm map normal Super P toggle-float
xrwm map normal "Super+Shift" P toggle-floating-views
xrwm map normal "Super+Shift" Return zoom
xrwm map normal "Super+Shift" R reload
xrwm map normal "Super+Shift" Q exit

# ---------------------------------------------------------------------------
# Focus Navigation & Swapping (Vim HJKL + Arrow keys)
# ---------------------------------------------------------------------------

xrwm map normal Super H focus-view left
xrwm map normal Super J focus-view next
xrwm map normal Super K focus-view previous
xrwm map normal Super L focus-view right

xrwm map normal Super Up focus-view previous
xrwm map normal Super Down focus-view next

xrwm map normal "Super+Shift" H swap left
xrwm map normal "Super+Shift" J swap down
xrwm map normal "Super+Shift" K swap up
xrwm map normal "Super+Shift" L swap right

xrwm map normal "Super+Shift" Up swap up
xrwm map normal "Super+Shift" Down swap down
xrwm map normal "Super+Shift" Left swap left
xrwm map normal "Super+Shift" Right swap right

# ---------------------------------------------------------------------------
# Floating Window Control (Translate & Snap)
# ---------------------------------------------------------------------------

# Keyboard Translation (Super + Control + HJKL)
xrwm map normal "Super+Control" H move left 50
xrwm map normal "Super+Control" J move down 50
xrwm map normal "Super+Control" K move up 50
xrwm map normal "Super+Control" L move right 50

# Half-Screen Snap (Super + Alt + HJKL)
xrwm map normal "Super+Alt" H snap left
xrwm map normal "Super+Alt" L snap right
xrwm map normal "Super+Alt" K snap up
xrwm map normal "Super+Alt" J snap down

# ---------------------------------------------------------------------------
# Layout Direction & Ratios (Instant response)
# ---------------------------------------------------------------------------

xrwm map normal Super Y main-location left
xrwm map normal Super U main-location top

xrwm map normal Super I main-ratio -0.05
xrwm map normal Super O main-ratio +0.05
xrwm map normal Super Left main-ratio -0.05
xrwm map normal Super Right main-ratio +0.05
xrwm map normal Super bracketleft stack-ratio -0.05
xrwm map normal Super bracketright stack-ratio +0.05

# ---------------------------------------------------------------------------
# Workspace Tags (1 - 9)
# ---------------------------------------------------------------------------

for i in $(seq 1 9); do
	tags=$((1 << (i - 1)))
	xrwm map normal Super "$i" set-focused-tags "$tags"
	xrwm map normal "Super+Shift" "$i" set-view-tags "$tags"
done

# Quick tag toggle (Super + Tab)
xrwm map normal Super Tab focus-previous-tags
xrwm map normal "Super+Shift" Tab send-to-previous-tags

# View all tags (Super + =)
xrwm map normal Super equal set-focused-tags 511

# Pin window to all tags (Super + -)
xrwm map normal Super minus set-view-tags 511

# Scratchpad drawer (Tag 32, mask 2147483648)
xrwm map normal Super 0 toggle-focused-tags 2147483648
xrwm map normal "Alt" Space toggle-focused-tags 2147483648
xrwm map normal "Super+Shift" 0 set-view-tags 2147483648

# ---------------------------------------------------------------------------
# Pointer Bindings (Mouse)
# ---------------------------------------------------------------------------

xrwm map-pointer normal Super BTN_LEFT move-view
xrwm map-pointer normal Super BTN_RIGHT resize-view
xrwm map-pointer normal Super BTN_MIDDLE toggle-float

# ---------------------------------------------------------------------------
# Hardware & Multimedia Controls
# ---------------------------------------------------------------------------

# Screen locker: hyprlock
xrwm map normal Super Escape spawn hyprlock

# Screenshots: grim + slurp
# shellcheck disable=SC2016
xrwm map normal "Super+Shift" S spawn sh -c 'grim -g "$(slurp)" - | wl-copy'
xrwm map normal None Print spawn sh -c 'grim - | wl-copy'

# Volume control via PipeWire wpctl
xrwm map normal None XF86AudioRaiseVolume spawn wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
xrwm map normal None XF86AudioLowerVolume spawn wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
xrwm map normal None XF86AudioMute spawn wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
xrwm map normal None XF86AudioMicMute spawn wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Backlight control via brightnessctl
xrwm map normal None XF86MonBrightnessUp spawn brightnessctl set +5%
xrwm map normal None XF86MonBrightnessDown spawn brightnessctl set 5%-

# Media playback controls
xrwm map normal None XF86AudioPlay spawn playerctl play-pause
xrwm map normal None XF86AudioNext spawn playerctl next
xrwm map normal None XF86AudioPrev spawn playerctl previous
