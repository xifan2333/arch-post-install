#!/usr/bin/env bash
# @summary Start session-owned desktop services and fetch the login wallpaper
# @deps uwsm, systemctl, custom-session, custom-wallpaper
set -euo pipefail

if ! command -v uwsm >/dev/null; then
	custom-i18n get cli_dependency name=uwsm >&2
	exit 127
fi

# Native services retain their existing D-Bus names and reload interfaces.
systemctl --user start waybar.service mako.service app-org.fcitx.Fcitx5@autostart.service

custom-session start custom-polkit.service -- /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
custom-session start custom-idle.service -- swayidle -w
custom-session start custom-clipboard-text.service -- wl-paste --type text --watch cliphist store
custom-session start custom-clipboard-image.service -- wl-paste --type image --watch cliphist store

# The wallpaper request runs in its own unit and does not block session startup.
custom-session start custom-wallpaper-fetch.service -- custom-wallpaper random
