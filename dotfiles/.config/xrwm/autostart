#!/usr/bin/env bash
# arch:summary=Autostart desktop daemons and background services via uwsm
# Modular autostart for River / xrwm session
set -euo pipefail

# Helper to launch daemons via uwsm app with single-instance check
start_daemon() {
	local bin="$1"
	shift
	command -v "$bin" >/dev/null 2>&1 || return 0

	if pgrep -x "$bin" >/dev/null 2>&1; then
		return 0
	fi

	if command -v uwsm >/dev/null 2>&1; then
		uwsm app -s b -S both -- "$bin" "$@" >/dev/null 2>&1 &
	else
		"$bin" "$@" >/dev/null 2>&1 &
	fi
}

# 1. Input method framework (Fcitx5)
if command -v fcitx5 >/dev/null 2>&1; then
	if ! pgrep -x fcitx5 >/dev/null 2>&1; then
		if command -v uwsm >/dev/null 2>&1; then
			uwsm app -s b -S both -- fcitx5 --replace >/dev/null 2>&1 &
		else
			fcitx5 --replace >/dev/null 2>&1 &
		fi
	fi
fi

# 2. Notification daemon (Mako)
start_daemon mako

# 3. Status bar (Waybar)
start_daemon waybar

# 4. Polkit authentication agent
polkit_agent="/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
if [[ -x "$polkit_agent" ]] && ! pgrep -f "polkit-gnome" >/dev/null 2>&1; then
	if command -v uwsm >/dev/null 2>&1; then
		uwsm app -s b -S both -- "$polkit_agent" >/dev/null 2>&1 &
	else
		"$polkit_agent" >/dev/null 2>&1 &
	fi
fi

# 5. Idle and power management daemon (Swayidle)
start_daemon swayidle -w

# 6. Clipboard manager (Cliphist)
if command -v cliphist >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
	if ! pgrep -f "wl-paste --watch cliphist store" >/dev/null 2>&1; then
		if command -v uwsm >/dev/null 2>&1; then
			uwsm app -s b -S both -- wl-paste --watch cliphist store >/dev/null 2>&1 &
		else
			wl-paste --watch cliphist store >/dev/null 2>&1 &
		fi
	fi
	if ! pgrep -f "wl-paste --type image --watch cliphist store" >/dev/null 2>&1; then
		if command -v uwsm >/dev/null 2>&1; then
			uwsm app -s b -S both -- wl-paste --type image --watch cliphist store >/dev/null 2>&1 &
		else
			wl-paste --type image --watch cliphist store >/dev/null 2>&1 &
		fi
	fi
fi

# 7. Fetch a random Wallhaven pixel-art wallpaper after independent services start.
custom-wallpaper random
