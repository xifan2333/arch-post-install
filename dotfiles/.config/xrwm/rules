#!/usr/bin/env bash
# arch:summary=Configure xrwm window rules, floating dialogs, and decorations
# xrwm window rules configuration
set -euo pipefail

# Server-side decorations (SSD) for all client windows
xrwm rule-add -app-id "*" ssd

# Utility floating dialogs & terminal popups
xrwm rule-add -app-id "ftty-float" float
xrwm rule-add -app-id "ftty-float" dimensions 960 540

xrwm rule-add -app-id "lxqt-openssh-askpass" float
xrwm rule-add -app-id "lxqt-openssh-askpass" dimensions 400 200

# Media viewers & previews
xrwm rule-add -app-id "imv" float
xrwm rule-add -app-id "imv" dimensions 960 540

xrwm rule-add -app-id "mpv" float
xrwm rule-add -app-id "mpv" dimensions 960 540

# Screenshot annotation
xrwm rule-add -app-id "com.gabm.satty" float
xrwm rule-add -app-id "com.gabm.satty" dimensions 960 540
xrwm rule-add -app-id "satty" float
xrwm rule-add -app-id "satty" dimensions 960 540

# Livestream configurator
xrwm rule-add -app-id "arch-live-config" float
xrwm rule-add -app-id "arch-live-config" dimensions 640 300

# Webcam picture-in-picture overlay (mpv)
xrwm rule-add -app-id "pip-camera" float
xrwm rule-add -app-id "pip-camera" dimensions 185 185
xrwm rule-add -app-id "pip-camera" position 4 579
xrwm rule-add -app-id "pip-camera" tags 4294967295
xrwm rule-add -app-id "pip-camera" csd

# Transparent desktop overlay HUDs (streaming & recording)
xrwm rule-add -app-id "arch-overlay-*" float
xrwm rule-add -app-id "arch-overlay-*" csd
xrwm rule-add -app-id "arch-overlay-*" tags 4294967295

# Key HUD overlay (showmethekey)
xrwm rule-add -app-id "one.alynx.showmethekey" float
xrwm rule-add -app-id "one.alynx.showmethekey" tags 4294967295
xrwm rule-add -app-id "one.alynx.showmethekey" csd

# Custom tools
xrwm rule-add -app-id "fuzzel" csd
