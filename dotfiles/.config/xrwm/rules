#!/usr/bin/env bash
# arch:summary=Configure xrwm window rules, floating dialogs, and decorations
# xrwm window rules configuration
set -euo pipefail

# Server-side decorations (SSD) for all client windows
xrwm rule-add -app-id "*" ssd

# Utility floating dialogs & terminal popups
xrwm rule-add -app-id "ftty-float" float
xrwm rule-add -app-id "ftty-float" dimensions 960 540

xrwm rule-add -app-id "lxqt-openssh-askpass" float
xrwm rule-add -app-id "lxqt-openssh-askpass" dimensions 400 200

# Media viewers & previews
xrwm rule-add -app-id "imv" float
xrwm rule-add -app-id "imv" dimensions 960 540

xrwm rule-add -app-id "mpv" float
xrwm rule-add -app-id "mpv" dimensions 960 540

# Screenshot annotation
xrwm rule-add -app-id "dev.tensaku.Tensaku" float
xrwm rule-add -app-id "dev.tensaku.Tensaku" dimensions 960 540
xrwm rule-add -title "Tensaku" float
xrwm rule-add -title "Tensaku" dimensions 960 540

# Custom tools
xrwm rule-add -app-id "fuzzel" csd
