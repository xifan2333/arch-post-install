{
  "layer": "top",
  "position": "top",
  "height": 26,
  "modules-left": [
    "custom/tag-1",
    "custom/tag-2",
    "custom/tag-3",
    "custom/tag-4",
    "custom/tag-5",
    "custom/tag-6",
    "custom/tag-7",
    "custom/tag-8",
    "custom/tag-9",
    "custom/xrwm-window"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "custom/screenshot",
    "custom/screenrecord",
    "bluetooth",
    "network",
    "pulseaudio",
    "pulseaudio#microphone",
    "backlight",
    "battery",
    "clock",
    "custom/power"
  ],
  "custom/tag-1": {
    "format": "1",
    "tooltip": false,
    "return-type": "json",
    "exec": "xrwm status --tag 1 --stream",
    "on-click": "xrwm set-focused-tags 1"
  },
  "custom/tag-2": {
    "format": "2",
    "tooltip": false,
    "return-type": "json",
    "exec": "xrwm status --tag 2 --stream",
    "on-click": "xrwm set-focused-tags 2"
  },
  "custom/tag-3": {
    "format": "3",
    "tooltip": false,
    "return-type": "json",
    "exec": "xrwm status --tag 3 --stream",
    "on-click": "xrwm set-focused-tags 4"
  },
  "custom/tag-4": {
    "format": "4",
    "tooltip": false,
    "return-type": "json",
    "exec": "xrwm status --tag 4 --stream",
    "on-click": "xrwm set-focused-tags 8"
  },
  "custom/tag-5": {
    "format": "5",
    "tooltip": false,
    "return-type": "json",
    "exec": "xrwm status --tag 5 --stream",
    "on-click": "xrwm set-focused-tags 16"
  },
  "custom/tag-6": {
    "format": "6",
    "tooltip": false,
    "return-type": "json",
    "exec": "xrwm status --tag 6 --stream",
    "on-click": "xrwm set-focused-tags 32"
  },
  "custom/tag-7": {
    "format": "7",
    "tooltip": false,
    "return-type": "json",
    "exec": "xrwm status --tag 7 --stream",
    "on-click": "xrwm set-focused-tags 64"
  },
  "custom/tag-8": {
    "format": "8",
    "tooltip": false,
    "return-type": "json",
    "exec": "xrwm status --tag 8 --stream",
    "on-click": "xrwm set-focused-tags 128"
  },
  "custom/tag-9": {
    "format": "9",
    "tooltip": false,
    "return-type": "json",
    "exec": "xrwm status --tag 9 --stream",
    "on-click": "xrwm set-focused-tags 256"
  },
  "custom/xrwm-window": {
    "format": "{}",
    "max-length": 45,
    "tooltip": true,
    "return-type": "json",
    "exec": "xrwm status --window --stream"
  },
  "custom/screenshot": {
    "format": "󰻿",
    "tooltip": false,
    "on-click": "arch-cap-menu",
    "on-click-right": "arch-cap-area"
  },
  "custom/screenrecord": {
    "format": "{icon} {text}",
    "format-icons": {
      "recording": "󰑋",
      "live": "󰐻",
      "idle": "󰑊"
    },
    "tooltip": false,
    "return-type": "json",
    "exec": "arch-cap-rec status --waybar",
    "signal": 8,
    "interval": 1,
    "on-click": "arch-cap-rec toggle",
    "on-click-right": "arch-rec-menu"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%Y-%m-%d %A}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "arch-blue-menu"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "format-icons": [
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format": "{ifname} via {gwaddr}\nSSID: {essid}\nIP: {ipaddr}/{cidr}\nSignal: {signalStrength}%",
    "tooltip-format-disconnected": "网络已断开",
    "on-click": "arch-net-menu"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  {volume}%",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬  {volume}%",
    "format-source-muted": "󰍭  {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  },
  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "arch-power-menu"
  }
}
