/* Waybar stylesheet — template
 * Colors are filled from colors.toml at theme-switch time.
 */
@define-color foreground {{ fg }};
@define-color background {{ bg }};

@define-color color-bg0 {{ bg }};
@define-color color-bg1 {{ bg_dim }};
@define-color color-bg2 {{ gray }};
@define-color color-fg0 {{ fg }};
@define-color color-fg1 {{ fg }};
@define-color color-fg2 {{ fg_dim }};

@define-color color-red {{ red }};
@define-color color-orange {{ orange }};
@define-color color-yellow {{ yellow }};
@define-color color-green {{ green }};
@define-color color-cyan {{ aqua }};
@define-color color-blue {{ blue }};
@define-color color-purple {{ purple }};
@define-color color-pink {{ purple }};

@define-color accent-primary {{ yellow }};
@define-color accent-secondary {{ orange }};
