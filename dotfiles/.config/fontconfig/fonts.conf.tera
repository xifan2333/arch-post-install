{% if env.XDG_STATE_HOME is defined and env.XDG_STATE_HOME != "" %}{% set state = env.XDG_STATE_HOME %}{% else %}{% set state = env.HOME ~ "/.local/state" %}{% endif -%}
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <!-- Desktop generic families share the user's primary/fallback pair. -->
{% for family in ["sans-serif", "serif", "system-ui", "ui-sans-serif", "ui-serif", "ui-monospace"] %}
  <alias binding="strong">
    <family>{{ family }}</family>
    <prefer>
      <family>monospace</family>
    </prefer>
  </alias>
{% endfor %}

  <!-- Resolve generic aliases before applying the selected mono/CJK families. -->
  <include ignore_missing="no">{{ state | escape }}/font/fonts.conf</include>
</fontconfig>
