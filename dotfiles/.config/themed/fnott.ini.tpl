# Global color scheme
background={{ background_strip }}f0
border-color={{ accent_strip }}ff
title-color={{ bright_foreground_strip }}ff
summary-color={{ bright_foreground_strip }}ff
body-color={{ light_foreground_strip }}ff
progress-color={{ accent_strip }}ff

[low]
background={{ background_strip }}f0
border-color={{ muted_strip }}ff
title-color={{ muted_strip }}ff
summary-color={{ muted_strip }}ff
body-color={{ muted_strip }}ff
default-timeout=3

[normal]
background={{ background_strip }}f0
border-color={{ accent_strip }}ff
title-color={{ bright_foreground_strip }}ff
summary-color={{ bright_foreground_strip }}ff
body-color={{ light_foreground_strip }}ff
default-timeout=6

[critical]
background={{ background_strip }}f0
border-color={{ red_strip }}ff
title-color={{ bright_red_strip }}ff
summary-color={{ bright_red_strip }}ff
body-color={{ bright_red_strip }}ff
default-timeout=12
