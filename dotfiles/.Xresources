! Xresources configuration for Suckless suite (dwm & st)

! st terminal configuration
st.font: DejaVu Sans Mono:size=13
st.background: #1a1b26
st.foreground: #c0caf5
st.cursorColor: #7aa2f7

st.color0: #15161e
st.color1: #f7768e
st.color2: #9ece6a
st.color3: #e0af68
st.color4: #7aa2f7
st.color5: #bb9af7
st.color6: #7dcfff
st.color7: #a9b1d6
st.color8: #414868
st.color9: #f7768e
st.color10: #9ece6a
st.color11: #e0af68
st.color12: #7aa2f7
st.color13: #bb9af7
st.color14: #7dcfff
st.color15: #c0caf5

! dwm window manager configuration
dwm.font: DejaVu Sans Mono:size=11
dwm.normbgcolor: #1a1b26
dwm.normfgcolor: #c0caf5
dwm.normbordercolor: #15161e
dwm.selbgcolor: #24283b
dwm.selfgcolor: #7aa2f7
dwm.selbordercolor: #7aa2f7
dwm.borderpx: 2
