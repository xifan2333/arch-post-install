#!/usr/bin/env bash
# arch:summary=Show password for active or specified Wi-Fi connection
set -euo pipefail

if ! command -v nmcli >/dev/null 2>&1; then
	printf 'Error: nmcli not found\n' >&2
	exit 1
fi

conn_name="${1:-}"

if [[ -z "$conn_name" ]]; then
	conn_name=$(nmcli -t -f IN-USE,SSID dev wifi list 2>/dev/null | awk -F: '$1 == "*" { print $2; exit }' || true)
fi

if [[ -z "$conn_name" ]]; then
	printf 'Error: No active Wi-Fi connection. Specify profile: arch net password <name>\n' >&2
	exit 1
fi

pass=$(nmcli -s -g 802-11-wireless-security.psk connection show "$conn_name" 2>/dev/null || true)

if [[ -z "$pass" ]]; then
	# Fallback to dev wifi show-password
	pass=$(nmcli dev wifi show-password 2>/dev/null | awk '/(Password|密码):/ { print $2; exit }' || true)
fi

if [[ -n "$pass" ]]; then
	printf 'SSID:     %s\n' "$conn_name"
	printf 'Password: %s\n' "$pass"
else
	printf 'No saved password found for %s\n' "$conn_name" >&2
	exit 1
fi
