#!/usr/bin/env bash
# arch:summary=Show password for active or specified iwd Wi-Fi connection
set -euo pipefail

if ! command -v iwctl >/dev/null 2>&1; then
	printf 'Error: iwctl not found. Please install iwd\n' >&2
	exit 1
fi

conn_name="${1:-}"

if [[ -z "$conn_name" ]]; then
	dev=$(iwctl device list 2>/dev/null | awk '/station/ { print $2; exit }' || true)
	[[ -z "$dev" ]] && dev=$(iwctl device list 2>/dev/null | awk 'NR>4 && NF>1 { print $2; exit }' || true)
	if [[ -n "$dev" ]]; then
		conn_name=$(iwctl station "$dev" show 2>/dev/null | awk -F': ' '/Connected network/ { print $2; exit }' | xargs || true)
	fi
fi

if [[ -z "$conn_name" ]]; then
	printf 'Error: No active Wi-Fi connection. Specify SSID: arch net password <SSID>\n' >&2
	exit 1
fi

psk_file="/var/lib/iwd/${conn_name}.psk"
pass=""

if [[ -r "$psk_file" ]]; then
	pass=$(awk -F'=' '/^Passphrase=/ { print $2; exit }' "$psk_file" || true)
elif command -v sudo >/dev/null 2>&1; then
	pass=$(sudo awk -F'=' '/^Passphrase=/ { print $2; exit }' "$psk_file" 2>/dev/null || true)
fi

if [[ -n "$pass" ]]; then
	printf 'SSID:     %s\n' "$conn_name"
	printf 'Password: %s\n' "$pass"
else
	printf 'Error: Cannot retrieve password for %s (check /var/lib/iwd/%s.psk)\n' "$conn_name" "$conn_name" >&2
	exit 1
fi
