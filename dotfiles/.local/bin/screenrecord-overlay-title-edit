#!/usr/bin/python
"""Quick title overlay editor — single GTK dialog with text + font size."""

import configparser
import os
import subprocess
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib


def t(key, fallback=""):
    """Translate via the bash i18n-core msg() function."""
    try:
        r = subprocess.run(
            ["bash", "-c",
             f'source "$HOME/.local/bin/i18n-core" 2>/dev/null && msg {key}'],
            env={**os.environ, "PATH": os.path.expanduser("~/.local/bin") + ":" + os.environ.get("PATH", "")},
            capture_output=True, text=True, timeout=2,
        )
        out = r.stdout.strip()
        return out if out else fallback
    except Exception:
        return fallback

CONFIG_FILE = Path(GLib.get_user_config_dir()) / "screenrecord" / "title.conf"

DEFAULTS = {
    "text": "直播标题",
    "font_family": "sans-serif",
    "font_size": "36",
    "font_weight": "700",
    "text_color": "#ffffff",
    "background": "rgba(0, 0, 0, 0.55)",
    "text_shadow": "-1px -1px 0 black, 1px -1px 0 black, -1px 1px 0 black, 1px 1px 0 black",
    "anchor_x": "left",
    "anchor_y": "top",
    "margin_x": "24",
    "margin_y": "24",
    "padding_x": "16",
    "padding_y": "10",
    "max_width": "900",
    "opacity": "1.0",
}


def load_config():
    cfg = configparser.ConfigParser()
    if CONFIG_FILE.exists():
        cfg.read(CONFIG_FILE, encoding="utf-8")
    if "title" not in cfg:
        cfg["title"] = {}
        for k, v in DEFAULTS.items():
            cfg["title"][k] = v
    return cfg


def save_config(cfg):
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        cfg.write(f)


def ensure_overlay_visible():
    try:
        subprocess.run(
            ["pgrep", "-f", "python .*/screenrecord-overlay-title$"],
            check=True, capture_output=True,
        )
    except subprocess.CalledProcessError:
        subprocess.Popen(
            ["screenrecord-overlay-title"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )


class TitleDialog(Gtk.Dialog):
    def __init__(self, cfg):
        super().__init__(
            title=t("screenrecord_overlay_title_edit_title", "Edit Title Overlay"),
            modal=True,
        )
        self.cfg = cfg
        self.set_default_size(400, -1)
        self.set_border_width(12)

        content = self.get_content_area()
        content.set_spacing(10)

        # ── title text ──────────────────────────────────────────────
        label = Gtk.Label(label=t("screenrecord_overlay_title_edit_text_item", "Title text"))
        label.set_halign(Gtk.Align.START)
        content.pack_start(label, False, False, 0)

        self.entry = Gtk.Entry()
        self.entry.set_text(cfg["title"].get("text", DEFAULTS["text"]))
        self.entry.set_activates_default(True)
        content.pack_start(self.entry, False, False, 0)

        # ── font size ───────────────────────────────────────────────
        label2 = Gtk.Label(label=t("screenrecord_overlay_title_edit_size_item", "Font size"))
        label2.set_halign(Gtk.Align.START)
        content.pack_start(label2, False, False, 0)

        adj = Gtk.Adjustment(
            value=int(cfg["title"].get("font_size", DEFAULTS["font_size"])),
            lower=12,
            upper=120,
            step_increment=1,
        )
        self.spin = Gtk.SpinButton(adjustment=adj, climb_rate=1, digits=0)
        content.pack_start(self.spin, False, False, 0)

        # ── buttons ─────────────────────────────────────────────────
        self.add_button(t("cancel", "Cancel"), Gtk.ResponseType.CANCEL)
        ok = self.add_button(t("confirm", "OK"), Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        self.set_default_response(Gtk.ResponseType.OK)

        content.show_all()

    def get_values(self):
        return self.entry.get_text(), str(self.spin.get_value_as_int())


def main():
    cfg = load_config()
    dialog = TitleDialog(cfg)
    response = dialog.run()

    if response == Gtk.ResponseType.OK:
        new_text, new_size = dialog.get_values()
        cfg["title"]["text"] = new_text
        cfg["title"]["font_size"] = new_size
        save_config(cfg)
        ensure_overlay_visible()

    dialog.destroy()


if __name__ == "__main__":
    main()
