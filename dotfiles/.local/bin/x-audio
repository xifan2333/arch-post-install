#!/usr/bin/env bash
# arch:summary=Select and switch PipeWire audio output (sink) and microphone (source) devices
# arch:args=[devices [sink|source] | get [sink|source] | set <id> [sink|source] | sink | source | menu [sink|source]]
# arch:examples=x-audio devices | x-audio get | x-audio set 45 | x-audio sink
set -euo pipefail

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$(x-i18n get audio_notify_title 2>/dev/null || echo "Audio")" "$1"
	fi
}

resolve_mode() {
	local m="${1:-sink}"
	if [[ "$m" == "source" || "$m" == "mic" || "$m" == "input" ]]; then
		printf 'source'
	else
		printf 'sink'
	fi
}

get_default_target() {
	local m="$1"
	if [[ "$m" == "source" ]]; then
		printf '@DEFAULT_AUDIO_SOURCE@'
	else
		printf '@DEFAULT_AUDIO_SINK@'
	fi
}

get_target_class() {
	local m="$1"
	if [[ "$m" == "source" ]]; then
		printf 'Audio/Source'
	else
		printf 'Audio/Sink'
	fi
}

get_default_id() {
	local target="$1"
	wpctl inspect "$target" 2>/dev/null | awk '$1=="id"{sub(/,/, "", $2); print $2; exit}' || true
}

list_devices() {
	local m
	m="$(resolve_mode "${1:-sink}")"
	local target_class default_target default_id
	target_class="$(get_target_class "$m")"
	default_target="$(get_default_target "$m")"
	default_id="$(get_default_id "$default_target")"

	pw-dump Node 2>/dev/null | jq -r \
		--arg class "$target_class" \
		--arg def "$default_id" '
	.[] |
	select(.info.props["media.class"] == $class) |
	select((.info.props["node.name"] // "") | test("\\.monitor$") | not) |
	[
	  .id,
	  (if (.id | tostring) == $def then "*" else "" end),
	  (.info.props["node.description"] // .info.props["node.nick"] // .info.props["node.name"])
	] | @tsv
	'
}

show_current() {
	local m
	m="$(resolve_mode "${1:-sink}")"
	local default_target default_id
	default_target="$(get_default_target "$m")"
	default_id="$(get_default_id "$default_target")"

	if [[ -n "$default_id" ]]; then
		local name
		name="$(pw-dump Node 2>/dev/null | jq -r --arg id "$default_id" '.[] | select((.id | tostring) == $id) | .info.props["node.description"] // .info.props["node.name"] // empty' 2>/dev/null || true)"
		printf '%s\t%s\n' "$default_id" "${name:-Unknown}"
	fi
}

set_device() {
	local dev_id="$1"
	local m
	m="$(resolve_mode "${2:-sink}")"
	[[ -n "$dev_id" ]] || {
		printf 'Error: device id required\n' >&2
		exit 1
	}

	wpctl set-default "$dev_id"
	local dev_name
	dev_name="$(pw-dump Node 2>/dev/null | jq -r --arg id "$dev_id" '.[] | select((.id | tostring) == $id) | .info.props["node.description"] // .info.props["node.name"] // empty' 2>/dev/null || echo "$dev_id")"

	if [[ "$m" == "source" ]]; then
		notify "$(x-i18n get audio_source_switched "dev=$dev_name" 2>/dev/null || echo "Switched mic: $dev_name")"
	else
		notify "$(x-i18n get audio_sink_switched "dev=$dev_name" 2>/dev/null || echo "Switched sink: $dev_name")"
	fi
	printf '%s\t%s\n' "$dev_id" "$dev_name"
}

interactive_menu() {
	local m
	m="$(resolve_mode "${1:-sink}")"
	local prompt_text
	if [[ "$m" == "source" ]]; then
		prompt_text="$(x-i18n get audio_source_prompt 2>/dev/null || echo "Audio Input: ")"
	else
		prompt_text="$(x-i18n get audio_sink_prompt 2>/dev/null || echo "Audio Output: ")"
	fi

	local dev_lines
	dev_lines="$(list_devices "$m")"
	if [[ -z "$dev_lines" ]]; then
		notify "$(x-i18n get audio_no_devices 2>/dev/null || echo "No devices found")"
		return 0
	fi

	local menu_items=()
	while IFS=$'\t' read -r did is_def desc; do
		[[ -n "$did" ]] || continue
		local prefix="  "
		[[ "$is_def" == "*" ]] && prefix="* "
		menu_items+=("$prefix$desc ($did)")
	done <<<"$dev_lines"

	local chosen=""
	if command -v fuzzel >/dev/null 2>&1; then
		chosen="$(printf '%s\n' "${menu_items[@]}" | fuzzel --dmenu --prompt "$prompt_text" --lines 10 || true)"
	elif command -v bemenu >/dev/null 2>&1; then
		chosen="$(printf '%s\n' "${menu_items[@]}" | bemenu -p "$prompt_text" || true)"
	fi
	[[ -n "$chosen" ]] || return 0

	local chosen_id
	chosen_id=$(grep -o -E '\([0-9]+\)' <<<"$chosen" | tr -d '()')
	[[ -n "$chosen_id" ]] && set_device "$chosen_id" "$m"
}

main() {
	local cmd="${1:-sink}"
	case "$cmd" in
	devices | list)
		shift
		list_devices "${1:-sink}"
		;;
	get | current)
		shift
		show_current "${1:-sink}"
		;;
	set)
		shift
		set_device "${1:-}" "${2:-sink}"
		;;
	menu)
		shift
		interactive_menu "${1:-sink}"
		;;
	sink | source | mic | input)
		interactive_menu "$cmd"
		;;
	-h | --help | help)
		printf 'Usage: x-audio [devices [sink|source] | get [sink|source] | set <id> [sink|source] | menu [sink|source] | sink | source]\n'
		;;
	*)
		interactive_menu "$cmd"
		;;
	esac
}

main "$@"
