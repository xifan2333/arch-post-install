#!/usr/bin/env bash
# arch:summary=Interactive font configuration via fuzzel
# arch:examples=arch font menu
set -euo pipefail

curr_cjk="$(arch-font-current --cjk 2>/dev/null || echo "Sarasa Mono SC")"

dmenu_exec() {
	local prompt="$1"
	if command -v fuzzel &>/dev/null; then
		fuzzel --dmenu --prompt "$prompt"
	elif command -v bemenu &>/dev/null; then
		bemenu -p "$prompt"
	else
		head -n 1
	fi
}

# Step 1: Select Monospace / Nerd Font
mono_list="$(arch-font-list --mono)"
selected_mono=$(echo "$mono_list" | dmenu_exec "代码与图标字体 (Nerd Font): ")
[[ -n "${selected_mono:-}" ]] || exit 0
selected_mono="${selected_mono#\* }"

# Step 2: Select CJK Fallback Font
cjk_list="$(arch-font-list --cjk)"
selected_cjk=$(echo "$cjk_list" | dmenu_exec "中文字体 (CJK Fallback): ")
if [[ -z "${selected_cjk:-}" ]]; then
	# User cancelled step 2: retain active CJK font and apply chosen mono font
	selected_cjk="$curr_cjk"
else
	selected_cjk="${selected_cjk#\* }"
fi

# Step 3: Apply dual fonts atomically
arch-font-set "$selected_mono" "$selected_cjk"
