#!/usr/bin/env bash
# arch:summary=Interactive font configuration via fuzzel
# arch:examples=arch font menu
set -euo pipefail

curr_mono="$(arch-font-current --mono 2>/dev/null || echo "JetBrainsMono Nerd Font")"
curr_cjk="$(arch-font-current --cjk 2>/dev/null || echo "Sarasa Mono SC")"

format_menu() {
	local current="$1"
	local raw_list="$2"
	local lines=()
	if [[ -n "$current" ]]; then
		lines+=("* $current")
	fi
	while IFS= read -r item; do
		[[ -n "$item" ]] || continue
		[[ "$item" == "$current" ]] && continue
		lines+=("  $item")
	done <<<"$raw_list"
	printf '%s\n' "${lines[@]}"
}

dmenu_exec() {
	local prompt="$1"
	local input="$2"
	if command -v fuzzel &>/dev/null; then
		printf '%s\n' "$input" | fuzzel --dmenu --prompt "$prompt"
	elif command -v bemenu &>/dev/null; then
		printf '%s\n' "$input" | bemenu -p "$prompt"
	else
		printf '%s\n' "$input" | head -n 1
	fi
}

# Step 1: Select Monospace / Nerd Font
mono_raw="$(arch-font-list --mono)"
mono_menu="$(format_menu "$curr_mono" "$mono_raw")"
selected_mono=$(dmenu_exec "Mono: " "$mono_menu")
[[ -n "${selected_mono:-}" ]] || exit 0
selected_mono="${selected_mono#\* }"
selected_mono="${selected_mono#  }"

# Step 2: Select CJK Fallback Font
cjk_raw="$(arch-font-list --cjk)"
cjk_menu="$(format_menu "$curr_cjk" "$cjk_raw")"
selected_cjk=$(dmenu_exec "CJK: " "$cjk_menu")
if [[ -z "${selected_cjk:-}" ]]; then
	selected_cjk="$curr_cjk"
else
	selected_cjk="${selected_cjk#\* }"
	selected_cjk="${selected_cjk#  }"
fi

# Step 3: Apply dual fonts atomically
arch-font-set "$selected_mono" "$selected_cjk"
