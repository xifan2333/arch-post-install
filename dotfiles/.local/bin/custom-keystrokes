#!/usr/bin/env bash
#
# @name         custom-keystrokes
# @summary      Toggle or control keystroke HUD overlay via wayhud
# @version      1.0.0
# @deps         systemctl, uwsm, wayhud
#
# @description  On-screen keystroke visualizer HUD overlay controller.
#               Uses a session-bound systemd service without PID files.
#
# @usage        custom-keystrokes [options] [command]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   toggle      Toggle keystroke overlay on or off (default)
#   start       Start keystroke overlay
#   stop        Stop keystroke overlay
#   status      Print current overlay state (active | inactive)
#
# @stdout       Status string (active | inactive)
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-keystrokes
#   custom-keystrokes toggle
#   custom-keystrokes status

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	if ((BASH_SUBSHELL == 0)); then
		custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	fi
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }

unit=custom-keystrokes.service
startup_delay=0.1
running() {
	local state
	require systemctl
	state=$(systemctl --user show --property=ActiveState --value "$unit") || die 1 cli_unavailable "name=$unit"
	case "$state" in active | activating) return 0 ;; inactive | failed) return 1 ;; *) die 1 cli_unavailable "name=$unit:$state" ;; esac
}
stop_keys() {
	require systemctl
	if running; then systemctl --user stop "$unit"; fi
}
start_keys() {
	if running; then return 0; fi
	require wayhud uwsm systemctl
	uwsm app -t service -p PartOf=graphical-session.target -s b -u "$unit" -- wayhud -n keys
	sleep "$startup_delay"
	running || die 1 cli_unavailable "name=$unit"
}
main() {
	(($# <= 1)) || usage_error
	case "${1:-toggle}" in
	-h | --help) t help_keystrokes ;;
	start) start_keys ;; stop) stop_keys ;;
	toggle) if running; then stop_keys; else start_keys; fi ;;
	status) if running; then printf 'active\n'; else printf 'inactive\n'; fi ;;
	*) usage_error ;;
	esac
}
main "$@"
