#!/usr/bin/env bash
#
# @name         custom-keystrokes
# @summary      Toggle or control keystroke HUD overlay via wayhud
# @version      1.0.0
# @deps         wayhud
#
# @description  On-screen keystroke visualizer HUD overlay controller.
#               Inspects wayhud processes dynamically without persistent state files.
#
# @usage        custom-keystrokes [options] [command]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   toggle      Toggle keystroke overlay on or off (default)
#   start       Start keystroke overlay
#   stop        Stop keystroke overlay
#   status      Print current overlay state (active | inactive)
#
# @stdout       Status string (active | inactive)
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-keystrokes
#   custom-keystrokes toggle
#   custom-keystrokes status

set -euo pipefail

show_help() {
	cat <<'EOF'
Usage: custom-keystrokes [options] [command]

Options:
  -h, --help  Show this help message and exit

Commands:
  toggle      Toggle keystroke overlay on or off (default)
  start       Start keystroke overlay
  stop        Stop keystroke overlay
  status      Print current overlay state (active | inactive)

Examples:
  custom-keystrokes
  custom-keystrokes toggle
  custom-keystrokes status
EOF
}

is_keys_running() {
	pgrep -f "wayhud[[:space:]]+-n[[:space:]]+keys\b" >/dev/null 2>&1
}

stop_keys() {
	pkill -f "wayhud[[:space:]]+-n[[:space:]]+keys\b" 2>/dev/null || true
}

start_keys() {
	if ! command -v wayhud >/dev/null 2>&1; then
		printf 'Error: wayhud is not installed\n' >&2
		exit 127
	fi
	stop_keys
	wayhud -n keys >/dev/null 2>&1 &
}

toggle_keys() {
	if is_keys_running; then
		stop_keys
	else
		start_keys
	fi
}

main() {
	local act="${1:-toggle}"
	case "$act" in
	-h | --help)
		show_help
		exit 0
		;;
	start) start_keys ;;
	stop) stop_keys ;;
	toggle) toggle_keys ;;
	status)
		if is_keys_running; then
			printf 'active\n'
		else
			printf 'inactive\n'
		fi
		;;
	*)
		printf 'Error: Unknown command "%s" (run custom-keystrokes --help for usage)\n' "$act" >&2
		exit 2
		;;
	esac
}

main "$@"
