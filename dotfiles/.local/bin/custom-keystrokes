#!/usr/bin/env bash
#
# @name         custom-keystrokes
# @summary      Toggle or control keystroke HUD overlay via wayhud
# @version      1.0.0
# @deps         wayhud
#
# @description  On-screen keystroke visualizer HUD overlay controller.
#               Inspects wayhud processes dynamically without persistent state files.
#
# @usage        custom-keystrokes [options] [command]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   toggle      Toggle keystroke overlay on or off (default)
#   start       Start keystroke overlay
#   stop        Stop keystroke overlay
#   status      Print current overlay state (active | inactive)
#
# @stdout       Status string (active | inactive)
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-keystrokes
#   custom-keystrokes toggle
#   custom-keystrokes status

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }

pattern='(^|/)wayhud[[:space:]]+-n[[:space:]]+keys([[:space:]]|$)'
startup_delay=0.1
running() {
	local rc
	require pgrep
	if pgrep -u "$UID" -f "$pattern" >/dev/null; then return 0; else rc=$?; fi
	((rc == 1)) || die 1 cli_unavailable name=pgrep
	return 1
}
stop_keys() {
	require pkill
	if running; then pkill -u "$UID" -f "$pattern"; fi
}
start_keys() {
	local pid
	require wayhud
	if running; then return 0; fi
	wayhud -n keys >/dev/null &
	pid=$!
	sleep "$startup_delay"
	if ! kill -0 "$pid" 2>/dev/null; then
		wait "$pid"
		die 1 cli_unavailable name=wayhud
	fi
}
main() {
	(($# <= 1)) || usage_error
	case "${1:-toggle}" in
	-h | --help) t help_keystrokes ;;
	start) start_keys ;; stop) stop_keys ;;
	toggle) if running; then stop_keys; else start_keys; fi ;;
	status) if running; then printf 'active\n'; else printf 'inactive\n'; fi ;;
	*) usage_error ;;
	esac
}
main "$@"
