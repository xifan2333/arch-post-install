#!/usr/bin/env bash
# arch:summary=Manage, switch, or interactively configure monospace and CJK fallback fonts
# arch:args=[menu | current [mono|cjk] | list [mono|cjk] | set <mono> [cjk] | <mono> [cjk]]
# arch:examples=x-font | x-font current | x-font "JetBrainsMono Nerd Font" "Sarasa Mono SC"
set -euo pipefail

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$(x-i18n get font_title 2>/dev/null || echo "Typography")" "$1"
	fi
}

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/font"
mkdir -p "$state_dir"

get_current_mono() {
	if [[ -f "$state_dir/mono.name" ]]; then
		cat "$state_dir/mono.name"
	else
		fc-match monospace -f '%{family}\n' 2>/dev/null | head -n1 | cut -d, -f1
	fi
}

get_current_cjk() {
	if [[ -f "$state_dir/cjk.name" ]]; then
		cat "$state_dir/cjk.name"
	else
		printf 'Sarasa Mono SC\n'
	fi
}

is_cjk_font() {
	local name="$1"
	if [[ "$name" =~ (Sarasa|CJK|WenKai|Source\ Han|PingFang|Microsoft\ YaHei|SimSun|KaiTi) ]]; then
		return 0
	fi
	return 1
}

get_mono_fonts() {
	local curr_mono="$1" raw
	raw=$(fc-list : family 2>/dev/null |
		tr ',' '\n' |
		sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
		grep -iE "(Nerd Font|Maple Mono|Fira Code|Hack|Iosevka|JetBrains|Source Code|Cascadia)" |
		grep -vE "(Extra|Semi|Light|Thin|Medium|Bold|Black|Italic|NL)" |
		grep -vE "(CJK|Chinese|SC|TC|HK|JP|KR)" |
		sort -u || true)

	if [[ -n "$curr_mono" ]] && echo "$raw" | grep -Fxq "$curr_mono"; then
		printf '%s\n' "$curr_mono"
		echo "$raw" | grep -vFx "$curr_mono" || true
	else
		echo "$raw"
	fi
}

get_cjk_fonts() {
	local curr_cjk="$1" raw
	raw=$(fc-list : family 2>/dev/null |
		tr ',' '\n' |
		sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
		grep -E "^(Sarasa Mono SC|Sarasa UI SC|Sarasa Gothic SC|Noto Sans Mono CJK SC|Noto Sans CJK SC|Source Han Sans CN|LXGW WenKai)" |
		grep -vE "(Black|DemiLight|Light|Medium|Thin|SemiBold|XLight|Extra|Bold|Italic)" |
		sort -u || true)

	if [[ -n "$curr_cjk" ]] && echo "$raw" | grep -Fxq "$curr_cjk"; then
		printf '%s\n' "$curr_cjk"
		echo "$raw" | grep -vFx "$curr_cjk" || true
	else
		echo "$raw"
	fi
}

list_fonts() {
	local type="${1:-all}"
	local curr_mono curr_cjk
	curr_mono="$(get_current_mono)"
	curr_cjk="$(get_current_cjk)"

	case "$type" in
	mono | -m | --mono)
		get_mono_fonts "$curr_mono"
		;;
	cjk | -c | --cjk)
		get_cjk_fonts "$curr_cjk"
		;;
	*)
		printf 'Available Monospace / Nerd Fonts:\n'
		while IFS= read -r f; do
			[[ -z "$f" ]] && continue
			printf '  %s\n' "$f"
		done < <(get_mono_fonts "$curr_mono")

		printf '\nAvailable CJK Fallback Fonts:\n'
		while IFS= read -r f; do
			[[ -z "$f" ]] && continue
			printf '  %s\n' "$f"
		done < <(get_cjk_fonts "$curr_cjk")
		;;
	esac
}

show_current() {
	local type="${1:-all}"
	case "$type" in
	mono | -m | --mono)
		get_current_mono
		;;
	cjk | -c | --cjk)
		get_current_cjk
		;;
	*)
		printf 'Mono: %s\n' "$(get_current_mono)"
		printf 'CJK : %s\n' "$(get_current_cjk)"
		;;
	esac
}

set_fonts() {
	local mono_font="$1" cjk_font="$2"

	# 1. State: Fontconfig monospace & CJK fallback snippet
	cat >"$state_dir/fonts.conf" <<EOF
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Auto-generated by x-font: DO NOT EDIT DIRECTLY -->
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="prepend" binding="strong">
      <string>$mono_font</string>
    </edit>
  </match>
  <alias>
    <family>monospace</family>
    <prefer>
      <family>$cjk_font</family>
      <family>Noto Color Emoji</family>
    </prefer>
  </alias>
</fontconfig>
EOF

	# 2. State: Waybar typography snippet
	cat >"$state_dir/waybar.css" <<EOF
/* Auto-generated by x-font: DO NOT EDIT DIRECTLY */
* {
    font-family: "$mono_font", "$cjk_font";
}
EOF

	# 3. State: Fuzzel typography snippet
	cat >"$state_dir/fuzzel.ini" <<EOF
# Auto-generated by x-font: DO NOT EDIT DIRECTLY
[main]
font=$cjk_font:size=13
EOF

	# 4. State: Persist font names for quick introspection
	printf '%s\n' "$mono_font" >"$state_dir/mono.name"
	printf '%s\n' "$cjk_font" >"$state_dir/cjk.name"

	# 5. Broadcast live reloads
	pkill -SIGUSR2 waybar 2>/dev/null || true
	fc-cache 2>/dev/null || true

	notify "$(x-i18n get font_switched "font=$mono_font" 2>/dev/null || echo "Monospace font switched to: $mono_font")"
	printf '✓ Set active fonts:\n  Mono: %s\n  CJK : %s\n' "$mono_font" "$cjk_font"
}

interactive_menu() {
	local curr_mono curr_cjk
	curr_mono="$(get_current_mono)"
	curr_cjk="$(get_current_cjk)"

	local dmenu_cmd="fuzzel --dmenu --prompt"
	if ! command -v fuzzel &>/dev/null; then
		if command -v bemenu &>/dev/null; then
			dmenu_cmd="bemenu -p"
		else
			dmenu_cmd="head -1"
		fi
	fi

	# Format menu entries with active mark
	format_menu() {
		local curr="$1" raw_list="$2"
		local lines=()
		if [[ -n "$curr" ]]; then
			lines+=("* $curr")
		fi
		while IFS= read -r item; do
			[[ -n "$item" ]] || continue
			[[ "$item" == "$curr" ]] && continue
			lines+=("  $item")
		done <<<"$raw_list"
		printf '%s\n' "${lines[@]}"
	}

	# Step 1: Select Monospace Font
	local prompt_mono prompt_cjk
	prompt_mono="$(x-i18n get font_prompt_mono 2>/dev/null || echo "Monospace Font: ")"
	prompt_cjk="$(x-i18n get font_prompt_cjk 2>/dev/null || echo "CJK Font: ")"

	local mono_raw mono_menu selected_mono
	mono_raw="$(get_mono_fonts "$curr_mono")"
	mono_menu="$(format_menu "$curr_mono" "$mono_raw")"
	selected_mono=$(printf '%s\n' "$mono_menu" | $dmenu_cmd "$prompt_mono")
	[[ -n "${selected_mono:-}" ]] || return 0
	selected_mono="${selected_mono#\* }"
	selected_mono="${selected_mono#  }"

	# Step 2: Select CJK Font
	local cjk_raw cjk_menu selected_cjk
	cjk_raw="$(get_cjk_fonts "$curr_cjk")"
	cjk_menu="$(format_menu "$curr_cjk" "$cjk_raw")"
	selected_cjk=$(printf '%s\n' "$cjk_menu" | $dmenu_cmd "$prompt_cjk")
	if [[ -z "${selected_cjk:-}" ]]; then
		selected_cjk="$curr_cjk"
	else
		selected_cjk="${selected_cjk#\* }"
		selected_cjk="${selected_cjk#  }"
	fi

	set_fonts "$selected_mono" "$selected_cjk"
}

main() {
	local action="${1:-menu}"

	case "$action" in
	menu)
		interactive_menu
		;;
	current)
		shift
		show_current "${1:-all}"
		;;
	list)
		shift
		list_fonts "${1:-all}"
		;;
	set)
		shift
		if [[ $# -eq 0 ]]; then
			printf 'Usage: x-font set <mono-font> [<cjk-font>]\n' >&2
			exit 1
		fi
		local mono="$1" cjk="${2:-}"
		if [[ -z "$cjk" ]]; then
			if is_cjk_font "$mono"; then
				cjk="$mono"
				mono="$(get_current_mono)"
			else
				cjk="$(get_current_cjk)"
			fi
		fi
		set_fonts "$mono" "$cjk"
		;;
	-h | --help | help)
		printf 'Usage: x-font [menu | current [mono|cjk] | list [mono|cjk] | set <mono> [cjk] | <mono> [cjk]]\n'
		;;
	*)
		# Direct font name arguments
		local mono="$1" cjk="${2:-}"
		if [[ -z "$cjk" ]]; then
			if is_cjk_font "$mono"; then
				cjk="$mono"
				mono="$(get_current_mono)"
			else
				cjk="$(get_current_cjk)"
			fi
		fi
		set_fonts "$mono" "$cjk"
		;;
	esac
}

main "$@"
