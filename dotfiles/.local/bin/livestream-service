#!/usr/bin/python
"""Session D-Bus service and client for multi-platform RTMP/SRT streaming.

One gpu-screen-recorder encode is fanned out to N targets (Bilibili 16:9 + Phone 9:16)
via ffmpeg with per-platform Lanczos composition and zero-copy stream fan-out.
"""

from __future__ import annotations

import argparse
import contextlib
import json
import os
import re
import signal
import subprocess
import threading
import time
import warnings
from dataclasses import dataclass
from pathlib import Path

DEFAULT_VIDEO_BITRATE = 6000
DEFAULT_AUDIO_BITRATE = 160

import gi

gi.require_version("Gio", "2.0")

from gi.repository import Gio, GLib

warnings.filterwarnings("ignore", category=DeprecationWarning)


def translate(key, fallback="", **values):
    bin_dir = Path(__file__).resolve().parent
    i18n_core = bin_dir / "i18n-core"
    command = [
        "bash",
        "-c",
        f'source "{i18n_core}" 2>/dev/null || exit 1; msg "$@"',
        "livestream-i18n",
        key,
    ]
    for name, value in values.items():
        command.extend([name, str(value)])

    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        message = result.stdout.strip()
        if result.returncode == 0 and message and message != f"[{key}]":
            return message
    except (OSError, subprocess.TimeoutExpired):
        pass

    try:
        return fallback.format(**values)
    except (KeyError, ValueError):
        return fallback


def translated_state(state):
    return translate(f"livestream_state_{state}", state)


BUS_NAME = "com.xifan.Livestream"
OBJECT_PATH = "/com/xifan/Livestream"
INTERFACE = "com.xifan.Livestream"
INTROSPECTION_XML = f"""
<node>
  <interface name="{INTERFACE}">
    <method name="GetStatus">
      <arg type="s" name="status_json" direction="out"/>
    </method>
    <method name="Stop">
      <arg type="b" name="accepted" direction="out"/>
    </method>
    <signal name="StatusChanged">
      <arg type="s" name="status_json"/>
    </signal>
  </interface>
</node>
"""


@dataclass
class Platform:
    name: str
    server: str
    stream_key: str
    url: str
    video_bitrate: int
    audio_bitrate: int
    scheme: str = "rtmp"
    aspect_ratio: str = "16:9"


def bounded_int(value, default, minimum, maximum):
    try:
        number = int(value)
    except (TypeError, ValueError):
        return default
    return number if minimum <= number <= maximum else default


def make_platform(name, server, stream_key, video_bitrate, audio_bitrate, aspect_ratio="16:9"):
    name = str(name or "").replace("\t", " ").replace("\r", " ").replace("\n", " ").strip()
    server = str(server or "").strip().rstrip("/")
    stream_key = str(stream_key or "").strip().lstrip("/")
    aspect_ratio = str(aspect_ratio or "16:9").strip().lower()
    if aspect_ratio not in ("9:16", "16:9"):
        aspect_ratio = "16:9"

    if not name or not server or any(c in server + stream_key for c in "\t\r\n"):
        return None

    if server.startswith("srt://"):
        return Platform(
            name=name,
            server=server,
            stream_key="",
            url=server,
            video_bitrate=int(video_bitrate),
            audio_bitrate=int(audio_bitrate),
            scheme="srt",
            aspect_ratio=aspect_ratio,
        )
    if not server.startswith(("rtmp://", "rtmps://")):
        server = f"rtmp://{server}"
    url = f"{server}/{stream_key}" if stream_key else server
    return Platform(
        name=name,
        server=server,
        stream_key=stream_key,
        url=url,
        video_bitrate=int(video_bitrate),
        audio_bitrate=int(audio_bitrate),
        scheme="rtmp",
        aspect_ratio=aspect_ratio,
    )


def platforms_from_items(items, video_bitrate, audio_bitrate):
    platforms = []
    if isinstance(items, dict):
        pairs = items.items()
    elif isinstance(items, list):
        pairs = (
            (item.get("name") or item.get("platform") or f"p{index}", item)
            for index, item in enumerate(items)
            if isinstance(item, dict)
        )
    else:
        return platforms

    for name, item in pairs:
        if not isinstance(item, dict):
            continue
        enabled = item.get("enabled", True)
        if isinstance(enabled, bool) and not enabled:
            continue
        platform = make_platform(
            name,
            item.get("server"),
            item.get("key") or item.get("stream_key"),
            video_bitrate,
            audio_bitrate,
            item.get("aspect_ratio", "16:9"),
        )
        if platform:
            platforms.append(platform)
    return platforms


def load_stream_config(path):
    config_path = Path(path)

    video = DEFAULT_VIDEO_BITRATE
    audio = DEFAULT_AUDIO_BITRATE
    platforms = []
    if not config_path.is_file():
        return platforms, video, audio

    try:
        data = json.loads(config_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return platforms, video, audio
    if not isinstance(data, dict):
        return platforms, video, audio

    video = bounded_int(
        data.get("bitrate", data.get("video_bitrate")),
        DEFAULT_VIDEO_BITRATE,
        100,
        50000,
    )
    audio = bounded_int(
        data.get("audio_bitrate"),
        DEFAULT_AUDIO_BITRATE,
        32,
        320,
    )
    platforms = platforms_from_items(data.get("platforms") or [], video, audio)
    return platforms, video, audio


def offline_status():
    return {
        "active": False,
        "state": "offline",
        "mode": "idle",
        "duration_seconds": 0,
        "bitrate": 0,
        "audio_bitrate": 0,
        "platforms": [],
    }


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    run_parser = subparsers.add_parser("run", help="Run the D-Bus service daemon")
    run_parser.add_argument("--config", required=True, help="Path to config.json")
    run_parser.add_argument("--target", default="screen", help="Capture target")
    run_parser.add_argument(
        "--audio-source", default="default_output|default_input", help="Audio source"
    )
    run_parser.add_argument("--framerate", type=int, default=30, help="Video framerate")
    run_parser.add_argument("--keyint", type=int, default=2, help="Keyframe interval (seconds)")
    run_parser.add_argument("--scale-width", type=int, default=0, help="Downscale width")
    run_parser.add_argument("--log-file", required=True, help="Path to log file")

    validate_parser = subparsers.add_parser("validate", help="Validate config")
    validate_parser.add_argument("--config", required=True, help="Path to config.json")

    status_parser = subparsers.add_parser("status", help="Get streaming status JSON")
    status_parser.add_argument("--platforms-only", action="store_true")

    field_parser = subparsers.add_parser("field", help="Get a specific status field")
    field_parser.add_argument("name", help="Field name")

    wait_parser = subparsers.add_parser("wait-ready", help="Wait until service is ready")
    wait_parser.add_argument("--timeout", type=int, default=30)

    stop_parser = subparsers.add_parser("stop", help="Stop streaming")
    stop_parser.add_argument("--timeout", type=int, default=7)

    subparsers.add_parser("is-active", help="Check if active")
    return parser.parse_args()


def get_proxy():
    try:
        connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        proxy = Gio.DBusProxy.new_sync(
            connection,
            Gio.DBusProxyFlags.DO_NOT_AUTO_START,
            None,
            BUS_NAME,
            OBJECT_PATH,
            INTERFACE,
            None,
        )
        if proxy.get_name_owner() is None:
            return None
        return proxy
    except (GLib.Error, TypeError):
        return None


def get_remote_status():
    proxy = get_proxy()
    if proxy is None:
        return None
    try:
        return json.loads(proxy.GetStatus())
    except (GLib.Error, json.JSONDecodeError, TypeError):
        return None


def platform_status_lines(status):
    platforms = status.get("platforms", [])
    if not platforms:
        return [translate("livestream_status_no_platforms", "No platforms configured")]
    return [
        f"{p.get('name', 'unknown')}: {translated_state(p.get('state', 'unknown'))}"
        for p in platforms
    ]


class LivestreamService:
    def __init__(self, args):
        self.args = args
        platforms, video_bitrate, audio_bitrate = load_stream_config(args.config)
        self.platforms = platforms
        self.video_bitrate = video_bitrate
        self.audio_bitrate = audio_bitrate
        self.started_at = time.monotonic()
        self.loop = GLib.MainLoop()
        self.connection = None
        self.registration_id = 0
        self.owner_id = 0
        self.name_acquired = False
        self.stopping = False
        self.all_dead_since = None
        self.last_signature = None
        self.log_lock = threading.Lock()
        self.log_handle = self._open_log(args.log_file)
        self.node_info = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION_XML)
        self.encoder_process = None
        self.tee_process = None
        self.tee_log_thread = None
        self.encoder_log_thread = None
        self.stream_state = "connecting"
        self.baseline_acked = None
        self.last_acked = None
        self.last_progress = None

    @staticmethod
    def _open_log(path):
        log_path = Path(path)
        log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with contextlib.suppress(OSError):
            os.chmod(log_path.parent, 0o700)
        fd = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with contextlib.suppress(OSError):
            os.chmod(log_path, 0o600)
        return os.fdopen(fd, "w", encoding="utf-8", buffering=1)

    def log(self, message):
        line = f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {message}\n"
        with self.log_lock:
            self.log_handle.write(line)
            self.log_handle.flush()

    def safe_log_line(self, line):
        safe_line = line
        for platform in self.platforms:
            safe_line = safe_line.replace(platform.url, "[TARGET]")
            if platform.stream_key:
                safe_line = safe_line.replace(platform.stream_key, "[KEY]")
        self.log(safe_line)

    def read_process_log(self, process):
        if process is None or process.stderr is None:
            return
        for raw in iter(process.stderr.readline, b""):
            line = raw.decode("utf-8", errors="replace").rstrip()
            if not line or line.startswith(
                (
                    "frame=",
                    "size=",
                    "time=",
                    "bitrate=",
                    "speed=",
                    "video:",
                    "audio:",
                )
            ):
                continue
            self.safe_log_line(line)

    def encoder_command(self, video_bitrate, audio_bitrate, output=None):
        command = [
            "gpu-screen-recorder",
            "-w",
            self.args.target,
            "-c",
            "flv",
            "-f",
            str(self.args.framerate),
            "-fm",
            "cfr",
            "-bm",
            "cbr",
            "-q",
            str(video_bitrate),
            "-keyint",
            str(self.args.keyint),
            "-ab",
            str(audio_bitrate),
            "-cr",
            "limited",
            "-a",
            self.args.audio_source,
            "-fallback-cpu-encoding",
            "yes",
        ]
        if self.args.scale_width:
            command.extend(["-s", f"{self.args.scale_width}x0"])
        if output is not None:
            command.extend(["-o", output])
        return command

    @staticmethod
    def platform_format(platform):
        return "mpegts" if platform.scheme == "srt" else "flv"

    def lan_only(self):
        return all(platform.scheme == "srt" for platform in self.platforms)

    @staticmethod
    def escape_tee_slave(url):
        special = set("\\'|:[]=?&")
        return "".join(f"\\{char}" if char in special or char.isspace() else char for char in url)

    @staticmethod
    def vertical_filter():
        return "scale=1080:-2:flags=lanczos,pad=1080:1920:0:(1920-ih)/2:black"

    def tee_targets(self, platforms):
        return "|".join(
            f"[f={self.platform_format(platform)}]{self.escape_tee_slave(platform.url)}"
            for platform in platforms
        )

    def fanout_command(self):
        groups = {
            mode: [platform for platform in self.platforms if platform.aspect_ratio == mode]
            for mode in ("16:9", "9:16")
        }
        filters = [f"[0:v]{self.vertical_filter()}[v_vertical]"] if groups["9:16"] else []
        command = ["ffmpeg", "-hide_banner", "-loglevel", "warning", "-i", "-"]
        if filters:
            command.extend(["-filter_complex", ";".join(filters)])

        gop = max(1, self.args.framerate * self.args.keyint)
        for mode in ("16:9", "9:16"):
            platforms = groups[mode]
            if not platforms:
                continue

            if mode == "16:9":
                command.extend(["-map", "0:v", "-c:v", "copy"])
            else:
                command.extend(
                    [
                        "-map",
                        "[v_vertical]",
                        "-c:v",
                        "libx264",
                        "-preset",
                        "veryfast",
                        "-tune",
                        "zerolatency",
                        "-b:v",
                        f"{self.video_bitrate}k",
                        "-pix_fmt",
                        "yuv420p",
                        "-g",
                        str(gop),
                        "-keyint_min",
                        str(gop),
                        "-sc_threshold",
                        "0",
                    ]
                )

            command.extend(
                [
                    "-map",
                    "0:a?",
                    "-c:a",
                    "copy",
                    "-f",
                    "tee",
                    self.tee_targets(platforms),
                ]
            )

        return command

    def start_stream(self):
        if not self.platforms:
            self.log("No valid streaming targets configured")
            self.stream_state = "failed"
            self.emit_status(force=True)
            self.all_dead_since = time.monotonic()
            return

        video_bitrate = self.video_bitrate
        audio_bitrate = self.audio_bitrate
        for platform in self.platforms:
            platform.video_bitrate = video_bitrate
            platform.audio_bitrate = audio_bitrate

        direct_platform = (
            self.platforms[0]
            if len(self.platforms) == 1
            and self.platforms[0].scheme == "rtmp"
            and self.platforms[0].aspect_ratio == "16:9"
            else None
        )

        try:
            if direct_platform is not None:
                self.encoder_process = subprocess.Popen(
                    self.encoder_command(
                        video_bitrate,
                        audio_bitrate,
                        output=direct_platform.url,
                    ),
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                )
                self.tee_process = None
                self.log(
                    f"direct stream started at {video_bitrate}/{audio_bitrate} kbps "
                    f"-> {direct_platform.name}",
                )
            else:
                self.encoder_process = subprocess.Popen(
                    self.encoder_command(video_bitrate, audio_bitrate),
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                )
                self.tee_process = subprocess.Popen(
                    self.fanout_command(),
                    stdin=self.encoder_process.stdout,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                )
                self.encoder_process.stdout.close()
                self.log(
                    f"fanout stream started at {video_bitrate}/{audio_bitrate} kbps "
                    f"-> {len(self.platforms)} target(s)",
                )
        except OSError as error:
            self.log(f"failed to start stream pipeline: {error}")
            self.terminate_processes()
            self.encoder_process = None
            self.tee_process = None
            self.stream_state = "failed"
            self.emit_status(force=True)
            self.all_dead_since = time.monotonic()
            return

        self.encoder_log_thread = threading.Thread(
            target=self.read_process_log,
            args=(self.encoder_process,),
            daemon=True,
        )
        self.encoder_log_thread.start()
        if self.tee_process is not None:
            self.tee_log_thread = threading.Thread(
                target=self.read_process_log,
                args=(self.tee_process,),
                daemon=True,
            )
            self.tee_log_thread.start()
        self.emit_status(force=True)

    @staticmethod
    def socket_snapshot():
        try:
            result = subprocess.run(
                ["ss", "-Htinp", "state", "established"],
                capture_output=True,
                text=True,
                timeout=2,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            return {}

        lines = result.stdout.splitlines()
        sockets = {}
        for index, line in enumerate(lines):
            pids = [int(value) for value in re.findall(r"pid=(\d+),", line)]
            if not pids:
                continue
            details = line
            if index + 1 < len(lines) and not re.search(r"pid=\d+,", lines[index + 1]):
                details += " " + lines[index + 1]
            ack_match = re.search(r"bytes_acked:(\d+)", details)
            if not ack_match:
                continue
            acked = int(ack_match.group(1))
            for pid in pids:
                sockets[pid] = sockets.get(pid, 0) + acked
        return sockets

    def stream_process(self):
        return self.tee_process if self.tee_process is not None else self.encoder_process

    def update_stream(self, sockets, now):
        process = self.stream_process()
        if process is None or process.poll() is not None:
            self.stream_state = "failed"
        else:
            acked = sockets.get(process.pid, 0)
            if self.last_acked is None or acked < self.last_acked:
                self.baseline_acked = acked
                self.last_acked = acked
                self.last_progress = None
            elif acked > self.last_acked:
                self.last_acked = acked
                self.last_progress = now

            baseline = self.baseline_acked
            delta = acked - baseline if baseline is not None else 0
            recent = self.last_progress is not None and now - self.last_progress <= 5
            if delta >= 65536 and recent:
                self.stream_state = "sending"
            elif delta >= 65536:
                self.stream_state = "stalled"
            else:
                self.stream_state = "connecting"

            if self.lan_only():
                # SRT establishes its peer before ffmpeg starts writing. A live
                # fanout process therefore represents an active SRT session.
                self.stream_state = "sending"

    def build_status(self):
        now = time.monotonic()
        duration = int(now - self.started_at) if self.started_at is not None else 0
        state = self.stream_state
        platforms = [
            {
                "name": p.name,
                "state": state,
                "video_bitrate": p.video_bitrate,
                "audio_bitrate": p.audio_bitrate,
                "aspect_ratio": p.aspect_ratio,
            }
            for p in self.platforms
        ]
        return {
            "active": state in ("connecting", "sending", "stalled"),
            "state": state,
            "mode": self.args.target,
            "duration_seconds": duration,
            "bitrate": self.video_bitrate,
            "audio_bitrate": self.audio_bitrate,
            "platforms": platforms,
        }

    @staticmethod
    def refresh_waybar():
        subprocess.run(
            ["pkill", "-SIGRTMIN+8", "waybar"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )

    def emit_status(self, force=False):
        status = self.build_status()
        signature = (
            status["active"],
            status["state"],
            tuple((platform["name"], platform["state"]) for platform in status["platforms"]),
        )
        if not force and signature == self.last_signature:
            return
        self.last_signature = signature
        if self.connection is not None:
            with contextlib.suppress(GLib.Error):
                self.connection.emit_signal(
                    None,
                    OBJECT_PATH,
                    INTERFACE,
                    "StatusChanged",
                    GLib.Variant("(s)", (json.dumps(status),)),
                )
        self.refresh_waybar()

    def on_bus_acquired(self, connection, name):
        self.connection = connection
        self.registration_id = connection.register_object(
            OBJECT_PATH,
            self.node_info.interfaces[0],
            self.handle_method_call,
            None,
            None,
        )

    def on_name_acquired(self, connection, name):
        self.name_acquired = True
        self.start_stream()

    def on_name_lost(self, connection, name):
        if not self.name_acquired:
            self.log("Name lost: another instance holds the D-Bus service")
        self.loop.quit()

    def handle_method_call(self, connection, sender, path, iface, method, params, invocation):
        if method == "GetStatus":
            status_json = json.dumps(self.build_status())
            invocation.return_value(GLib.Variant("(s)", (status_json,)))
        elif method == "Stop":
            accepted = not self.stopping
            invocation.return_value(GLib.Variant("(b)", (accepted,)))
            GLib.idle_add(self.request_stop)

    def request_stop(self):
        if self.stopping:
            return GLib.SOURCE_REMOVE
        self.stopping = True
        self.stream_state = "stopping"
        self.log("stop requested")
        self.emit_status(force=True)
        self.terminate_processes()
        self.loop.quit()
        return GLib.SOURCE_REMOVE

    def terminate_processes(self):
        processes = (self.tee_process, self.encoder_process)
        for process in processes:
            if process is not None and process.poll() is None:
                with contextlib.suppress(OSError):
                    process.terminate()
        time.sleep(0.2)
        for process in processes:
            if process is not None and process.poll() is None:
                with contextlib.suppress(OSError):
                    process.kill()

    def tick(self):
        if self.stopping:
            return GLib.SOURCE_REMOVE

        now = time.monotonic()
        sockets = self.socket_snapshot()
        self.update_stream(sockets, now)

        if self.stream_state == "failed":
            if self.all_dead_since is None:
                self.all_dead_since = now
            elif now - self.all_dead_since >= 5:
                self.log("Stream failed for 5s, shutting down")
                self.terminate_processes()
                self.loop.quit()
                return False
        else:
            self.all_dead_since = None

        self.emit_status()
        return True

    def run(self):
        signal.signal(signal.SIGINT, lambda *_args: GLib.idle_add(self.request_stop))
        signal.signal(signal.SIGTERM, lambda *_args: GLib.idle_add(self.request_stop))
        self.owner_id = Gio.bus_own_name(
            Gio.BusType.SESSION,
            BUS_NAME,
            Gio.BusNameOwnerFlags.NONE,
            self.on_bus_acquired,
            self.on_name_acquired,
            self.on_name_lost,
        )
        GLib.timeout_add(500, self.tick)
        try:
            self.loop.run()
        finally:
            self.terminate_processes()
            if self.registration_id and self.connection:
                self.connection.unregister_object(self.registration_id)
            if self.owner_id:
                Gio.bus_unown_name(self.owner_id)
            for thread in (self.encoder_log_thread, self.tee_log_thread):
                if thread is not None:
                    thread.join(timeout=1)
            self.refresh_waybar()
            self.log_handle.close()
        return 0


def main():
    args = parse_args()
    if args.command == "run":
        return LivestreamService(args).run()
    if args.command == "validate":
        platforms, _video, _audio = load_stream_config(args.config)
        return 0 if platforms else 3
    if args.command == "is-active":
        status = get_remote_status()
        return 0 if status and status.get("active") is True else 1
    if args.command == "status":
        status = get_remote_status() or offline_status()
        if args.platforms_only:
            for line in platform_status_lines(status):
                print(line)
        else:
            print(json.dumps(status, indent=2))
        return 0
    if args.command == "field":
        status = get_remote_status() or offline_status()
        print(status.get(args.name, ""))
        return 0
    if args.command == "wait-ready":
        deadline = time.monotonic() + args.timeout
        while time.monotonic() < deadline:
            status = get_remote_status()
            if status is not None:
                state = status.get("state")
                if state == "sending":
                    return 0
                if state in ("failed", "stalled", "offline"):
                    return 1
            time.sleep(0.3)
        return 1
    if args.command == "stop":
        proxy = get_proxy()
        if proxy is None:
            return 0
        try:
            proxy.Stop()
        except GLib.Error:
            return 1

        deadline = time.monotonic() + args.timeout
        while time.monotonic() < deadline:
            if get_proxy() is None:
                return 0
            time.sleep(0.1)
        return 4
    return 0


if __name__ == "__main__":
    # Preserve CLI exit codes: capture-router relies on them for active-state checks.
    raise SystemExit(main())
