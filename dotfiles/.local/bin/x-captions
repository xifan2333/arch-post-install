#!/usr/bin/env -S PYTHONDONTWRITEBYTECODE=1 python3
# arch:summary=Real-time speech-to-text live subtitle overlay using vinput and wayhud
# arch:args=[toggle | start | stop | status | run]
# arch:examples=arch overlay captions | arch overlay captions toggle
"""Real-time speech-to-text live subtitle overlay using vinput and wayhud."""

from __future__ import annotations

import array
import base64
import contextlib
import json
import os
import queue
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

SAMPLE_RATE = 16000
CHANNELS = 1
BYTES_PER_SAMPLE = 2
FRAME_MS = 100
FRAME_BYTES = SAMPLE_RATE * CHANNELS * BYTES_PER_SAMPLE * FRAME_MS // 1000

VOICE_RMS_THRESHOLD = int(os.environ.get("ARCH_CAPTIONS_RMS", "180"))
SILENCE_FRAMES_TO_FINISH = int(os.environ.get("ARCH_CAPTIONS_SILENCE_FRAMES", "6"))
MAX_UTTERANCE_SECONDS = int(os.environ.get("ARCH_CAPTIONS_MAX_UTTERANCE_SECS", "18"))
MAX_CAPTION_CHARS = int(os.environ.get("ARCH_CAPTIONS_MAX_CHARS", "60"))
PROVIDER_POLL_SECONDS = 3.0
VINPUT_STATUS_POLL_SECONDS = 0.5

VINPUT_BUS_NAME = "org.fcitx.Vinput"
VINPUT_OBJECT_PATH = "/org/fcitx/Vinput"
VINPUT_INTERFACE = "org.fcitx.Vinput.Service"

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "wayhud"
PID_FILE = RUNTIME_DIR / "captions.pid"
LOG_FILE = RUNTIME_DIR / "captions.log"

try:
    from gi.repository import Gio, GLib
except ImportError:
    Gio = None
    GLib = None


def parse_dbus_result(payload: str) -> str:
    """Parse vinput RecognitionResult payload: extract commit_text."""
    if not payload:
        return ""
    if payload.startswith("{") and payload.endswith("}"):
        with contextlib.suppress(json.JSONDecodeError, KeyError):
            data = json.loads(payload)
            if isinstance(data, dict) and "commit_text" in data:
                return str(data["commit_text"]).strip()
    return payload.strip()


def sanitize_caption(text: str) -> str:
    return str(text or "").replace("\r", "").replace("\n", "").strip()


def truncate_caption(text: str, max_chars: int) -> str:
    if max_chars <= 0 or len(text) <= max_chars:
        return text
    if max_chars == 1:
        return "…"
    return "…" + text[-(max_chars - 1) :]


def pcm16_rms(chunk: bytes) -> int:
    if not chunk:
        return 0
    samples = array.array("h")
    samples.frombytes(chunk[: len(chunk) - (len(chunk) % 2)])
    if sys.byteorder != "little":
        samples.byteswap()
    if not samples:
        return 0
    total = sum(sample * sample for sample in samples)
    return int((total / len(samples)) ** 0.5)


def get_active_vinput_provider() -> dict[str, object] | None:
    try:
        proc = subprocess.run(
            ["vinput", "-j", "config", "get", "/asr"],
            check=True,
            text=True,
            capture_output=True,
            timeout=3,
        )
        data = json.loads(proc.stdout)
        val = data.get("value")
        if isinstance(val, str):
            val = json.loads(val)
        if not isinstance(val, dict):
            return None
        active_id = val.get("active_provider")
        providers = val.get("providers") or []
        for p in providers:
            if (
                isinstance(p, dict)
                and p.get("id") == active_id
                and p.get("type") == "command"
                and p.get("command")
            ):
                return {
                    "id": p.get("id", ""),
                    "command": p.get("command"),
                    "args": p.get("args") or [],
                    "env": p.get("env") or {},
                }
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        pass
    return None


def is_vinput_recording_active() -> bool:
    if Gio is None:
        return False
    try:
        connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        proxy = Gio.DBusProxy.new_sync(
            connection,
            Gio.DBusProxyFlags.DO_NOT_AUTO_START,
            None,
            VINPUT_BUS_NAME,
            VINPUT_OBJECT_PATH,
            VINPUT_INTERFACE,
            None,
        )
        if proxy.get_name_owner() is None:
            return False
        result = proxy.call_sync("GetStatus", None, Gio.DBusCallFlags.NONE, 100, None)
        return result.unpack()[0] != "idle"
    except (GLib.Error, OSError, TypeError):
        return False


class ProviderSession:
    def __init__(
        self,
        events: queue.Queue[tuple[str, str]],
        provider: dict[str, object],
    ) -> None:
        self.events = events
        self.provider = provider
        self.proc: subprocess.Popen[str] | None = None
        self.closed = False
        self.provider_id = str(provider.get("id", ""))

    def start(self) -> None:
        env = os.environ.copy()
        raw_env = self.provider.get("env")
        if isinstance(raw_env, dict):
            for k, v in raw_env.items():
                if k:
                    env[k] = str(v)
        command = str(self.provider["command"])
        args = [str(a) for a in self.provider.get("args") or []]
        self.proc = subprocess.Popen(
            [command, *args],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
            env=env,
        )
        threading.Thread(target=self._read_stdout, daemon=True).start()

    def send_audio(self, chunk: bytes) -> None:
        if not self.proc or self.closed or not self.proc.stdin:
            return
        b64 = base64.b64encode(chunk).decode("ascii")
        event = {"type": "audio", "audio_base64": b64}
        try:
            self.proc.stdin.write(json.dumps(event, ensure_ascii=False) + "\n")
            self.proc.stdin.flush()
        except (BrokenPipeError, OSError):
            self.closed = True

    def finish(self) -> None:
        if not self.proc or self.closed or not self.proc.stdin:
            return
        try:
            self.proc.stdin.write(json.dumps({"type": "finish"}) + "\n")
            self.proc.stdin.flush()
            self.proc.stdin.close()
        except (BrokenPipeError, OSError, ValueError):
            pass
        self.closed = True

    def terminate(self) -> None:
        self.finish()
        if self.proc and self.proc.poll() is None:
            with contextlib.suppress(OSError):
                self.proc.terminate()

    def _read_stdout(self) -> None:
        if not self.proc or not self.proc.stdout:
            return
        for raw_line in self.proc.stdout:
            line = raw_line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            typ = event.get("type")
            text = str(event.get("text") or "").strip()
            if typ in ("partial", "final", "final_timestamps") and text:
                self.events.put((typ, text))


class WayhudPresenter:
    def __init__(self) -> None:
        self.proc: subprocess.Popen[str] | None = None
        self.lock = threading.Lock()

    def ensure_process(self) -> bool:
        if self.proc and self.proc.poll() is None:
            return True
        try:
            self.proc = subprocess.Popen(
                ["wayhud", "-n", "captions"],
                stdin=subprocess.PIPE,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1,
            )
            return True
        except OSError:
            return False

    def push(self, text: str) -> None:
        with self.lock:
            if not self.ensure_process() or not self.proc or not self.proc.stdin:
                return
            try:
                self.proc.stdin.write(text + "\n")
                self.proc.stdin.flush()
            except (BrokenPipeError, OSError):
                self.proc = None

    def close(self) -> None:
        with self.lock:
            if self.proc:
                with contextlib.suppress(OSError):
                    if self.proc.stdin:
                        self.proc.stdin.close()
                    if self.proc.poll() is None:
                        self.proc.terminate()
                self.proc = None


class CaptionsDaemon:
    def __init__(self) -> None:
        self.events: queue.Queue[tuple[str, str]] = queue.Queue()
        self.stop_event = threading.Event()
        self.audio_proc: subprocess.Popen[bytes] | None = None
        self.current_session: ProviderSession | None = None
        self.session_lock = threading.Lock()
        self.active_provider: dict[str, object] | None = None
        self.last_provider_poll_at = 0.0
        self.voice_input_active = False
        self.presenter = WayhudPresenter()

    def poll_active_provider(self, force: bool = False) -> dict[str, object] | None:
        now = time.monotonic()
        if (
            not force
            and self.active_provider
            and now - self.last_provider_poll_at < PROVIDER_POLL_SECONDS
        ):
            return self.active_provider
        self.last_provider_poll_at = now
        provider = get_active_vinput_provider()
        if (
            provider
            and self.active_provider
            and provider.get("id") != self.active_provider.get("id")
        ):
            self.terminate_session()
        self.active_provider = provider
        return self.active_provider

    def start_session(self) -> ProviderSession | None:
        provider = self.poll_active_provider(force=False)
        if not provider:
            return None
        session = ProviderSession(self.events, provider)
        session.start()
        with self.session_lock:
            self.current_session = session
        return session

    def ensure_session(self) -> ProviderSession | None:
        with self.session_lock:
            cur = self.current_session
        if cur and cur.proc and cur.proc.poll() is None and not cur.closed:
            return cur
        self.terminate_session()
        return self.start_session()

    def finish_session(self) -> None:
        with self.session_lock:
            if self.current_session:
                self.current_session.finish()
                self.current_session = None

    def terminate_session(self) -> None:
        with self.session_lock:
            if self.current_session:
                self.current_session.terminate()
                self.current_session = None

    def _poll_vinput_loop(self) -> None:
        while not self.stop_event.is_set():
            active = is_vinput_recording_active()
            if active != self.voice_input_active:
                self.voice_input_active = active
                if active:
                    self.terminate_session()
            self.stop_event.wait(VINPUT_STATUS_POLL_SECONDS)

    def _listen_dbus_signals(self) -> None:
        """Subscribe to Fcitx5 VInput signals so dictation also shows on HUD."""
        if Gio is None or GLib is None:
            return
        try:
            conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)

            def on_signal(
                _conn: Gio.DBusConnection,
                _sender: str,
                _path: str,
                _interface: str,
                signal_name: str,
                parameters: GLib.Variant,
            ) -> None:
                if signal_name == "RecognitionPartial":
                    text = parameters.unpack()[0] if parameters else ""
                    if text:
                        self.events.put(("partial", text.strip()))
                elif signal_name == "RecognitionResult":
                    raw = parameters.unpack()[0] if parameters else ""
                    commit = parse_dbus_result(raw)
                    if commit:
                        self.events.put(("final", commit))

            conn.signal_subscribe(
                VINPUT_BUS_NAME,
                VINPUT_INTERFACE,
                None,
                VINPUT_OBJECT_PATH,
                None,
                Gio.DBusSignalFlags.NONE,
                on_signal,
            )
            loop = GLib.MainLoop()
            while not self.stop_event.is_set():
                loop.get_context().iteration(False)
                time.sleep(0.05)
        except (GLib.Error, OSError, TypeError):
            pass

    def _run_audio_loop(self) -> None:
        device_args: list[str] = []
        source = os.environ.get("ARCH_CAPTIONS_SOURCE", "")
        if source:
            device_args = [f"--device={source}"]

        try:
            self.audio_proc = subprocess.Popen(
                [
                    "parec",
                    *device_args,
                    "--format=s16le",
                    f"--rate={SAMPLE_RATE}",
                    f"--channels={CHANNELS}",
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            return

        silence_frames = 0
        in_speech = False
        utterance_start = 0.0

        try:
            while not self.stop_event.is_set():
                if not self.audio_proc.stdout:
                    break
                chunk = self.audio_proc.stdout.read(FRAME_BYTES)
                if not chunk:
                    break

                if self.voice_input_active:
                    in_speech = False
                    silence_frames = 0
                    continue

                rms = pcm16_rms(chunk)
                is_voice = rms >= VOICE_RMS_THRESHOLD

                session = self.ensure_session()
                if session:
                    session.send_audio(chunk)

                if is_voice:
                    if not in_speech:
                        in_speech = True
                        utterance_start = time.monotonic()
                    silence_frames = 0
                elif in_speech:
                    silence_frames += 1

                too_long = (
                    in_speech
                    and (time.monotonic() - utterance_start) > MAX_UTTERANCE_SECONDS
                )
                if in_speech and (
                    silence_frames >= SILENCE_FRAMES_TO_FINISH or too_long
                ):
                    self.finish_session()
                    in_speech = False
                    silence_frames = 0
        finally:
            self.finish_session()

    def run(self) -> None:
        self.presenter.ensure_process()
        threading.Thread(target=self._run_audio_loop, daemon=True).start()
        threading.Thread(target=self._poll_vinput_loop, daemon=True).start()
        threading.Thread(target=self._listen_dbus_signals, daemon=True).start()

        while not self.stop_event.is_set():
            try:
                _typ, text = self.events.get(timeout=0.1)
                clean_text = truncate_caption(sanitize_caption(text), MAX_CAPTION_CHARS)
                if clean_text:
                    self.presenter.push(clean_text)
            except queue.Empty:
                pass

    def stop(self) -> None:
        self.stop_event.set()
        self.finish_session()
        if self.audio_proc and self.audio_proc.poll() is None:
            with contextlib.suppress(OSError):
                self.audio_proc.terminate()
        self.presenter.close()


def is_running() -> bool:
    if PID_FILE.is_file():
        with contextlib.suppress(ValueError, OSError):
            pid = int(PID_FILE.read_text(encoding="utf-8").strip())
            os.kill(pid, 0)
            return True
    return False


def cmd_start() -> int:
    if is_running():
        return 0

    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    script_path = Path(__file__).resolve()

    with open(LOG_FILE, "a", encoding="utf-8") as log:
        proc = subprocess.Popen(
            [sys.executable, str(script_path), "run"],
            stdout=log,
            stderr=log,
            start_new_session=True,
        )
    PID_FILE.write_text(str(proc.pid), encoding="utf-8")
    return 0


def cmd_stop() -> int:
    if PID_FILE.is_file():
        with contextlib.suppress(ValueError, OSError):
            pid = int(PID_FILE.read_text(encoding="utf-8").strip())
            os.kill(pid, signal.SIGTERM)
            deadline = time.monotonic() + 2.0
            while time.monotonic() < deadline:
                try:
                    os.kill(pid, 0)
                    time.sleep(0.1)
                except OSError:
                    break
        PID_FILE.unlink(missing_ok=True)

    # Clean up wayhud captions if left orphaned
    subprocess.run(
        ["pkill", "-f", "wayhud[[:space:]]+-n[[:space:]]+captions\\b"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return 0


def cmd_toggle() -> int:
    return cmd_stop() if is_running() else cmd_start()


def cmd_status() -> int:
    print("open" if is_running() else "closed")
    return 0


def cmd_run() -> int:
    daemon = CaptionsDaemon()

    def on_sig(_s: int, _f: object) -> None:
        daemon.stop()
        sys.exit(0)

    signal.signal(signal.SIGINT, on_sig)
    signal.signal(signal.SIGTERM, on_sig)

    try:
        daemon.run()
    finally:
        daemon.stop()
    return 0


def main() -> int:
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    if action == "start":
        return cmd_start()
    if action in ("stop", "close", "hide", "kill"):
        return cmd_stop()
    if action == "toggle":
        return cmd_toggle()
    if action in ("status", "state"):
        return cmd_status()
    if action == "run":
        return cmd_run()

    print(
        "Usage: x-captions [toggle | start | stop | status | run]",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
