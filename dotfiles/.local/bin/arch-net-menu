#!/usr/bin/env luajit
-- arch:summary=Interactive Wi-Fi connection menu driven by Fuzzel and iwd D-Bus
-- arch:args=[menu | toggle]
-- arch:examples=arch net menu | arch net toggle

local function exec_cmd(cmd)
  local p = io.popen(cmd, "r")
  if not p then
    return ""
  end
  local output = p:read("*a") or ""
  p:close()
  return output
end

local function i18n(key, vars)
  local args = { "arch-i18n", "get", key }
  if vars then
    for k, v in pairs(vars) do
      table.insert(args, string.format("%s=%s", k, tostring(v)))
    end
  end
  local quoted = {}
  for _, arg_val in ipairs(args) do
    table.insert(quoted, string.format("%q", arg_val))
  end
  local text = exec_cmd(table.concat(quoted, " "))
  return (text:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function notify(msg)
  local title = i18n("net_notify_title")
  os.execute(string.format("notify-send %q %q 2>/dev/null", title, msg))
end

-- 1. Dependency checks
if os.execute("command -v busctl >/dev/null 2>&1") ~= 0 then
  io.stderr:write("Error: busctl not found. Please install systemd\n")
  os.exit(1)
end

if os.execute("command -v fuzzel >/dev/null 2>&1") ~= 0 then
  io.stderr:write("Error: fuzzel not found\n")
  os.exit(1)
end

if os.execute("command -v jq >/dev/null 2>&1") ~= 0 then
  io.stderr:write("Error: jq not found\n")
  os.exit(1)
end

-- 2. Query iwd D-Bus ObjectManager for station and device
local query_station_cmd =
  [[busctl call net.connman.iwd / org.freedesktop.DBus.ObjectManager GetManagedObjects --json=short 2>/dev/null | jq -r '
.data[0] | to_entries[] |
select(.value["net.connman.iwd.Station"]) |
[
  .key,
  (.value["net.connman.iwd.Device"].Name.data // ""),
  (.value["net.connman.iwd.Station"].State.data // ""),
  (.value["net.connman.iwd.Station"].ConnectedNetwork.data // "")
] | @tsv
' | head -n 1]]

local station_line = exec_cmd(query_station_cmd)
local station_path, dev_name, station_state, connected_network_path =
  station_line:match("^(.-)\t(.-)\t(.-)\t(.*)$")

if not station_path or station_path == "" then
  notify(i18n("net_no_device"))
  os.exit(1)
end

-- Handle CLI toggle action (quick connect / disconnect)
local action = arg[1]
if action == "toggle" then
  if connected_network_path and connected_network_path ~= "" then
    os.execute(
      string.format(
        "busctl call net.connman.iwd %s net.connman.iwd.Station Disconnect >/dev/null 2>&1",
        station_path
      )
    )
    notify(i18n("net_disconnected", { ssid = dev_name }))
  else
    local quick_connect_cmd = string.format(
      [[busctl call net.connman.iwd %s net.connman.iwd.Station GetOrderedNetworks --json=short 2>/dev/null | jq -r '.data[0][][0] // empty' | head -n 1]],
      station_path
    )
    local best_net_path = exec_cmd(quick_connect_cmd)
    if best_net_path ~= "" then
      os.execute(
        string.format(
          "busctl call net.connman.iwd %s net.connman.iwd.Network Connect >/dev/null 2>&1",
          best_net_path
        )
      )
      notify(i18n("net_connected", { ssid = dev_name }))
    else
      os.execute(arg[0] .. " &")
    end
  end
  os.exit(0)
end

-- 3. Query all networks from D-Bus
local query_networks_cmd =
  [[busctl call net.connman.iwd / org.freedesktop.DBus.ObjectManager GetManagedObjects --json=short 2>/dev/null | jq -r '
.data[0] | to_entries[] |
select(.value["net.connman.iwd.Network"]) |
.key as $path |
.value["net.connman.iwd.Network"] |
[
  $path,
  .Name.data,
  .Type.data,
  (if .Connected.data then "1" else "0" end),
  (.KnownNetwork.data // "")
] | @tsv
']]

local networks_by_path = {}
for line in exec_cmd(query_networks_cmd):gmatch("[^\r\n]+") do
  local path, name, net_type, conn_s, known_path = line:match("^(.-)\t(.-)\t(.-)\t(.-)\t(.*)$")
  if path and name and name ~= "" then
    networks_by_path[path] = {
      path = path,
      name = name,
      type = net_type,
      connected = (conn_s == "1"),
      known_network = (known_path ~= "" and known_path) or nil,
    }
  end
end

-- 4. Query ordered networks with signal metrics (100*dBm)
local query_ordered_cmd = string.format(
  [[busctl call net.connman.iwd %s net.connman.iwd.Station GetOrderedNetworks --json=short 2>/dev/null | jq -r '.data[0][] | [(.[0] // ""), (.[1] // 0)] | @tsv']],
  station_path
)

local ordered_networks = {}
local seen_names = {}

for line in exec_cmd(query_ordered_cmd):gmatch("[^\r\n]+") do
  local path, sig_str = line:match("^(.-)\t(.-)$")
  local net = networks_by_path[path]
  if net and not seen_names[net.name] then
    net.signal = tonumber(sig_str) or -10000
    table.insert(ordered_networks, net)
    seen_names[net.name] = true
  end
end

-- 5. Format NerdFont glyphs
local function get_signal_icon(sig)
  if sig >= -5000 then
    return "󰤨"
  elseif sig >= -6500 then
    return "󰤥"
  elseif sig >= -7500 then
    return "󰤢"
  elseif sig >= -8500 then
    return "󰤟"
  else
    return "󰤯"
  end
end

local function get_lock_icon(net_type)
  if net_type == "open" then
    return "󰌿"
  else
    return "󰌾"
  end
end

-- 6. Build action header
local menu_lines = {}
local connected_ssid = nil

for _, net in ipairs(ordered_networks) do
  if net.connected then
    connected_ssid = net.name
    break
  end
end

if connected_ssid then
  table.insert(
    menu_lines,
    string.format("  󰖪  %s", i18n("net_disconnect", { ssid = connected_ssid }))
  )
end
table.insert(menu_lines, string.format("  󰑐  %s", i18n("net_rescan")))

-- 7. Build network list entries
for _, net in ipairs(ordered_networks) do
  local star = net.connected and "* " or "  "
  local sig_icon = get_signal_icon(net.signal or -7000)
  local lock_icon = get_lock_icon(net.type)
  table.insert(menu_lines, string.format("%s%s   %s   %s", star, sig_icon, lock_icon, net.name))
end

-- 8. Display Fuzzel dmenu
local prompt_text = i18n("net_prompt", { dev = dev_name })
local tmp = os.tmpname()
local f = io.open(tmp, "w")
if f then
  f:write(table.concat(menu_lines, "\n") .. "\n")
  f:close()
end

local p = io.popen(
  string.format("fuzzel --dmenu --prompt %q --lines 15 < %q 2>/dev/null", prompt_text, tmp),
  "r"
)
local chosen = p and p:read("*l") or ""
if p then
  p:close()
end
os.remove(tmp)

if not chosen or chosen == "" then
  os.exit(0)
end

local action_chosen = chosen:gsub("^%s+", ""):gsub("%s+$", "")

-- 9. Handle action header items
if action_chosen:find("^󰑐") then
  os.execute(
    string.format(
      "busctl call net.connman.iwd %s net.connman.iwd.Station Scan >/dev/null 2>&1",
      station_path
    )
  )
  os.execute("sleep 1.2")
  os.execute(arg[0] .. " &")
  os.exit(0)
end

if action_chosen:find("^󰖪") then
  os.execute(
    string.format(
      "busctl call net.connman.iwd %s net.connman.iwd.Station Disconnect >/dev/null 2>&1",
      station_path
    )
  )
  notify(i18n("net_disconnected", { ssid = connected_ssid or "" }))
  os.exit(0)
end

-- 10. Extract target SSID
local target_ssid = chosen:match("^[ *]+%S+%s+%S+%s+(.*)$")
if not target_ssid or target_ssid == "" then
  os.exit(0)
end
target_ssid = target_ssid:gsub("^%s+", ""):gsub("%s+$", "")

local target_net = nil
for _, net in ipairs(ordered_networks) do
  if net.name == target_ssid then
    target_net = net
    break
  end
end

if not target_net then
  os.exit(0)
end

-- If already connected: disconnect
if target_net.connected then
  os.execute(
    string.format(
      "busctl call net.connman.iwd %s net.connman.iwd.Station Disconnect >/dev/null 2>&1",
      station_path
    )
  )
  notify(i18n("net_disconnected", { ssid = target_net.name }))
  os.exit(0)
end

-- Function to connect with a passphrase via iwctl
local function connect_with_passphrase(prompt_str)
  local pass_p = io.popen(
    string.format("fuzzel --dmenu --password --prompt %q --lines 0 2>/dev/null", prompt_str),
    "r"
  )
  local pass = pass_p and pass_p:read("*l") or ""
  if pass_p then
    pass_p:close()
  end
  if not pass or pass == "" then
    os.exit(0)
  end

  local cmd = string.format(
    "iwctl --passphrase %q station %s connect %q >/dev/null 2>&1",
    pass,
    dev_name,
    target_net.name
  )
  if os.execute(cmd) == 0 then
    notify(i18n("net_connected", { ssid = target_net.name }))
  else
    notify(i18n("net_auth_failed", { ssid = target_net.name }))
  end
  os.exit(0)
end

-- If known network (already saved credentials): connect directly via D-Bus
if target_net.known_network then
  os.execute(
    string.format(
      "busctl call net.connman.iwd %s net.connman.iwd.Network Connect >/dev/null 2>&1",
      target_net.path
    )
  )

  -- Check if connection succeeded
  local state = exec_cmd(
    string.format(
      "busctl get-property net.connman.iwd %s net.connman.iwd.Station State 2>/dev/null",
      station_path
    )
  )
  if state:find("connected") then
    notify(i18n("net_connected", { ssid = target_net.name }))
    os.exit(0)
  end

  -- Auto-recovery: if connection failed (password changed on router)
  -- Purge stale known network via D-Bus and prompt for the new password!
  os.execute(
    string.format(
      "busctl call net.connman.iwd %s net.connman.iwd.KnownNetwork Forget >/dev/null 2>&1",
      target_net.known_network
    )
  )
  connect_with_passphrase(i18n("net_password_changed_prompt"))
  os.exit(0)
end

-- If open network (no password required): connect directly via D-Bus
if target_net.type == "open" then
  os.execute(
    string.format(
      "busctl call net.connman.iwd %s net.connman.iwd.Network Connect >/dev/null 2>&1",
      target_net.path
    )
  )
  local state = exec_cmd(
    string.format(
      "busctl get-property net.connman.iwd %s net.connman.iwd.Station State 2>/dev/null",
      station_path
    )
  )
  if state:find("connected") then
    notify(i18n("net_connected", { ssid = target_net.name }))
  else
    notify(i18n("net_failed", { ssid = target_net.name }))
  end
  os.exit(0)
end

-- Unconfigured secure network: prompt for passphrase
connect_with_passphrase(i18n("net_password_prompt", { ssid = target_net.name }))
