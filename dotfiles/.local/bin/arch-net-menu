#!/usr/bin/env bash
# arch:summary=Interactive Wi-Fi connection menu driven by Fuzzel
set -euo pipefail

# Ensure NetworkManager and fuzzel are present
if ! command -v nmcli >/dev/null 2>&1; then
	printf 'Error: nmcli not found\n' >&2
	exit 1
fi

if ! command -v fuzzel >/dev/null 2>&1; then
	printf 'Error: fuzzel not found\n' >&2
	exit 1
fi

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$@"
	fi
}

# 1. Fetch current Wi-Fi status
wifi_state=$(nmcli -t -f WIFI g 2>/dev/null || echo "unknown")
current_ssid=$(nmcli -t -f IN-USE,SSID dev wifi list 2>/dev/null | awk -F: '$1 == "*" { print $2; exit }' || true)

# 2. Build action header
actions=()
if [[ "$wifi_state" == "enabled" ]]; then
	if [[ -n "$current_ssid" ]]; then
		actions+=("󰖪  Disconnect: $current_ssid")
	fi
	actions+=("󰑐  Rescan Wi-Fi Networks")
	actions+=("󰖩  Wi-Fi Power: Disable")
else
	actions+=("󰖩  Wi-Fi Power: Enable")
fi
actions+=("󰍹  Launch Terminal NMTUI")

# 3. Scan nearby networks if Wi-Fi is enabled
network_lines=()
if [[ "$wifi_state" == "enabled" ]]; then
	while IFS=':' read -r in_use signal security ssid; do
		[[ -z "$ssid" ]] && continue
		# Clean formatting
		local_star=" "
		[[ "$in_use" == "*" ]] && local_star="●"
		lock_icon="  "
		[[ -n "$security" && "$security" != "--" ]] && lock_icon="󰌾"

		network_lines+=("$(printf '%s %s %-24s [%3s%%]' "$local_star" "$lock_icon" "$ssid" "$signal")")
	done < <(nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list --rescan no 2>/dev/null | awk '!seen[$4]++' || true)
fi

# 4. Display combined menu in fuzzel
menu_input=$(
	for a in "${actions[@]}"; do
		printf '%s\n' "$a"
	done
	for n in "${network_lines[@]}"; do
		printf '%s\n' "$n"
	done
)

chosen=$(printf '%s' "$menu_input" | fuzzel --dmenu --prompt "Wi-Fi > " --lines 15 --width 45 || true)
[[ -z "$chosen" ]] && exit 0

# 5. Handle selected action
case "$chosen" in
*"Disconnect:"*)
	nmcli dev disconnect iface "$(nmcli -t -f DEVICE,TYPE dev | awk -F: '$2=="wifi"{print $1; exit}')" 2>/dev/null || true
	notify "Wi-Fi" "Disconnected from $current_ssid"
	exit 0
	;;
*"Rescan"*)
	nmcli dev wifi rescan 2>/dev/null || true
	notify "Wi-Fi" "Rescanned networks"
	exec "$0"
	;;
*"Wi-Fi Power: Disable"*)
	nmcli radio wifi off
	notify "Wi-Fi" "Wi-Fi disabled"
	exit 0
	;;
*"Wi-Fi Power: Enable"*)
	nmcli radio wifi on
	notify "Wi-Fi" "Wi-Fi enabled"
	exit 0
	;;
*"Terminal NMTUI"*)
	if command -v ftty >/dev/null 2>&1; then
		exec ftty -e nmtui
	else
		exec xdg-terminal-exec nmtui
	fi
	;;
esac

# 6. Extract target SSID from formatted line
# Format: "● 󰌾 SSID_NAME               [100%]"
target_ssid=$(printf '%s' "$chosen" | sed -E 's/^[● ] (󰌾|  ) //; s/ +\[[0-9]+%\]$//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
[[ -z "$target_ssid" ]] && exit 0

# 7. Check if network is already known / saved
known_conns=$(nmcli -t -f NAME connection show 2>/dev/null || true)
is_known=false
if grep -Fxq "$target_ssid" <<<"$known_conns"; then
	is_known=true
fi

if $is_known; then
	notify "Wi-Fi" "Connecting to $target_ssid..."
	if nmcli connection up id "$target_ssid" >/dev/null 2>&1; then
		notify "Wi-Fi" "Connected to $target_ssid"
	else
		notify -u critical "Wi-Fi Error" "Failed to connect to $target_ssid"
	fi
	exit 0
fi

# Check security type
is_secure=false
if [[ "$chosen" == *"󰌾"* ]]; then
	is_secure=true
fi

if $is_secure; then
	password=$(fuzzel --dmenu --password --prompt "Password for $target_ssid > " --lines 0 --width 35 || true)
	[[ -z "$password" ]] && exit 0

	notify "Wi-Fi" "Connecting to $target_ssid..."
	if nmcli dev wifi connect "$target_ssid" password "$password" >/dev/null 2>&1; then
		notify "Wi-Fi" "Connected to $target_ssid"
	else
		notify -u critical "Wi-Fi Error" "Authentication failed for $target_ssid"
	fi
else
	notify "Wi-Fi" "Connecting to $target_ssid..."
	if nmcli dev wifi connect "$target_ssid" >/dev/null 2>&1; then
		notify "Wi-Fi" "Connected to $target_ssid"
	else
		notify -u critical "Wi-Fi Error" "Failed to connect to $target_ssid"
	fi
fi
