#!/usr/bin/env bash
# arch:summary=Manage or display stream title HUD overlay via wayhud
# arch:args=[get | set <text> | edit | clear | toggle | start | stop | status]
# arch:examples=x-title get | x-title set "Live Streaming" | x-title edit | x-title clear
set -euo pipefail

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/wayhud"
TITLE_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wayhud"
TITLE_HISTORY_FILE="$TITLE_STATE_DIR/title_history.txt"
TITLE_PID_FILE="$RUNTIME_DIR/title.pid"

is_title_running() {
	if [[ -f "$TITLE_PID_FILE" ]]; then
		local pid
		pid="$(cat "$TITLE_PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
	fi
	pgrep -f "wayhud[[:space:]]+-n[[:space:]]+title\b" >/dev/null 2>&1
}

stop_title() {
	if [[ -f "$TITLE_PID_FILE" ]]; then
		local pid
		pid="$(cat "$TITLE_PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			kill -TERM "$pid" 2>/dev/null || true
		fi
		rm -f "$TITLE_PID_FILE"
	fi
	pkill -f "wayhud[[:space:]]+-n[[:space:]]+title\b" 2>/dev/null || true
}

start_title() {
	local text="$1"
	[[ -n "$text" ]] || return 0
	if ! command -v wayhud >/dev/null 2>&1; then
		return 0
	fi
	stop_title
	mkdir -p "$RUNTIME_DIR"
	printf '%s\n' "$text" | nohup wayhud -n title >/dev/null 2>&1 &
	local pid=$!
	printf '%s\n' "$pid" >"$TITLE_PID_FILE"
}

get_title() {
	if [[ -f "$TITLE_HISTORY_FILE" ]]; then
		head -n 1 "$TITLE_HISTORY_FILE" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
	fi
}

set_title() {
	local new_title="$1"
	if [[ -z "$new_title" ]]; then
		stop_title
		return 0
	fi
	mkdir -p "$TITLE_STATE_DIR"
	local tmp_file="$TITLE_STATE_DIR/title_history.tmp.$$"
	{
		printf '%s\n' "$new_title"
		if [[ -f "$TITLE_HISTORY_FILE" ]]; then
			grep -v -F -x "$new_title" "$TITLE_HISTORY_FILE" 2>/dev/null || true
		fi
	} | head -n 30 >"$tmp_file"
	mv -f "$tmp_file" "$TITLE_HISTORY_FILE"
	start_title "$new_title"
}

clear_title() {
	set_title ""
}

edit_title() {
	local candidates=""
	if [[ -f "$TITLE_HISTORY_FILE" ]]; then
		candidates="$(grep -v '^[[:space:]]*$' "$TITLE_HISTORY_FILE" 2>/dev/null || true)"
	fi

	local prompt_text
	prompt_text="$(x-i18n get overlay_title_prompt 2>/dev/null || echo "Stream Title: ")"

	local chosen=""
	if command -v fuzzel >/dev/null 2>&1; then
		chosen="$(printf '%s\n' "$candidates" | fuzzel --dmenu --prompt "$prompt_text" || true)"
	elif command -v bemenu >/dev/null 2>&1; then
		chosen="$(printf '%s\n' "$candidates" | bemenu -p "$prompt_text" || true)"
	fi
	[[ -n "$chosen" ]] || return 0

	set_title "$chosen"
}

toggle_title() {
	if is_title_running; then
		stop_title
	else
		local current
		current="$(get_title)"
		if [[ -n "$current" ]]; then
			start_title "$current"
		else
			edit_title
		fi
	fi
}

main() {
	local act="${1:-edit}"
	case "$act" in
	get) get_title ;;
	set)
		shift
		set_title "$*"
		;;
	clear) clear_title ;;
	edit) edit_title ;;
	toggle) toggle_title ;;
	start)
		local current
		current="$(get_title)"
		if [[ -n "$current" ]]; then
			start_title "$current"
		else
			edit_title
		fi
		;;
	stop) stop_title ;;
	status)
		if is_title_running; then
			printf 'open\n'
		else
			printf 'closed\n'
		fi
		;;
	-h | --help | help)
		printf 'Usage: x-title [get | set <text> | edit | clear | toggle | start | stop | status]\n'
		;;
	*)
		toggle_title
		;;
	esac
}

main "$@"
