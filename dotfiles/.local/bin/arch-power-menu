#!/usr/bin/env bash
# arch:summary=Interactive session power management menu driven by fuzzel
# arch:examples=arch power menu
set -euo pipefail

tr_msg() {
	local key="$1"
	shift
	if command -v arch-i18n >/dev/null 2>&1; then
		arch-i18n get "$key" "$@"
	else
		printf '%s' "$key"
	fi
}

dmenu_exec() {
	local prompt="$1"
	if command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu --prompt "$prompt"
	elif command -v bemenu >/dev/null 2>&1; then
		bemenu -p "$prompt"
	else
		head -n 1
	fi
}

opt_lock="$(tr_msg power_lock)"
opt_suspend="$(tr_msg power_suspend)"
opt_logout="$(tr_msg power_logout)"
opt_reboot="$(tr_msg power_reboot)"
opt_shutdown="$(tr_msg power_shutdown)"

menu_items=(
	"$opt_lock"
	"$opt_suspend"
	"$opt_logout"
	"$opt_reboot"
	"$opt_shutdown"
)

choice=$(printf '%s\n' "${menu_items[@]}" | dmenu_exec "$(tr_msg power_menu_prompt)")
[[ -n "${choice:-}" ]] || exit 0

case "$choice" in
"$opt_lock")
	if command -v hyprlock >/dev/null 2>&1; then
		hyprlock
	fi
	;;
"$opt_suspend")
	systemctl suspend
	;;
"$opt_logout")
	if command -v xrwm >/dev/null 2>&1; then
		xrwm exit
	elif command -v riverctl >/dev/null 2>&1; then
		riverctl exit
	fi
	;;
"$opt_reboot")
	systemctl reboot
	;;
"$opt_shutdown")
	systemctl poweroff
	;;
esac
