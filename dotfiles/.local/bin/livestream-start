#!/bin/bash
# Start full-screen Live stream push (wf-recorder + ffmpeg RTMP)

set -e
source livestream-core
source i18n-core

livestream_load_config
livestream_check_deps

if livestream_is_active; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_already_active)"
    fi
    exit 1
fi

if livestream_local_recording_active; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_recording_active)"
    fi
    exit 1
fi

if ! livestream_require_platforms >/dev/null; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_missing_rtmp)"
    fi
    exit 1
fi

set +e
livestream_start "${1:-portal}"
rc=$?
set -e

case "$rc" in
    0)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_started_full)"
        fi
        ;;
    2)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_already_active)"
        fi
        exit 1
        ;;
    3)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_missing_rtmp)"
        fi
        exit 1
        ;;
    5)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_recording_active)"
        fi
        exit 1
        ;;
    *)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_start_failed)"
        fi
        exit 1
        ;;
esac
