#!/usr/bin/env bash
#
# @name         custom-record
# @summary      Manage and control screen video recording via gpu-screen-recorder
# @version      1.0.0
# @deps         gpu-screen-recorder, slurp, fuzzel
#
# @description  Hardware-accelerated screen video recording controller and CLI.
#               Supports fullscreen and region recording, Waybar status formatting, and Fuzzel launcher.
#
# @usage        custom-record [options] [command] [subcommand]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   status [text|waybar]  Print current recording state or JSON payload for status bars (default)
#   full                  Start fullscreen recording session
#   area                  Select screen region and start recording
#   stop                  Stop active recording session and save file
#   toggle                Toggle recording state (start full or stop)
#   menu                  Open interactive recording launcher via Fuzzel
#
# @stdout       Status string, Waybar JSON, or completed video file path
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-record
#   custom-record toggle
#   custom-record status waybar
#   custom-record stop

set -euo pipefail

DOMAIN="record"

REC_VIDEOS_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}/screenrecords"
mkdir -p "$REC_VIDEOS_DIR"

show_help() {
	cat <<'EOF'
Usage: custom-record [options] [command] [arguments...]

Options:
  -h, --help            Show this help message and exit

Commands:
  status [text|waybar]  Print current recording status (default: text)
  full                  Start fullscreen recording session
  area                  Select rectangular region and start recording
  stop                  Stop active recording session
  toggle                Toggle recording state (start full or stop)
  menu                  Open interactive recording launcher via Fuzzel

Examples:
  custom-record
  custom-record toggle
  custom-record status waybar
  custom-record stop
EOF
}

notify_rec() {
	local title body
	title="$(custom-i18n get "domain_${DOMAIN}" 2>/dev/null || echo "Screen Recording")"
	body="$1"
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -u "${2:-normal}" -a "custom-${DOMAIN}" -h "string:x-canonical-private-synchronous:${DOMAIN}" "$title" "$body"
	fi
}

notify_waybar() {
	pkill -RTMIN+8 waybar 2>/dev/null || true
}

is_recording() {
	pgrep -x gpu-screen-recorder >/dev/null 2>&1
}

rec_stop() {
	if is_recording; then
		pkill -SIGINT -x gpu-screen-recorder 2>/dev/null || true
		local timeout=50
		while is_recording && ((timeout > 0)); do
			sleep 0.1
			timeout=$((timeout - 1))
		done
		notify_rec "$(custom-i18n get screenrecord_notify_stopped 2>/dev/null || echo "Recording stopped")"
		notify_waybar
	fi
}

rec_start_full() {
	rec_stop >/dev/null 2>&1 || true
	local filename filepath
	filename="screenrecord-$(date +%Y%m%d_%H%M%S).mp4"
	filepath="$REC_VIDEOS_DIR/$filename"

	gpu-screen-recorder -w screen -f 60 -a default_output -c mp4 -o "$filepath" >/dev/null 2>&1 &
	notify_rec "$(custom-i18n get screenrecord_notify_started_full 2>/dev/null || echo "Started full recording")"
	notify_waybar
	printf '%s\n' "$filepath"
}

rec_start_area() {
	rec_stop >/dev/null 2>&1 || true
	local geometry filename filepath
	geometry="$(slurp 2>/dev/null || true)"
	[[ -n "$geometry" ]] || exit 0

	filename="screenrecord-$(date +%Y%m%d_%H%M%S).mp4"
	filepath="$REC_VIDEOS_DIR/$filename"

	gpu-screen-recorder -w "$geometry" -f 60 -a default_output -c mp4 -o "$filepath" >/dev/null 2>&1 &
	notify_rec "$(custom-i18n get screenrecord_notify_started_area 2>/dev/null || echo "Started area recording")"
	notify_waybar
	printf '%s\n' "$filepath"
}

rec_toggle() {
	if is_recording; then
		rec_stop
	else
		rec_start_full
	fi
}

rec_status() {
	local mode="${1:-text}"
	if is_recording; then
		local pid dur
		pid="$(pgrep -x gpu-screen-recorder 2>/dev/null | head -n 1 || echo 0)"
		dur=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d '[:space:]' || echo "0")
		local mins=$((dur / 60)) secs=$((dur % 60))
		local dur_fmt
		dur_fmt=$(printf "%02d:%02d" "$mins" "$secs")
		if [[ "$mode" == "waybar" || "$mode" == "--waybar" ]]; then
			printf '{"text":"%s","alt":"recording","class":"recording","tooltip":"Screen Recording: %s"}\n' "$dur_fmt" "$dur_fmt"
		else
			printf 'recording (%s)\n' "$dur_fmt"
		fi
	else
		if [[ "$mode" == "waybar" || "$mode" == "--waybar" ]]; then
			printf '{"text":"","alt":"idle","class":"idle","tooltip":"Recording Idle"}\n'
		else
			printf 'idle\n'
		fi
	fi
}

dmenu_exec() {
	local prompt="$1"
	if command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu --prompt "$prompt"
	elif command -v bemenu >/dev/null 2>&1; then
		bemenu -p "$prompt"
	else
		head -n 1
	fi
}

rec_menu() {
	local opt_full opt_area opt_stop
	opt_full="$(custom-i18n get rec_menu_full 2>/dev/null || echo "Record Fullscreen")"
	opt_area="$(custom-i18n get rec_menu_area 2>/dev/null || echo "Record Area")"
	opt_stop="$(custom-i18n get rec_menu_stop 2>/dev/null || echo "Stop Recording")"

	local menu_items=()
	if is_recording; then
		menu_items+=("$opt_stop")
	else
		menu_items+=("$opt_full" "$opt_area")
	fi

	local choice
	choice=$(printf '%s\n' "${menu_items[@]}" | dmenu_exec "$(custom-i18n get rec_menu_prompt 2>/dev/null || echo "Recording: ")")
	[[ -n "${choice:-}" ]] || exit 0

	case "$choice" in
	"$opt_full") rec_start_full ;;
	"$opt_area") rec_start_area ;;
	"$opt_stop") rec_stop ;;
	esac
}

main() {
	local act="${1:-status}"
	case "$act" in
	-h | --help)
		show_help
		exit 0
		;;
	full) rec_start_full ;;
	area) rec_start_area ;;
	stop) rec_stop ;;
	toggle) rec_toggle ;;
	status)
		shift
		rec_status "${1:-text}"
		;;
	menu) rec_menu ;;
	*)
		printf 'Error: Unknown command "%s" (run custom-record --help for usage)\n' "$act" >&2
		exit 2
		;;
	esac
}

main "$@"
