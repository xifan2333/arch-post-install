#!/usr/bin/env bash
#
# @name         custom-stream-title
# @summary      Manage or display stream title HUD overlay via wayhud
# @version      1.0.0
# @deps         custom-session, wayhud, fuzzel
#
# @description  On-screen stream title banner HUD overlay controller.
#               Manages display text, recent title history, and process lifecycle without PID files.
#
# @usage        custom-stream-title [options] [command] [arguments...]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   get         Print active stream title from history
#   set <text>  Set stream title and display overlay
#   edit        Open interactive title picker / editor via Fuzzel (default)
#   clear       Clear title and hide overlay
#   toggle      Toggle title overlay banner on or off
#   start       Start displaying current title banner
#   stop        Hide title banner
#   status      Print current overlay state (open | closed)
#
# @stdout       Title text or status string
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-stream-title get
#   custom-stream-title set "Live Coding Session"
#   custom-stream-title edit
#   custom-stream-title toggle

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	if ((BASH_SUBSHELL == 0)); then
		custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	fi
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel uses 1 both for Esc and startup failure; errors distinguish the two.
pick() (
	local selection rc errors
	errors=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-picker.XXXXXX")
	trap 'rm -f -- "$errors"' EXIT
	if selection=$(fuzzel --dmenu --log-level=error "$@" 2>"$errors"); then
		cat "$errors" >&2
		printf '%s' "$selection"
	else
		rc=$?
		cat "$errors" >&2
		if ((rc == 1)) && [[ ! -s "$errors" ]]; then return 0; fi
		if ((rc == 127 || rc == 130)); then exit "$rc"; fi
		die 1 cli_picker_failed
	fi
)

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/custom-stream-title"
history_file="$state_dir/history.txt"
history_limit=30
startup_delay=0.1
unit=custom-stream-title.service

running() {
	local state
	require custom-session
	state=$(custom-session state "$unit") || die 1 cli_unavailable "name=$unit"
	case "$state" in active | activating) return 0 ;; inactive | failed) return 1 ;; *) die 1 cli_unavailable "name=$unit:$state" ;; esac
}
stop_title() {
	require custom-session
	custom-session stop "$unit"
}
get_title() {
	if [[ -e "$history_file" ]]; then head -n 1 -- "$history_file"; fi
}
start_title() {
	local text="$1" data
	[[ -n "$text" ]] || die 1 title_empty
	require wayhud custom-session base64
	data=$(printf '%s\n' "$text" | base64 -w 0)
	stop_title
	custom-session start "$unit" -p StandardInput=data -p "StandardInputData=$data" -- wayhud -n title
	sleep "$startup_delay"
	running || die 1 cli_unavailable "name=$unit"
}
set_title() (
	local title="$1" tmp line
	local -a history=("$title")
	[[ -n "$title" && "$title" != *$'\n'* && "$title" != *$'\r'* ]] || usage_error
	require wayhud flock
	mkdir -p -- "$state_dir"
	# Lock the directory, leaving no second state file behind.
	exec {lock}<"$state_dir"
	flock "$lock"
	if [[ -e "$history_file" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			[[ -n "$line" && "$line" != "$title" ]] || continue
			if ((${#history[@]} < history_limit)); then history+=("$line"); fi
		done <"$history_file"
	fi
	tmp=$(mktemp "$state_dir/.history.XXXXXX")
	trap 'rm -f -- "$tmp"' EXIT
	printf '%s\n' "${history[@]}" >"$tmp"
	mv -f -- "$tmp" "$history_file"
	flock -u "$lock"
	start_title "$title"
)
edit_title() {
	local candidates='' chosen prompt
	require fuzzel
	if [[ -e "$history_file" ]]; then candidates=$(cat -- "$history_file"); fi
	prompt=$(t overlay_title_prompt)
	chosen=$(pick --prompt "$prompt" <<<"$candidates")
	[[ -n "$chosen" ]] || return 0
	set_title "$chosen"
}
main() {
	local action="${1:-edit}" title
	if (($#)); then shift; fi
	case "$action" in
	set)
		(($# == 1)) || usage_error
		[[ -n "$1" && "$1" != *$'\n'* && "$1" != *$'\r'* ]] || usage_error
		;;
	get | edit | clear | toggle | start | stop | status | -h | --help) (($# == 0)) || usage_error ;;
	*) usage_error ;;
	esac
	case "$action" in
	-h | --help) t help_stream_title ;;
	get) get_title ;;
	set) set_title "$1" ;;
	clear | stop) stop_title ;;
	edit) edit_title ;;
	start)
		title=$(get_title)
		start_title "$title"
		;;
	toggle)
		if running; then
			stop_title
		else
			title=$(get_title)
			start_title "$title"
		fi
		;;
	status) if running; then printf 'open\n'; else printf 'closed\n'; fi ;;
	esac
}
main "$@"
