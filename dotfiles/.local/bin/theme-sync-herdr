#!/bin/bash
# Sync herdr [theme.custom] colors from the current Omarchy theme.
# Maps ~/.local/state/omarchy/current/theme/colors.toml tokens to herdr's
# semantic slots and replaces the marked block in herdr config.toml.
#
# Usage: theme-sync-herdr
# Env:   COLORS  - override colors.toml path
#        CONFIG  - override herdr config.toml path

set -e

COLORS="${COLORS:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml}"
CONFIG="${CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml}"
BEGIN_MARK="# --- BEGIN herdr theme ---"
END_MARK="# --- END herdr theme ---"

if [[ ! -f $COLORS ]]; then
    echo "No Omarchy colors.toml at $COLORS" >&2
    exit 1
fi

if [[ ! -f $CONFIG ]]; then
    echo "No herdr config at $CONFIG" >&2
    exit 1
fi

get_color() {
    local token="$1" value

    if [[ $token =~ ^#[0-9A-Fa-f]{6}$ ]]; then
        printf '%s' "$token"
        return
    fi

    if command -v omarchy-theme-color > /dev/null 2>&1; then
        value=$(omarchy-theme-color --file "$COLORS" "$token" 2> /dev/null || true)
    fi
    if [[ -z ${value:-} ]]; then
        value=$(grep -E "^${token}[[:space:]]*=" "$COLORS" | head -1 | cut -d'"' -f2)
    fi
    printf '%s' "${value:-}"
}

# Blend two hex colors: blend <base> <overlay> <overlay_ratio 0-100>
# Surface/subtext tokens are derived this way because color7/color8 semantics
# are inconsistent across Omarchy themes (e.g. flexoki-light puts pure black
# in color8), while a background→foreground ramp adapts to light and dark alike.
blend() {
    local base="${1#\#}" over="${2#\#}" ratio="$3"
    local br=$((16#${base:0:2})) bg=$((16#${base:2:2})) bb=$((16#${base:4:2}))
    local or=$((16#${over:0:2})) og=$((16#${over:2:2})) ob=$((16#${over:4:2}))
    printf "#%02x%02x%02x" \
        $((br + (or - br) * ratio / 100)) \
        $((bg + (og - bg) * ratio / 100)) \
        $((bb + (ob - bb) * ratio / 100))
}

# Fallback chain: pick first non-empty value
pick() {
    local v
    for token in "$@"; do
        v=$(get_color "$token")
        [[ -n $v ]] && {
            echo "$v"
            return
        }
    done
}

accent=$(pick accent color4)
background=$(pick background color0)
foreground=$(pick foreground color7)
selection_bg_src=$(pick selection selection_background "$accent")
color1=$(pick color1 red)
color2=$(pick color2 green)
color3=$(pick color3 yellow)
color4=$(pick color4 blue)
color5=$(pick color5 magenta)
color6=$(pick color6 cyan)
color11=$(pick color11 "$color3")

active_row_bg=$(blend "$background" "$foreground" 12)
selection_bg=$(blend "$background" "$selection_bg_src" 40)
surface0=$(blend "$background" "$foreground" 18)
surface1=$(blend "$background" "$foreground" 28)
surface_dim=$(blend "$background" "$foreground" 8)
overlay0=$(blend "$background" "$foreground" 40)
overlay1=$(blend "$background" "$foreground" 55)
subtext0=$(blend "$background" "$foreground" 70)

BLOCK=$(
    cat << EOF
[theme.custom]
# Auto-generated by theme-sync-herdr from the active Omarchy theme — do not edit manually
accent = "$accent"
panel_bg = "$background"
sidebar_bg = "$background"
active_row_bg = "$active_row_bg"
selection_bg = "$selection_bg"
surface0 = "$surface0"
surface1 = "$surface1"
surface_dim = "$surface_dim"
overlay0 = "$overlay0"
overlay1 = "$overlay1"
text = "$foreground"
subtext0 = "$subtext0"
mauve = "$color5"
green = "$color2"
yellow = "$color3"
red = "$color1"
blue = "$color4"
teal = "$color6"
peach = "$color11"
EOF
)

if ! grep -qF "$BEGIN_MARK" "$CONFIG" || ! grep -qF "$END_MARK" "$CONFIG"; then
    echo "herdr theme markers not found in $CONFIG" >&2
    exit 1
fi

TMP=$(mktemp)
awk -v begin="$BEGIN_MARK" -v end="$END_MARK" -v block="$BLOCK" '
    $0 == begin { print; print block; skip = 1; next }
    $0 == end   { skip = 0; print; next }
    !skip       { print }
' "$CONFIG" > "$TMP"

# Write through a possible stow symlink (cat > preserves the link)
cat "$TMP" > "$CONFIG"
rm -f "$TMP"

theme_name="$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme.name" 2> /dev/null || basename "$(readlink -f "$COLORS")")"

if pgrep -x herdr > /dev/null 2>&1 && herdr server reload-config 2> /dev/null; then
    echo "Herdr theme synced ($theme_name)"
else
    echo "Herdr theme updated — herdr not running ($theme_name)"
fi
