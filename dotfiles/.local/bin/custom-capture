#!/usr/bin/env bash
#
# @name         custom-capture
# @summary      Capture screenshots, OCR text, or pick colors on screen
# @version      1.0.0
# @deps         grim, slurp, wl-copy, fuzzel
#
# @description  Unified screen capture utility for Wayland desktop.
#               Supports region/fullscreen screenshots, in-place annotation, OCR, color picker, and scrolling capture.
#
# @usage        custom-capture [options] [command] [arguments...]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   menu        Open interactive fuzzy capture menu via Fuzzel (default)
#   area [-o <path>|-]  Capture selected rectangular screen area
#   full [-o <path>|-]  Capture entire screen output
#   edit        Capture screen area and open interactive annotation editor (satty)
#   ocr         Capture screen area, recognize text, and copy to clipboard
#   color       Interactively pick a pixel color on screen (hyprpicker)
#   preview     Capture screen area and preview floating window (imv)
#   scroll      Interactive scrolling screenshot (wayscrollshot)
#
# @stdin        Piped input where applicable
# @stdout       Captured image path, hex color, or recognized OCR text
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-capture area
#   custom-capture area - | wl-copy
#   custom-capture edit
#   custom-capture color

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	if ((BASH_SUBSHELL == 0)); then
		custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	fi
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel uses 1 both for Esc and startup failure; errors distinguish the two.
pick() (
	local selection rc errors
	errors=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-picker.XXXXXX")
	trap 'rm -f -- "$errors"' EXIT
	if selection=$(fuzzel --dmenu --log-level=error "$@" 2>"$errors"); then
		cat "$errors" >&2
		printf '%s' "$selection"
	else
		rc=$?
		cat "$errors" >&2
		if ((rc == 1)) && [[ ! -s "$errors" ]]; then return 0; fi
		if ((rc == 127 || rc == 130)); then exit "$rc"; fi
		die 1 cli_picker_failed
	fi
)

save_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots"

select_area() (
	local geometry rc errors
	require slurp
	errors=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-capture.XXXXXX")
	trap 'rm -f -- "$errors"' EXIT
	if geometry=$(slurp 2>"$errors"); then
		cat "$errors" >&2
		printf '%s' "$geometry"
	else
		rc=$?
		cat "$errors" >&2
		if ((rc == 1)) && [[ ! -s "$errors" ]]; then return 0; fi
		((rc != 130)) || exit 130
		die 1 cli_unavailable name=slurp
	fi
)
capture() (
	local mode="$1" target="$2" geometry='' tmp
	local -a grim_args=()
	require grim
	if [[ "$mode" == area ]]; then
		geometry=$(select_area)
		[[ -n "$geometry" ]] || return 0
		grim_args=(-g "$geometry")
	fi
	if [[ "$target" == - ]]; then
		grim "${grim_args[@]}" -
		return
	fi
	require wl-copy
	if [[ -z "$target" ]]; then target="$save_dir/screenshot-$(date +%Y%m%d_%H%M%S_%N).png"; fi
	mkdir -p -- "$(dirname -- "$target")"
	tmp=$(mktemp "$(dirname -- "$target")/.capture.XXXXXX")
	trap 'rm -f -- "$tmp"' EXIT
	grim "${grim_args[@]}" "$tmp"
	if [[ -e "$target" ]]; then
		chmod --reference="$target" "$tmp"
	else chmod '=rw' "$tmp"; fi
	mv -f -- "$tmp" "$target"
	wl-copy <"$target"
	printf '%s\n' "$target"
)
area_action() (
	local action="$1" geometry tmp text output
	case "$action" in
	ocr) require grim custom-ocr wl-copy ;;
	edit) require grim satty uwsm ;;
	preview) require grim imv wl-copy uwsm ;;
	esac
	geometry=$(select_area)
	[[ -n "$geometry" ]] || return 0
	tmp=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-capture.XXXXXX.png")
	trap 'rm -f -- "$tmp"' EXIT
	grim -g "$geometry" "$tmp"
	case "$action" in
	ocr)
		text=$(custom-ocr "$tmp")
		[[ -n "$text" ]] || return 0
		printf '%s' "$text" | wl-copy
		printf '%s\n' "$text"
		;;
	preview)
		wl-copy <"$tmp"
		uwsm app -t scope -- imv "${tmp//\$/\$\$}"
		;;
	edit)
		mkdir -p -- "$save_dir"
		output="$save_dir/screenshot-$(date +%Y%m%d_%H%M%S_%N).png"
		uwsm app -t scope -- satty --filename "${tmp//\$/\$\$}" --output-filename "${output//\$/\$\$}" --early-exit
		if [[ -f "$output" ]]; then printf '%s\n' "$output"; fi
		;;
	esac
)
color() {
	local value
	require hyprpicker wl-copy
	value=$(hyprpicker -n)
	[[ -n "$value" ]] || return 0
	printf '%s' "$value" | wl-copy
	printf '%s\n' "$value"
}
menu() {
	local label prompt choice index
	local -a actions=(area full edit preview ocr color scroll) rows=()
	local -a glyphs=(󰒅 󰍹 󰏫 󰋩 󱄽 󰈋 󰁅)
	require fuzzel
	prompt=$(t cap_menu_prompt)
	for index in "${!actions[@]}"; do
		label=$(t "cap_menu_${actions[$index]}")
		rows+=("  ${glyphs[$index]}  $label")
	done
	choice=$(printf '%s\n' "${rows[@]}" | pick --prompt "$prompt" --index)
	[[ -n "$choice" ]] || return 0
	[[ "$choice" =~ ^[0-9]+$ ]] || die 1 cli_picker_failed
	index=$((10#$choice))
	[[ "$index" == "$choice" ]] || die 1 cli_picker_failed
	((index < ${#actions[@]})) || die 1 cli_picker_failed
	main "${actions[$index]}"
}
main() {
	local action="${1:-menu}" target=''
	if (($#)); then shift; fi
	case "$action" in
	area | full)
		if (($# == 1)) && [[ "$1" == - ]]; then
			target=-
		elif (($# == 2)) && [[ "$1" == -o && -n "$2" ]]; then
			target="$2"
		elif (($# != 0)); then usage_error; fi
		;;
	-h | --help | menu | edit | ocr | color | preview | scroll) (($# == 0)) || usage_error ;;
	*) usage_error ;;
	esac
	case "$action" in
	-h | --help) t help_capture ;;
	menu) menu ;;
	area | full) capture "$action" "$target" ;;
	edit | ocr | preview) area_action "$action" ;;
	color) color ;;
	scroll)
		require wayscrollshot
		wayscrollshot -c
		;;
	esac
}
main "$@"
