#!/usr/bin/env luajit
-- arch:summary=Manage Wi-Fi through explicit CLI operations or an interactive menu
-- arch:args=[menu | list | status | connect <ssid> [--passphrase-stdin] | disconnect | toggle]
-- arch:examples=x-wifi list | x-wifi connect "MyWiFi" | x-wifi menu

local function quote(value)
  return "'" .. tostring(value):gsub("'", "'\\''") .. "'"
end

local function command(...)
  local args = { ... }
  for i, value in ipairs(args) do
    args[i] = quote(value)
  end
  return table.concat(args, " ")
end

local function capture(cmd)
  -- LuaJIT's Lua 5.1 pclose discards the child status. Frame it explicitly;
  -- pipefail also preserves failures from busctl before jq in query pipelines.
  local pipe =
    io.popen(command("bash", "-o", "pipefail", "-c", cmd .. "\nrc=$?\nprintf '\\n%d' \"$rc\""), "r")
  if not pipe then
    return "", 1
  end
  local output = pipe:read("*a") or ""
  pipe:close()
  local body, status = output:match("^(.*)\n(%d+)$")
  return body or "", tonumber(status) or 1
end

local function i18n(key, vars)
  local cmd = command("x-i18n", "get", key)
  for k, v in pairs(vars or {}) do
    cmd = cmd .. " " .. quote(k .. "=" .. v)
  end
  local text, status = capture(cmd .. " 2>/dev/null")
  return status == 0 and text ~= "" and text:gsub("\n$", "") or key
end

local function fail(key, vars, status)
  io.stderr:write(i18n(key, vars) .. "\n")
  os.exit(status or 1)
end

local function checked(cmd)
  local output, status = capture(cmd)
  if status ~= 0 then
    fail("net_operation_failed")
  end
  return output
end

local function require_tool(name)
  local _, status = capture(command("command", "-v", name) .. " >/dev/null")
  if status ~= 0 then
    fail("net_missing_tool", { tool = name })
  end
end

local action = arg[1] or "menu"
if action == "-h" or action == "--help" or action == "help" then
  io.stdout:write(i18n("net_usage") .. "\n")
  os.exit(0)
end
local valid = {
  menu = true,
  list = true,
  scan = true,
  status = true,
  connect = true,
  disconnect = true,
  toggle = true,
}
if
  not valid[action]
  or arg[4]
  or (action ~= "connect" and arg[2])
  or (
    action == "connect"
    and (not arg[2] or arg[2] == "" or (arg[3] and arg[3] ~= "--passphrase-stdin"))
  )
then
  fail("net_usage", nil, 2)
end
require_tool("busctl")
require_tool("jq")
if action == "menu" then
  require_tool("fuzzel")
end

local function notify(key, vars)
  if action == "menu" then
    capture(command("notify-send", i18n("net_notify_title"), i18n(key, vars)) .. " 2>/dev/null")
  end
end

local function tsv(value)
  return (value:gsub("\\", "\\\\"):gsub("\t", "\\t"):gsub("\n", "\\n"):gsub("\r", "\\r"))
end

local function fields(line)
  local result = {}
  for value in (line .. "\t"):gmatch("(.-)\t") do
    table.insert(
      result,
      (value:gsub("\\([\\tnr])", { ["\\"] = "\\", t = "\t", n = "\n", r = "\r" }))
    )
  end
  return result
end

local objects_cmd = command(
  "busctl",
  "--auto-start=no",
  "call",
  "net.connman.iwd",
  "/",
  "org.freedesktop.DBus.ObjectManager",
  "GetManagedObjects",
  "--json=short"
)
local station_query = [[
.data[0] | to_entries | map(select(.value["net.connman.iwd.Station"])) | .[0] // empty |
[.key, (.value["net.connman.iwd.Device"].Name.data // ""),
 (.value["net.connman.iwd.Station"].State.data // ""),
 (.value["net.connman.iwd.Station"].ConnectedNetwork.data // "")] | @tsv
]]
local station_line =
  checked(objects_cmd .. " | " .. command("jq", "-r", station_query)):match("[^\n]+")
if not station_line then
  fail("net_no_device")
end
local station = fields(station_line)
local station_path, device, state, connected_path = station[1], station[2], station[3], station[4]

local function station_call(method)
  return checked(
    command("busctl", "call", "net.connman.iwd", station_path, "net.connman.iwd.Station", method)
  )
end

local function disconnect()
  if state ~= "disconnected" then
    station_call("Disconnect")
  end
  notify("net_disconnected", { ssid = device })
  io.stdout:write("disconnected\n")
end

if action == "disconnect" or (action == "toggle" and state ~= "disconnected") then
  disconnect()
  os.exit(0)
end

local net_query = [[
.data[0] | to_entries[] | select(.value["net.connman.iwd.Network"]) |
.key as $path | .value["net.connman.iwd.Network"] |
[$path, .Name.data, .Type.data, (.Connected.data | tostring), (.KnownNetwork.data // "")] | @tsv
]]
local networks = {}
for line in checked(objects_cmd .. " | " .. command("jq", "-r", net_query)):gmatch("[^\n]+") do
  local f = fields(line)
  networks[f[1]] =
    { path = f[1], name = f[2], type = f[3], connected = f[4] == "true", known = f[5] ~= "" }
end

if action == "status" then
  local current = networks[connected_path]
  io.stdout:write(
    string.format(
      "device: %s\nstate: %s\nconnected: %s\n",
      tsv(device),
      state,
      current and tsv(current.name) or "none"
    )
  )
  os.exit(0)
end

local ordered_cmd = command(
  "busctl",
  "call",
  "net.connman.iwd",
  station_path,
  "net.connman.iwd.Station",
  "GetOrderedNetworks",
  "--json=short"
)
local ordered_query = ".data[0][] | [.[0], .[1]] | @tsv"
local ordered = {}
for line in checked(ordered_cmd .. " | " .. command("jq", "-r", ordered_query)):gmatch("[^\n]+") do
  local f = fields(line)
  local net = networks[f[1]]
  if net then
    net.signal = tonumber(f[2]) or -10000
    table.insert(ordered, net)
  end
end

local function connected(net)
  return checked(
    command(
      "busctl",
      "get-property",
      "net.connman.iwd",
      net.path,
      "net.connman.iwd.Network",
      "Connected"
    )
  ):match("^b true%s*$") ~= nil
end

local function connect(net, passphrase)
  if not net.connected then
    if passphrase then
      require_tool("iwctl")
      checked(
        command(
          "iwctl",
          "--dont-ask",
          "--passphrase",
          passphrase,
          "station",
          device,
          "connect",
          net.name
        )
      )
    else
      if not net.known and net.type ~= "open" then
        fail("net_credentials_required", { ssid = net.name })
      end
      checked(
        command("busctl", "call", "net.connman.iwd", net.path, "net.connman.iwd.Network", "Connect")
      )
    end
    if not connected(net) then
      fail("net_failed", { ssid = net.name })
    end
  end
  notify("net_connected", { ssid = net.name })
  io.stdout:write("connected\t" .. tsv(net.name) .. "\n")
end

local function find_network(ssid)
  local found
  for _, net in ipairs(ordered) do
    if net.name == ssid then
      if found then
        fail("net_ambiguous_ssid", { ssid = ssid })
      end
      found = net
    end
  end
  if not found then
    fail("net_not_found", { ssid = ssid })
  end
  return found
end

if action == "list" or action == "scan" then
  for _, net in ipairs(ordered) do
    io.stdout:write(
      string.format(
        "%s\t%d dBm\t%s\t%s\n",
        tsv(net.name),
        math.floor(net.signal / 100),
        net.type,
        net.connected and "connected" or "disconnected"
      )
    )
  end
elseif action == "connect" then
  local net = find_network(arg[2])
  local passphrase
  if arg[3] then
    passphrase = io.read("*l")
    if not passphrase or passphrase == "" then
      fail("net_empty_passphrase")
    end
  end
  connect(net, passphrase)
elseif action == "toggle" then
  for _, net in ipairs(ordered) do
    if net.known or net.type == "open" then
      connect(net)
      os.exit(0)
    end
  end
  fail("net_no_saved_network")
else
  local entries = { "  󰑐  " .. i18n("net_rescan") }
  for _, net in ipairs(ordered) do
    local icon = net.signal >= -5000 and "󰤨"
      or net.signal >= -6500 and "󰤥"
      or net.signal >= -7500 and "󰤢"
      or "󰤟"
    table.insert(
      entries,
      string.format(
        "%s%s  %s  %s",
        net.connected and "* " or "  ",
        icon,
        net.type == "open" and "󰌿" or "󰌾",
        tsv(net.name)
      )
    )
  end
  local selection, status = capture(
    command("printf", "%s", table.concat(entries, "\n") .. "\n")
      .. " | "
      .. command("fuzzel", "--dmenu", "--index", "--prompt", i18n("net_prompt"), "--lines", "15")
  )
  if status == 1 then
    os.exit(0)
  end
  if status ~= 0 then
    fail("net_operation_failed")
  end
  local index = tonumber(selection)
  if not index then
    fail("net_operation_failed")
  end
  if index == 0 then
    station_call("Scan")
    capture(command("sleep", "1.2"))
    checked(command(arg[0], "menu"))
  else
    local net = ordered[index]
    if not net then
      fail("net_operation_failed")
    end
    if net.connected then
      disconnect()
    elseif not net.known and net.type ~= "open" then
      local passphrase, pass_status = capture(
        command(
          "fuzzel",
          "--dmenu",
          "--password",
          "--prompt",
          i18n("net_password_prompt", { ssid = net.name }),
          "--lines",
          "0"
        ) .. " < /dev/null"
      )
      if pass_status == 1 then
        os.exit(0)
      end
      if pass_status ~= 0 then
        fail("net_operation_failed")
      end
      passphrase = passphrase:gsub("\n$", "")
      if passphrase == "" then
        os.exit(0)
      end
      connect(net, passphrase)
    else
      connect(net)
    end
  end
end
