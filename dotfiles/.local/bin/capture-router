#!/bin/bash
# Coordinate mutually exclusive local recording and livestream capture.

set -o pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
# shellcheck disable=SC1091
source "$SCRIPT_DIR/livestream-core"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/i18n-core"

CAPTURE_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/capture-$UID}/capture-router"
CAPTURE_LOCK_FILE="$CAPTURE_RUNTIME_DIR/operation.lock"
CAPTURE_LOCK_CONFLICT_RC=75
CAPTURE_SHOW_MENU_RC=79

capture_ensure_runtime() {
    install -d -m 700 "$CAPTURE_RUNTIME_DIR" || return 1
    [ -O "$CAPTURE_RUNTIME_DIR" ] || {
        printf 'capture-router: runtime directory is not owned by the current user: %s\n' \
            "$CAPTURE_RUNTIME_DIR" >&2
        return 1
    }
    chmod 700 "$CAPTURE_RUNTIME_DIR" 2> /dev/null || true
}

capture_notify() {
    local body="$1"
    local urgency="${2:-normal}"
    local title_key="${3:-capture_notify_title}"
    if command -v notify-send > /dev/null 2>&1; then
        notify-send -u "$urgency" "$(msg "$title_key")" "$body"
    fi
}

livestream_notify() {
    capture_notify "$1" "${2:-normal}" livestream_notify_title
}

# Let flock own the lock in a supervisor process and close its descriptor in
# the routed command. Persistent recorder/stream children therefore cannot
# inherit the lock. Nonblocking acquisition also prevents repeated UI clicks
# from queuing and executing later against a different capture state.
capture_with_lock() {
    local rc
    capture_ensure_runtime || return 1

    flock --exclusive --nonblock --close \
        --conflict-exit-code "$CAPTURE_LOCK_CONFLICT_RC" \
        "$CAPTURE_LOCK_FILE" \
        env CAPTURE_ROUTER_LOCKED=1 "$SCRIPT_DIR/capture-router" "$@"
    rc=$?

    case "$rc" in
        "$CAPTURE_LOCK_CONFLICT_RC")
            capture_notify "$(msg capture_notify_action_busy)"
            return "$rc"
            ;;
        "$CAPTURE_SHOW_MENU_RC")
            exec "$SCRIPT_DIR/capture-menu"
            ;;
        *) return "$rc" ;;
    esac
}

capture_state() {
    if livestream_is_active; then
        printf '%s\n' livestream
        return 0
    fi

    if capture_gsr_running; then
        printf '%s\n' recording
    else
        printf '%s\n' idle
    fi
}

capture_recording_start() {
    local state rc
    state=$(capture_state)
    case "$state" in
        livestream)
            capture_notify "$(msg capture_notify_livestream_active)"
            return 5
            ;;
        recording)
            capture_notify "$(msg capture_notify_recording_already_active)"
            return 2
            ;;
    esac

    command omarchy capture screenrecording "$@"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        capture_notify "$(msg capture_notify_recording_start_failed)" critical
    fi
    return "$rc"
}

capture_recording_stop() {
    local state rc
    state=$(capture_state)
    case "$state" in
        livestream)
            capture_notify "$(msg capture_notify_livestream_active)"
            return 5
            ;;
        idle)
            capture_notify "$(msg capture_notify_recording_not_active)"
            return 1
            ;;
    esac

    command omarchy capture screenrecording --stop-recording
    rc=$?
    return "$rc"
}

capture_recording_toggle() {
    case "$(capture_state)" in
        livestream)
            capture_notify "$(msg capture_notify_livestream_active)"
            return 5
            ;;
        recording)
            capture_recording_stop
            ;;
        idle)
            capture_recording_start "$@"
            ;;
    esac
}

capture_livestream_start() {
    local target="${1:-portal}"
    local state rc
    state=$(capture_state)
    case "$state" in
        livestream)
            livestream_notify "$(msg livestream_notify_already_active)"
            return 2
            ;;
        recording)
            livestream_notify "$(msg livestream_notify_recording_active)"
            return 5
            ;;
    esac

    livestream_start "$target"
    rc=$?
    case "$rc" in
        0) livestream_notify "$(msg livestream_notify_started_full)" ;;
        2) livestream_notify "$(msg livestream_notify_already_active)" ;;
        3) livestream_notify "$(msg livestream_notify_missing_rtmp)" ;;
        5) livestream_notify "$(msg livestream_notify_recording_active)" ;;
        *) livestream_notify "$(msg livestream_notify_start_failed)" critical ;;
    esac
    return "$rc"
}

capture_livestream_stop() {
    local state rc
    state=$(capture_state)
    if [ "$state" != livestream ]; then
        livestream_notify "$(msg livestream_notify_not_active)"
        return 1
    fi

    livestream_stop
    rc=$?
    if [ "$rc" -eq 0 ]; then
        livestream_notify "$(msg livestream_notify_stopped)"
    else
        livestream_notify "$(msg capture_notify_livestream_stop_failed)" critical
    fi
    return "$rc"
}

capture_livestream_toggle() {
    local target="${1:-portal}"
    case "$(capture_state)" in
        livestream) capture_livestream_stop ;;
        recording)
            livestream_notify "$(msg livestream_notify_recording_active)"
            return 5
            ;;
        idle) capture_livestream_start "$target" ;;
    esac
}

capture_toggle_active() {
    case "$(capture_state)" in
        livestream) capture_livestream_stop ;;
        recording) capture_recording_stop ;;
        idle) return "$CAPTURE_SHOW_MENU_RC" ;;
    esac
}

# Shared process discovery for overlay workers. Matches the python token only
# (word boundary, so python3 does not match), absolute or bare script paths;
# excludes capture-router shells and title-edit.
capture_overlay_pid() {
    local name="$1"
    local needle

    case "$name" in
        camera | captions | keys | title) needle="screenrecord-overlay-${name}" ;;
        *) return 1 ;;
    esac

    ps -u "$(id -u)" -o pid=,args= | awk -v needle="$needle" -v name="$name" '
        index($0, needle) == 0 { next }
        $0 ~ /capture-router/ { next }
        $0 ~ /awk -v needle/ { next }
        # title-edit embeds the same basename prefix; never treat it as the worker.
        name == "title" && index($0, "screenrecord-overlay-title-edit") { next }
        # Bare interpreter name "python" only (not python3*).
        $0 !~ /(^|[ \/])python( |$)/ { next }
        {
            print $1
            exit
        }'
}

capture_overlay_status() {
    local name pid
    for name in camera captions keys title; do
        pid=$(capture_overlay_pid "$name" || true)
        if [ -n "$pid" ]; then
            printf '%s running %s\n' "$name" "$pid"
        else
            printf '%s stopped\n' "$name"
        fi
    done
}

capture_overlay_toggle() {
    local name="$1"
    local bin pid notify_key
    case "$name" in
        camera | captions | keys | title) ;;
        *)
            capture_usage
            return 64
            ;;
    esac

    # The title card moved into Omarchy's Quickshell overlay plugin; route it
    # there first and fall back to the legacy GTK script only if unavailable.
    if [[ "$name" == title && -n "${OMARCHY_PATH:-}" && -x "${OMARCHY_PATH:-}/bin/omarchy-shell" ]]; then
        state=$("$OMARCHY_PATH"/bin/omarchy-shell shell toggle xifan.overlay-title '{}' 2> /dev/null || true)
        case "$state" in
            open) notify_key="screenrecord_overlay_title_on" ;;
            closed) notify_key="screenrecord_overlay_title_off" ;;
        esac
        if command -v notify-send > /dev/null 2>&1 && [ -n "$notify_key" ]; then
            notify-send "$(msg screenrecord_notify_title)" "$(msg "$notify_key")"
        elif [ -n "$notify_key" ]; then
            msg "$notify_key"
        fi
        return 0
    fi

    bin="$SCRIPT_DIR/screenrecord-overlay-$name"
    if [ ! -x "$bin" ]; then
        printf 'capture-router: overlay binary missing: %s\n' "$bin" >&2
        return 1
    fi

    pid=$(capture_overlay_pid "$name" || true)
    if [ -n "$pid" ]; then
        kill "$pid" 2> /dev/null || true
        notify_key="screenrecord_overlay_${name}_off"
    else
        nohup "$bin" > /dev/null 2>&1 &
        notify_key="screenrecord_overlay_${name}_on"
    fi

    if command -v notify-send > /dev/null 2>&1; then
        notify-send "$(msg screenrecord_notify_title)" "$(msg "$notify_key")"
    else
        msg "$notify_key"
    fi
}

capture_usage() {
    cat << 'EOF'
Usage:
  capture-router status|menu|toggle-active|config
  capture-router recording start|stop|toggle [screenrecord options]
  capture-router livestream start [target]|stop|toggle [target]|status
  capture-router overlay camera|captions|keys|title|edit|status
  capture-router overlay pid camera|captions|keys|title
EOF
}

main() {
    # Re-exec mutating routes under a lock held by flock itself. An idle
    # indicator click only opens the menu and does not need a mutation lock.
    if [ "${CAPTURE_ROUTER_LOCKED:-0}" != 1 ]; then
        case "${1:-}" in
            recording)
                capture_with_lock "$@"
                return
                ;;
            livestream)
                case "${2:-}" in
                    start | stop | toggle)
                        capture_with_lock "$@"
                        return
                        ;;
                esac
                ;;
            toggle-active)
                if [ "$(capture_state)" = idle ]; then
                    exec "$SCRIPT_DIR/capture-menu"
                fi
                capture_with_lock "$@"
                return
                ;;
        esac
    fi

    local domain="${1:-}"
    local action="${2:-}"
    [ "$#" -gt 0 ] && shift

    case "$domain" in
        status) capture_state ;;
        menu) exec "$SCRIPT_DIR/capture-menu" ;;
        config) exec "$SCRIPT_DIR/livestream-config" ;;
        toggle-active) capture_toggle_active ;;
        recording)
            [ "$#" -gt 0 ] && shift
            case "$action" in
                start) capture_recording_start "$@" ;;
                stop) capture_recording_stop ;;
                toggle) capture_recording_toggle "$@" ;;
                *)
                    capture_usage
                    return 64
                    ;;
            esac
            ;;
        livestream)
            [ "$#" -gt 0 ] && shift
            case "$action" in
                start) capture_livestream_start "${1:-portal}" ;;
                stop) capture_livestream_stop ;;
                toggle) capture_livestream_toggle "${1:-portal}" ;;
                status) livestream_status_report ;;
                *)
                    capture_usage
                    return 64
                    ;;
            esac
            ;;
        overlay)
            # Match recording/livestream: drop the action token so $1 is the
            # first overlay argument (name for pid, unused for toggles).
            [ "$#" -gt 0 ] && shift
            case "$action" in
                camera | captions | keys | title) capture_overlay_toggle "$action" ;;
                edit | title-edit) exec "$SCRIPT_DIR/screenrecord-overlay-title-edit" ;;
                status) capture_overlay_status ;;
                pid)
                    case "${1:-}" in
                        camera | captions | keys | title)
                            capture_overlay_pid "$1" || true
                            ;;
                        *)
                            capture_usage
                            return 64
                            ;;
                    esac
                    ;;
                *)
                    capture_usage
                    return 64
                    ;;
            esac
            ;;
        *)
            capture_usage
            return 64
            ;;
    esac
}

main "$@"
