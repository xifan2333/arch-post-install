#!/usr/bin/env bash
# arch:summary=Set active system-wide monospace font dynamically
# arch:args=<font-name>
# arch:examples=arch font set "Sarasa Mono SC" | arch font set "JetBrainsMono Nerd Font"
set -euo pipefail

usage() {
	printf 'Usage: arch-font-set <font-name>\n'
	printf 'Example: arch font set "Sarasa Mono SC"\n'
	printf 'See available fonts with: arch font list\n'
}

if [[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
	usage
	exit 0
fi

font_name="$1"

# Validate that font exists in fontconfig
if ! fc-list : family 2>/dev/null | grep -iF "$font_name" >/dev/null 2>&1; then
	printf 'Warning: Font "%s" was not found in fontconfig cache. Applying anyway.\n' "$font_name" >&2
fi

tr_msg() {
	local key="$1"
	shift
	if command -v arch-i18n >/dev/null 2>&1; then
		arch-i18n get "$key" "$@"
	else
		printf '%s' "$key"
	fi
}

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$(tr_msg font_title)" "$1"
	fi
}

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/font"
mkdir -p "$state_dir"

# 1. State: Fontconfig monospace override snippet
cat >"$state_dir/fonts.conf" <<EOF
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Auto-generated by arch-font-set: DO NOT EDIT DIRECTLY -->
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="prepend" binding="strong">
      <string>$font_name</string>
    </edit>
  </match>
</fontconfig>
EOF

# 2. State: Fuzzel typography snippet
cat >"$state_dir/fuzzel.ini" <<EOF
# Auto-generated by arch-font-set: DO NOT EDIT DIRECTLY
[main]
font=$font_name:size=13
EOF

# 3. State: Waybar CSS font-family snippet
cat >"$state_dir/waybar.css" <<EOF
/* Auto-generated by arch-font-set: DO NOT EDIT DIRECTLY */
* {
    font-family: "$font_name", "Symbols Nerd Font", sans-serif;
}
EOF

# Persist current selection
printf '%s\n' "$font_name" >"$state_dir/current.name"

# Broadcast reloads
pkill -SIGUSR2 waybar 2>/dev/null || true

notify_msg="$(tr_msg font_switched "font=$font_name")"
notify "$notify_msg"
printf '✓ Set active monospace font to "%s"\n' "$font_name"
