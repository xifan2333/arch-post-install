#!/usr/bin/env bash
# arch:summary=Set active monospace and CJK fallback fonts dynamically
# arch:args=<mono-font> [<cjk-font>] | --mono <mono-font> | --cjk <cjk-font>
# arch:examples=arch font set "JetBrainsMono Nerd Font" "Sarasa Mono SC"
set -euo pipefail

usage() {
	cat <<'EOF'
Usage:
  arch-font-set <mono-font> [<cjk-font>]
  arch-font-set --mono <mono-font>
  arch-font-set --cjk <cjk-font>

Examples:
  arch-font-set "JetBrainsMono Nerd Font" "Sarasa Mono SC"
  arch-font-set --mono "FiraCode Nerd Font"
  arch-font-set --cjk "Noto Sans Mono CJK SC"
EOF
}

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/font"
mkdir -p "$state_dir"

get_current_mono() {
	if [[ -f "$state_dir/mono.name" ]]; then
		cat "$state_dir/mono.name"
		return 0
	fi
	printf 'JetBrainsMono Nerd Font\n'
}

get_current_cjk() {
	if [[ -f "$state_dir/cjk.name" ]]; then
		cat "$state_dir/cjk.name"
		return 0
	fi
	printf 'Sarasa Mono SC\n'
}

is_cjk_font() {
	local name="$1"
	if [[ "$name" =~ (Sarasa|CJK|WenKai|Source\ Han|PingFang|Microsoft\ YaHei|SimSun|KaiTi) ]]; then
		return 0
	fi
	return 1
}

mono_font=""
cjk_font=""

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
	usage
	exit 0
elif [[ "$1" == "--mono" ]]; then
	if [[ $# -lt 2 ]]; then
		printf 'Error: Missing font name for --mono\n' >&2
		exit 1
	fi
	mono_font="$2"
	cjk_font="$(get_current_cjk)"
elif [[ "$1" == "--cjk" ]]; then
	if [[ $# -lt 2 ]]; then
		printf 'Error: Missing font name for --cjk\n' >&2
		exit 1
	fi
	mono_font="$(get_current_mono)"
	cjk_font="$2"
elif [[ $# -ge 2 ]]; then
	mono_font="$1"
	cjk_font="$2"
else
	# Single argument: detect whether it is CJK or Mono
	if is_cjk_font "$1"; then
		mono_font="$(get_current_mono)"
		cjk_font="$1"
	else
		mono_font="$1"
		cjk_font="$(get_current_cjk)"
	fi
fi

# 1. State: Fontconfig monospace & CJK fallback snippet
cat >"$state_dir/fonts.conf" <<EOF
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Auto-generated by arch-font-set: DO NOT EDIT DIRECTLY -->
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="prepend" binding="strong">
      <string>$mono_font</string>
    </edit>
  </match>
  <alias>
    <family>monospace</family>
    <prefer>
      <family>$cjk_font</family>
      <family>Noto Color Emoji</family>
    </prefer>
  </alias>
</fontconfig>
EOF

# 2. State: Fuzzel typography snippet
cat >"$state_dir/fuzzel.ini" <<EOF
# Auto-generated by arch-font-set: DO NOT EDIT DIRECTLY
[main]
font=$mono_font:size=13, $cjk_font:size=13
EOF

# 3. State: Waybar CSS font-family snippet
cat >"$state_dir/waybar.css" <<EOF
/* Auto-generated by arch-font-set: DO NOT EDIT DIRECTLY */
* {
    font-family: "$mono_font", "$cjk_font", sans-serif;
}
EOF

# Persist selections
printf '%s\n' "$mono_font" >"$state_dir/mono.name"
printf '%s\n' "$cjk_font" >"$state_dir/cjk.name"
printf '%s + %s\n' "$mono_font" "$cjk_font" >"$state_dir/current.name"

# Broadcast reloads
pkill -SIGUSR2 waybar 2>/dev/null || true

printf '✓ Set active fonts:\n  Mono: %s\n  CJK : %s\n' "$mono_font" "$cjk_font"
