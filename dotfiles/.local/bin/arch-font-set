#!/usr/bin/env bash
# arch:summary=Set or inspect active system-wide monospace font dynamically
# arch:args=<font-name> | list | current
# arch:examples=arch font set "Sarasa Mono SC" | arch font list
set -euo pipefail

get_state_dir() {
	printf '%s/font' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

get_current_font() {
	local state_dir
	state_dir="$(get_state_dir)"
	local name_file="$state_dir/current.name"
	if [[ -f "$name_file" ]]; then
		cat "$name_file"
		return 0
	fi
	printf 'Sarasa Mono SC\n'
}

tr_msg() {
	local key="$1"
	shift
	if command -v arch-i18n >/dev/null 2>&1; then
		arch-i18n get "$key" "$@"
	else
		printf '%s' "$key"
	fi
}

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$(tr_msg font_title)" "$1"
	fi
}

list_available_fonts() {
	local curr
	curr="$(get_current_font)"

	# Filter popular coding and terminal monospace fonts installed on system
	local fonts
	fonts=$(fc-list : family 2>/dev/null |
		tr ',' '\n' |
		grep -E "^(Sarasa Mono SC|JetBrainsMono Nerd Font|Maple Mono|Noto Sans Mono CJK SC|Fira Code|Hack|Iosevka)" |
		sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
		grep -vE "(Extra|Semi|Light|Thin|Medium|Bold|Black|Italic|NL)" |
		sort -u || true)

	if [[ -z "$fonts" ]]; then
		fonts="Sarasa Mono SC
JetBrainsMono Nerd Font
Noto Sans Mono CJK SC"
	fi

	while IFS= read -r f; do
		[[ -z "$f" ]] && continue
		local prefix="  "
		[[ "$f" == "$curr" ]] && prefix="* "
		printf '%s%s\n' "$prefix" "$f"
	done <<<"$fonts"
}

apply_font() {
	local font_name="$1"

	# Validate that font exists on the system
	if ! fc-list : family 2>/dev/null | grep -iF "$font_name" >/dev/null 2>&1; then
		printf 'Warning: Font "%s" was not found in fontconfig cache. Applying anyway.\n' "$font_name" >&2
	fi

	local state_dir
	state_dir="$(get_state_dir)"
	mkdir -p "$state_dir"

	# 1. State: Fontconfig monospace override snippet
	cat >"$state_dir/fonts.conf" <<EOF
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Auto-generated by arch-font-set: DO NOT EDIT DIRECTLY -->
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="prepend" binding="strong">
      <string>$font_name</string>
    </edit>
  </match>
</fontconfig>
EOF

	# 2. State: Fuzzel typography snippet
	cat >"$state_dir/fuzzel.ini" <<EOF
# Auto-generated by arch-font-set: DO NOT EDIT DIRECTLY
[main]
font=$font_name:size=13
EOF

	# 3. State: Waybar CSS font-family snippet
	cat >"$state_dir/waybar.css" <<EOF
/* Auto-generated by arch-font-set: DO NOT EDIT DIRECTLY */
* {
    font-family: "$font_name", "Symbols Nerd Font", sans-serif;
}
EOF

	# Persist current selection
	printf '%s\n' "$font_name" >"$state_dir/current.name"

	# Broadcast reloads
	pkill -SIGUSR2 waybar 2>/dev/null || true

	local notify_msg
	notify_msg="$(tr_msg font_switched "font=$font_name")"
	notify "$notify_msg"
	printf '✓ Set active monospace font to "%s"\n' "$font_name"
}

main() {
	if [[ $# -lt 1 ]]; then
		local curr
		curr="$(get_current_font)"
		printf 'Usage: arch-font-set <font-name> | list | current\n'
		printf 'Active font: %s\n' "$curr"
		return 0
	fi

	case "$1" in
	list | -l | --list)
		list_available_fonts
		;;
	current | -c | --current)
		get_current_font
		;;
	set)
		if [[ $# -lt 2 ]]; then
			printf 'Error: Missing font name argument for set\n' >&2
			return 1
		fi
		apply_font "$2"
		;;
	-h | --help | help)
		printf 'Usage: arch-font-set <font-name> | list | current\n'
		;;
	*)
		apply_font "$1"
		;;
	esac
}

main "$@"
