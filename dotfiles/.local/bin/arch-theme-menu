#!/usr/bin/env bash
# arch:summary=Open interactive theme selector menu
# arch:examples=arch theme menu
# Interactive theme selector for River desktop using fuzzel or bemenu
set -euo pipefail

curr=$(arch-theme-set --current 2>/dev/null || echo "")
all_themes=$(arch-theme-set --list | sed 's/^[ *]*//' | sort -u)
if [[ -z "$all_themes" ]]; then
	printf 'No themes found\n' >&2
	exit 1
fi

menu_lines=()
if [[ -n "$curr" ]]; then
	menu_lines+=("* $curr")
fi
while IFS= read -r t; do
	[[ -n "$t" ]] || continue
	[[ "$t" == "$curr" ]] && continue
	menu_lines+=("  $t")
done <<<"$all_themes"

if command -v fuzzel &>/dev/null; then
	selected=$(printf '%s\n' "${menu_lines[@]}" | fuzzel --dmenu --prompt "Theme: ")
elif command -v bemenu &>/dev/null; then
	selected=$(printf '%s\n' "${menu_lines[@]}" | bemenu -p "Theme: ")
else
	selected=$(printf '%s\n' "${menu_lines[@]}" | head -1)
fi

if [[ -n "${selected:-}" ]]; then
	cleaned_theme="${selected#\* }"
	cleaned_theme="${cleaned_theme#  }"
	arch-theme-set "$cleaned_theme"
fi
