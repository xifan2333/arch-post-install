#!/usr/bin/env bash
# arch:summary=Start, stop, or inspect desktop live streaming pipeline
# arch:args=[start | stop | status | toggle | restart | config | is-active]
# arch:examples=arch live push start | arch live push toggle | arch live push config
set -euo pipefail

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/livestream"
PID_FILE="$RUNTIME_DIR/pid"
LOG_FILE="$RUNTIME_DIR/livestream.log"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/livestream"
CONFIG_FILE="$CONFIG_DIR/config.json"
DANMAKU="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/arch-live-danmaku"

tr_msg() {
	local key="$1"
	shift
	if command -v arch-i18n >/dev/null 2>&1; then
		arch-i18n get "$key" "$@"
	else
		printf '%s' "$key"
	fi
}

notify() {
	local title body
	title="$(tr_msg livestream_notify_title)"
	body="$1"
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -u "${2:-normal}" "$title" "$body"
	fi
}

notify_waybar() {
	pkill -RTMIN+8 waybar 2>/dev/null || true
}

boost_hardware() {
	if command -v arch-hw-gpu >/dev/null 2>&1; then
		arch-hw-gpu max >/dev/null 2>&1 || true
	fi
	if command -v arch-hw-fan >/dev/null 2>&1; then
		arch-hw-fan full-speed >/dev/null 2>&1 || true
	fi
}

restore_hardware() {
	if command -v arch-hw-gpu >/dev/null 2>&1; then
		arch-hw-gpu auto >/dev/null 2>&1 || true
	fi
	if command -v arch-hw-fan >/dev/null 2>&1; then
		arch-hw-fan auto >/dev/null 2>&1 || true
	fi
}

open_danmaku() {
	if [[ -x "$DANMAKU" ]]; then
		"$DANMAKU" start >/dev/null 2>&1 &
	fi
}

close_danmaku() {
	if [[ -x "$DANMAKU" ]]; then
		"$DANMAKU" stop >/dev/null 2>&1 &
	fi
}

is_active() {
	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(cat "$PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
	fi
	if pgrep -f "gpu-screen-recorder.*-c flv" >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

cmd_start() {
	if is_active; then
		notify "$(tr_msg livestream_notify_already_active)"
		return 0
	fi

	if ! command -v gpu-screen-recorder >/dev/null 2>&1; then
		notify "未安装 gpu-screen-recorder" critical
		return 1
	fi

	if [[ ! -f "$CONFIG_FILE" ]]; then
		if command -v arch-live-config >/dev/null 2>&1; then
			arch-live-config
		fi
		return 0
	fi

	local server key bitrate full_url
	server="$(jq -r '.server // ""' "$CONFIG_FILE" 2>/dev/null || true)"
	key="$(jq -r '.key // ""' "$CONFIG_FILE" 2>/dev/null || true)"
	bitrate="$(jq -r '.bitrate // 4500' "$CONFIG_FILE" 2>/dev/null || echo 4500)"

	if [[ -z "$server" || "$server" == "null" ]]; then
		if command -v arch-live-config >/dev/null 2>&1; then
			arch-live-config
		fi
		return 0
	fi

	if [[ -z "$key" || "$key" == "null" ]]; then
		full_url="$server"
	elif [[ "$key" == \?* ]]; then
		full_url="${server}${key}"
	elif [[ "$server" == */ ]]; then
		full_url="${server}${key}"
	else
		full_url="${server}/${key}"
	fi

	mkdir -p "$RUNTIME_DIR"
	boost_hardware

	gpu-screen-recorder \
		-w portal \
		-f 60 \
		-c flv \
		-k h264 \
		-fallback-cpu-encoding yes \
		-bm cbr \
		-q "$bitrate" \
		-a "default_output|default_input" \
		-o "$full_url" >"$LOG_FILE" 2>&1 &
	local pid=$!
	printf '%s\n' "$pid" >"$PID_FILE"

	notify_waybar
	open_danmaku
	notify "$(tr_msg livestream_notify_started_full)"
}

cmd_stop() {
	if ! is_active; then
		notify "$(tr_msg livestream_notify_not_active)"
		return 0
	fi

	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(cat "$PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			kill -INT "$pid" 2>/dev/null || true
			local timeout=30
			while kill -0 "$pid" 2>/dev/null && [[ $timeout -gt 0 ]]; do
				sleep 0.1
				timeout=$((timeout - 1))
			done
		fi
		rm -f "$PID_FILE"
	fi

	pkill -SIGINT -f "gpu-screen-recorder.*-c flv" 2>/dev/null || true

	close_danmaku
	restore_hardware
	notify_waybar
	notify "$(tr_msg livestream_notify_stopped)"
}

cmd_toggle() {
	if is_active; then
		cmd_stop
	else
		cmd_start
	fi
}

main() {
	local action="${1:-status}"
	case "$action" in
	start)
		cmd_start
		;;
	stop)
		cmd_stop
		;;
	toggle)
		cmd_toggle
		;;
	restart)
		cmd_stop
		sleep 1
		cmd_start
		;;
	config)
		if command -v arch-live-config >/dev/null 2>&1; then
			arch-live-config
		fi
		;;
	is-active)
		is_active
		;;
	status)
		if is_active; then
			printf 'active\n'
		else
			printf 'inactive\n'
		fi
		;;
	*)
		printf 'Usage: arch-live-push [start | stop | toggle | restart | config | status]\n'
		;;
	esac
}

main "$@"
