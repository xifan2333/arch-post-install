#!/usr/bin/env bash
# arch:summary=Start, stop, or configure desktop live streaming pipeline via TSV history
# arch:args=[toggle | start | stop | status | restart | config | clear | danmaku [start|stop]]
# arch:examples=x-live | x-live config | x-live stop
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/livestream"
HISTORY_FILE="$STATE_DIR/history.tsv"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/livestream"
PID_FILE="$RUNTIME_DIR/pid"
LOG_FILE="$RUNTIME_DIR/livestream.log"
DANMAKU="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/x-danmaku"

notify() {
	local title body
	title="$(x-i18n get livestream_notify_title 2>/dev/null || echo "Live Stream")"
	body="$1"
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -u "${2:-normal}" "$title" "$body"
	fi
}

notify_waybar() {
	pkill -RTMIN+8 waybar 2>/dev/null || true
}

boost_hardware() {
	if command -v x-hw >/dev/null 2>&1; then
		x-hw gpu max >/dev/null 2>&1 || true
		x-hw fan max >/dev/null 2>&1 || true
	fi
}

restore_hardware() {
	if command -v x-hw >/dev/null 2>&1; then
		x-hw gpu auto >/dev/null 2>&1 || true
		x-hw fan auto >/dev/null 2>&1 || true
	fi
}

open_danmaku() {
	if [[ -x "$DANMAKU" ]]; then
		"$DANMAKU" start >/dev/null 2>&1 &
	fi
}

close_danmaku() {
	if [[ -x "$DANMAKU" ]]; then
		"$DANMAKU" stop >/dev/null 2>&1 &
	fi
}

is_active() {
	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(cat "$PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
	fi
	if pgrep -f "gpu-screen-recorder.*-c flv" >/dev/null 2>&1; then
		return 0
	fi
	return 1
}

dmenu() {
	local prompt="$1"
	shift
	if command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu --prompt "$prompt" "$@" || true
	elif command -v bemenu >/dev/null 2>&1; then
		bemenu -p "$prompt" || true
	else
		head -n 1
	fi
}

ensure_state_dir() {
	mkdir -p "$STATE_DIR"
	if [[ ! -f "$HISTORY_FILE" ]]; then
		touch "$HISTORY_FILE"
		chmod 0600 "$HISTORY_FILE" 2>/dev/null || true
	fi
}

get_active_record() {
	ensure_state_dir
	CURRENT_SERVER=""
	CURRENT_KEY=""
	CURRENT_BITRATE="4500"
	CURRENT_AUDIO_BITRATE="160"

	if [[ -s "$HISTORY_FILE" ]]; then
		IFS=$'\t' read -r CURRENT_SERVER CURRENT_KEY CURRENT_BITRATE CURRENT_AUDIO_BITRATE <"$HISTORY_FILE" || true
	fi

	CURRENT_BITRATE="${CURRENT_BITRATE:-4500}"
	CURRENT_AUDIO_BITRATE="${CURRENT_AUDIO_BITRATE:-160}"
}

save_active_record() {
	local s="$1" k="$2" vb="$3" ab="$4"
	ensure_state_dir
	local tmp="$HISTORY_FILE.tmp.$$"
	printf '%s\t%s\t%s\t%s\n' "$s" "$k" "$vb" "$ab" >"$tmp"
	if [[ -f "$HISTORY_FILE" ]]; then
		tail -n +2 "$HISTORY_FILE" >>"$tmp" 2>/dev/null || true
	fi
	chmod 0600 "$tmp" 2>/dev/null || true
	mv -f "$tmp" "$HISTORY_FILE"
}

edit_server() {
	local prompt choice
	prompt="$(x-i18n get livestream_cfg_server 2>/dev/null || echo "Server"): "

	local history_servers=()
	if [[ -f "$HISTORY_FILE" ]]; then
		while IFS=$'\t' read -r s k vb ab; do
			[[ -n "$s" && "$s" != "$CURRENT_SERVER" ]] || continue
			history_servers+=("  󰒓  $s")
		done < <(tail -n +2 "$HISTORY_FILE" 2>/dev/null | awk -F'\t' '!seen[$1]++')
	fi

	if [[ ${#history_servers[@]} -gt 0 ]]; then
		local menu_items=()
		if [[ -n "$CURRENT_SERVER" ]]; then
			menu_items+=("* 󰒓  $CURRENT_SERVER")
		fi
		menu_items+=("${history_servers[@]}")
		choice="$(printf '%s\n' "${menu_items[@]}" | dmenu "$prompt" --lines 6)"
	else
		choice="$(dmenu "$prompt" --lines 0)"
	fi
	[[ -n "$choice" ]] || return 0

	local clean_server="$choice"
	clean_server="${clean_server#\* 󰒓  }"
	clean_server="${clean_server#  󰒓  }"
	clean_server="${clean_server#"${clean_server%%[![:space:]]*}"}"
	clean_server="${clean_server%"${clean_server##*[![:space:]]}"}"

	if [[ -n "$clean_server" ]]; then
		save_active_record "$clean_server" "$CURRENT_KEY" "$CURRENT_BITRATE" "$CURRENT_AUDIO_BITRATE"
	fi
}

edit_key() {
	local prompt new_key
	prompt="$(x-i18n get livestream_cfg_key 2>/dev/null || echo "Key"): "
	new_key="$(dmenu "$prompt" --password --lines 0)"
	[[ -n "$new_key" ]] || return 0

	new_key="${new_key#"${new_key%%[![:space:]]*}"}"
	new_key="${new_key%"${new_key##*[![:space:]]}"}"
	save_active_record "$CURRENT_SERVER" "$new_key" "$CURRENT_BITRATE" "$CURRENT_AUDIO_BITRATE"
	notify "$(x-i18n get livestream_key_updated 2>/dev/null || echo "Stream key updated")"
}

edit_video_bitrate() {
	local prompt choice
	prompt="$(x-i18n get livestream_cfg_video_kbps 2>/dev/null || echo "Video Bitrate"): "
	local rates=("4500" "6000" "8000" "12000")
	local menu_items=()
	for r in "${rates[@]}"; do
		if [[ "$r" == "$CURRENT_BITRATE" ]]; then
			menu_items+=("* 󰕧  ${r} kbps")
		else
			menu_items+=("  󰕧  ${r} kbps")
		fi
	done

	choice="$(printf '%s\n' "${menu_items[@]}" | dmenu "$prompt" --lines 4)"
	[[ -n "$choice" ]] || return 0

	local val
	val="$(printf '%s' "$choice" | grep -oE '[0-9]+' | head -n 1)"
	if [[ -n "$val" ]]; then
		save_active_record "$CURRENT_SERVER" "$CURRENT_KEY" "$val" "$CURRENT_AUDIO_BITRATE"
	fi
}

edit_audio_bitrate() {
	local prompt choice
	prompt="$(x-i18n get livestream_cfg_audio_kbps 2>/dev/null || echo "Audio Bitrate"): "
	local rates=("128" "160" "192" "320")
	local menu_items=()
	for r in "${rates[@]}"; do
		if [[ "$r" == "$CURRENT_AUDIO_BITRATE" ]]; then
			menu_items+=("* 󰓃  ${r} kbps")
		else
			menu_items+=("  󰓃  ${r} kbps")
		fi
	done

	choice="$(printf '%s\n' "${menu_items[@]}" | dmenu "$prompt" --lines 4)"
	[[ -n "$choice" ]] || return 0

	local val
	val="$(printf '%s' "$choice" | grep -oE '[0-9]+' | head -n 1)"
	if [[ -n "$val" ]]; then
		save_active_record "$CURRENT_SERVER" "$CURRENT_KEY" "$CURRENT_BITRATE" "$val"
	fi
}

history_menu() {
	ensure_state_dir
	local count
	count="$(wc -l <"$HISTORY_FILE" 2>/dev/null || echo 0)"
	if [[ $count -le 1 ]]; then
		return 0
	fi

	local lines=()
	local line_indices=()
	local idx=2
	while IFS=$'\t' read -r s k vb ab; do
		[[ -n "$s" ]] || continue
		local host="${s#*://}"
		host="${host%%/*}"
		lines+=("  󰒓  ${host:-$s} (${vb}k/${ab}k)")
		line_indices+=("$idx")
		idx=$((idx + 1))
	done < <(tail -n +2 "$HISTORY_FILE")

	if [[ ${#lines[@]} -eq 0 ]]; then
		return 0
	fi

	local opt_clr
	opt_clr="  󰆴  $(x-i18n get livestream_action_clear_history 2>/dev/null || echo "Clear All History")"
	local menu_items=("${lines[@]}" "$opt_clr")

	local prompt choice
	prompt="$(x-i18n get livestream_history_title 2>/dev/null || echo "History"): "
	choice="$(printf '%s\n' "${menu_items[@]}" | dmenu "$prompt" --lines 8)"
	[[ -n "$choice" ]] || return 0

	if [[ "$choice" == "$opt_clr" ]]; then
		local tmp="$HISTORY_FILE.tmp.$$"
		head -n 1 "$HISTORY_FILE" >"$tmp"
		chmod 0600 "$tmp" 2>/dev/null || true
		mv -f "$tmp" "$HISTORY_FILE"
		notify "$(x-i18n get livestream_history_cleared 2>/dev/null || echo "History cleared")"
		return 0
	fi

	local chosen_line=0
	for i in "${!lines[@]}"; do
		if [[ "${lines[$i]}" == "$choice" ]]; then
			chosen_line="${line_indices[$i]}"
			break
		fi
	done

	if [[ $chosen_line -ge 2 ]]; then
		local tmp="$HISTORY_FILE.tmp.$$"
		sed -n "${chosen_line}p" "$HISTORY_FILE" >"$tmp"
		sed "${chosen_line}d" "$HISTORY_FILE" >>"$tmp"
		chmod 0600 "$tmp" 2>/dev/null || true
		mv -f "$tmp" "$HISTORY_FILE"
		notify "$(x-i18n get livestream_switched "target=${choice#*  }" 2>/dev/null || echo "Switched target")"
	fi
}

cmd_config() {
	while true; do
		get_active_record

		local srv_display key_display
		if [[ -n "$CURRENT_SERVER" ]]; then
			local host="${CURRENT_SERVER#*://}"
			host="${host%%/*}"
			srv_display="${host:-$CURRENT_SERVER}"
		else
			srv_display="$(x-i18n get state_unconfigured 2>/dev/null || echo "unconfigured")"
		fi

		if [[ -n "$CURRENT_KEY" ]]; then
			key_display="$(x-i18n get state_configured 2>/dev/null || echo "configured")"
		else
			key_display="$(x-i18n get state_unconfigured 2>/dev/null || echo "unconfigured")"
		fi

		local opt_server opt_key opt_vbitrate opt_abitrate opt_history
		opt_server="  󰒓  $(x-i18n get livestream_cfg_server 2>/dev/null || echo "Server"): $srv_display"
		opt_key="  󰌆  $(x-i18n get livestream_cfg_key 2>/dev/null || echo "Key"): $key_display"
		opt_vbitrate="  󰕧  $(x-i18n get livestream_cfg_video_kbps 2>/dev/null || echo "Video Bitrate"): ${CURRENT_BITRATE} kbps"
		opt_abitrate="  󰓃  $(x-i18n get livestream_cfg_audio_kbps 2>/dev/null || echo "Audio Bitrate"): ${CURRENT_AUDIO_BITRATE} kbps"

		local choices=("$opt_server" "$opt_key" "$opt_vbitrate" "$opt_abitrate")

		local hist_count
		hist_count="$(wc -l <"$HISTORY_FILE" 2>/dev/null || echo 0)"
		if [[ $hist_count -ge 2 ]]; then
			opt_history="  󰋚  $(x-i18n get livestream_history_title 2>/dev/null || echo "History")"
			choices+=("$opt_history")
		fi

		local prompt_text
		prompt_text="$(x-i18n get livestream_prompt 2>/dev/null || echo "Live Stream Config: ")"
		local choice
		choice="$(printf '%s\n' "${choices[@]}" | dmenu "$prompt_text" --lines 6)"
		[[ -n "$choice" ]] || return 0

		case "$choice" in
		*"$opt_server"*)
			edit_server
			;;
		*"$opt_key"*)
			edit_key
			;;
		*"$opt_vbitrate"*)
			edit_video_bitrate
			;;
		*"$opt_abitrate"*)
			edit_audio_bitrate
			;;
		*"$opt_history"*)
			history_menu
			;;
		esac
	done
}

cmd_start() {
	if is_active; then
		notify "$(x-i18n get livestream_notify_already_active 2>/dev/null || echo "Stream already active")"
		return 0
	fi

	if ! command -v gpu-screen-recorder >/dev/null 2>&1; then
		notify "gpu-screen-recorder not installed" critical
		return 1
	fi

	get_active_record

	if [[ -z "$CURRENT_SERVER" || -z "$CURRENT_KEY" ]]; then
		cmd_config
		get_active_record
		if [[ -z "$CURRENT_SERVER" || -z "$CURRENT_KEY" ]]; then
			notify "$(x-i18n get livestream_notify_missing_rtmp 2>/dev/null || echo "No streaming target configured")"
			return 1
		fi
	fi

	local full_url
	if [[ "$CURRENT_KEY" == \?* ]]; then
		full_url="${CURRENT_SERVER}${CURRENT_KEY}"
	elif [[ "$CURRENT_SERVER" == */ ]]; then
		full_url="${CURRENT_SERVER}${CURRENT_KEY}"
	else
		full_url="${CURRENT_SERVER}/${CURRENT_KEY}"
	fi

	mkdir -p "$RUNTIME_DIR"
	boost_hardware

	gpu-screen-recorder \
		-w portal \
		-f 30 \
		-fm cfr \
		-c flv \
		-k h264 \
		-fallback-cpu-encoding yes \
		-bm cbr \
		-q "$CURRENT_BITRATE" \
		-a "default_output|default_input" \
		-o "$full_url" >"$LOG_FILE" 2>&1 &
	local pid=$!
	printf '%s\n' "$pid" >"$PID_FILE"

	notify_waybar
	open_danmaku
	notify "$(x-i18n get livestream_notify_started_full 2>/dev/null || echo "Live streaming started")"
}

cmd_stop() {
	if ! is_active; then
		notify "$(x-i18n get livestream_notify_not_active 2>/dev/null || echo "No active stream")"
		return 0
	fi

	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(cat "$PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			kill -INT "$pid" 2>/dev/null || true
			local timeout=30
			while kill -0 "$pid" 2>/dev/null && [[ $timeout -gt 0 ]]; do
				sleep 0.1
				timeout=$((timeout - 1))
			done
		fi
		rm -f "$PID_FILE"
	fi

	pkill -SIGINT -f "gpu-screen-recorder.*-c flv" 2>/dev/null || true

	close_danmaku
	restore_hardware
	notify_waybar
	notify "$(x-i18n get livestream_notify_stopped 2>/dev/null || echo "Live stream stopped")"
}

cmd_toggle() {
	if is_active; then
		cmd_stop
	else
		cmd_start
	fi
}

cmd_clear() {
	ensure_state_dir
	rm -f "$HISTORY_FILE"
	notify "$(x-i18n get livestream_history_cleared 2>/dev/null || echo "History cleared")"
}

main() {
	local action="${1:-toggle}"
	case "$action" in
	start)
		cmd_start
		;;
	stop)
		cmd_stop
		;;
	toggle)
		cmd_toggle
		;;
	restart)
		cmd_stop
		sleep 1
		cmd_start
		;;
	config)
		cmd_config
		;;
	clear)
		cmd_clear
		;;
	danmaku)
		shift
		if [[ -x "$DANMAKU" ]]; then
			"$DANMAKU" "${1:-start}"
		fi
		;;
	is-active)
		is_active
		;;
	status)
		if is_active; then
			printf 'active\n'
		else
			printf 'inactive\n'
		fi
		;;
	*)
		printf 'Usage: x-live [toggle | start | stop | status | restart | config | clear | danmaku [start|stop]]\n'
		;;
	esac
}

main "$@"
