#!/bin/bash
# Toggle full-screen Live stream push (start/stop)

set -e
source livestream-core
source i18n-core

# Refuse to start live while an Omarchy screen recording is active
if ! livestream_is_active; then
    if pgrep -f "^gpu-screen-recorder" >/dev/null 2>&1; then
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_recording_active)"
        fi
        exit 1
    fi
    exec livestream-start
fi

exec livestream-stop
