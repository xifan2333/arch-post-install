#!/usr/bin/env -S PYTHONDONTWRITEBYTECODE=1 python3
# arch:summary=Webcam PIP via mpv with multi-camera selection and best quality discovery
# arch:args=[start | toggle | select | stop | status]
# arch:examples=arch overlay camera | arch overlay camera select
"""Webcam picture-in-picture floating player with v4l2 discovery and MPV."""

from __future__ import annotations

import contextlib
import os
import re
import signal
import subprocess
import sys
from pathlib import Path

CONFIG_DIR = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "screenrecord"
)
CONFIG_FILE = CONFIG_DIR / "camera.conf"


def list_v4l2_cameras() -> list[dict[str, object]]:
    devices: list[tuple[str, str]] = []
    try:
        out = subprocess.check_output(
            ["v4l2-ctl", "--list-devices"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
        cur_name = "Camera"
        for line in out.splitlines():
            if line and not line.startswith(("\t", " ")):
                cur_name = line.strip().rstrip(":")
            elif line.strip().startswith("/dev/video"):
                dev = line.strip()
                devices.append((dev, cur_name))
    except (subprocess.CalledProcessError, FileNotFoundError):
        devices = [("/dev/video0", "Camera")]

    cameras: list[dict[str, object]] = []
    for dev, name in devices:
        try:
            out = subprocess.check_output(
                ["v4l2-ctl", "-d", dev, "--list-formats-ext"],
                text=True,
                stderr=subprocess.DEVNULL,
            )
            cur_fmt = None
            cur_w, cur_h = 0, 0
            best_w, best_h, best_fps = 0, 0, 0
            best_fmt = "mjpeg"
            best_score = -1.0

            for line in out.splitlines():
                if "'MJPG'" in line or "'mjpeg'" in line.lower():
                    cur_fmt = "mjpeg"
                elif "'YUYV'" in line or "'yuv'" in line.lower():
                    cur_fmt = "yuyv422"
                elif "Size: Discrete" in line:
                    m = re.search(r"Size: Discrete (\d+)x(\d+)", line)
                    if m:
                        cur_w, cur_h = int(m.group(1)), int(m.group(2))
                elif "Interval: Discrete" in line and cur_w > 0:
                    m = re.search(r"\((\d+(?:\.\d+)?)\s*fps\)", line)
                    if m:
                        fps = float(m.group(1))
                        score = float(cur_w * cur_h * fps)
                        if cur_fmt == "mjpeg":
                            score *= 1.05
                        if score > best_score:
                            best_score = score
                            best_w = cur_w
                            best_h = cur_h
                            best_fps = int(fps)
                            best_fmt = cur_fmt or "mjpeg"

            if best_w > 0:
                is_usb = "usb" in name.lower() or "external" in name.lower()
                clean_name = name.split("(")[0].strip()
                cameras.append(
                    {
                        "device": dev,
                        "name": clean_name,
                        "width": best_w,
                        "height": best_h,
                        "fps": best_fps,
                        "format": best_fmt,
                        "is_usb": is_usb,
                        "score": best_score * (1.25 if is_usb else 1.0),
                    }
                )
        except (subprocess.CalledProcessError, FileNotFoundError):
            continue

    cameras.sort(key=lambda c: float(c["score"]), reverse=True)
    return cameras


def tr_msg(key: str, fallback: str) -> str:
    try:
        res = subprocess.run(
            ["arch-i18n", "get", key],
            capture_output=True,
            text=True,
            timeout=1,
            check=False,
        )
        msg = res.stdout.strip()
        if res.returncode == 0 and msg and msg != f"[{key}]":
            return msg
    except (OSError, subprocess.TimeoutExpired):
        pass
    return fallback


def prompt_camera_selection(
    cameras: list[dict[str, object]],
) -> dict[str, object] | None:
    if not cameras:
        return None

    lines: list[str] = []
    for cam in cameras:
        spec = f"{cam['width']}x{cam['height']} @ {cam['fps']}fps"
        lines.append(f"{cam['name']} ({cam['device']}) - {spec}")

    menu_input = "\n".join(lines)
    prompt = tr_msg("overlay_cam_prompt", "选择摄像头: ")
    try:
        proc = subprocess.Popen(
            ["fuzzel", "--dmenu", "--prompt", prompt],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True,
        )
        stdout, _ = proc.communicate(input=menu_input)
        chosen = stdout.strip()
        if not chosen:
            return None

        for cam in cameras:
            if str(cam["device"]) in chosen:
                return cam
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass

    return None


def find_camera_pids() -> list[int]:
    try:
        out = subprocess.check_output(
            ["pgrep", "-f", "wayland-app-id=pip-camera"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
        my_pid = os.getpid()
        return [
            int(p.strip())
            for p in out.splitlines()
            if p.strip() and int(p.strip()) != my_pid
        ]
    except (subprocess.CalledProcessError, ValueError):
        return []


def stop_camera() -> None:
    for pid in find_camera_pids():
        with contextlib.suppress(OSError):
            os.kill(pid, signal.SIGTERM)


def launch_camera(cam: dict[str, object]) -> None:
    stop_camera()
    dev = str(cam["device"])
    w = int(cam["width"])
    h = int(cam["height"])
    fps = int(cam["fps"])
    fmt = str(cam["format"])

    cmd = [
        "mpv",
        f"av://v4l2:{dev}",
        f"--demuxer-lavf-o=video_size={w}x{h},input_format={fmt},framerate={fps}",
        "--profile=low-latency",
        "--untimed",
        "--title=pip-camera",
        "--wayland-app-id=pip-camera",
        "--no-osc",
        "--no-osd-bar",
        "--border=no",
        "--autofit=384x216",
        "--vf=hflip",
    ]

    subprocess.Popen(
        cmd,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main() -> None:
    action = sys.argv[1] if len(sys.argv) > 1 else "start"

    if action in ("stop", "kill", "close", "hide"):
        stop_camera()
        return

    if action in ("status", "state"):
        print("open" if find_camera_pids() else "closed")
        return

    if action == "toggle":
        if find_camera_pids():
            stop_camera()
            return
        action = "start"

    cameras = list_v4l2_cameras()
    if not cameras:
        sys.stderr.write(tr_msg("overlay_cam_no_device", "未检测到可用视频设备") + "\n")
        sys.exit(1)

    if action == "select" or len(cameras) > 1:
        chosen = prompt_camera_selection(cameras)
        if chosen:
            launch_camera(chosen)
    else:
        launch_camera(cameras[0])


if __name__ == "__main__":
    main()
