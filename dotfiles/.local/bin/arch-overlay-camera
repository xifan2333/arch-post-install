#!/usr/bin/env -S PYTHONDONTWRITEBYTECODE=1 python3
# arch:summary=Webcam PIP floating HUD with automated best device discovery
# arch:args=[toggle | start | stop | status]
# arch:examples=arch overlay camera | arch overlay camera toggle
"""Camera picture-in-picture floating GTK application using GStreamer."""

from __future__ import annotations

import configparser
import contextlib
import math
import os
import signal
import subprocess
import sys
from pathlib import Path

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Gst", "1.0")
from gi.repository import Gdk, GLib, Gst, Gtk  # noqa: E402

CONFIG_DIR = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "screenrecord"
)
CONFIG_FILE = CONFIG_DIR / "camera.conf"

DEFAULTS = {
    "device": "auto",
    "width": "280",
    "height": "210",
    "fps": "30",
    "border_radius": "16",
    "border_width": "2",
    "border_color": "#7aa2f7",
    "mirror": "true",
}


def load_config() -> dict[str, str]:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    cfg = configparser.ConfigParser()
    data = dict(DEFAULTS)
    if CONFIG_FILE.is_file():
        with contextlib.suppress(Exception):
            cfg.read(CONFIG_FILE, encoding="utf-8")
            if cfg.has_section("camera"):
                for k, v in cfg.items("camera"):
                    data[k] = v
    return data


def save_config(data: dict[str, str]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    cfg = configparser.ConfigParser()
    cfg["camera"] = {k: str(v) for k, v in data.items()}
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        cfg.write(f)


def discover_best_camera(preferred: str = "auto") -> str:
    if preferred != "auto" and Path(preferred).exists():
        return preferred

    v4l_dir = Path("/sys/class/video4linux")
    if not v4l_dir.is_dir():
        return "/dev/video0"

    candidates: list[tuple[int, str]] = []
    for entry in v4l_dir.glob("video*"):
        dev_path = f"/dev/{entry.name}"
        if not Path(dev_path).exists():
            continue

        name = ""
        name_file = entry / "name"
        if name_file.is_file():
            with contextlib.suppress(OSError):
                name = name_file.read_text(encoding="utf-8").strip()

        score = 10
        if "integrated" in name.lower() or "internal" in name.lower():
            score = 5
        elif "usb" in name.lower() or "uvc" in name.lower():
            score = 20

        num = int(entry.name.replace("video", "") or 0)
        candidates.append((score * 100 - num, dev_path))

    if candidates:
        candidates.sort(key=lambda c: c[0], reverse=True)
        return candidates[0][1]

    return "/dev/video0"


class CameraApp(Gtk.Window):
    def __init__(self) -> None:
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.conf = load_config()
        self.device = discover_best_camera(self.conf.get("device", "auto"))
        self.pipeline: Gst.Pipeline | None = None
        self.current_surface: cairo.ImageSurface | None = None
        self.save_timer: int | None = None

        init_w = int(float(self.conf.get("width", "280")))
        init_h = int(float(self.conf.get("height", "210")))

        self.set_title("arch-overlay-camera")
        self.set_decorated(False)
        self.set_resizable(True)
        self.set_default_size(init_w, init_h)
        self.set_app_paintable(True)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
        )

        self.connect("draw", self.on_draw)
        self.connect("size-allocate", self.on_size_allocate)
        self.connect("button-press-event", self.on_button_press)
        self.connect("destroy", self.on_destroy)

        self.start_camera_pipeline(init_w, init_h)
        self.show_all()

    def start_camera_pipeline(self, target_w: int, target_h: int) -> None:
        if self.pipeline:
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None

        mirror = self.conf.get("mirror", "true").lower() in ("true", "1", "yes")
        flip = "videoflip method=horizontal-flip ! " if mirror else ""
        fps = int(float(self.conf.get("fps", "30")))

        caps_filter = (
            f"video/x-raw,format=BGRx,"
            f"width={target_w},height={target_h},"
            f"framerate={fps}/1"
        )
        pipeline_str = (
            f"v4l2src device={self.device} ! "
            f"videoconvert ! {flip}"
            f"videoscale ! {caps_filter} ! "
            f"appsink name=sink emit-signals=true max-buffers=1 drop=true sync=false"
        )

        try:
            self.pipeline = Gst.parse_launch(pipeline_str)  # type: ignore[assignment]
            sink = self.pipeline.get_by_name("sink")  # type: ignore[union-attr]
            sink.connect("new-sample", self.on_new_sample)
            self.pipeline.set_state(Gst.State.PLAYING)  # type: ignore[union-attr]
        except (GLib.Error, OSError):
            self.pipeline = None

    def on_new_sample(self, sink: Gst.Element) -> Gst.FlowReturn:
        sample = sink.emit("pull-sample")
        if not sample:
            return Gst.FlowReturn.ERROR

        buf = sample.get_buffer()
        caps = sample.get_caps()
        if not buf or not caps:
            return Gst.FlowReturn.OK

        success, map_info = buf.map(Gst.MapFlags.READ)
        if not success:
            return Gst.FlowReturn.OK

        struct = caps.get_structure(0)
        width = struct.get_int("width")[1]
        height = struct.get_int("height")[1]
        stride = cairo.ImageSurface.format_stride_for_width(cairo.FORMAT_RGB24, width)

        try:
            surface = cairo.ImageSurface.create_for_data(
                bytearray(map_info.data),
                cairo.FORMAT_RGB24,
                width,
                height,
                stride,
            )
            self.current_surface = surface
            self.queue_draw()
        finally:
            buf.unmap(map_info)

        return Gst.FlowReturn.OK

    def on_size_allocate(self, _widget: Gtk.Widget, allocation: Gdk.Rectangle) -> None:
        self.conf["width"] = str(allocation.width)
        self.conf["height"] = str(allocation.height)

        if self.save_timer is not None:
            GLib.source_remove(self.save_timer)
        self.save_timer = GLib.timeout_add(1000, self._debounced_save)

        # Update input shape for natural pass-through
        rect = cairo.RectangleInt(0, 0, allocation.width, allocation.height)
        self.input_shape_combine_region(cairo.Region(rect))

    def _debounced_save(self) -> bool:
        save_config(self.conf)
        self.save_timer = None
        return False

    def on_draw(self, widget: Gtk.Widget, cr: cairo.Context) -> bool:
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        radius = float(self.conf.get("border_radius", "16"))
        b_width = float(self.conf.get("border_width", "2"))

        # Clear canvas to 100% transparent
        cr.set_source_rgba(0, 0, 0, 0)
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.paint()

        # Rounded rectangle path
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.new_sub_path()
        cr.arc(w - radius, radius, radius, -math.pi / 2, 0)
        cr.arc(w - radius, h - radius, radius, 0, math.pi / 2)
        cr.arc(radius, h - radius, radius, math.pi / 2, math.pi)
        cr.arc(radius, radius, radius, math.pi, 3 * math.pi / 2)
        cr.close_path()

        cr.save()
        cr.clip()

        if self.current_surface:
            cr.set_source_surface(self.current_surface, 0, 0)
            cr.paint()
        else:
            # Standby placeholder
            cr.set_source_rgba(0.1, 0.1, 0.15, 0.85)
            cr.paint()

        cr.restore()

        # Draw decorative border
        if b_width > 0:
            cr.set_source_rgba(0.48, 0.64, 0.97, 0.8)
            cr.set_line_width(b_width)
            cr.new_sub_path()
            cr.arc(w - radius, radius, radius, -math.pi / 2, 0)
            cr.arc(w - radius, h - radius, radius, 0, math.pi / 2)
            cr.arc(radius, h - radius, radius, math.pi / 2, math.pi)
            cr.arc(radius, radius, radius, math.pi, 3 * math.pi / 2)
            cr.close_path()
            cr.stroke()

        return False

    def on_button_press(self, _widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        if event.type == Gdk.EventType._2BUTTON_PRESS and event.button == 1:
            # Double click: toggle mirror mode
            curr_mirror = self.conf.get("mirror", "true").lower() in (
                "true",
                "1",
                "yes",
            )
            self.conf["mirror"] = "false" if curr_mirror else "true"
            save_config(self.conf)
            w = self.get_allocated_width()
            h = self.get_allocated_height()
            self.start_camera_pipeline(w, h)
            return True

        if event.button == 1:
            # Native Wayland move drag
            self.begin_move_drag(
                event.button, int(event.x_root), int(event.y_root), event.time
            )
            return True
        return False

    def on_destroy(self, _widget: Gtk.Widget) -> None:
        if self.pipeline:
            self.pipeline.set_state(Gst.State.NULL)
            self.pipeline = None
        if Gtk.main_level() > 0:
            Gtk.main_quit()


def find_running_pids() -> list[int]:
    try:
        out = subprocess.check_output(["pgrep", "-f", "arch-overlay-camera"], text=True)
        my_pid = os.getpid()
        return [
            int(p.strip())
            for p in out.splitlines()
            if p.strip() and int(p.strip()) != my_pid
        ]
    except (subprocess.CalledProcessError, ValueError):
        return []


def cmd_toggle() -> None:
    pids = find_running_pids()
    if pids:
        for p in pids:
            with contextlib.suppress(OSError):
                os.kill(p, signal.SIGTERM)
    else:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve())],
            start_new_session=True,
        )


def main() -> None:
    GLib.set_prgname("arch-overlay-camera")
    Gst.init(None)

    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "toggle":
        cmd_toggle()
        return
    if action in ("stop", "hide", "close"):
        for p in find_running_pids():
            with contextlib.suppress(OSError):
                os.kill(p, signal.SIGTERM)
        return
    if action in ("status", "state"):
        print("open" if find_running_pids() else "closed")
        return

    signal.signal(signal.SIGINT, lambda _s, _f: Gtk.main_quit())
    signal.signal(signal.SIGTERM, lambda _s, _f: Gtk.main_quit())

    _app = CameraApp()
    Gtk.main()


if __name__ == "__main__":
    main()
