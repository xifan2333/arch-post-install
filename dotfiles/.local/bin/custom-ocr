#!/usr/bin/env bash
#
# @name         custom-ocr
# @summary      Extract text from image file or stdin stream using newbee-ocr
# @version      1.0.0
# @deps         nbocr, jq
#
# @description  Offline OCR text extractor.
#               Reads image path or standard input stream and outputs recognized text to stdout.
#
# @usage        custom-ocr [options] [<image-path> | -]
#
# @options
#   -h, --help  Show this help message and exit
#
# @stdin        Raw image PNG/JPEG data stream when '-' or piped input is used
# @stdout       Extracted and reconstructed plain text
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-ocr image.png
#   grim -g "$(slurp)" - | custom-ocr - | wl-copy

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel reports Esc as 1; every other unsuccessful exit is an error.
pick() {
	local selection rc
	if selection=$(fuzzel --dmenu "$@"); then
		printf '%s' "$selection"
	else
		rc=$?
		((rc == 1)) || {
			((rc == 130)) && exit 130
			die 1 cli_picker_failed
		}
	fi
}

minimum_confidence=0.60
main() (
	(($# <= 1)) || usage_error
	case "${1:-}" in -h | --help)
		t help_ocr
		return
		;;
	-*) [[ "$1" == - ]] || usage_error ;; esac
	local source="${1:--}" tmp_dir img result text
	if [[ "$source" == - ]]; then
		[[ ! -t 0 ]] || usage_error
	else [[ -f "$source" ]] || usage_error; fi
	require nbocr jq
	tmp_dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-ocr.XXXXXX")
	trap 'rm -rf -- "$tmp_dir"' EXIT
	img="$tmp_dir/input.png"
	result="$tmp_dir/result.json"
	if [[ "$source" == - ]]; then cat >"$img"; else cp -- "$source" "$img"; fi
	[[ -s "$img" ]] || die 1 cli_unavailable name=stdin
	nbocr recognize "$img" --language zh --format json --output "$result" >/dev/null
	jq -e '.results | type == "array"' "$result" >/dev/null
	text="$(jq -r --argjson minimum "$minimum_confidence" '
		def median: sort as $sorted
			| $sorted[(($sorted | length) / 2 | floor)];
		[.results[] | select(.confidence >= $minimum)] as $items
		| if ($items | length) == 0 then ""
		  else ($items | map(.bbox.height) | median) as $height
		  | (($height * 0.65) | if . < 8 then 8 else . end) as $row_height
		  | ($items | sort_by(.bbox.y, .bbox.x)) as $sorted
		  | reduce $sorted[] as $it (
			  [];
			  if length == 0 then [[$it]]
			  elif ($it.bbox.y - (.[-1][0].bbox.y)) <= $row_height then .[-1] += [$it]
			  else . + [[$it]]
			  end
			)
		  | map(sort_by(.bbox.x) | map(.text) | join(" "))
		  | join("\n")
		  end
	' "$result")"

	if [[ -n "$text" ]]; then printf '%s\n' "$text"; fi
)
main "$@"
