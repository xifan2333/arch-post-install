#!/usr/bin/env bash
# arch:summary=Manage, switch, or select desktop wallpapers
# arch:args=[menu | current | list | random | search [query] | set <path|id|url>]
# arch:examples=x-wall current | x-wall random | x-wall set ~/Pictures/wallpapers/a.jpg
set -euo pipefail

wall_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/wallpapers"
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper/current"
mkdir -p "$wall_dir"

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$(x-i18n get wallpaper_notify_title 2>/dev/null || echo "Wallpaper")" "$1"
	fi
}

fail() {
	notify "$(x-i18n get wallpaper_failed 2>/dev/null || echo "Wallpaper failed")"
	printf '%s\n' "$1" >&2
	exit 1
}

dmenu() {
	local prompt="$1"
	shift
	if command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu --prompt "$prompt" "$@" || true
	elif command -v bemenu >/dev/null 2>&1; then
		bemenu -p "$prompt" || true
	else
		head -n 1
	fi
}

set_wallpaper() {
	local img="$1" tmp old_pids
	[[ -f "$img" ]] || fail "Wallpaper file not found: $img"
	old_pids=$(pgrep -x swaybg || true)

	if command -v uwsm >/dev/null 2>&1; then
		uwsm app -s b -S both -- swaybg -i "$img" -m fill >/dev/null 2>&1 &
	else
		swaybg -i "$img" -m fill >/dev/null 2>&1 &
	fi

	sleep 0.2
	if [[ -n "$old_pids" ]]; then
		kill "$old_pids" 2>/dev/null || true
	fi

	mkdir -p "$(dirname "$state_file")"
	tmp="$state_file.tmp.$$"
	printf '%s\n' "$img" >"$tmp"
	mv -f "$tmp" "$state_file"
	printf '%s\n' "$img"
}

get_current() {
	if [[ -f "$state_file" ]]; then
		cat "$state_file"
	fi
}

list_local() {
	find "$wall_dir" -maxdepth 2 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) 2>/dev/null | sort || true
}

apply_target() {
	local arg="$1"
	arg="${arg/#\~\//$HOME/}"

	if [[ -f "$arg" ]]; then
		set_wallpaper "$arg"
		return 0
	fi

	# If argument is a URL or Wallhaven ID, delegate to x-wallhaven download
	if [[ -x "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/x-wallhaven" ]]; then
		local downloaded
		downloaded="$("$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/x-wallhaven" download "$arg" 2>/dev/null || true)"
		if [[ -n "$downloaded" && -f "$downloaded" ]]; then
			set_wallpaper "$downloaded"
			return 0
		fi
	fi

	fail "$(x-i18n get wallpaper_invalid_target 2>/dev/null || echo "Invalid wallpaper target")"
}

random_local() {
	local img
	img="$(list_local | shuf -n 1)"
	[[ -n "$img" ]] || fail "No wallpapers found in $wall_dir"
	set_wallpaper "$img"
}

select_local_menu() {
	local current files
	current="$(get_current)"
	files="$(list_local)"
	[[ -n "$files" ]] || fail "No wallpapers found in $wall_dir"

	local use_icons=0
	if command -v fuzzel >/dev/null 2>&1; then
		use_icons=1
	fi

	local thumb_dir="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper/thumbs"
	if [[ "$use_icons" -eq 1 ]] && command -v magick >/dev/null 2>&1; then
		mkdir -p "$thumb_dir"
		local gen_jobs=0
		while IFS= read -r f; do
			[[ -n "$f" ]] || continue
			local th_name th_file
			th_name="$(printf '%s' "$f" | md5sum | awk '{print $1}').png"
			th_file="$thumb_dir/$th_name"
			if [[ ! -f "$th_file" || "$f" -nt "$th_file" ]]; then
				(magick "$f" -thumbnail 96x96 "$th_file" 2>/dev/null || rm -f "$th_file") &
				gen_jobs=$((gen_jobs + 1))
				if ((gen_jobs >= 8)); then
					wait -n 2>/dev/null || true
					gen_jobs=$((gen_jobs - 1))
				fi
			fi
		done <<<"$files"
		wait
	fi

	local menu_items=()
	declare -A label_to_file
	while IFS= read -r f; do
		[[ -n "$f" ]] || continue
		local name prefix label th_name th_file
		name="$(basename "$f")"
		if [[ "$f" == "$current" ]]; then
			prefix="* "
		else
			prefix="  "
		fi

		label="${prefix}${name}"
		if [[ -n "${label_to_file["$label"]:-}" ]]; then
			label="${prefix}${f#"$wall_dir"/}"
		fi
		label_to_file["$label"]="$f"

		th_name="$(printf '%s' "$f" | md5sum | awk '{print $1}').png"
		th_file="$thumb_dir/$th_name"

		if [[ "$use_icons" -eq 1 && -f "$th_file" ]]; then
			menu_items+=("${label}\0icon\x1f${th_file}")
		else
			local fallback_label="${prefix}󰋩  ${name}"
			menu_items+=("$fallback_label")
			label_to_file["$fallback_label"]="$f"
		fi
	done <<<"$files"

	local pick
	pick="$(
		for item in "${menu_items[@]}"; do
			printf '%b\n' "$item"
		done | dmenu "$(x-i18n get wallpaper_pick_prompt 2>/dev/null || echo "Select Wallpaper: ")" --lines 15
	)"
	[[ -n "$pick" ]] || return 0

	local target="${label_to_file["$pick"]:-}"
	if [[ -z "$target" ]]; then
		local clean="$pick"
		clean="${clean%%\0*}"
		clean="${clean#\*}"
		clean="${clean# }"
		clean="${clean#󰋩}"
		clean="${clean#"${clean%%[![:space:]]*}"}"
		while IFS= read -r f; do
			if [[ "$(basename "$f")" == "$clean" || "${f#"$wall_dir"/}" == "$clean" ]]; then
				target="$f"
				break
			fi
		done <<<"$files"
	fi

	if [[ -n "$target" && -f "$target" ]]; then
		set_wallpaper "$target"
	fi
}

interactive_menu() {
	local rand_label local_label search_label
	rand_label="$(x-i18n get wallpaper_mode_random 2>/dev/null || echo "Random")"
	local_label="$(x-i18n get wallpaper_mode_local 2>/dev/null || echo "Local")"
	search_label="$(x-i18n get wallpaper_mode_search 2>/dev/null || echo "Search")"

	local choices=(
		"󰋩  $local_label"
		"󰒝  $rand_label"
		"󰍉  $search_label"
	)

	local choice
	choice="$(printf '%s\n' "${choices[@]}" | dmenu "$(x-i18n get wallpaper_mode_prompt 2>/dev/null || echo "Wallpaper Mode: ")" --lines 5)"
	[[ -n "$choice" ]] || return 0

	case "$choice" in
	*"$local_label") select_local_menu ;;
	*"$rand_label") random_local ;;
	*"$search_label")
		local dl=""
		if command -v x-wallhaven >/dev/null 2>&1; then
			dl="$(x-wallhaven menu || true)"
		elif [[ -x "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/x-wallhaven" ]]; then
			dl="$("$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/x-wallhaven" menu || true)"
		fi
		[[ -n "$dl" && -f "$dl" ]] && set_wallpaper "$dl"
		;;
	esac
}

main() {
	local cmd="${1:-menu}"
	case "$cmd" in
	menu) interactive_menu ;;
	current | get) get_current ;;
	list) list_local ;;
	random) random_local ;;
	search)
		shift
		local dl=""
		if command -v x-wallhaven >/dev/null 2>&1; then
			dl="$(x-wallhaven menu "${1:-}" || true)"
		elif [[ -x "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/x-wallhaven" ]]; then
			dl="$("$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/x-wallhaven" menu "${1:-}" || true)"
		fi
		[[ -n "$dl" && -f "$dl" ]] && set_wallpaper "$dl"
		;;
	set)
		shift
		[[ $# -ge 1 ]] || {
			printf 'Usage: x-wall set <path|id|url>\n' >&2
			exit 1
		}
		apply_target "$1"
		;;
	-h | --help | help)
		printf 'Usage: x-wall [menu | current | list | random | search [query] | set <path|id|url>]\n'
		;;
	*)
		apply_target "$cmd"
		;;
	esac
}

main "$@"
