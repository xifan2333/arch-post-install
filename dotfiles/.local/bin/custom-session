#!/usr/bin/env bash
#
# @name         custom-session
# @summary      Launch desktop applications and control their systemd user services
# @deps         uwsm, systemctl, custom-i18n
# @usage        custom-session launch [uwsm-options] -- command [args...]
#               custom-session start|toggle unit.service [uwsm-options] -- command [args...]
#               custom-session state|stop unit.service
#               custom-session reload unit-pattern...
#               custom-session signal signal unit-pattern...
#               custom-session signal-app signal executable
# @stdout       Unit state for state; scope applications retain their stdout
# @stderr       Launch and lifecycle errors
# @examples     custom-session launch -- ftty
#               custom-session signal SIGUSR1 'app-*-ftty@*.service'

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1"
	custom-i18n get cli_failed "command=${0##*/}" "line=$2" >&2
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
die() {
	local rc="$1"
	shift
	custom-i18n get "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"; done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
unit_argument() {
	[[ "$1" == *.service && "$1" != -* && "$1" != */* && "$1" != *[[:space:]]* ]] || usage_error
	if [[ "${2:-exact}" == exact ]]; then
		[[ "$1" != *[\*\?\[]* ]] || usage_error
	fi
}
state() {
	local properties key value load='' active=''
	require systemctl
	properties=$(systemctl --user show --property=LoadState,ActiveState -- "$1")
	while IFS='=' read -r key value; do
		case "$key" in LoadState) load="$value" ;; ActiveState) active="$value" ;; esac
	done <<<"$properties"
	case "$load:$active" in
	not-found:inactive | loaded:active | loaded:inactive | loaded:activating | loaded:deactivating | loaded:failed) printf '%s\n' "$active" ;;
	*) die 1 cli_unavailable "name=$1:$load:$active" ;;
	esac
}
launch() {
	local arg i
	local -a options=() command=()
	while (($#)) && [[ "$1" != -- ]]; do
		options+=("$1")
		shift
	done
	(($# >= 2)) || usage_error
	shift
	command=("$@")
	require uwsm "${command[0]}"
	# UWSM currently invokes systemd-run without --expand-environment=no.
	# Preserve literal dollar signs in application arguments across that layer.
	for ((i = 1; i < ${#command[@]}; i++)); do
		arg="${command[$i]}"
		command[i]="${arg//\$/\$\$}"
	done
	uwsm app -t service -p PartOf=graphical-session.target "${options[@]}" -- "${command[@]}"
}
stop() {
	local current
	current=$(state "$1")
	[[ "$current" != inactive ]] || return 0
	systemctl --user stop -- "$1"
}
start() {
	local unit="$1" current
	shift
	current=$(state "$unit")
	case "$current" in active | activating) return 0 ;; deactivating) die 1 cli_unavailable "name=$unit" ;;
	failed) systemctl --user reset-failed -- "$unit" ;; esac
	launch -s b -u "$unit" "$@"
}
apply_to_running() {
	local action="$1" signal="$2" rows unit rest pid executable=""
	shift 2
	if [[ "$action" == signal-app ]]; then
		executable="$1"
		shift
	fi
	require systemctl
	rows=$(systemctl --user list-units --type=service --state=running --plain --no-legend --no-pager -- "$@")
	while read -r unit rest; do
		[[ -n "$unit" ]] || continue
		case "$action" in
		reload) systemctl --user reload -- "$unit" ;;
		signal) systemctl --user kill --kill-whom=main --signal="$signal" -- "$unit" ;;
		signal-app)
			pid=$(systemctl --user show --property=MainPID --value -- "$unit")
			[[ "$pid" =~ ^[0-9]+$ ]] || die 1 cli_unavailable "name=$unit"
			[[ -e "/proc/$pid/exe" ]] || continue
			local path
			path=$(readlink "/proc/$pid/exe")
			[[ "${path##*/}" == "$executable" ]] || continue
			systemctl --user kill --kill-whom=main --signal="$signal" -- "$unit"
			;;
		esac
	done <<<"$rows"
}
main() {
	local action="${1:-}" unit current
	(($#)) || usage_error
	shift
	case "$action" in
	-h | --help)
		(($# == 0)) || usage_error
		custom-i18n get help_session
		;;
	launch) launch "$@" ;;
	state | stop)
		(($# == 1)) || usage_error
		unit_argument "$1"
		"$action" "$1"
		;;
	start | toggle)
		(($# >= 3)) || usage_error
		unit="$1"
		unit_argument "$unit"
		shift
		if [[ "$action" == toggle ]]; then
			current=$(state "$unit")
			case "$current" in active | activating)
				stop "$unit"
				return
				;;
			esac
		fi
		start "$unit" "$@"
		;;
	signal-app)
		(($# == 2)) || usage_error
		[[ "$1" =~ ^(SIG)?[A-Z0-9+]+$ && "$2" != */* && -n "$2" ]] || usage_error
		apply_to_running signal-app "$1" "$2" 'app-*.service' 'custom-*.service'
		;;
	reload)
		(($#)) || usage_error
		for unit in "$@"; do unit_argument "$unit" pattern; done
		apply_to_running reload '' "$@"
		;;
	signal)
		(($# >= 2)) || usage_error
		[[ "$1" =~ ^(SIG)?[A-Z0-9+]+$ ]] || usage_error
		local signal="$1"
		shift
		for unit in "$@"; do unit_argument "$unit" pattern; done
		apply_to_running signal "$signal" "$@"
		;;
	*) usage_error ;;
	esac
}
main "$@"
