#!/usr/bin/env bash
#
# @name         custom-clipboard
# @summary      Manage, interactively select, or clear clipboard history via cliphist
# @version      1.0.0
# @deps         cliphist, wl-copy
#
# @description  Clipboard history manager for Wayland desktop.
#               Supports fuzzy selection launcher, history listing, and history clearing.
#
# @usage        custom-clipboard [options] [command]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   menu        Open interactive fuzzy clipboard launcher via Fuzzel (default)
#   list        Output raw clipboard history list to stdout
#   clear       Wipe and clear all clipboard history
#
# @stdin        Accepts piped input where applicable
# @stdout       Clipboard history list
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-clipboard
#   custom-clipboard menu
#   custom-clipboard list
#   custom-clipboard clear

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel reports Esc as 1; every other unsuccessful exit is an error.
pick() {
	local selection rc
	if selection=$(fuzzel --dmenu "$@"); then
		printf '%s' "$selection"
	else
		rc=$?
		((rc == 1)) || {
			((rc == 130)) && exit 130
			die 1 cli_picker_failed
		}
	fi
}

menu() (
	local history prompt clear choice index tmp
	local -a entries=()
	require cliphist fuzzel
	history=$(cliphist list)
	clear=$(t clip_clear_option)
	prompt=$(t clip_prompt)
	entries+=("$clear")
	if [[ -n "$history" ]]; then
		while IFS= read -r line; do entries+=("$line"); done <<<"$history"
	fi
	choice=$(printf '%s\n' "${entries[@]}" | pick --prompt "$prompt" --index)
	[[ -n "$choice" ]] || return 0
	[[ "$choice" =~ ^[0-9]+$ ]] || die 1 cli_picker_failed
	index=$((10#$choice))
	((index < ${#entries[@]})) || die 1 cli_picker_failed
	if ((index == 0)); then
		cliphist wipe
		return
	fi
	require wl-copy
	tmp=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-clipboard.XXXXXX")
	trap 'rm -f -- "$tmp"' EXIT
	# Decode completely before changing the clipboard, including binary entries.
	printf '%s' "${entries[$index]}" | cliphist decode >"$tmp"
	wl-copy <"$tmp"
)
main() {
	(($# <= 1)) || usage_error
	case "${1:-menu}" in
	-h | --help) t help_clipboard ;;
	menu) menu ;;
	list)
		require cliphist
		cliphist list
		;;
	clear | wipe)
		require cliphist
		cliphist wipe
		;;
	*) usage_error ;;
	esac
}
main "$@"
