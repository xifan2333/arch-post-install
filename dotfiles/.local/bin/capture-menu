#!/bin/bash
# User-owned capture menu. All capture mutations go through capture-router.

set -o pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
ROUTER="$SCRIPT_DIR/capture-router"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/i18n-core"

menu_select() {
    local prompt="$1"
    shift
    omarchy menu select "$prompt" "$@" -- --width 360 --maxheight 630
}

webcam_devices() {
    command -v v4l2-ctl > /dev/null 2>&1 || return 1
    v4l2-ctl --list-devices 2> /dev/null | while IFS= read -r line; do
        if [[ "$line" != $'\t'* && -n "$line" ]]; then
            local name="$line"
            local device
            IFS= read -r device || break
            device=$(printf '%s' "$device" | tr -d '\t' | head -1)
            [ -n "$device" ] && printf '%s  %s\n' "$device" "$name"
        fi
    done
}

start_webcam_recording() {
    local devices count selection device
    devices=$(webcam_devices || true)
    count=$(printf '%s\n' "$devices" | grep -c . 2> /dev/null || true)
    if [ -z "$devices" ] || [ "${count:-0}" -eq 0 ]; then
        command -v notify-send > /dev/null 2>&1 &&
            notify-send -u critical \
                "$(msg capture_notify_title)" \
                "$(msg capture_notify_no_webcam)"
        return 1
    fi

    if [ "$count" -eq 1 ]; then
        selection="$devices"
    else
        local device_options=()
        mapfile -t device_options <<< "$devices"
        selection=$(omarchy menu select "Select webcam" \
            "${device_options[@]}" -- --width 480 --maxheight 630)
    fi
    [ -n "$selection" ] || return 0
    device=${selection%%  *}

    "$ROUTER" recording start \
        --with-desktop-audio \
        --with-microphone-audio \
        --with-webcam \
        --webcam-device="$device"
}

main() {
    local state choice
    local title="Capture"
    local stop_recording="󰓛  Stop local recording"
    local stop_livestream="󰓛  Stop livestream"
    local no_audio="  Record with no audio"
    local desktop_audio="  Record with desktop audio"
    local desktop_mic="  Record with desktop + microphone audio"
    local webcam="󰄀  Record with desktop + microphone + webcam"
    local livestream="󰑋  Start livestream"
    local config="󰒓  Livestream configuration"
    local overlays="󰌪  Capture overlays"

    state=$("$ROUTER" status)
    case "$state" in
        recording)
            choice=$(menu_select "$title" "$stop_recording" "$overlays")
            ;;
        livestream)
            choice=$(menu_select "$title" \
                "$stop_livestream" "$config" "$overlays")
            ;;
        *)
            choice=$(menu_select "$title" \
                "$no_audio" "$desktop_audio" "$desktop_mic" "$webcam" \
                "$livestream" "$config" "$overlays")
            ;;
    esac

    case "$choice" in
        "$stop_recording") "$ROUTER" recording stop ;;
        "$stop_livestream") "$ROUTER" livestream stop ;;
        "$no_audio") "$ROUTER" recording start ;;
        "$desktop_audio") "$ROUTER" recording start --with-desktop-audio ;;
        "$desktop_mic")
            "$ROUTER" recording start --with-desktop-audio --with-microphone-audio
            ;;
        "$webcam") start_webcam_recording ;;
        "$livestream") "$ROUTER" livestream start portal ;;
        "$config") "$ROUTER" config ;;
        "$overlays") "$ROUTER" overlays ;;
        *) return 0 ;;
    esac
}

main "$@"
