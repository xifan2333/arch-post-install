#!/usr/bin/env bash
# arch:summary=Capture selected screen area and pin floating preview with imv
# arch:examples=arch cap preview
set -euo pipefail

geometry="$(slurp 2>/dev/null || true)"
[[ -n "$geometry" ]] || exit 0

temp_dir="${XDG_RUNTIME_DIR:-/tmp}/screenshots"
mkdir -p "$temp_dir"

filepath="$temp_dir/preview-$(date +%Y%m%d_%H%M%S).png"

grim -g "$geometry" "$filepath"
wl-copy <"$filepath"

if command -v imv >/dev/null 2>&1; then
	imv -w "Screenshot Preview" "$filepath" >/dev/null 2>&1 &
fi
