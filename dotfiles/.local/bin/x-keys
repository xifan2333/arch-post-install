#!/usr/bin/env bash
# arch:summary=Toggle or control keystroke HUD overlay via wayhud
# arch:args=[toggle | start | stop | status]
# arch:examples=x-keys toggle | x-keys start | x-keys stop
set -euo pipefail

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/wayhud"
KEYS_PID_FILE="$RUNTIME_DIR/keys.pid"

is_keys_running() {
	if [[ -f "$KEYS_PID_FILE" ]]; then
		local pid
		pid="$(cat "$KEYS_PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
	fi
	pgrep -f "wayhud[[:space:]]+-n[[:space:]]+keys\b" >/dev/null 2>&1
}

stop_keys() {
	if [[ -f "$KEYS_PID_FILE" ]]; then
		local pid
		pid="$(cat "$KEYS_PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			kill -TERM "$pid" 2>/dev/null || true
		fi
		rm -f "$KEYS_PID_FILE"
	fi
	pkill -f "wayhud[[:space:]]+-n[[:space:]]+keys\b" 2>/dev/null || true
}

start_keys() {
	if ! command -v wayhud >/dev/null 2>&1; then
		printf 'Error: wayhud is not installed\n' >&2
		exit 1
	fi
	stop_keys
	mkdir -p "$RUNTIME_DIR"
	wayhud -n keys >/dev/null 2>&1 &
	local pid=$!
	printf '%s\n' "$pid" >"$KEYS_PID_FILE"
}

toggle_keys() {
	if is_keys_running; then
		stop_keys
	else
		start_keys
	fi
}

main() {
	local act="${1:-toggle}"
	case "$act" in
	start) start_keys ;;
	stop) stop_keys ;;
	toggle) toggle_keys ;;
	status)
		if is_keys_running; then
			printf 'active\n'
		else
			printf 'inactive\n'
		fi
		;;
	-h | --help | help)
		printf 'Usage: x-keys [toggle | start | stop | status]\n'
		;;
	*)
		toggle_keys
		;;
	esac
}

main "$@"
