#!/usr/bin/env bash
# arch:summary=Manage, switch, search, or interactively select desktop wallpapers
# arch:args=[menu | current | random | search [query] | set <path|id|url> | <path|id|url>]
# arch:examples=arch wallpaper | arch wallpaper current | arch wallpaper random | arch wallpaper set ~/Pictures/wallpapers/a.jpg
set -euo pipefail

wall_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/wallpapers"
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper/current"
wallhaven_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/wallhaven.json"
api_base="https://wallhaven.cc/api/v1"
max_bytes=52428800

mkdir -p "$wall_dir"

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$(arch-i18n get wallpaper_notify_title)" "$1"
	fi
}

fail() {
	notify "$(arch-i18n get wallpaper_failed)"
	printf '%s\n' "$1" >&2
	exit 1
}

cfgval() {
	local key="$1" default="$2" val=""
	if [[ -f "$wallhaven_cfg" ]] && command -v jq >/dev/null 2>&1; then
		val="$(jq -r --arg k "$key" '.[$k] // empty' "$wallhaven_cfg" 2>/dev/null || true)"
	fi
	if [[ -n "$val" ]]; then
		printf '%s' "$val"
	else
		printf '%s' "$default"
	fi
}

dmenu() {
	local prompt="$1"
	shift
	if command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu --prompt "$prompt" "$@" || true
	elif command -v bemenu >/dev/null 2>&1; then
		bemenu -p "$prompt" || true
	else
		head -n 1
	fi
}

get_current() {
	if [[ -s "$state_file" ]]; then
		cat "$state_file"
	else
		printf 'none\n'
	fi
}

wallhaven_image_url() {
	local id="$1" key url
	key="$(cfgval apiKey "")"
	url="$api_base/w/${id}"
	[[ -n "$key" ]] && url="${url}?apikey=${key}"
	curl -fsSL --max-time 30 "$url" 2>/dev/null | jq -r '.data.path // empty' 2>/dev/null || true
}

download_image() {
	local url="$1" ext dest tmp
	mkdir -p "$wall_dir"

	ext="${url##*.}"
	case "$ext" in
	jpg | jpeg | png | webp) ;;
	*) ext="jpg" ;;
	esac

	rm -f "$wall_dir"/wallpaper.*
	dest="$wall_dir/wallpaper.$ext"
	tmp="$dest.part.$$"
	if ! curl -fsSL --max-time 300 --max-filesize "$max_bytes" -o "$tmp" "$url"; then
		rm -f "$tmp"
		return 1
	fi
	mv -f "$tmp" "$dest"
	printf '%s' "$dest"
}

set_wallpaper() {
	local img="$1" tmp old_pids
	old_pids=$(pgrep -x swaybg || true)

	if command -v uwsm >/dev/null 2>&1; then
		uwsm app -s b -S both -- swaybg -i "$img" -m fill >/dev/null 2>&1 &
	else
		swaybg -i "$img" -m fill >/dev/null 2>&1 &
	fi

	sleep 0.2
	if [[ -n "$old_pids" ]]; then
		kill "$old_pids" 2>/dev/null || true
	fi

	mkdir -p "$(dirname "$state_file")"
	tmp="$state_file.tmp.$$"
	printf '%s\n' "$img" >"$tmp"
	mv -f "$tmp" "$state_file"
}

apply_target() {
	local arg="$1" img="" id=""
	arg="${arg/#\~\//$HOME/}"

	if [[ -f "$arg" ]]; then
		img="$arg"
	elif [[ "$arg" =~ ^https?://(www\.)?wallhaven\.cc/w/([A-Za-z0-9]+)/?$ ]]; then
		id="${BASH_REMATCH[2]}"
		img="$(wallhaven_image_url "$id")"
		[[ -n "$img" ]] || fail "Failed to resolve Wallhaven wallpaper $id"
		if ! img="$(download_image "$img")"; then
			fail "Failed to download wallpaper"
		fi
	elif [[ "$arg" =~ ^[A-Za-z0-9]+$ ]]; then
		img="$(wallhaven_image_url "$arg")"
		[[ -n "$img" ]] || fail "Failed to resolve Wallhaven wallpaper $arg"
		if ! img="$(download_image "$img")"; then
			fail "Failed to download wallpaper"
		fi
	elif [[ "$arg" =~ ^https?:// ]]; then
		if ! img="$(download_image "$arg")"; then
			fail "Failed to download wallpaper"
		fi
	else
		fail "$(arch-i18n get wallpaper_invalid_target)"
	fi

	[[ -f "$img" ]] || fail "Wallpaper file not found: $img"
	set_wallpaper "$img"
}

fetch_thumb() {
	local id="$1" url="$2" dir="$3"
	curl -fsSL --connect-timeout 3 --max-time 8 "$url" 2>/dev/null |
		timeout 8 magick jpeg:- -thumbnail 96x96 "$dir/$id.png" 2>/dev/null || return 1
	printf '%s' "$dir/$id.png"
}

search_wallhaven_thumbs() {
	local query="$1" page="${2:-1}" thumbs_dir="$3"
	local key
	key="$(cfgval apiKey "")"

	local curl_args=(-fsSL --max-time 30 -G)
	[[ -n "$query" ]] && curl_args+=(--data-urlencode "q=$query")
	curl_args+=(--data-urlencode "categories=$(cfgval categories 111)")
	curl_args+=(--data-urlencode "purity=$(cfgval purity 110)")
	curl_args+=(--data-urlencode "sorting=$(cfgval sorting date_added)")
	curl_args+=(--data-urlencode "order=$(cfgval order desc)")
	curl_args+=(--data-urlencode "page=$page")
	curl_args+=(--data-urlencode "atleast=$(cfgval atleast 1920x1080)")
	[[ -n "$key" ]] && curl_args+=(--data-urlencode "apikey=$key")

	local resp
	if ! resp="$(curl --connect-timeout 5 --max-time 20 "${curl_args[@]}" "$api_base/search" 2>/dev/null)"; then
		return 1
	fi

	mkdir -p "$thumbs_dir"
	local count
	count="$(printf '%s' "$resp" | jq -r '(.data // []) | length' 2>/dev/null || echo 0)"
	printf '#count %s\n' "$count"

	local idx=0
	while IFS=$'\t' read -r id resolution thumburl; do
		[[ -n "$id" && -n "$thumburl" ]] || continue
		(
			if png="$(fetch_thumb "$id" "$thumburl" "$thumbs_dir")"; then
				printf '%s\t%s\t%s\n' "$id" "$resolution" "$png"
			fi
		) &
		idx=$((idx + 1))
		while (($(jobs -rp | wc -l) >= 16)); do wait -n 2>/dev/null || break; done
	done <<<"$(printf '%s\n' "$resp" | jq -r '(.data // [])[] | [.id, .resolution, .thumbs.large] | @tsv')"
	wait
}

search_flow() {
	local initial_query="${1:-}"
	local query="$initial_query" page=1 pick id back_label prev_label next_label thumb_dir use_icons=0
	back_label="$(arch-i18n get wallpaper_back)"
	prev_label="$(arch-i18n get wallpaper_prev)"
	next_label="$(arch-i18n get wallpaper_next)"

	if command -v fuzzel >/dev/null 2>&1; then use_icons=1; fi

	if [[ -z "$query" ]]; then
		query="$(dmenu "$(arch-i18n get wallpaper_search_prompt)" --lines 0)"
	fi
	[[ -n "$query" ]] || return 0

	thumb_dir="$(mktemp -d)"
	trap 'rm -rf "$thumb_dir"' EXIT

	while true; do
		local count=0

		pick="$(
			exec 3< <(search_wallhaven_thumbs "$query" "$page" "$thumb_dir" 2>/dev/null)
			{
				local meta
				read -r meta <&3 || true
				count="${meta#* }"
				[[ "$count" =~ ^[0-9]+$ ]] || count=0

				printf '%s\n' "$back_label"
				[[ "$page" -gt 1 ]] && printf '%s\n' "$prev_label"
				[[ "$count" -ge 24 ]] && printf '%s\n' "$next_label"

				local rid rres rpng
				while IFS=$'\t' read -r rid rres rpng; do
					[[ -n "$rid" ]] || continue
					if [[ "$use_icons" -eq 1 && -n "$rpng" && -f "$rpng" ]]; then
						printf '%s\0icon\x1f%s\n' "$rid  $rres" "$rpng"
					else
						printf '%s\n' "$rid  $rres"
					fi
				done <&3
			} | dmenu "$(arch-i18n get wallpaper_pick_prompt)" --lines 15
		)"
		[[ -n "$pick" ]] || return 0

		if [[ "$pick" == "$back_label" ]]; then
			return 0
		elif [[ "$pick" == "$prev_label" ]]; then
			page=$((page - 1))
			[[ "$page" -lt 1 ]] && page=1
		elif [[ "$pick" == "$next_label" ]]; then
			page=$((page + 1))
		else
			id="${pick%%[[:space:]]*}"
			apply_target "$id"
			return 0
		fi
	done
}

random_online() {
	local rand_page results chosen id
	rand_page=$(((RANDOM % 30) + 1))

	local curl_args=(-fsSL --max-time 20 -G)
	curl_args+=(--data-urlencode "q=pixel art")
	curl_args+=(--data-urlencode "sorting=random")
	curl_args+=(--data-urlencode "page=$rand_page")
	local key
	key="$(cfgval apiKey "")"
	[[ -n "$key" ]] && curl_args+=(--data-urlencode "apikey=$key")

	results="$(curl "${curl_args[@]}" "$api_base/search" 2>/dev/null | jq -r '(.data // [])[] | .id' 2>/dev/null || true)"
	chosen="$(shuf -n 1 <<<"$results" || true)"

	if [[ -n "$chosen" ]]; then
		apply_target "$chosen"
	else
		notify "$(arch-i18n get wallpaper_failed)"
	fi
}

list_images() {
	find "$wall_dir" -maxdepth 1 -type f \
		\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
		-printf '%f\n' 2>/dev/null | sort || true
}

interactive_menu() {
	if ! command -v fuzzel >/dev/null 2>&1 && ! command -v bemenu >/dev/null 2>&1; then
		printf 'Error: fuzzel or bemenu required\n' >&2
		exit 1
	fi

	local rand_online_label search_label
	rand_online_label="$(arch-i18n get wallpaper_mode_random_online)"
	search_label="$(arch-i18n get wallpaper_mode_search)"

	local curr_wall curr_file images
	curr_wall=""
	if [[ -s "$state_file" ]]; then
		curr_wall="$(<"$state_file")"
	fi
	curr_file="${curr_wall##*/}"
	images="$(list_images)"

	local choice
	choice="$(
		{
			printf '  󰑐  %s\n' "$rand_online_label"
			printf '  󰍉  %s\n' "$search_label"

			if [[ -n "$curr_file" && -f "$wall_dir/$curr_file" ]]; then
				printf '* 󰋩  %s\n' "$curr_file"
			fi

			while IFS= read -r f; do
				[[ -n "$f" ]] || continue
				[[ "$f" == "$curr_file" ]] && continue
				printf '  󰋩  %s\n' "$f"
			done <<<"$images"
		} | dmenu "$(arch-i18n get wallpaper_mode_prompt)" --lines 15
	)"

	[[ -n "$choice" ]] || return 0

	local action_chosen
	action_chosen="${choice#"${choice%%[![:space:]]*}"}"

	if [[ "$action_chosen" =~ ^󰑐 ]]; then
		random_online
		return 0
	fi

	if [[ "$action_chosen" =~ ^󰍉 ]]; then
		search_flow
		return 0
	fi

	# User clicked a local file
	local clean_file="${choice#\* }"
	clean_file="${clean_file#  }"
	if [[ "$clean_file" == *"󰋩"* ]]; then
		clean_file="${clean_file#*󰋩}"
	fi
	clean_file="${clean_file#"${clean_file%%[![:space:]]*}"}"
	clean_file="${clean_file%"${clean_file##*[![:space:]]}"}"

	local img="$wall_dir/$clean_file"
	if [[ -f "$img" ]]; then
		apply_target "$img"
	fi
}

main() {
	local action="${1:-menu}"

	case "$action" in
	menu)
		interactive_menu
		;;
	current | get)
		get_current
		;;
	random)
		random_online
		;;
	search)
		shift
		search_flow "${1:-}"
		;;
	set)
		shift
		if [[ $# -eq 0 ]]; then
			printf 'Usage: arch wallpaper set <path|id|url>\n' >&2
			exit 1
		fi
		apply_target "$1"
		;;
	-h | --help | help)
		printf 'Usage: arch wallpaper [menu | current | random | search [query] | set <path|id|url> | <path|id|url>]\n'
		;;
	*)
		apply_target "$action"
		;;
	esac
}

main "$@"
