#!/bin/bash
# Live stream streaming library - shared functions
# Source this file in livestream scripts
#
# Pipeline: gpu-screen-recorder single process → RTMP.
#   - h264_vaapi hardware encoding (i965 on Sandy Bridge+), CBR bitrate
#   - keyint in seconds (Bilibili requires GOP <= 2s)
#   - multiple audio sources mixed by gsr itself (mic | system monitor)
#   - no wf-recorder→ffmpeg pipe, so network backpressure cannot corrupt audio

# XDG paths
LIVESTREAM_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/livestream"
LIVESTREAM_PLATFORMS_FILE="$LIVESTREAM_CONFIG_DIR/platforms.conf"
LIVESTREAM_CONFIG_FILE="$LIVESTREAM_CONFIG_DIR/config"
LIVESTREAM_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/livestream-$UID}/livestream"
LIVESTREAM_PID_FILE="$LIVESTREAM_RUNTIME_DIR/pgid"
LIVESTREAM_MODE_FILE="$LIVESTREAM_RUNTIME_DIR/mode"
LIVESTREAM_LOG_FILE="$LIVESTREAM_RUNTIME_DIR/livestream.log"
LIVESTREAM_RUNNER="$LIVESTREAM_RUNTIME_DIR/run.sh"

# Defaults tuned for low-power CPUs (e.g. Sandy Bridge i5): GPU encoding.
# BITRATE is in kbps (gsr -q for CBR mode). KEYINT is in seconds.
AUDIO_SOURCE=""                  # empty = auto (see livestream_load_config)
FRAMERATE="25"
BITRATE="1800"
AUDIO_BITRATE="128"
KEYINT="2"
# Max output width; 0 = keep native desktop resolution
SCALE_WIDTH="0"

livestream_ensure_dirs() {
    mkdir -p "$LIVESTREAM_CONFIG_DIR" "$LIVESTREAM_RUNTIME_DIR"
}

# Load optional key=value config (does not override non-empty env)
livestream_load_config() {
    livestream_ensure_dirs

    if [ -f "$LIVESTREAM_CONFIG_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ''|\#*) continue ;;
                *=*)
                    key="${line%%=*}"
                    val="${line#*=}"
                    key="${key// /}"
                    case "$key" in
                        AUDIO_SOURCE|FRAMERATE|BITRATE|AUDIO_BITRATE|KEYINT|SCALE_WIDTH)
                            eval "current=\${$key-}"
                            if [ -z "$current" ]; then
                                export "$key=$val"
                            fi
                            ;;
                    esac
                    ;;
            esac
        done < "$LIVESTREAM_CONFIG_FILE"
    fi

    FRAMERATE="${FRAMERATE:-25}"
    BITRATE="${BITRATE:-1800}"
    AUDIO_BITRATE="${AUDIO_BITRATE:-128}"
    KEYINT="${KEYINT:-2}"
    SCALE_WIDTH="${SCALE_WIDTH:-0}"

    # Audio source resolution:
    #   1. explicit AUDIO_SOURCE config wins (may be gsr "a|b" syntax)
    #   2. record_mix.monitor when the record-audio daemon graph is up
    #   3. default: mic (rnnoise) + default sink monitor, mixed by gsr
    if [ -z "$AUDIO_SOURCE" ]; then
        if command -v record-audio-core >/dev/null 2>&1 || [ -f "$HOME/.local/bin/record-audio-core" ]; then
            # shellcheck disable=SC1091
            source record-audio-core 2>/dev/null || source "$HOME/.local/bin/record-audio-core" 2>/dev/null || true
            if declare -F record_audio_capture_source >/dev/null 2>&1; then
                _cap=$(record_audio_capture_source 2>/dev/null || true)
                # A bare mic fallback gets system audio appended by gsr mixing
                case "$_cap" in
                    "$RECORD_AUDIO_SOURCE_NAME"|"")
                        AUDIO_SOURCE="$_cap"
                        ;;
                    *)
                        local _sys
                        _sys=$(pactl get-default-sink 2>/dev/null || true)
                        if [ -n "$_sys" ]; then
                            AUDIO_SOURCE="device:${_cap}|device:${_sys}.monitor"
                        else
                            AUDIO_SOURCE="device:${_cap}"
                        fi
                        ;;
                esac
            fi
        fi
        AUDIO_SOURCE="${AUDIO_SOURCE:-device:rnnoise_source}"
    fi
}

livestream_check_deps() {
    for cmd in gpu-screen-recorder pactl; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            echo "Error: $cmd is not installed" >&2
            exit 1
        fi
    done
}

# Resolve platform RTMP URLs from platforms.conf (INI format).
# Each section: [Name] server=... key=... → rtmp://server/key
# Outputs one URL per line; returns non-zero if no platforms configured.
livestream_get_platform_urls() {
    local file="${1:-$LIVESTREAM_PLATFORMS_FILE}"
    [ -f "$file" ] || return 1

    python3 - "$file" <<'PY'
import configparser, sys
cfg = configparser.ConfigParser()
cfg.read(sys.argv[1], encoding="utf-8")
for name in cfg.sections():
    srv = cfg[name].get("server", "").strip()
    key = cfg[name].get("key", "").strip()
    if not srv:
        continue
    url = f"rtmp://{srv}/{key}" if not srv.startswith("rtmp://") else f"{srv}/{key}"
    print(url)
PY
}

livestream_require_platforms() {
    local urls
    urls=$(livestream_get_platform_urls) || return 1
    [ -n "$urls" ] || return 1
    printf '%s' "$urls"
}

livestream_is_active() {
    local pgid
    [ -f "$LIVESTREAM_PID_FILE" ] || return 1
    pgid=$(tr -d '[:space:]' < "$LIVESTREAM_PID_FILE")
    [ -n "$pgid" ] || return 1

    if kill -0 -- "-$pgid" 2>/dev/null; then
        return 0
    fi
    if kill -0 "$pgid" 2>/dev/null; then
        return 0
    fi
    return 1
}

livestream_get_mode() {
    if [ -f "$LIVESTREAM_MODE_FILE" ]; then
        tr -d '[:space:]' < "$LIVESTREAM_MODE_FILE"
    fi
}

livestream_get_duration_seconds() {
    local pgid duration
    [ -f "$LIVESTREAM_PID_FILE" ] || return 1
    pgid=$(tr -d '[:space:]' < "$LIVESTREAM_PID_FILE")
    [ -n "$pgid" ] || return 1

    duration=$(ps -o etimes= -p "$pgid" 2>/dev/null | tr -d '[:space:]')
    if [ -z "$duration" ]; then
        # Fallback: first gpu-screen-recorder owned by this user while live
        duration=$(ps -o etimes= -C gpu-screen-recorder 2>/dev/null | head -1 | tr -d '[:space:]')
    fi
    [ -n "$duration" ] || return 1
    echo "$duration"
}

livestream_unmute_audio() {
    if command -v pactl >/dev/null 2>&1; then
        local source
        source=$(printf '%s' "$AUDIO_SOURCE" | sed -n 's/^device:\([^|]*\).*/\1/p')
        if [ -n "$source" ]; then
            if pactl list sources 2>/dev/null | grep -A 10 "Name: $source" | grep -q "Mute: yes"; then
                pactl set-source-mute "$source" 0
            fi
        fi
    fi
}

# Reuse screenrecord waybar module (signal 8)
livestream_notify_waybar() {
    pkill -SIGRTMIN+8 waybar 2>/dev/null || true
}

# True when a local file recording owns gpu-screen-recorder (not livestream)
livestream_local_recording_active() {
    if livestream_is_active; then
        return 1
    fi
    pgrep -u "$(id -u)" -x gpu-screen-recorder >/dev/null 2>&1
}

# Build gsr extra args for output scaling; empty when SCALE_WIDTH=0
livestream_gsr_scale_args() {
    if [ -n "$SCALE_WIDTH" ] && [ "$SCALE_WIDTH" != "0" ]; then
        printf '%s\n' "-s" "${SCALE_WIDTH}x0"
    fi
}

# Start streaming pipeline.
# Args: mode (full|area) [ignored legacy extra args]
livestream_start() {
    local mode="$1"
    shift
    local platform_urls
    local scale_args=()

    livestream_load_config
    livestream_check_deps
    livestream_ensure_dirs

    if livestream_is_active; then
        return 2
    fi

    if livestream_local_recording_active; then
        return 5
    fi

    if ! platform_urls=$(livestream_require_platforms); then
        return 3
    fi

    livestream_unmute_audio
    mapfile -t scale_args < <(livestream_gsr_scale_args)

    : > "$LIVESTREAM_LOG_FILE"
    printf '%s\n' "$mode" > "$LIVESTREAM_MODE_FILE"

    cat > "$LIVESTREAM_RUNNER" <<'RUNNER'
#!/bin/bash
set -e
exec >>"$LIVESTREAM_LOG_FILE" 2>&1

cleanup() {
    pkill -INT -P $$ 2>/dev/null || true
    wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# One gpu-screen-recorder instance per RTMP target, all in this process group.
# SIGINT (from livestream_stop) makes gsr finalize and exit cleanly.
pids=()
while IFS= read -r url; do
    [ -n "$url" ] || continue
    gpu-screen-recorder \
        -w screen \
        -c flv \
        -f "$LIVESTREAM_FRAMERATE" \
        -bm cbr \
        -q "$LIVESTREAM_BITRATE" \
        -keyint "$LIVESTREAM_KEYINT" \
        -ab "$LIVESTREAM_AUDIO_BITRATE" \
        -a "$LIVESTREAM_AUDIO_SOURCE" \
        ${LIVESTREAM_GSR_SCALE_ARGS} \
        -o "$url" &
    pids+=("$!")
done <<< "$LIVESTREAM_RTMP_TARGETS"

if [ ${#pids[@]} -eq 0 ]; then
    echo "FATAL: no RTMP targets configured" >&2
    exit 1
fi

# Exit if the first encoder dies (e.g. encoder unavailable at startup)
for i in $(seq 1 15); do
    if ! kill -0 "${pids[0]}" 2>/dev/null; then
        echo "FATAL: gpu-screen-recorder exited early" >&2
        cleanup
        exit 1
    fi
    sleep 0.1
done

wait
RUNNER
    chmod +x "$LIVESTREAM_RUNNER"

    # New session so livestream_stop can signal the whole pipeline
    setsid env \
        LIVESTREAM_LOG_FILE="$LIVESTREAM_LOG_FILE" \
        LIVESTREAM_AUDIO_SOURCE="$AUDIO_SOURCE" \
        LIVESTREAM_FRAMERATE="$FRAMERATE" \
        LIVESTREAM_BITRATE="$BITRATE" \
        LIVESTREAM_AUDIO_BITRATE="$AUDIO_BITRATE" \
        LIVESTREAM_KEYINT="$KEYINT" \
        LIVESTREAM_GSR_SCALE_ARGS="${scale_args[*]}" \
        LIVESTREAM_RTMP_TARGETS="$platform_urls" \
        "$LIVESTREAM_RUNNER" &

    echo $! > "$LIVESTREAM_PID_FILE"

    # Brief settle: fail fast if pipeline died immediately
    sleep 1.5
    if ! livestream_is_active; then
        return 4
    fi

    # Must actually be pushing to an RTMP server, not just sitting idle
    if ! pgrep -u "$(id -u)" -af 'gpu-screen-recorder.*rtmp://' >/dev/null 2>&1; then
        local pgid
        pgid=$(tr -d '[:space:]' < "$LIVESTREAM_PID_FILE")
        if ! pgrep -u "$(id -u)" -P "$pgid" -a gpu-screen-recorder >/dev/null 2>&1 \
            && ! pgrep -u "$(id -u)" -g "$pgid" -a gpu-screen-recorder >/dev/null 2>&1; then
            livestream_stop || true
            return 4
        fi
    fi

    livestream_notify_waybar
    return 0
}

livestream_stop() {
    local pgid
    local i

    livestream_ensure_dirs

    if [ ! -f "$LIVESTREAM_PID_FILE" ]; then
        return 1
    fi

    pgid=$(tr -d '[:space:]' < "$LIVESTREAM_PID_FILE")
    if [ -z "$pgid" ]; then
        rm -f "$LIVESTREAM_PID_FILE" "$LIVESTREAM_MODE_FILE"
        return 1
    fi

    kill -INT -- "-$pgid" 2>/dev/null || kill -INT "$pgid" 2>/dev/null || true
    # Also interrupt recorder directly (it may ignore group signal timing)
    pkill -INT -u "$(id -u)" -x gpu-screen-recorder 2>/dev/null || true

    for i in $(seq 1 30); do
        if ! livestream_is_active; then
            break
        fi
        sleep 0.1
    done

    if livestream_is_active; then
        kill -TERM -- "-$pgid" 2>/dev/null || kill -TERM "$pgid" 2>/dev/null || true
        pkill -TERM -u "$(id -u)" -x gpu-screen-recorder 2>/dev/null || true
        for i in $(seq 1 20); do
            if ! livestream_is_active; then
                break
            fi
            sleep 0.1
        done
    fi

    if livestream_is_active; then
        kill -KILL -- "-$pgid" 2>/dev/null || kill -KILL "$pgid" 2>/dev/null || true
        pkill -KILL -u "$(id -u)" -x gpu-screen-recorder 2>/dev/null || true
        pkill -KILL -u "$(id -u)" -f 'gpu-screen-recorder.*rtmp://' 2>/dev/null || true
        for i in $(seq 1 10); do
            if ! livestream_is_active; then
                break
            fi
            sleep 0.1
        done
    fi

    rm -f "$LIVESTREAM_PID_FILE" "$LIVESTREAM_MODE_FILE"
    livestream_notify_waybar
    return 0
}
