#!/bin/bash
# Shared client helpers for the Session D-Bus livestream service.
# One gpu-screen-recorder process is used per RTMP platform.

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck disable=SC1091
source "$SCRIPT_DIR/record-audio-core"
LIVESTREAM_SERVICE="$SCRIPT_DIR/livestream-service"
LIVESTREAM_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/livestream"
LIVESTREAM_PLATFORMS_FILE="$LIVESTREAM_CONFIG_DIR/platforms.conf"
LIVESTREAM_CONFIG_FILE="$LIVESTREAM_CONFIG_DIR/config"
LIVESTREAM_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/livestream-$UID}/livestream"
LIVESTREAM_LOG_FILE="$LIVESTREAM_RUNTIME_DIR/livestream.log"
LIVESTREAM_AUDIO_OWN_FILE="$LIVESTREAM_RUNTIME_DIR/audio-owned"

# Empty values may be filled by ~/.config/livestream/config. Non-empty
# environment variables take precedence over that file.
AUDIO_SOURCE="${AUDIO_SOURCE-}"
FRAMERATE="${FRAMERATE-}"
BITRATE="${BITRATE-}"
AUDIO_BITRATE="${AUDIO_BITRATE-}"
KEYINT="${KEYINT-}"
SCALE_WIDTH="${SCALE_WIDTH-}"

livestream_ensure_dirs() {
    install -d -m 700 "$LIVESTREAM_CONFIG_DIR" "$LIVESTREAM_RUNTIME_DIR"
}

livestream_load_config() {
    livestream_ensure_dirs
    [ -f "$LIVESTREAM_PLATFORMS_FILE" ] && chmod 600 "$LIVESTREAM_PLATFORMS_FILE"
    [ -f "$LIVESTREAM_CONFIG_FILE" ] && chmod 600 "$LIVESTREAM_CONFIG_FILE"

    if [ -f "$LIVESTREAM_CONFIG_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ''|\#*) continue ;;
                *=*)
                    key="${line%%=*}"
                    val="${line#*=}"
                    key="${key// /}"
                    case "$key" in
                        AUDIO_SOURCE|FRAMERATE|BITRATE|AUDIO_BITRATE|KEYINT|SCALE_WIDTH)
                            eval "current=\${$key-}"
                            if [ -z "$current" ]; then
                                export "$key=$val"
                            fi
                            ;;
                    esac
                    ;;
            esac
        done < "$LIVESTREAM_CONFIG_FILE"
    fi

    FRAMERATE="${FRAMERATE:-25}"
    BITRATE="${BITRATE:-1800}"
    AUDIO_BITRATE="${AUDIO_BITRATE:-128}"
    KEYINT="${KEYINT:-2}"
    SCALE_WIDTH="${SCALE_WIDTH:-0}"

    if ! [[ "$FRAMERATE" =~ ^[0-9]+$ ]] || ((FRAMERATE < 1 || FRAMERATE > 240)); then
        FRAMERATE=25
    fi
    if ! [[ "$BITRATE" =~ ^[0-9]+$ ]] || ((BITRATE < 100 || BITRATE > 50000)); then
        BITRATE=1800
    fi
    if ! [[ "$AUDIO_BITRATE" =~ ^[0-9]+$ ]] \
        || ((AUDIO_BITRATE < 32 || AUDIO_BITRATE > 320)); then
        AUDIO_BITRATE=128
    fi
    if ! [[ "$KEYINT" =~ ^[0-9]+$ ]] || ((KEYINT < 1 || KEYINT > 10)); then
        KEYINT=2
    fi
    if ! [[ "$SCALE_WIDTH" =~ ^[0-9]+$ ]] || ((SCALE_WIDTH > 16384)); then
        SCALE_WIDTH=0
    fi

    # Default capture path is the shared record_mix graph so ducking applies.
    # Explicit AUDIO_SOURCE still wins for advanced overrides.
    if [ -z "$AUDIO_SOURCE" ]; then
        AUDIO_SOURCE="device:${RECORD_AUDIO_SOURCE_NAME:-record_mix.monitor}"
    fi
}

# Strategy B: share the record-audio mix/daemon with other capture tools.
# Livestream only tears down pieces it started for this session.
livestream_prepare_shared_audio() {
    local mix_was_up=0 daemon_was_up=0

    livestream_ensure_dirs
    rm -f "$LIVESTREAM_AUDIO_OWN_FILE"

    if record_audio_is_up; then
        mix_was_up=1
    fi
    if record_audio_daemon_running; then
        daemon_was_up=1
    fi

    if ! record_audio_enable_shared; then
        # Roll back only what this attempt may have created.
        if [ "$daemon_was_up" -eq 0 ]; then
            record_audio_stop_daemon || true
        fi
        if [ "$mix_was_up" -eq 0 ]; then
            record_audio_down || true
        fi
        return 1
    fi

    {
        printf 'mix_owned=%s\n' "$((1 - mix_was_up))"
        printf 'daemon_owned=%s\n' "$((1 - daemon_was_up))"
    } >"$LIVESTREAM_AUDIO_OWN_FILE"
    chmod 600 "$LIVESTREAM_AUDIO_OWN_FILE" 2>/dev/null || true

    AUDIO_SOURCE="device:${RECORD_AUDIO_SOURCE_NAME}"
    return 0
}

livestream_release_shared_audio() {
    local mix_owned=0 daemon_owned=0

    if [ -f "$LIVESTREAM_AUDIO_OWN_FILE" ]; then
        # shellcheck disable=SC1090
        source "$LIVESTREAM_AUDIO_OWN_FILE"
        rm -f "$LIVESTREAM_AUDIO_OWN_FILE"
    fi

    if [ "${daemon_owned:-0}" = 1 ]; then
        record_audio_stop_daemon || true
    fi
    if [ "${mix_owned:-0}" = 1 ]; then
        # Keep the graph if another client still needs it (e.g. local recording).
        if ! livestream_local_recording_active; then
            record_audio_down || true
        fi
    fi
}

livestream_check_deps() {
    local cmd
    for cmd in gpu-screen-recorder pactl ss "$LIVESTREAM_SERVICE"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            printf 'Error: %s is not installed\n' "$cmd" >&2
            return 1
        fi
    done
}

livestream_is_active() {
    "$LIVESTREAM_SERVICE" is-active >/dev/null 2>&1
}

livestream_get_mode() {
    "$LIVESTREAM_SERVICE" field mode 2>/dev/null
}

livestream_get_duration_seconds() {
    "$LIVESTREAM_SERVICE" field duration_seconds 2>/dev/null
}

livestream_connection_state() {
    "$LIVESTREAM_SERVICE" field state 2>/dev/null || printf '%s\n' offline
}

livestream_platform_status_text() {
    "$LIVESTREAM_SERVICE" status --platforms-only 2>/dev/null
}

livestream_status_report() {
    "$LIVESTREAM_SERVICE" status 2>/dev/null
}

livestream_notify_waybar() {
    pkill -SIGRTMIN+8 waybar 2>/dev/null || true
}

livestream_local_recording_active() {
    if livestream_is_active; then
        return 1
    fi
    pgrep -u "$(id -u)" -f '^gpu-screen-recorder ' >/dev/null 2>&1
}

livestream_unmute_audio() {
    if command -v pactl >/dev/null 2>&1; then
        local source
        source=$(printf '%s' "$AUDIO_SOURCE" | sed -n 's/^device:\([^|]*\).*/\1/p')
        if [ -n "$source" ]; then
            if pactl list sources 2>/dev/null \
                | grep -A 10 "Name: $source" \
                | grep -q "Mute: yes"; then
                pactl set-source-mute "$source" 0
            fi
        fi
    fi
}

livestream_capture_target() {
    local target="${1:-portal}"
    case "$target" in
        full) printf '%s\n' screen ;;
        *) printf '%s\n' "$target" ;;
    esac
}

livestream_start() {
    local target="${1:-portal}"
    local capture_target rc

    livestream_load_config
    livestream_check_deps || return 4
    capture_target=$(livestream_capture_target "$target")

    if livestream_is_active; then
        return 2
    fi
    if livestream_local_recording_active; then
        return 5
    fi
    "$LIVESTREAM_SERVICE" validate \
        --platforms-file "$LIVESTREAM_PLATFORMS_FILE" \
        --default-video "$BITRATE" \
        --default-audio "$AUDIO_BITRATE" >/dev/null 2>&1 || return 3

    # Default path uses the shared mix + ducking. An explicit AUDIO_SOURCE
    # override keeps full control and skips ownership of the shared graph.
    if [[ "$AUDIO_SOURCE" == device:${RECORD_AUDIO_SOURCE_NAME} \
        || "$AUDIO_SOURCE" == "${RECORD_AUDIO_SOURCE_NAME}" ]]; then
        if ! livestream_prepare_shared_audio; then
            livestream_release_shared_audio
            return 4
        fi
    fi

    livestream_unmute_audio
    setsid "$LIVESTREAM_SERVICE" run \
        --platforms-file "$LIVESTREAM_PLATFORMS_FILE" \
        --target "$capture_target" \
        --audio-source "$AUDIO_SOURCE" \
        --framerate "$FRAMERATE" \
        --default-video "$BITRATE" \
        --default-audio "$AUDIO_BITRATE" \
        --keyint "$KEYINT" \
        --scale-width "$SCALE_WIDTH" \
        --log-file "$LIVESTREAM_LOG_FILE" \
        >/dev/null 2>&1 &

    "$LIVESTREAM_SERVICE" wait-ready --timeout 30
    rc=$?
    case "$rc" in
        0|6)
            livestream_notify_waybar
            return "$rc"
            ;;
        *)
            "$LIVESTREAM_SERVICE" stop --timeout 7 >/dev/null 2>&1 || true
            livestream_release_shared_audio
            livestream_notify_waybar
            return 4
            ;;
    esac
}

livestream_stop() {
    local rc
    "$LIVESTREAM_SERVICE" stop --timeout 7
    rc=$?
    livestream_release_shared_audio
    livestream_notify_waybar
    return "$rc"
}
