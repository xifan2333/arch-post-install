#!/bin/bash
# Shared client helpers for the Session D-Bus livestream service.
# One gpu-screen-recorder encode is fanned out to N RTMP targets via ffmpeg tee.

SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
LIVESTREAM_SERVICE="$SCRIPT_DIR/livestream-service"
LIVE_DANMAKU="$SCRIPT_DIR/live-danmaku"
LIVESTREAM_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/livestream"
# Single JSON config: global bitrate + platforms[].
LIVESTREAM_CONFIG_FILE="$LIVESTREAM_CONFIG_DIR/config.json"
LIVESTREAM_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/livestream-$UID}/livestream"
LIVESTREAM_LOG_FILE="$LIVESTREAM_RUNTIME_DIR/livestream.log"

livestream_ensure_dirs() {
    install -d -m 700 "$LIVESTREAM_CONFIG_DIR" "$LIVESTREAM_RUNTIME_DIR"
}

livestream_load_config() {
    livestream_ensure_dirs
    [ -f "$LIVESTREAM_CONFIG_FILE" ] && chmod 600 "$LIVESTREAM_CONFIG_FILE"

    # Fixed defaults (not user-configurable).
    # Bitrate lives in config.json and is read by livestream-service.
    FRAMERATE=30
    KEYINT=2
    SCALE_WIDTH=0
    AUDIO_SOURCE="default_output|default_input"
}

livestream_check_deps() {
    local cmd
    for cmd in gpu-screen-recorder pactl ss "$LIVESTREAM_SERVICE"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            printf 'Error: %s is not installed\n' "$cmd" >&2
            return 1
        fi
    done
}

livestream_is_active() {
    "$LIVESTREAM_SERVICE" is-active >/dev/null 2>&1
}

livestream_get_mode() {
    "$LIVESTREAM_SERVICE" field mode 2>/dev/null
}

livestream_get_duration_seconds() {
    "$LIVESTREAM_SERVICE" field duration_seconds 2>/dev/null
}

livestream_connection_state() {
    "$LIVESTREAM_SERVICE" field state 2>/dev/null || printf '%s\n' offline
}

livestream_platform_status_text() {
    "$LIVESTREAM_SERVICE" status --platforms-only 2>/dev/null
}

livestream_status_report() {
    "$LIVESTREAM_SERVICE" status 2>/dev/null
}

livestream_notify_waybar() {
    pkill -SIGRTMIN+8 waybar 2>/dev/null || true
}

# Path-tolerant match for gpu-screen-recorder (bare name or absolute path).
# Shared with capture-router so record/live mutual exclusion stays consistent.
capture_gsr_running() {
    pgrep -u "$(id -u)" -f '(^|/)gpu-screen-recorder( |$)' >/dev/null 2>&1
}

livestream_local_recording_active() {
    if livestream_is_active; then
        return 1
    fi
    capture_gsr_running
}

livestream_unmute_audio() {
    if ! command -v pactl >/dev/null 2>&1; then
        return 0
    fi

    local source
    case "$AUDIO_SOURCE" in
        device:*)
            source=$(printf '%s' "$AUDIO_SOURCE" | sed -n 's/^device:\([^|]*\).*/\1/p')
            ;;
        *default_input*|default_input)
            source=$(pactl get-default-source 2>/dev/null || true)
            ;;
    esac

    if [ -n "$source" ]; then
        pactl set-source-mute "$source" 0 2>/dev/null || true
    fi
}

livestream_capture_target() {
    local target="${1:-portal}"
    case "$target" in
        full) printf '%s\n' screen ;;
        *) printf '%s\n' "$target" ;;
    esac
}

# Herdr live desk (unibarrage + dmnotifier). Fully silent; never affects stream rc.
livestream_open_danmaku() {
    [ -x "$LIVE_DANMAKU" ] || return 0
    "$LIVE_DANMAKU" start >/dev/null 2>&1 &
}

livestream_close_danmaku() {
    [ -x "$LIVE_DANMAKU" ] || return 0
    "$LIVE_DANMAKU" stop >/dev/null 2>&1 &
}

livestream_start() {
    local target="${1:-portal}"
    local capture_target rc

    livestream_load_config
    livestream_check_deps || return 4
    capture_target=$(livestream_capture_target "$target")

    if livestream_is_active; then
        return 2
    fi
    if livestream_local_recording_active; then
        return 5
    fi
    "$LIVESTREAM_SERVICE" validate \
        --config "$LIVESTREAM_CONFIG_FILE" >/dev/null 2>&1 || return 3

    livestream_unmute_audio
    setsid "$LIVESTREAM_SERVICE" run \
        --config "$LIVESTREAM_CONFIG_FILE" \
        --target "$capture_target" \
        --audio-source "$AUDIO_SOURCE" \
        --framerate "$FRAMERATE" \
        --keyint "$KEYINT" \
        --scale-width "$SCALE_WIDTH" \
        --log-file "$LIVESTREAM_LOG_FILE" \
        >/dev/null 2>&1 &

    "$LIVESTREAM_SERVICE" wait-ready --timeout 30
    rc=$?
    case "$rc" in
        0|6)
            livestream_notify_waybar
            livestream_open_danmaku
            return "$rc"
            ;;
        *)
            "$LIVESTREAM_SERVICE" stop --timeout 7 >/dev/null 2>&1 || true
            livestream_notify_waybar
            return 4
            ;;
    esac
}

livestream_stop() {
    local rc
    "$LIVESTREAM_SERVICE" stop --timeout 7
    rc=$?
    if [ "$rc" -eq 0 ]; then
        livestream_close_danmaku
    fi
    livestream_notify_waybar
    return "$rc"
}
