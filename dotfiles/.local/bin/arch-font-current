#!/usr/bin/env bash
# arch:summary=Show current active monospace and CJK fonts
# arch:examples=arch font current | arch font current --mono | arch font current --cjk
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/font"

get_mono() {
	if [[ -f "$state_dir/mono.name" ]]; then
		cat "$state_dir/mono.name"
	else
		fc-match monospace -f '%{family}\n' 2>/dev/null | head -n1 | cut -d, -f1
	fi
}

get_cjk() {
	if [[ -f "$state_dir/cjk.name" ]]; then
		cat "$state_dir/cjk.name"
	else
		printf 'Sarasa Mono SC\n'
	fi
}

case "${1:-}" in
--mono | -m)
	get_mono
	;;
--cjk | -c)
	get_cjk
	;;
*)
	printf 'Mono: %s\n' "$(get_mono)"
	printf 'CJK : %s\n' "$(get_cjk)"
	;;
esac
