#!/usr/bin/env bash
# arch:summary=Apply or switch desktop semantic color theme
# arch:args=<theme-name> | --list | --current | --refresh
# arch:examples=arch theme set tokyo-night | arch theme set --list
set -euo pipefail

get_config_dir() {
	local xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
	if [[ -d "$xdg/themes" ]]; then
		printf '%s' "$xdg"
		return 0
	fi
	local repo_cfg
	repo_cfg="$(dirname "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")")/.config"
	if [[ -d "$repo_cfg/themes" ]]; then
		printf '%s' "$repo_cfg"
		return 0
	fi
	printf '%s' "$xdg"
}

get_state_dir() {
	printf '%s' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

get_current_theme() {
	local state_dir
	state_dir="$(get_state_dir)"
	local name_file="$state_dir/theme/current.name"
	if [[ -f "$name_file" ]]; then
		cat "$name_file"
		return 0
	fi
	local link="$state_dir/theme/current"
	if [[ -L "$link" ]]; then
		basename "$(readlink -f "$link")"
		return 0
	fi
	return 1
}

list_themes() {
	local themes_dir="$1"
	local curr
	curr="$(get_current_theme || true)"
	for d in "$themes_dir"/*; do
		if [[ -d "$d" && -f "$d/colors.toml" ]]; then
			local name="${d##*/}"
			local prefix="  "
			[[ "$name" == "$curr" ]] && prefix="* "
			printf '%s%s\n' "$prefix" "$name"
		fi
	done
}

broadcast_reloads() {
	pkill -SIGUSR2 waybar 2>/dev/null || true
	pkill -SIGUSR1 fnott 2>/dev/null || true

	# Gracefully reload Fcitx5 via native DBus Controller interface or fcitx5-remote
	if pgrep -x fcitx5 >/dev/null 2>&1; then
		busctl --user call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 Restart 2>/dev/null || fcitx5-remote -r 2>/dev/null || true
	elif systemctl --user is-active --quiet fcitx5.service 2>/dev/null; then
		systemctl --user restart fcitx5.service 2>/dev/null || true
	fi

	# Reload Herdr server config if running
	if pgrep -x herdr >/dev/null 2>&1 && command -v herdr >/dev/null 2>&1; then
		herdr server reload-config >/dev/null 2>&1 || true
	fi

	# Reload running Neovim instances over active Unix domain sockets
	local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}"
	if [[ -d "$runtime_dir" ]]; then
		while IFS= read -r sock; do
			[[ -S "$sock" ]] || continue
			nvim --server "$sock" --remote-send "<Cmd>doautocmd User LazyReload<CR>" >/dev/null 2>&1 || true
		done < <(find "$runtime_dir" -type s -name "*nvim*.sock" 2>/dev/null)
	fi

	if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
		local state_dir
		state_dir="$(get_state_dir)"
		local xrwm_theme="$state_dir/theme/xrwm.sh"
		if [[ -x "$xrwm_theme" ]]; then
			"$xrwm_theme" >/dev/null 2>&1 || true
		fi
	fi
}

ensure_fcitx5_theme() {
	local state_theme="$1"
	[[ -f "$state_theme" ]] || return 0

	local fcitx_dir="${XDG_DATA_HOME:-$HOME/.local/share}/fcitx5/themes/custom"
	mkdir -p "$fcitx_dir"

	local target_conf="$fcitx_dir/theme.conf"
	if [[ "$(readlink -f "$target_conf" 2>/dev/null || true)" != "$state_theme" ]]; then
		ln -sf "$state_theme" "$target_conf"
	fi

	for svg in arrow.svg next.svg prev.svg radio.svg; do
		if [[ -f "/usr/share/fcitx5/themes/default/$svg" && ! -e "$fcitx_dir/$svg" ]]; then
			ln -sf "/usr/share/fcitx5/themes/default/$svg" "$fcitx_dir/$svg"
		fi
	done
}

ensure_neovim_theme() {
	local state_theme="$1"
	[[ -f "$state_theme" ]] || return 0

	local nvim_plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/lua/plugins"
	mkdir -p "$nvim_plugins_dir"

	local target_conf="$nvim_plugins_dir/theme.lua"
	if [[ "$(readlink -f "$target_conf" 2>/dev/null || true)" != "$state_theme" ]]; then
		ln -sf "$state_theme" "$target_conf"
	fi
	touch -c "$target_conf" 2>/dev/null || true
}

blend_color() {
	local base="${1#\#}" over="${2#\#}" ratio="$3"
	local br=$((16#${base:0:2})) bg=$((16#${base:2:2})) bb=$((16#${base:4:2}))
	local or=$((16#${over:0:2})) og=$((16#${over:2:2})) ob=$((16#${over:4:2}))
	printf "#%02x%02x%02x" \
		$((br + (or - br) * ratio / 100)) \
		$((bg + (og - bg) * ratio / 100)) \
		$((bb + (ob - bb) * ratio / 100))
}

get_color_token() {
	local file="$1" key="$2" default="${3:-}"
	local val
	val="$(grep -E "^${key}[[:space:]]*=" "$file" 2>/dev/null | head -1 | cut -d'"' -f2 || true)"
	if [[ -n "$val" ]]; then
		printf '%s' "$val"
	else
		printf '%s' "$default"
	fi
}

assemble_herdr_theme() {
	local colors_file="$1" theme_state="$2"
	local cfg
	cfg="$(get_config_dir)"

	local base_cfg=""
	if [[ -f "$cfg/herdr/config.base.toml" ]]; then
		base_cfg="$cfg/herdr/config.base.toml"
	elif [[ -f "$HOME/.config/herdr/config.base.toml" ]]; then
		base_cfg="$HOME/.config/herdr/config.base.toml"
	fi

	[[ -n "$base_cfg" && -f "$base_cfg" ]] || return 0

	local accent background foreground selection muted
	local lighter_background light_foreground
	local magenta green yellow red blue cyan orange

	accent="$(get_color_token "$colors_file" "accent" "#7aa2f7")"
	background="$(get_color_token "$colors_file" "background" "#1a1b26")"
	foreground="$(get_color_token "$colors_file" "foreground" "#a9b1d6")"
	selection="$(get_color_token "$colors_file" "selection" "$accent")"
	muted="$(get_color_token "$colors_file" "muted" "#414868")"
	lighter_background="$(get_color_token "$colors_file" "lighter_background" "")"
	light_foreground="$(get_color_token "$colors_file" "light_foreground" "")"

	magenta="$(get_color_token "$colors_file" "magenta" "#ad8ee6")"
	green="$(get_color_token "$colors_file" "green" "#9ece6a")"
	yellow="$(get_color_token "$colors_file" "yellow" "#e0af68")"
	red="$(get_color_token "$colors_file" "red" "#f7768e")"
	blue="$(get_color_token "$colors_file" "blue" "#7aa2f7")"
	cyan="$(get_color_token "$colors_file" "cyan" "#449dab")"
	orange="$(get_color_token "$colors_file" "orange" "$yellow")"

	local active_row_bg selection_bg surface_dim surface0 surface1 overlay0 overlay1 subtext0
	active_row_bg="$(blend_color "$background" "$foreground" 12)"
	selection_bg="$(blend_color "$background" "$selection" 40)"
	surface_dim="$(blend_color "$background" "$foreground" 6)"
	surface0="${lighter_background:-$(blend_color "$background" "$foreground" 8)}"
	surface1="${muted:-$(blend_color "$background" "$foreground" 16)}"
	overlay0="$(blend_color "$background" "$foreground" 88)"
	overlay1="$(blend_color "$background" "$foreground" 94)"
	subtext0="${light_foreground:-$(blend_color "$background" "$foreground" 78)}"

	local target_herdr="$theme_state/herdr.toml"
	{
		cat "$base_cfg"
		printf '\n# Auto-generated by arch-theme-set from active theme\n'
		printf '[theme.custom]\n'
		printf 'accent = "%s"\n' "$accent"
		printf 'panel_bg = "%s"\n' "$background"
		printf 'sidebar_bg = "%s"\n' "$background"
		printf 'active_row_bg = "%s"\n' "$active_row_bg"
		printf 'selection_bg = "%s"\n' "$selection_bg"
		printf 'surface0 = "%s"\n' "$surface0"
		printf 'surface1 = "%s"\n' "$surface1"
		printf 'surface_dim = "%s"\n' "$surface_dim"
		printf 'overlay0 = "%s"\n' "$overlay0"
		printf 'overlay1 = "%s"\n' "$overlay1"
		printf 'text = "%s"\n' "$foreground"
		printf 'subtext0 = "%s"\n' "$subtext0"
		printf 'mauve = "%s"\n' "$magenta"
		printf 'green = "%s"\n' "$green"
		printf 'yellow = "%s"\n' "$yellow"
		printf 'red = "%s"\n' "$red"
		printf 'blue = "%s"\n' "$blue"
		printf 'teal = "%s"\n' "$cyan"
		printf 'peach = "%s"\n' "$orange"
	} >"$target_herdr"

	local herdr_dir="${XDG_CONFIG_HOME:-$HOME/.config}/herdr"
	mkdir -p "$herdr_dir"
	local herdr_conf="$herdr_dir/config.toml"
	if [[ "$(readlink -f "$herdr_conf" 2>/dev/null || true)" != "$target_herdr" ]]; then
		ln -sf "$target_herdr" "$herdr_conf"
	fi
}

render_template() {
	local colors_file="$1"
	local tpl_file="$2"
	local target_file="$3"
	local is_exec="${4:-0}"

	mkdir -p "$(dirname "$target_file")"
	local tmp
	tmp=$(mktemp -p "$(dirname "$target_file")" ".${target_file##*/}.tmp.XXXXXX")

	awk '
    function hex2dec(hex,   chars, val, i) {
        hex = tolower(hex)
        chars = "0123456789abcdef"
        val = 0
        for (i = 1; i <= length(hex); i++) {
            val = val * 16 + (index(chars, substr(hex, i, 1)) - 1)
        }
        return val
    }

    function hex2rgb(hex,   r, g, b) {
        sub(/^#/, "", hex)
        r = hex2dec(substr(hex, 1, 2))
        g = hex2dec(substr(hex, 3, 2))
        b = hex2dec(substr(hex, 5, 2))
        return r "," g "," b
    }

    NR == FNR {
        if ($0 ~ /^[a-z_]+[ \t]*=/) {
            split($0, parts, "=")
            gsub(/[ \t]/, "", parts[1])
            gsub(/[ \t"\047]/, "", parts[2])
            colors[parts[1]] = parts[2]
        }
        next
    }

    FNR == 1 {
        if (!("orange" in colors) && ("yellow" in colors)) colors["orange"] = colors["yellow"]
        if (!("brown" in colors) && ("muted" in colors)) colors["brown"] = colors["muted"]
        if (!("darker_background" in colors) && ("dark_background" in colors)) colors["darker_background"] = colors["dark_background"]
        if (!("selection_foreground" in colors) && ("bright_foreground" in colors)) colors["selection_foreground"] = colors["bright_foreground"]
        if (!("selection_background" in colors) && ("selection" in colors)) colors["selection_background"] = colors["selection"]
    }

    {
        line = $0
        for (k in colors) {
            c = colors[k]
            c_strip = c
            sub(/^#/, "", c_strip)
            c_rgb = hex2rgb(c)

            pat_plain = "\\{\\{[ \t]*" k "[ \t]*\\}\\}"
            pat_strip = "\\{\\{[ \t]*" k "(_strip|[ \t]*\\|[ \t]*strip)[ \t]*\\}\\}"
            pat_rgb   = "\\{\\{[ \t]*" k "(_rgb|[ \t]*\\|[ \t]*rgb)[ \t]*\\}\\}"

            gsub(pat_strip, c_strip, line)
            gsub(pat_rgb, c_rgb, line)
            gsub(pat_plain, c, line)
        }
        print line
    }
    ' "$colors_file" "$tpl_file" >"$tmp"

	if [[ "$is_exec" -eq 1 ]]; then
		chmod 0755 "$tmp"
	else
		chmod 0644 "$tmp"
	fi
	mv -f "$tmp" "$target_file"
}

apply_theme() {
	local theme_name="$1"
	local cfg
	cfg="$(get_config_dir)"
	local state_dir
	state_dir="$(get_state_dir)"
	local theme_path="$cfg/themes/$theme_name"
	local colors_file="$theme_path/colors.toml"

	if [[ ! -f "$colors_file" ]]; then
		printf 'Error: Theme "%s" not found at %s\n' "$theme_name" "$colors_file" >&2
		return 1
	fi

	local theme_state="$state_dir/theme"
	mkdir -p "$theme_state"

	local themed_dir="$cfg/themed"
	local rendered_count=0
	if [[ -d "$themed_dir" ]]; then
		for tpl in "$themed_dir"/*.tpl; do
			[[ -f "$tpl" ]] || continue
			local filename="${tpl##*/}"
			local target_name="${filename%.tpl}"
			local target="$theme_state/$target_name"
			local is_exec=0
			if [[ "$target_name" == *.sh ]]; then
				is_exec=1
			fi
			render_template "$colors_file" "$tpl" "$target" "$is_exec"
			rendered_count=$((rendered_count + 1))
		done
	fi

	cp -f "$colors_file" "$theme_state/colors.toml"
	printf '%s\n' "$theme_name" >"$theme_state/current.name"

	local current_symlink="$theme_state/current"
	rm -f "$current_symlink"
	ln -s "$theme_path" "$current_symlink" 2>/dev/null || true

	ensure_fcitx5_theme "$theme_state/fcitx5-theme.conf"
	ensure_neovim_theme "$theme_state/neovim.lua"
	assemble_herdr_theme "$colors_file" "$theme_state"
	broadcast_reloads

	printf '✓ Applied theme "%s" (%d template(s) rendered)\n' "$theme_name" "$rendered_count"
}

main() {
	local cfg
	cfg="$(get_config_dir)"
	local themes_dir="$cfg/themes"

	if [[ $# -lt 1 ]]; then
		local curr
		curr="$(get_current_theme || echo "none")"
		printf 'Usage: arch-theme-set <theme-name> | --list | --current | --refresh\n'
		printf 'Active theme: %s\n' "$curr"
		return 0
	fi

	case "$1" in
	-l | --list)
		list_themes "$themes_dir"
		;;
	-c | --current)
		get_current_theme || printf 'none\n'
		;;
	-r | --refresh)
		local curr
		curr="$(get_current_theme || true)"
		if [[ -z "$curr" ]]; then
			printf 'Error: No active theme found to refresh\n' >&2
			return 1
		fi
		apply_theme "$curr"
		;;
	-h | --help | help)
		printf 'Usage: arch-theme-set <theme-name> | --list | --current | --refresh\n'
		;;
	*)
		apply_theme "$1"
		;;
	esac
}

main "$@"
