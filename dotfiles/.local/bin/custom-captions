#!/usr/bin/env -S PYTHONDONTWRITEBYTECODE=1 python3
#
# @name         custom-captions
# @summary      Control live speech captions within a graphical-session user service
# @deps         systemctl; start/run: uwsm, vinput, parec, wayhud, python-gobject
#               The configured ASR command is also required
# @usage        custom-captions [status|start|stop|toggle]
# @options      -h, --help  Print localized usage
# @commands     run  Internal service entrypoint
# @stdin        Unused; the service captures PCM from the configured audio source
# @stdout       open/closed service state
# @stderr       Diagnostics; usage=2, missing dependency=127, operation failure=1
# @examples     custom-captions status; custom-captions start; custom-captions stop
#
"""Real-time speech-to-text live subtitle overlay using vinput and wayhud."""

from __future__ import annotations

import array
import base64
import contextlib
import json
import os
import queue
import shutil
import signal
import subprocess
import sys
import threading
import time
from collections.abc import Callable
from pathlib import Path

SAMPLE_RATE = 16000
CHANNELS = 1
BYTES_PER_SAMPLE = 2
FRAME_MS = 100
FRAME_BYTES = SAMPLE_RATE * CHANNELS * BYTES_PER_SAMPLE * FRAME_MS // 1000

VOICE_RMS_THRESHOLD = 180
SILENCE_FRAMES_TO_FINISH = 6
MAX_UTTERANCE_SECONDS = 18
MAX_CAPTION_CHARS = 60
PROVIDER_TIMEOUT = 3
DBUS_TIMEOUT_MS = 100
EVENT_POLL_SECONDS = 0.1
GLIB_POLL_SECONDS = 0.05
sys.dont_write_bytecode = True
PROVIDER_POLL_SECONDS = 3.0
VINPUT_STATUS_POLL_SECONDS = 0.5

VINPUT_BUS_NAME = "org.fcitx.Vinput"
VINPUT_OBJECT_PATH = "/org/fcitx/Vinput"
VINPUT_INTERFACE = "org.fcitx.Vinput.Service"

UNIT = "custom-captions.service"

try:
    from gi.repository import Gio, GLib
except ImportError:
    Gio = None
    GLib = None


def tr(key: str, **values: object) -> str:
    return subprocess.check_output(
        ["custom-i18n", "get", key, *(f"{k}={v}" for k, v in values.items())], text=True
    ).rstrip("\n")


def report_error(key: str, **values: object) -> None:
    """Report diagnostics without replacing the operation's exit status."""
    try:
        subprocess.run(
            ["custom-i18n", "get", key, *(f"{k}={v}" for k, v in values.items())],
            stdout=sys.stderr,
            check=False,
        )
    except OSError as exc:
        # No substitute message: report only the unavailable executable/path.
        if exc.filename:
            print(exc.filename, file=sys.stderr)


def fail(code: int, key: str, **values: object) -> None:
    print(tr(key, **values), file=sys.stderr)
    raise SystemExit(code)


def require(*names: str) -> None:
    for name in names:
        if shutil.which(name) is None:
            fail(127, "cli_dependency", name=name)


def configure_runtime() -> None:
    global VOICE_RMS_THRESHOLD, SILENCE_FRAMES_TO_FINISH
    global MAX_UTTERANCE_SECONDS, MAX_CAPTION_CHARS

    def number(name: str, default: int, minimum: int) -> int:
        raw = os.environ.get(name, str(default))
        if not raw.isascii() or not raw.isdecimal() or int(raw) < minimum:
            fail(2, "cli_unavailable", name=name)
        return int(raw)

    VOICE_RMS_THRESHOLD = number("ARCH_CAPTIONS_RMS", 180, 0)
    SILENCE_FRAMES_TO_FINISH = number("ARCH_CAPTIONS_SILENCE_FRAMES", 6, 1)
    MAX_UTTERANCE_SECONDS = number("ARCH_CAPTIONS_MAX_UTTERANCE_SECS", 18, 1)
    MAX_CAPTION_CHARS = number("ARCH_CAPTIONS_MAX_CHARS", 60, 0)


def require_runtime() -> None:
    require("vinput", "parec", "wayhud")
    if Gio is None or GLib is None:
        fail(127, "cli_dependency", name="python-gobject")
    provider = get_active_vinput_provider()
    require(str(provider["command"]))
    configure_runtime()


def parse_dbus_result(payload: str) -> str:
    """Parse vinput RecognitionResult payload: extract commit_text."""
    if not payload:
        return ""
    if payload.startswith("{") and payload.endswith("}"):
        with contextlib.suppress(json.JSONDecodeError, KeyError):
            data = json.loads(payload)
            if isinstance(data, dict) and "commit_text" in data:
                return str(data["commit_text"]).strip()
    return payload.strip()


def sanitize_caption(text: str) -> str:
    return str(text or "").replace("\r", "").replace("\n", "").strip()


def truncate_caption(text: str, max_chars: int) -> str:
    if max_chars <= 0 or len(text) <= max_chars:
        return text
    if max_chars == 1:
        return "…"
    return "…" + text[-(max_chars - 1) :]


def pcm16_rms(chunk: bytes) -> int:
    if not chunk:
        return 0
    samples = array.array("h")
    samples.frombytes(chunk[: len(chunk) - (len(chunk) % 2)])
    if sys.byteorder != "little":
        samples.byteswap()
    if not samples:
        return 0
    total = sum(sample * sample for sample in samples)
    return int((total / len(samples)) ** 0.5)


def get_active_vinput_provider() -> dict[str, object]:
    proc = subprocess.run(
        ["vinput", "-j", "config", "get", "/asr"],
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        timeout=PROVIDER_TIMEOUT,
    )
    data = json.loads(proc.stdout)
    val = data.get("value")
    if isinstance(val, str):
        val = json.loads(val)
    if not isinstance(val, dict):
        raise RuntimeError("vinput:/asr")
    for provider in val.get("providers") or []:
        if (
            isinstance(provider, dict)
            and provider.get("id") == val.get("active_provider")
            and provider.get("type") == "command"
            and provider.get("command")
        ):
            return {
                "id": provider["id"],
                "command": provider["command"],
                "args": provider.get("args") or [],
                "env": provider.get("env") or {},
            }
    raise RuntimeError("vinput:/asr/active_provider")


def is_vinput_recording_active() -> bool:
    try:
        connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        proxy = Gio.DBusProxy.new_sync(
            connection,
            Gio.DBusProxyFlags.DO_NOT_AUTO_START,
            None,
            VINPUT_BUS_NAME,
            VINPUT_OBJECT_PATH,
            VINPUT_INTERFACE,
            None,
        )
        if proxy.get_name_owner() is None:
            return False
        result = proxy.call_sync(
            "GetStatus", None, Gio.DBusCallFlags.NONE, DBUS_TIMEOUT_MS, None
        )
        return result.unpack()[0] != "idle"
    except (GLib.Error, OSError, TypeError) as exc:
        raise RuntimeError("vinput:D-Bus") from exc


class ProviderSession:
    def __init__(
        self,
        events: queue.Queue[tuple[str, str]],
        provider: dict[str, object],
    ) -> None:
        self.events = events
        self.provider = provider
        self.proc: subprocess.Popen[str] | None = None
        self.closed = False
        self.terminating = False
        self.provider_id = str(provider.get("id", ""))

    def start(self) -> None:
        env = os.environ.copy()
        raw_env = self.provider.get("env")
        if isinstance(raw_env, dict):
            for k, v in raw_env.items():
                if k:
                    env[k] = str(v)
        command = str(self.provider["command"])
        args = [str(a) for a in self.provider.get("args") or []]
        self.proc = subprocess.Popen(
            [command, *args],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=None,
            text=True,
            bufsize=1,
            env=env,
        )
        threading.Thread(target=self._read_stdout, daemon=True).start()

    def send_audio(self, chunk: bytes) -> None:
        if not self.proc or self.closed or not self.proc.stdin:
            return
        b64 = base64.b64encode(chunk).decode("ascii")
        event = {"type": "audio", "audio_base64": b64}
        try:
            self.proc.stdin.write(json.dumps(event, ensure_ascii=False) + "\n")
            self.proc.stdin.flush()
        except (BrokenPipeError, OSError):
            self.closed = True

    def finish(self) -> None:
        if not self.proc or self.closed or not self.proc.stdin:
            return
        try:
            self.proc.stdin.write(json.dumps({"type": "finish"}) + "\n")
            self.proc.stdin.flush()
            self.proc.stdin.close()
        except (BrokenPipeError, OSError, ValueError):
            pass
        self.closed = True

    def terminate(self) -> None:
        self.terminating = True
        self.finish()
        if self.proc and self.proc.poll() is None:
            with contextlib.suppress(OSError):
                self.proc.terminate()

    def _read_stdout(self) -> None:
        if not self.proc or not self.proc.stdout:
            return
        try:
            for raw_line in self.proc.stdout:
                line = raw_line.strip()
                if not line:
                    continue
                event = json.loads(line)
                typ = event.get("type")
                text = str(event.get("text") or "").strip()
                if typ in ("partial", "final", "final_timestamps") and text:
                    self.events.put((typ, text))
            code = self.proc.wait()
            if code and not self.terminating:
                self.events.put(("error", str(self.provider["command"])))
        except (OSError, ValueError, AttributeError):
            if not self.terminating:
                self.events.put(("error", str(self.provider["command"])))


class WayhudPresenter:
    def __init__(self) -> None:
        self.proc: subprocess.Popen[str] | None = None
        self.lock = threading.Lock()

    def ensure_process(self) -> bool:
        if self.proc:
            if self.proc.poll() is None:
                return True
            raise RuntimeError("wayhud")
        try:
            self.proc = subprocess.Popen(
                [
                    "wayhud",
                    "-n",
                    "captions",
                    "-s",
                    str(
                        Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
                        / "wayhud/style.css"
                    ),
                    "-s",
                    str(
                        Path(
                            os.environ.get(
                                "XDG_STATE_HOME", Path.home() / ".local/state"
                            )
                        )
                        / "font/wayhud.css"
                    ),
                ],
                stdin=subprocess.PIPE,
                stdout=subprocess.DEVNULL,
                stderr=None,
                text=True,
                bufsize=1,
            )
            return True
        except OSError as exc:
            raise RuntimeError("wayhud") from exc

    def push(self, text: str) -> None:
        with self.lock:
            if not self.ensure_process() or not self.proc or not self.proc.stdin:
                return
            try:
                self.proc.stdin.write(text + "\n")
                self.proc.stdin.flush()
            except (BrokenPipeError, OSError) as exc:
                raise RuntimeError("wayhud") from exc

    def close(self) -> None:
        with self.lock:
            if self.proc:
                with contextlib.suppress(OSError):
                    if self.proc.stdin:
                        self.proc.stdin.close()
                    if self.proc.poll() is None:
                        self.proc.terminate()
                self.proc = None


class CaptionsDaemon:
    def __init__(self) -> None:
        self.events: queue.Queue[tuple[str, str]] = queue.Queue()
        self.stop_event = threading.Event()
        self.audio_proc: subprocess.Popen[bytes] | None = None
        self.current_session: ProviderSession | None = None
        self.session_lock = threading.Lock()
        self.active_provider: dict[str, object] | None = None
        self.last_provider_poll_at = 0.0
        self.voice_input_active = False
        self.presenter = WayhudPresenter()

    def poll_active_provider(self, force: bool = False) -> dict[str, object] | None:
        now = time.monotonic()
        if (
            not force
            and self.active_provider
            and now - self.last_provider_poll_at < PROVIDER_POLL_SECONDS
        ):
            return self.active_provider
        self.last_provider_poll_at = now
        provider = get_active_vinput_provider()
        if (
            provider
            and self.active_provider
            and provider.get("id") != self.active_provider.get("id")
        ):
            self.terminate_session()
        self.active_provider = provider
        return self.active_provider

    def start_session(self) -> ProviderSession | None:
        provider = self.poll_active_provider(force=False)
        if not provider:
            return None
        session = ProviderSession(self.events, provider)
        session.start()
        with self.session_lock:
            self.current_session = session
        return session

    def ensure_session(self) -> ProviderSession | None:
        with self.session_lock:
            cur = self.current_session
        if cur and cur.proc and cur.proc.poll() is None and not cur.closed:
            return cur
        self.terminate_session()
        return self.start_session()

    def finish_session(self) -> None:
        with self.session_lock:
            if self.current_session:
                self.current_session.finish()
                self.current_session = None

    def terminate_session(self) -> None:
        with self.session_lock:
            if self.current_session:
                self.current_session.terminate()
                self.current_session = None

    def _poll_vinput_loop(self) -> None:
        while not self.stop_event.is_set():
            active = is_vinput_recording_active()
            if active != self.voice_input_active:
                self.voice_input_active = active
                if active:
                    self.terminate_session()
            self.stop_event.wait(VINPUT_STATUS_POLL_SECONDS)

    def _listen_dbus_signals(self) -> None:
        """Subscribe to Fcitx5 VInput signals so dictation also shows on HUD."""
        try:
            conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)

            def on_signal(
                _conn: Gio.DBusConnection,
                _sender: str,
                _path: str,
                _interface: str,
                signal_name: str,
                parameters: GLib.Variant,
            ) -> None:
                if signal_name == "RecognitionPartial":
                    text = parameters.unpack()[0] if parameters else ""
                    if text:
                        self.events.put(("partial", text.strip()))
                elif signal_name == "RecognitionResult":
                    raw = parameters.unpack()[0] if parameters else ""
                    commit = parse_dbus_result(raw)
                    if commit:
                        self.events.put(("final", commit))

            conn.signal_subscribe(
                VINPUT_BUS_NAME,
                VINPUT_INTERFACE,
                None,
                VINPUT_OBJECT_PATH,
                None,
                Gio.DBusSignalFlags.NONE,
                on_signal,
            )
            loop = GLib.MainLoop()
            while not self.stop_event.is_set():
                loop.get_context().iteration(False)
                self.stop_event.wait(GLIB_POLL_SECONDS)
        except (GLib.Error, OSError, TypeError) as exc:
            raise RuntimeError("vinput:D-Bus") from exc

    def _run_audio_loop(self) -> None:
        device_args: list[str] = []
        source = os.environ.get("ARCH_CAPTIONS_SOURCE", "")
        if source:
            device_args = [f"--device={source}"]

        try:
            self.audio_proc = subprocess.Popen(
                [
                    "parec",
                    *device_args,
                    "--format=s16le",
                    f"--rate={SAMPLE_RATE}",
                    f"--channels={CHANNELS}",
                ],
                stdout=subprocess.PIPE,
                stderr=None,
            )
        except OSError as exc:
            raise RuntimeError("parec") from exc

        silence_frames = 0
        in_speech = False
        utterance_start = 0.0

        try:
            while not self.stop_event.is_set():
                if not self.audio_proc.stdout:
                    break
                chunk = self.audio_proc.stdout.read(FRAME_BYTES)
                if not chunk:
                    if not self.stop_event.is_set():
                        raise RuntimeError("parec")
                    break

                if self.voice_input_active:
                    in_speech = False
                    silence_frames = 0
                    continue

                rms = pcm16_rms(chunk)
                is_voice = rms >= VOICE_RMS_THRESHOLD

                session = self.ensure_session()
                if session:
                    session.send_audio(chunk)

                if is_voice:
                    if not in_speech:
                        in_speech = True
                        utterance_start = time.monotonic()
                    silence_frames = 0
                elif in_speech:
                    silence_frames += 1

                too_long = (
                    in_speech
                    and (time.monotonic() - utterance_start) > MAX_UTTERANCE_SECONDS
                )
                if in_speech and (
                    silence_frames >= SILENCE_FRAMES_TO_FINISH or too_long
                ):
                    self.finish_session()
                    in_speech = False
                    silence_frames = 0
        finally:
            self.finish_session()

    def worker(self, target: Callable[[], None]) -> None:
        try:
            target()
        except Exception as exc:  # noqa: BLE001 - propagate every worker failure to the service
            if isinstance(exc, subprocess.CalledProcessError):
                name = exc.cmd[0]
            elif isinstance(exc, OSError):
                name = exc.filename or type(exc).__name__
            else:
                name = str(exc) if isinstance(exc, RuntimeError) else type(exc).__name__
            self.events.put(("error", name))

    def run(self) -> None:
        self.presenter.ensure_process()
        for target in (
            self._run_audio_loop,
            self._poll_vinput_loop,
            self._listen_dbus_signals,
        ):
            threading.Thread(target=self.worker, args=(target,), daemon=True).start()
        while not self.stop_event.is_set():
            self.presenter.ensure_process()
            try:
                typ, text = self.events.get(timeout=EVENT_POLL_SECONDS)
                if typ == "error":
                    raise RuntimeError(text)
                clean_text = truncate_caption(sanitize_caption(text), MAX_CAPTION_CHARS)
                if clean_text:
                    self.presenter.push(clean_text)
            except queue.Empty:
                pass

    def stop(self) -> None:
        self.stop_event.set()
        self.finish_session()
        if self.audio_proc and self.audio_proc.poll() is None:
            with contextlib.suppress(OSError):
                self.audio_proc.terminate()
        self.presenter.close()


def is_running() -> bool:
    state = subprocess.check_output(
        ["systemctl", "--user", "show", "--property=ActiveState", "--value", UNIT],
        text=True,
    ).strip()
    if state not in ("active", "activating", "deactivating", "inactive", "failed"):
        fail(1, "cli_unavailable", name=UNIT)
    return state in ("active", "activating", "deactivating")


def cmd_start() -> int:
    if is_running():
        return 0
    require("uwsm")
    require_runtime()
    subprocess.run(
        [
            "uwsm",
            "app",
            "-t",
            "service",
            "-s",
            "b",
            "-u",
            UNIT,
            "-p",
            "PartOf=graphical-session.target",
            "--",
            sys.executable,
            "-B",
            str(Path(__file__).resolve()).replace("$", "$$"),
            "run",
        ],
        check=True,
    )
    return 0


def cmd_stop() -> int:
    if is_running():
        subprocess.run(["systemctl", "--user", "stop", UNIT], check=True)
    return 0


def cmd_toggle() -> int:
    return cmd_stop() if is_running() else cmd_start()


def cmd_status() -> int:
    print("open" if is_running() else "closed")
    return 0


def cmd_run() -> int:
    require_runtime()
    owner = subprocess.check_output(
        ["systemctl", "--user", "show", "--property=MainPID", "--value", UNIT],
        text=True,
    ).strip()
    if owner != str(os.getpid()):
        fail(1, "cli_unavailable", name=UNIT)
    daemon = CaptionsDaemon()

    def on_sig(_s: int, _f: object) -> None:
        daemon.stop()
        sys.exit(130 if _s == signal.SIGINT else 0)

    signal.signal(signal.SIGINT, on_sig)
    signal.signal(signal.SIGTERM, on_sig)

    try:
        daemon.run()
    finally:
        daemon.stop()
    return 0


def main() -> int:
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    if len(sys.argv) <= 2 and action in ("-h", "--help", "help"):
        print(tr("help_captions"))
        return 0
    if len(sys.argv) > 2 or action not in (
        "start",
        "stop",
        "close",
        "hide",
        "kill",
        "toggle",
        "status",
        "state",
        "run",
    ):
        subprocess.run(
            ["custom-i18n", "get", "cli_usage", "command=custom-captions"],
            stdout=sys.stderr,
            check=True,
        )
        return 2
    require("systemctl")
    if action == "start":
        return cmd_start()
    if action in ("stop", "close", "hide", "kill"):
        return cmd_stop()
    if action == "toggle":
        return cmd_toggle()
    if action in ("status", "state"):
        return cmd_status()
    if action == "run":
        return cmd_run()

    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except FileNotFoundError as exc:
        if exc.filename == "custom-i18n":
            print(exc.filename, file=sys.stderr)
        else:
            report_error("cli_dependency", name=exc.filename)
        sys.exit(127)
    except subprocess.CalledProcessError as exc:
        report_error("cli_unavailable", name=exc.cmd[0])
        sys.exit(exc.returncode if exc.returncode in (127, 130) else 1)
    except (OSError, subprocess.TimeoutExpired, ValueError, RuntimeError) as exc:
        name = str(exc) if isinstance(exc, RuntimeError) else type(exc).__name__
        report_error("cli_unavailable", name=name)
        sys.exit(1)
