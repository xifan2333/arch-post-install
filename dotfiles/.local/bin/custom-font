#!/usr/bin/env bash
#
# @name         custom-font
# @summary      Manage, switch, or interactively configure monospace and CJK fallback fonts
# @version      1.0.0
# @deps         fc-list, fc-cache, xmllint, gsettings, fuzzel, notify-send, systemctl
#
# @description  Universal typography manager for River WM desktop.
#               Supports monospace/CJK font selection, atomic configuration rendering, and live reloading.
#
# @usage        custom-font [options] [command] [arguments...]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   init <mono> <cjk>         Initialize missing state; preserve existing fonts
#   menu                      Open interactive font picker via Fuzzel (default)
#   current [mono|cjk|all]    Print active font names
#   list [mono|cjk|all]       List installed candidate fonts
#   set <mono> [cjk]          Set active monospace and fallback CJK fonts atomically
#
# @stdout       Current font names or candidate list
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-font
#   custom-font current
#   custom-font set "JetBrainsMono Nerd Font" "Sarasa Mono SC"

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	if ((BASH_SUBSHELL == 0)); then
		custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	fi
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel uses 1 both for Esc and startup failure; errors distinguish the two.
pick() (
	local selection rc errors
	errors=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-picker.XXXXXX")
	trap 'rm -f -- "$errors"' EXIT
	if selection=$(fuzzel --dmenu --log-level=error "$@" 2>"$errors"); then
		cat "$errors" >&2
		printf '%s' "$selection"
	else
		rc=$?
		cat "$errors" >&2
		if ((rc == 1)) && [[ ! -s "$errors" ]]; then return 0; fi
		if ((rc == 127 || rc == 130)); then exit "$rc"; fi
		die 1 cli_picker_failed
	fi
)

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/font"
fcitx_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fcitx5"
qt_template="${XDG_CONFIG_HOME:-$HOME/.config}/qt6ct/qt6ct.conf.template"
font_size=13
ui_font_size=11
notification_font_size=11
notification_body_font_size=10
candidate_font_size=12
ime_menu_font_size=10

read_fonts() {
	local -n selected_mono="$1" selected_cjk="$2"
	require xmllint
	[[ -f "$state_dir/fonts.conf" ]] || die 1 cli_unavailable "name=$state_dir/fonts.conf"
	xmllint --nonet --noout "$state_dir/fonts.conf"
	local count
	count=$(xmllint --nonet --xpath 'count(/fontconfig/match/edit[@name="family"][@binding="strong"]/string)' "$state_dir/fonts.conf")
	[[ "$count" == 1 ]] || die 1 cli_unavailable "name=$state_dir/fonts.conf"
	selected_mono=$(xmllint --nonet --xpath 'string(/fontconfig/match/edit[@name="family"][@binding="strong"]/string)' "$state_dir/fonts.conf")
	selected_cjk=$(xmllint --nonet --xpath 'string(/fontconfig/alias[family="monospace"]/prefer/family[1])' "$state_dir/fonts.conf")
	[[ -n "$selected_mono" && -n "$selected_cjk" ]] || die 1 cli_unavailable "name=$state_dir/fonts.conf"
}
validate_font() {
	font_argument "$1"
	local installed family
	installed=$(fc-list --format '%{family}\n')
	installed=$(tr ',' '\n' <<<"$installed")
	while IFS= read -r family; do [[ "$family" != "$1" ]] || return 0; done <<<"$installed"
	die 1 cli_unavailable "name=$1"
}
xml_escape() {
	local value="$1"
	value="${value//&/\&amp;}"
	value="${value//</\&lt;}"
	value="${value//>/\&gt;}"
	printf '%s' "$value"
}
css_escape() {
	local value="$1"
	value="${value//\\/\\\\}"
	value="${value//\"/\\\"}"
	printf '%s' "$value"
}
font_argument() {
	# Keep names representable in the line-based config formats and Fuzzel list.
	[[ -n "$1" && "$1" != *[[:cntrl:]:=,\\]* ]] || usage_error
}
sync_fnott() (
	local fnott_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fnott"
	local theme_ini="${XDG_STATE_HOME:-$HOME/.local/state}/theme/fnott.ini"
	local font_ini="$state_dir/fnott.ini"
	local tmp
	mkdir -p -- "$fnott_dir"
	tmp=$(mktemp "$fnott_dir/.fnott.XXXXXX")
	trap 'rm -f -- "$tmp"' EXIT
	if [[ -f "$theme_ini" ]]; then cat -- "$theme_ini" >"$tmp"; fi
	if [[ -f "$font_ini" ]]; then
		printf '\n' >>"$tmp"
		cat -- "$font_ini" >>"$tmp"
	fi
	chmod 644 "$tmp"
	mv -Tf -- "$tmp" "$fnott_dir/fnott.ini"
)
sync_toolkit_fonts() {
	local family="$1, $2" key value
	# GSettings uses quoted GVariant strings, not shell quoting.
	value="'${family//\'/\\\'} $ui_font_size'"
	for key in font-name monospace-font-name document-font-name; do
		gsettings set org.gnome.desktop.interface "$key" "$value"
	done
	gsettings set org.gnome.desktop.wm.preferences titlebar-font "$value"
}
reload_fonts() {
	local title body unit state pids pid path
	require systemctl fc-cache notify-send
	fc-cache
	# Waybar watches the imported font CSS without rebuilding its bars/modules.
	for unit in fnott.service app-org.fcitx.Fcitx5@autostart.service; do
		state=$(systemctl --user show --property=ActiveState --value "$unit")
		if [[ "$state" == active ]]; then
			if [[ "$unit" == fnott.service ]]; then
				systemctl --user restart "$unit"
			else
				systemctl --user reload "$unit"
			fi
		fi
	done
	# Query unit MainPIDs so terminal shells and jobs never receive this signal.
	pids=$(systemctl --user show --property=MainPID --value 'app-*.service' 'custom-*.service')
	for pid in $pids; do
		[[ "$pid" =~ ^[0-9]+$ ]] || die 1 cli_unavailable name=MainPID
		if path=$(readlink "/proc/$pid/exe") && [[ "${path##*/}" == ftty ]]; then
			kill -USR1 "$pid"
		fi
	done
	title=$(t domain_font)
	body=$(t font_switched "font=$1")
	notify-send -a custom-font -h string:x-canonical-private-synchronous:font "$title" "$body"
}
write_fonts() (
	local write_mono="$1" write_cjk="$2" initialize="$3" tmp link_tmp mono_xml cjk_xml mono_css cjk_css qt qt_dir
	local -a cleanup
	require fc-list xmllint flock gsettings
	if [[ "$initialize" == true && -e "$state_dir/fonts.conf" ]]; then read_fonts write_mono write_cjk; fi
	validate_font "$write_mono"
	validate_font "$write_cjk"
	mkdir -p -- "$state_dir"
	exec {lock}<"$state_dir"
	flock "$lock"
	if [[ "$initialize" == true && -e "$state_dir/fonts.conf" ]]; then read_fonts write_mono write_cjk; fi
	tmp=$(mktemp -d "$state_dir/.font.XXXXXX")
	cleanup=("$tmp")
	trap 'rm -rf -- "${cleanup[@]}"' EXIT
	mono_xml=$(xml_escape "$write_mono")
	cjk_xml=$(xml_escape "$write_cjk")
	mono_css=$(css_escape "$write_mono")
	cjk_css=$(css_escape "$write_cjk")
	cat >"$tmp/fonts.conf" <<EOF
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Generated by custom-font -->
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="prepend" binding="strong"><string>$mono_xml</string></edit>
  </match>
  <alias>
    <family>monospace</family>
    <prefer><family>$cjk_xml</family><family>Noto Color Emoji</family></prefer>
  </alias>
</fontconfig>
EOF
	xmllint --nonet --noout "$tmp/fonts.conf"
	printf '* { font-family: "%s", "%s"; }\n' "$mono_css" "$cjk_css" >"$tmp/waybar.css"
	printf 'label { font-family: "%s", "%s"; }\n' "$mono_css" "$cjk_css" >"$tmp/wayhud.css"
	# QFont's INI serialization stores one family; QSS retains the CJK fallback list.
	printf '* { font-family: "%s", "%s"; }\n' "$mono_css" "$cjk_css" >"$tmp/qt.qss"
	for qt in qt5ct qt6ct; do
		qt_dir="${XDG_CONFIG_HOME:-$HOME/.config}/$qt"
		cat -- "$qt_template" >"$tmp/$qt.conf"
		printf '\ncolor_scheme_path="%s"\n\n[Fonts]\ngeneral="%s,%s,-1,5,50,0,0,0,0,0"\nfixed="%s,%s,-1,5,50,0,0,0,0,0"\n\n[Interface]\nstylesheets="%s"\n' \
			"$(css_escape "$qt_dir/colors.conf")" \
			"$mono_css" "$ui_font_size" "$mono_css" "$ui_font_size" \
			"$(css_escape "$state_dir/qt.qss")" >>"$tmp/$qt.conf"
	done
	# Escape Fontconfig's family/point-size separator in literal family names.
	printf '[main]\nfont=%s:size=%s,%s:size=%s\n' "${write_mono//-/\\-}" "$font_size" "${write_cjk//-/\\-}" "$font_size" >"$tmp/fuzzel.ini"
	# The validated names use the same quote escaping in CSS and TOML strings.
	printf '[font]\nfamily = ["%s", "%s", "Noto Color Emoji"]\n' "$mono_css" "$cjk_css" >"$tmp/ftty.toml"
	printf '[main]\ntitle-font=%s,%s:size=%s\nsummary-font=%s,%s:size=%s\nbody-font=%s,%s:size=%s\n' \
		"$write_mono" "$write_cjk" "$notification_font_size" \
		"$write_mono" "$write_cjk" "$notification_font_size" \
		"$write_mono" "$write_cjk" "$notification_body_font_size" >"$tmp/fnott.ini"
	# Fcitx5 caches generic-family matches; give its UI the actual selected pair.
	cat -- "$fcitx_dir/classicui.conf.template" >"$tmp/fcitx5.conf"
	printf '\nFont="%s,%s %s"\nMenuFont="%s,%s %s"\nTrayFont="%s,%s Bold %s"\n' \
		"$mono_css" "$cjk_css" "$candidate_font_size" \
		"$mono_css" "$cjk_css" "$ime_menu_font_size" \
		"$mono_css" "$cjk_css" "$ime_menu_font_size" >>"$tmp/fcitx5.conf"
	# On init the existing authority is preserved byte for byte; only regenerate derivatives.
	if [[ "$initialize" != true || ! -e "$state_dir/fonts.conf" ]]; then
		mv -f -- "$tmp/fonts.conf" "$state_dir/fonts.conf"
	fi
	mv -f -- "$tmp/waybar.css" "$state_dir/waybar.css"
	mv -f -- "$tmp/wayhud.css" "$state_dir/wayhud.css"
	mv -f -- "$tmp/qt.qss" "$state_dir/qt.qss"
	for qt in qt5ct qt6ct; do mv -f -- "$tmp/$qt.conf" "$state_dir/$qt.conf"; done
	mv -f -- "$tmp/fuzzel.ini" "$state_dir/fuzzel.ini"
	mv -f -- "$tmp/ftty.toml" "$state_dir/ftty.toml"
	mv -f -- "$tmp/fnott.ini" "$state_dir/fnott.ini"
	mv -f -- "$tmp/fcitx5.conf" "$state_dir/fcitx5.conf"
	# Bootstrap init establishes this generated-config link; set also converges it.
	mkdir -p -- "$fcitx_dir/conf"
	if [[ ! -L "$fcitx_dir/conf/classicui.conf" || ! "$fcitx_dir/conf/classicui.conf" -ef "$state_dir/fcitx5.conf" ]]; then
		link_tmp=$(mktemp -d "$fcitx_dir/conf/.font.XXXXXX")
		cleanup+=("$link_tmp")
		ln -s -- "$state_dir/fcitx5.conf" "$link_tmp/classicui.conf"
		mv -Tf -- "$link_tmp/classicui.conf" "$fcitx_dir/conf/classicui.conf"
	fi
	# Both plugins watch their config directory, not the symlink target's directory.
	for qt in qt5ct qt6ct; do
		qt_dir="${XDG_CONFIG_HOME:-$HOME/.config}/$qt"
		mkdir -p -- "$qt_dir"
		link_tmp=$(mktemp -d "$qt_dir/.font.XXXXXX")
		cleanup+=("$link_tmp")
		ln -s -- "$state_dir/$qt.conf" "$link_tmp/$qt.conf"
		mv -Tf -- "$link_tmp/$qt.conf" "$qt_dir/$qt.conf"
	done
	sync_fnott
	sync_toolkit_fonts "$write_mono" "$write_cjk"
)
list_fonts() {
	local kind="$1" fonts
	require fc-list
	case "$kind" in
	mono) fonts=$(fc-list :spacing=mono --format '%{family}\n') ;;
	cjk) fonts=$(fc-list :lang=zh-cn --format '%{family}\n') ;;
	all) fonts=$(fc-list --format '%{family}\n') ;;
	esac
	tr ',' '\n' <<<"$fonts" | awk 'NF' | sort -u
}
select_font() {
	local kind="$1" current="$2" fonts font prefix choice index prompt
	local -a rows=() names=()
	fonts=$(list_fonts "$kind")
	[[ -n "$fonts" ]] || return 0
	while IFS= read -r font; do
		prefix='  '
		if [[ "$font" == "$current" ]]; then prefix='* '; fi
		rows+=("${prefix}$font")
		names+=("$font")
	done <<<"$fonts"
	prompt=$(t "font_prompt_$kind")
	choice=$(printf '%s\n' "${rows[@]}" | pick --prompt "$prompt" --index)
	[[ -n "$choice" ]] || return 0
	[[ "$choice" =~ ^[0-9]+$ ]] || die 1 cli_picker_failed
	index=$((10#$choice))
	[[ "$index" == "$choice" ]] || die 1 cli_picker_failed
	((index < ${#names[@]})) || die 1 cli_picker_failed
	printf '%s' "${names[$index]}"
}
menu() {
	local mono cjk selected_mono selected_cjk
	require fuzzel
	read_fonts mono cjk
	selected_mono=$(select_font mono "$mono")
	[[ -n "$selected_mono" ]] || return 0
	selected_cjk=$(select_font cjk "$cjk")
	[[ -n "$selected_cjk" ]] || return 0
	require systemctl fc-cache notify-send
	write_fonts "$selected_mono" "$selected_cjk" false
	reload_fonts "$selected_mono"
}
main() {
	local action="${1:-menu}" kind mono cjk
	if (($#)); then shift; fi
	case "$action" in
	-h | --help | menu) (($# == 0)) || usage_error ;;
	current | list)
		(($# <= 1)) || usage_error
		kind="${1:-all}"
		case "$kind" in mono | cjk | all) ;; *) usage_error ;; esac
		;;
	set)
		(($# == 1 || $# == 2)) || usage_error
		font_argument "$1"
		if (($# == 2)); then font_argument "$2"; fi
		;;
	init)
		(($# == 2)) || usage_error
		font_argument "$1"
		font_argument "$2"
		;;
	*) usage_error ;;
	esac
	case "$action" in
	-h | --help) t help_font ;;
	menu) menu ;;
	current)
		read_fonts mono cjk
		case "$kind" in mono) printf '%s\n' "$mono" ;; cjk) printf '%s\n' "$cjk" ;;
		all) printf 'mono\t%s\ncjk\t%s\n' "$mono" "$cjk" ;; esac
		;;
	list) list_fonts "$kind" ;;
	set)
		if (($# == 1)); then read_fonts mono cjk; else cjk="$2"; fi
		require systemctl fc-cache notify-send
		write_fonts "$1" "$cjk" false
		reload_fonts "$1"
		;;
	init) write_fonts "$1" "$2" true ;;
	esac
}
main "$@"
