#!/usr/bin/env bash
#
# @name         custom-font
# @summary      Manage, switch, or interactively configure monospace and CJK fallback fonts
# @version      1.0.0
# @deps         fontconfig, fuzzel
#
# @description  Universal typography manager for River WM desktop.
#               Supports monospace/CJK font selection, atomic configuration rendering, and live reloading.
#
# @usage        custom-font [options] [command] [arguments...]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   menu                      Open interactive font picker via Fuzzel (default)
#   current [mono|cjk|all]    Print active font names
#   list [mono|cjk|all]       List installed candidate fonts
#   set <mono> [cjk]          Set active monospace and fallback CJK fonts atomically
#
# @stdout       Current font names or candidate list
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-font
#   custom-font current
#   custom-font set "JetBrainsMono Nerd Font" "Sarasa Mono SC"

set -euo pipefail

DOMAIN="font"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/font"
mkdir -p "$state_dir"

show_help() {
	cat <<'EOF'
Usage: custom-font [options] [command] [arguments...]

Options:
  -h, --help                Show this help message and exit

Commands:
  menu                      Open interactive font picker via Fuzzel (default)
  current [mono|cjk|all]    Print active font names
  list [mono|cjk|all]       List installed candidate fonts
  set <mono> [cjk]          Set active monospace and fallback CJK fonts atomically

Examples:
  custom-font
  custom-font current
  custom-font set "JetBrainsMono Nerd Font" "Sarasa Mono SC"
EOF
}

notify() {
	local title body
	title="$(custom-i18n get "domain_${DOMAIN}" 2>/dev/null || echo "Typography")"
	body="$1"
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -a "custom-${DOMAIN}" -h "string:x-canonical-private-synchronous:${DOMAIN}" "$title" "$body"
	fi
}

atomic_write() {
	local target="$1" tmp
	tmp="$target.tmp.$$"
	cat >"$tmp"
	mv -f "$tmp" "$target"
}

get_current_mono() {
	if [[ -f "$state_dir/mono.name" ]]; then
		cat "$state_dir/mono.name"
	else
		fc-match monospace -f '%{family}\n' 2>/dev/null | head -n1 | cut -d, -f1
	fi
}

get_current_cjk() {
	if [[ -f "$state_dir/cjk.name" ]]; then
		cat "$state_dir/cjk.name"
	else
		printf 'Sarasa Mono SC\n'
	fi
}

is_cjk_font() {
	local name="$1"
	if [[ "$name" =~ (Sarasa|CJK|WenKai|Source\ Han|PingFang|Microsoft\ YaHei|SimSun|KaiTi) ]]; then
		return 0
	fi
	return 1
}

get_mono_fonts() {
	local curr_mono="$1" raw
	raw=$(fc-list : family 2>/dev/null |
		tr ',' '\n' |
		sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
		grep -iE "(Nerd Font|Maple Mono|Fira Code|Hack|Iosevka|JetBrains|Source Code|Cascadia)" |
		grep -vE "(Extra|Semi|Light|Thin|Medium|Bold|Black|Italic|NL)" |
		grep -vE "(CJK|Chinese|SC|TC|HK|JP|KR)" |
		sort -u || true)

	if [[ -n "$curr_mono" ]] && echo "$raw" | grep -Fxq "$curr_mono"; then
		printf '%s\n' "$curr_mono"
		echo "$raw" | grep -vFx "$curr_mono" || true
	else
		echo "$raw"
	fi
}

get_cjk_fonts() {
	local curr_cjk="$1" raw
	raw=$(fc-list : family 2>/dev/null |
		tr ',' '\n' |
		sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
		grep -E "^(Sarasa Mono SC|Sarasa UI SC|Sarasa Gothic SC|Noto Sans Mono CJK SC|Noto Sans CJK SC|Source Han Sans CN|LXGW WenKai)" |
		grep -vE "(Black|DemiLight|Light|Medium|Thin|SemiBold|XLight|Extra|Bold|Italic)" |
		sort -u || true)

	if [[ -n "$curr_cjk" ]] && echo "$raw" | grep -Fxq "$curr_cjk"; then
		printf '%s\n' "$curr_cjk"
		echo "$raw" | grep -vFx "$curr_cjk" || true
	else
		echo "$raw"
	fi
}

list_fonts() {
	case "${1:-all}" in
	mono | -m | --mono)
		get_mono_fonts ""
		;;
	cjk | -c | --cjk)
		get_cjk_fonts ""
		;;
	*)
		printf '=== Monospace Fonts ===\n'
		get_mono_fonts ""
		printf '\n=== CJK Fallback Fonts ===\n'
		get_cjk_fonts ""
		;;
	esac
}

show_current() {
	case "${1:-all}" in
	mono | -m | --mono)
		get_current_mono
		;;
	cjk | -c | --cjk)
		get_current_cjk
		;;
	*)
		printf 'Mono: %s\n' "$(get_current_mono)"
		printf 'CJK : %s\n' "$(get_current_cjk)"
		;;
	esac
}

set_fonts() {
	local mono_font="$1" cjk_font="$2"

	# 1. State: Fontconfig monospace & CJK fallback snippet
	atomic_write "$state_dir/fonts.conf" <<EOF
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- Auto-generated by custom-font: DO NOT EDIT DIRECTLY -->
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any"><string>monospace</string></test>
    <edit name="family" mode="prepend" binding="strong">
      <string>$mono_font</string>
    </edit>
  </match>
  <alias>
    <family>monospace</family>
    <prefer>
      <family>$cjk_font</family>
      <family>Noto Color Emoji</family>
    </prefer>
  </alias>
</fontconfig>
EOF

	# 2. State: Waybar typography snippet
	atomic_write "$state_dir/waybar.css" <<EOF
/* Auto-generated by custom-font: DO NOT EDIT DIRECTLY */
* {
    font-family: "$mono_font", "$cjk_font";
}
EOF

	# 3. State: Fuzzel typography snippet
	atomic_write "$state_dir/fuzzel.ini" <<EOF
# Auto-generated by custom-font: DO NOT EDIT DIRECTLY
[main]
font=$cjk_font:size=13
EOF

	# 4. State: Persist font names for quick introspection
	printf '%s\n' "$mono_font" | atomic_write "$state_dir/mono.name"
	printf '%s\n' "$cjk_font" | atomic_write "$state_dir/cjk.name"

	# 5. Broadcast live reloads
	pkill -SIGUSR2 waybar 2>/dev/null || true
	fc-cache 2>/dev/null || true

	notify "$(custom-i18n get font_switched "font=$mono_font" 2>/dev/null || echo "Monospace font switched to: $mono_font")"
	printf '✓ Set active fonts:\n  Mono: %s\n  CJK : %s\n' "$mono_font" "$cjk_font"
}

interactive_menu() {
	local curr_mono curr_cjk
	curr_mono="$(get_current_mono)"
	curr_cjk="$(get_current_cjk)"

	local dmenu_cmd="fuzzel --dmenu --prompt"
	if ! command -v fuzzel &>/dev/null; then
		if command -v bemenu &>/dev/null; then
			dmenu_cmd="bemenu -p"
		else
			dmenu_cmd="head -1"
		fi
	fi

	# Format menu entries with active mark
	format_menu() {
		local curr="$1" raw_list="$2"
		local lines=()
		if [[ -n "$curr" ]]; then
			lines+=("* $curr")
		fi
		while IFS= read -r item; do
			[[ -n "$item" ]] || continue
			[[ "$item" == "$curr" ]] && continue
			lines+=("  $item")
		done <<<"$raw_list"
		printf '%s\n' "${lines[@]}"
	}

	# Step 1: Select Monospace Font
	local prompt_mono prompt_cjk
	prompt_mono="$(custom-i18n get font_prompt_mono 2>/dev/null || echo "Monospace Font: ")"
	prompt_cjk="$(custom-i18n get font_prompt_cjk 2>/dev/null || echo "CJK Font: ")"

	local mono_raw mono_menu selected_mono
	mono_raw="$(get_mono_fonts "$curr_mono")"
	mono_menu="$(format_menu "$curr_mono" "$mono_raw")"
	selected_mono=$(printf '%s\n' "$mono_menu" | $dmenu_cmd "$prompt_mono")
	[[ -n "${selected_mono:-}" ]] || return 0
	selected_mono="${selected_mono#\* }"
	selected_mono="${selected_mono#  }"

	# Step 2: Select CJK Font
	local cjk_raw cjk_menu selected_cjk
	cjk_raw="$(get_cjk_fonts "$curr_cjk")"
	cjk_menu="$(format_menu "$curr_cjk" "$cjk_raw")"
	selected_cjk=$(printf '%s\n' "$cjk_menu" | $dmenu_cmd "$prompt_cjk")
	if [[ -z "${selected_cjk:-}" ]]; then
		selected_cjk="$curr_cjk"
	else
		selected_cjk="${selected_cjk#\* }"
		selected_cjk="${selected_cjk#  }"
	fi

	set_fonts "$selected_mono" "$selected_cjk"
}

main() {
	local action="${1:-menu}"

	case "$action" in
	-h | --help)
		show_help
		exit 0
		;;
	menu)
		interactive_menu
		;;
	current)
		shift
		show_current "${1:-all}"
		;;
	list)
		shift
		list_fonts "${1:-all}"
		;;
	set)
		shift
		if [[ $# -eq 0 ]]; then
			printf 'Error: Missing font arguments for set (run custom-font --help for usage)\n' >&2
			exit 2
		fi
		local mono="$1" cjk="${2:-}"
		if [[ -z "$cjk" ]]; then
			if is_cjk_font "$mono"; then
				cjk="$mono"
				mono="$(get_current_mono)"
			else
				cjk="$(get_current_cjk)"
			fi
		fi
		set_fonts "$mono" "$cjk"
		;;
	*)
		local mono="$1" cjk="${2:-}"
		if [[ -z "$cjk" ]]; then
			if is_cjk_font "$mono"; then
				cjk="$mono"
				mono="$(get_current_mono)"
			else
				cjk="$(get_current_cjk)"
			fi
		fi
		set_fonts "$mono" "$cjk"
		;;
	esac
}

main "$@"
