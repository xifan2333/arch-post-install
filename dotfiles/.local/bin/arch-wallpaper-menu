#!/usr/bin/env bash
# arch:summary=Interactive wallpaper picker (local / online random / Wallhaven search)
# arch:examples=arch wallpaper menu
set -euo pipefail

wall_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/wallpapers"
mkdir -p "$wall_dir"

tr_msg() {
	local key="$1"
	shift
	if command -v arch-i18n >/dev/null 2>&1; then
		arch-i18n get "$key" "$@"
	else
		printf '%s' "$key"
	fi
}

notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$(tr_msg wallpaper_notify_title)" "$1"
	fi
}

# fuzzel-first dmenu wrapper; cancels (Esc) yield an empty selection.
dmenu() {
	local prompt="$1"
	shift
	if command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu --prompt "$prompt" "$@" || true
	elif command -v bemenu >/dev/null 2>&1; then
		bemenu -p "$prompt" || true
	else
		head -n 1
	fi
}

list_images() {
	find "$wall_dir" -maxdepth 1 -type f \
		\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
		-printf '%f\n' 2>/dev/null | sort || true
}

# Generate (once per temp dir) a 96px PNG thumbnail for a local file.
make_thumb() {
	local file="$1"
	local dir="$2"
	local out="$dir/$file.png"
	if [[ ! -f "$out" ]]; then
		timeout 10 magick "$wall_dir/$file" -thumbnail 96x96 "$out" 2>/dev/null || return 1
	fi
	printf '%s' "$out"
}

search_flow() {
	(
		local query page=1 pick id back_label prev_label next_label thumb_dir use_icons=0
		back_label="$(tr_msg wallpaper_back)"
		prev_label="$(tr_msg wallpaper_prev)"
		next_label="$(tr_msg wallpaper_next)"

		if command -v fuzzel >/dev/null 2>&1; then use_icons=1; fi
		query="$(dmenu "$(tr_msg wallpaper_search_prompt)" --lines 0)"
		[[ -n "$query" ]] || return 0

		thumb_dir="$(mktemp -d)"
		trap 'rm -rf "$thumb_dir"' EXIT

		while true; do
			local count=0

			pick="$(
				exec 3< <(arch-wallpaper-search "$query" --page "$page" --thumbs "$thumb_dir" 2>/dev/null)
				{
					local meta
					read -r meta <&3 || true
					count="${meta#* }"
					[[ "$count" =~ ^[0-9]+$ ]] || count=0

					printf '%s\n' "$back_label"
					[[ "$page" -gt 1 ]] && printf '%s\n' "$prev_label"
					[[ "$count" -ge 24 ]] && printf '%s\n' "$next_label"

					local rid rres rpng
					while IFS=$'\t' read -r rid rres rpng; do
						[[ -n "$rid" ]] || continue
						if [[ "$use_icons" -eq 1 && -n "$rpng" && -f "$rpng" ]]; then
							printf '%s\0icon\x1f%s\n' "$rid  $rres" "$rpng"
						else
							printf '%s\n' "$rid  $rres"
						fi
					done <&3
				} | dmenu "$(tr_msg wallpaper_pick_prompt)" --lines 15
			)"
			[[ -n "$pick" ]] || return 0

			if [[ "$pick" == "$back_label" ]]; then
				return 0
			elif [[ "$pick" == "$prev_label" ]]; then
				page=$((page - 1))
				[[ "$page" -lt 1 ]] && page=1
			elif [[ "$pick" == "$next_label" ]]; then
				page=$((page + 1))
			else
				id="${pick%%[[:space:]]*}"
				arch-wallpaper-set "$id"
			fi
		done
	)
}

local_flow() {
	(
		local back_label use_icons=0
		back_label="$(tr_msg wallpaper_back)"
		if command -v fuzzel >/dev/null 2>&1 && command -v magick >/dev/null 2>&1; then use_icons=1; fi

		local thumb_dir
		thumb_dir="$(mktemp -d)"
		trap 'rm -rf "$thumb_dir"' EXIT

		while true; do
			local images curr_wall curr_file pick f img thumb t
			images="$(list_images)"
			if [[ -z "$images" ]]; then
				notify "$(tr_msg wallpaper_none_found dir="$wall_dir")"
				return 0
			fi

			curr_wall="$(arch-wallpaper-current 2>/dev/null || true)"
			curr_file="${curr_wall##*/}"

			pick="$(
				{
					printf '%s\n' "$back_label"

					if [[ -n "$curr_file" && -f "$wall_dir/$curr_file" ]]; then
						if [[ "$use_icons" -eq 1 ]] && thumb="$(make_thumb "$curr_file" "$thumb_dir")"; then
							printf '%s\0icon\x1f%s\n' "* $curr_file" "$thumb"
						else
							printf '%s\n' "* $curr_file"
						fi
					fi

					while IFS= read -r f; do
						[[ -n "$f" ]] || continue
						[[ "$f" == "$curr_file" ]] && continue
						(
							if [[ "$use_icons" -eq 1 ]] && t="$(make_thumb "$f" "$thumb_dir")"; then
								printf '%s\0icon\x1f%s\n' "  $f" "$t"
							else
								printf '%s\n' "  $f"
							fi
						) &
						while (($(jobs -rp | wc -l) >= 8)); do wait -n 2>/dev/null || break; done
					done <<<"$images"
					wait
				} | dmenu "$(tr_msg wallpaper_pick_prompt)" --lines 15
			)"
			[[ -n "$pick" ]] || return 0

			if [[ "$pick" == "$back_label" ]]; then
				return 0
			fi

			local clean_file="${pick#\* }"
			clean_file="${clean_file#  }"
			img="$wall_dir/$clean_file"
			[[ -f "$img" ]] || continue
			arch-wallpaper-set "$img"
		done
	)
}

random_online() {
	local rand_page results chosen id
	rand_page=$(((RANDOM % 30) + 1))

	results="$(arch-wallpaper-search "pixel art" --sorting random --page "$rand_page" 2>/dev/null || true)"
	[[ -n "$results" ]] || results="$(arch-wallpaper-search "pixel art" --sorting random --page 1 2>/dev/null || true)"

	chosen="$(shuf -n 1 <<<"$results" || true)"
	id="${chosen%%[[:space:]]*}"

	if [[ -n "$id" ]]; then
		arch-wallpaper-set "$id"
	else
		notify "$(tr_msg wallpaper_failed)"
	fi
}

main() {
	if ! command -v fuzzel >/dev/null 2>&1 && ! command -v bemenu >/dev/null 2>&1; then
		printf 'Error: fuzzel or bemenu required\n' >&2
		exit 1
	fi

	local local_label rand_online_label search_label
	local_label="$(tr_msg wallpaper_mode_local)"
	rand_online_label="$(tr_msg wallpaper_mode_random_online)"
	search_label="$(tr_msg wallpaper_mode_search)"

	local choice
	choice="$(
		printf '%s\n%s\n%s\n' "$local_label" "$rand_online_label" "$search_label" |
			dmenu "$(tr_msg wallpaper_mode_prompt)" --lines 3
	)"
	[[ -n "$choice" ]] || return 0

	case "$choice" in
	"$local_label") local_flow ;;
	"$rand_online_label") random_online ;;
	"$search_label") search_flow ;;
	esac
}

main "$@"
