#!/usr/bin/env bash
#
# @name         custom-audio
# @summary      Select and switch PipeWire audio output and microphone devices
# @version      1.0.0
# @deps         wpctl, pw-dump, jq, fuzzel
#
# @description  PipeWire audio routing switcher and inspector.
#               Supports querying default devices, switching endpoints, and interactive Fuzzel picker.
#
# @usage        custom-audio [options] [command] [subcommand]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   menu [sink|source]     Open interactive device selection menu via Fuzzel (default)
#   list [sink|source]     Print all available audio nodes to stdout
#   current [sink|source]  Print active default node ID and description
#   set <id> [sink|source] Set default audio endpoint by node ID
#   sink                   Shortcut to open audio output switcher
#   source                 Shortcut to open audio input/microphone switcher
#
# @stdout       Node TSV listing or switched node ID and name
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-audio
#   custom-audio list
#   custom-audio current source
#   custom-audio set 45

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	if ((BASH_SUBSHELL == 0)); then
		custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	fi
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel uses 1 both for Esc and startup failure; errors distinguish the two.
pick() (
	local selection rc errors
	errors=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-picker.XXXXXX")
	trap 'rm -f -- "$errors"' EXIT
	if selection=$(fuzzel --dmenu --log-level=error "$@" 2>"$errors"); then
		cat "$errors" >&2
		printf '%s' "$selection"
	else
		rc=$?
		cat "$errors" >&2
		if ((rc == 1)) && [[ ! -s "$errors" ]]; then return 0; fi
		if ((rc == 127 || rc == 130)); then exit "$rc"; fi
		die 1 cli_picker_failed
	fi
)

resolve_mode() {
	case "$1" in sink) mode=sink ;; source | mic | input) mode=source ;; *) usage_error ;; esac
}
nodes() {
	require pw-dump jq
	pw-dump Node | jq -ce --arg class "Audio/${1^}" '
        if type != "array" then error("invalid PipeWire nodes") else . end |
        [.[] | select(.info.props["media.class"] == $class) |
         select((.info.props["node.name"] // "" | test("\\.monitor$")) | not) |
         {id: .id, name: (.info.props["node.description"] // .info.props["node.nick"] // .info.props["node.name"])}] |
         if all(.[]; (.id | type == "number") and (.name | type == "string" and length > 0))
         then . else error("invalid audio node") end'
}
default_id() {
	local target="@DEFAULT_AUDIO_${1^^}@" inspection id
	require wpctl
	inspection=$(wpctl inspect "$target")
	id=$(awk '$1=="id"{sub(/,/, "", $2); print $2}' <<<"$inspection")
	[[ "$id" =~ ^[0-9]+$ ]] || die 1 cli_unavailable "name=$target"
	printf '%s' "$id"
}
list_devices() {
	local mode="$1" data id
	data=$(nodes "$mode")
	[[ "$data" != '[]' ]] || return 0
	id=$(default_id "$mode")
	jq -r --arg id "$id" '.[] | [.id, (if (.id|tostring) == $id then "*" else "-" end), .name] | @tsv' <<<"$data"
}
current() {
	local mode="$1" data id
	data=$(nodes "$mode")
	[[ "$data" != '[]' ]] || return 0
	id=$(default_id "$mode")
	jq -er --arg id "$id" '[.[] | select((.id|tostring) == $id)] |
        if length == 1 then .[0] | [.id, .name] | @tsv else error("default node missing") end' <<<"$data"
}
set_device() {
	local id="$1" mode="$2" data name title body
	require wpctl notify-send
	data=$(nodes "$mode")
	name=$(jq -er --arg id "$id" '[.[] | select((.id|tostring) == $id)] |
        if length == 1 then .[0].name else error("audio node missing") end' <<<"$data")
	title=$(t domain_audio)
	body=$(t "audio_${mode}_switched" "dev=$name")
	wpctl set-default "$id"
	notify-send -a custom-audio -h string:x-canonical-private-synchronous:audio "$title" "$body"
	printf '%s\t%s\n' "$id" "$name"
}
menu() {
	local mode="$1" devices prompt id marker description prefix choice index glyph='󰓃'
	local -a rows=() ids=()
	require fuzzel
	if [[ "$mode" == source ]]; then glyph='󰍬'; fi
	devices=$(list_devices "$mode")
	[[ -n "$devices" ]] || return 0
	prompt=$(t "audio_${mode}_prompt")
	while IFS=$'\t' read -r id marker description; do
		prefix='  '
		if [[ "$marker" == '*' ]]; then prefix='* '; fi
		rows+=("${prefix}${glyph}  $description  ($id)")
		ids+=("$id")
	done <<<"$devices"
	choice=$(printf '%s\n' "${rows[@]}" | pick --prompt "$prompt" --index)
	[[ -n "$choice" ]] || return 0
	[[ "$choice" =~ ^[0-9]+$ ]] || die 1 cli_picker_failed
	index=$((10#$choice))
	[[ "$index" == "$choice" ]] || die 1 cli_picker_failed
	((index < ${#ids[@]})) || die 1 cli_picker_failed
	set_device "${ids[$index]}" "$mode"
}
main() {
	local action="${1:-menu}" mode
	if (($#)); then shift; fi
	case "$action" in
	-h | --help)
		(($# == 0)) || usage_error
		t help_audio
		return
		;;
	sink | source | mic | input)
		(($# == 0)) || usage_error
		resolve_mode "$action"
		action=menu
		;;
	menu | list | devices | current | get)
		(($# <= 1)) || usage_error
		resolve_mode "${1:-sink}"
		;;
	set)
		(($# == 1 || $# == 2)) || usage_error
		[[ "$1" =~ ^[0-9]+$ ]] || usage_error
		resolve_mode "${2:-sink}"
		;;
	*) usage_error ;;
	esac
	case "$action" in
	menu) menu "$mode" ;; list | devices) list_devices "$mode" ;;
	current | get) current "$mode" ;; set) set_device "$1" "$mode" ;;
	esac
}
main "$@"
