#!/usr/bin/env bash
# arch:summary=Generate terminal QR code for the active Wi-Fi connection
set -euo pipefail

if ! command -v nmcli >/dev/null 2>&1; then
	printf 'Error: nmcli not found\n' >&2
	exit 1
fi

if ! command -v qrencode >/dev/null 2>&1; then
	printf 'Error: qrencode not found. Please install pacman:qrencode\n' >&2
	exit 1
fi

wifi_pass_info=$(nmcli dev wifi show-password 2>/dev/null || true)
if [[ -z "$wifi_pass_info" ]]; then
	printf 'Error: No active Wi-Fi connection found or cannot access password\n' >&2
	exit 1
fi

ssid=$(awk '/SSID:/ { print $2; exit }' <<<"$wifi_pass_info")
pass=$(awk '/(Password|密码):/ { print $2; exit }' <<<"$wifi_pass_info")
sec=$(awk '/(Security|安全性):/ { print $2; exit }' <<<"$wifi_pass_info")

if [[ -z "$ssid" ]]; then
	printf 'Error: Unable to detect SSID\n' >&2
	exit 1
fi

qr_sec="WPA"
[[ "$sec" == *"WEP"* ]] && qr_sec="WEP"
[[ -z "$pass" || "$sec" == *"none"* ]] && qr_sec="nopass"

qr_payload="WIFI:T:${qr_sec};S:${ssid};P:${pass};;"

printf 'Wi-Fi QR Code for %s:\n\n' "$ssid"
qrencode -t UTF8 "$qr_payload"
printf '\nSSID: %s | Password: %s\n' "$ssid" "${pass:-<none>}"
