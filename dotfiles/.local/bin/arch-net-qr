#!/usr/bin/env bash
# arch:summary=Generate terminal QR code for the active iwd Wi-Fi connection
set -euo pipefail

if ! command -v iwctl >/dev/null 2>&1; then
	printf 'Error: iwctl not found. Please install iwd\n' >&2
	exit 1
fi

if ! command -v qrencode >/dev/null 2>&1; then
	printf 'Error: qrencode not found. Please install pacman:qrencode\n' >&2
	exit 1
fi

dev=$(iwctl device list 2>/dev/null | awk '/station/ { print $2; exit }' || true)
[[ -z "$dev" ]] && dev=$(iwctl device list 2>/dev/null | awk 'NR>4 && NF>1 { print $2; exit }' || true)

if [[ -z "$dev" ]]; then
	printf 'Error: No active wireless device found\n' >&2
	exit 1
fi

ssid=$(iwctl station "$dev" show 2>/dev/null | awk -F': ' '/Connected network/ { print $2; exit }' | xargs || true)
if [[ -z "$ssid" ]]; then
	printf 'Error: No active Wi-Fi connection found on %s\n' "$dev" >&2
	exit 1
fi

psk_file="/var/lib/iwd/${ssid}.psk"
pass=""
if [[ -r "$psk_file" ]]; then
	pass=$(awk -F'=' '/^Passphrase=/ { print $2; exit }' "$psk_file" || true)
elif command -v sudo >/dev/null 2>&1; then
	pass=$(sudo awk -F'=' '/^Passphrase=/ { print $2; exit }' "$psk_file" 2>/dev/null || true)
fi

qr_sec="WPA"
[[ -z "$pass" ]] && qr_sec="nopass"

qr_payload="WIFI:T:${qr_sec};S:${ssid};P:${pass};;"

printf 'Wi-Fi QR Code for %s:\n\n' "$ssid"
qrencode -t UTF8 "$qr_payload"
printf '\nSSID: %s | Password: %s\n' "$ssid" "${pass:-<none>}"
