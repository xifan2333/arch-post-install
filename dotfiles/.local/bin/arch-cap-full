#!/usr/bin/env bash
# arch:summary=Capture full screen, save to Pictures/screenshots, and copy to clipboard
# arch:examples=arch cap full
set -euo pipefail

save_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots"
mkdir -p "$save_dir"

filename="screenshot-$(date +%Y%m%d_%H%M%S).png"
filepath="$save_dir/$filename"

grim "$filepath"
wl-copy <"$filepath"

if command -v notify-send >/dev/null 2>&1; then
	notify-send "全屏截图" "已保存至相册并复制到剪贴板:\n$filename"
fi
