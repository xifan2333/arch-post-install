#!/usr/bin/env bash
#
# @name         custom-title
# @summary      Manage or display stream title HUD overlay via wayhud
# @version      1.0.0
# @deps         systemctl, uwsm, wayhud, fuzzel
#
# @description  On-screen stream title banner HUD overlay controller.
#               Manages display text, recent title history, and process lifecycle without PID files.
#
# @usage        custom-title [options] [command] [arguments...]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   get         Print active stream title from history
#   history     Print recent stream title history
#   set <text>  Set stream title and display overlay
#   edit        Open interactive title picker / editor via Fuzzel (default)
#   clear       Clear title history and hide overlay
#   toggle      Toggle title overlay banner on or off
#   start       Start displaying current title banner
#   stop        Hide title banner
#   status      Print current overlay state (open | closed)
#
# @stdout       Title text or status string
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-title get
#   custom-title history
#   custom-title set "Live Coding Session"
#   custom-title edit
#   custom-title clear
#   custom-title toggle

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	if ((BASH_SUBSHELL == 0)); then
		custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	fi
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel uses 1 both for Esc and startup failure; errors distinguish the two.
pick() (
	local selection rc errors
	errors=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-picker.XXXXXX")
	trap 'rm -f -- "$errors"' EXIT
	if selection=$(fuzzel --dmenu --log-level=error "$@" 2>"$errors"); then
		cat "$errors" >&2
		printf '%s' "$selection"
	else
		rc=$?
		cat "$errors" >&2
		if ((rc == 1)) && [[ ! -s "$errors" ]]; then return 0; fi
		if ((rc == 127 || rc == 130)); then exit "$rc"; fi
		die 1 cli_picker_failed
	fi
)

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/custom-title"
style_file="${XDG_CONFIG_HOME:-$HOME/.config}/wayhud/style.css"
font_file="${XDG_STATE_HOME:-$HOME/.local/state}/font/wayhud.css"
history_file="$state_dir/history.txt"
history_limit=30
startup_delay=0.1
unit=custom-title.service

running() {
	local state
	require systemctl
	state=$(systemctl --user show --property=ActiveState --value "$unit") || die 1 cli_unavailable "name=$unit"
	case "$state" in active | activating) return 0 ;; inactive | failed) return 1 ;; *) die 1 cli_unavailable "name=$unit:$state" ;; esac
}
notify() {
	local title body
	title=$(t domain_title)
	body=$(t "$@")
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -a custom-title -h string:x-canonical-private-synchronous:title "$title" "$body"
	fi
}
stop_title() {
	require systemctl
	if running; then systemctl --user stop "$unit"; fi
}
clear_title() (
	require flock
	stop_title
	if [[ -d "$state_dir" ]]; then
		exec {lock}<"$state_dir"
		flock "$lock"
		rm -f -- "$history_file"
		flock -u "$lock"
	fi
	notify overlay_title_history_cleared
)
get_title() {
	if [[ -e "$history_file" ]]; then head -n 1 -- "$history_file"; fi
}
history_title() {
	if [[ -e "$history_file" ]]; then cat -- "$history_file"; fi
}
start_title() {
	local text="$1" data
	[[ -n "$text" ]] || die 1 title_empty
	require wayhud uwsm systemctl base64
	data=$(printf '%s\n' "$text" | base64 -w 0)
	stop_title
	uwsm app -t service -p PartOf=graphical-session.target -s b -u "$unit" -p StandardInput=data -p "StandardInputData=$data" -- wayhud -n title -s "$style_file" -s "$font_file"
	sleep "$startup_delay"
	running || die 1 cli_unavailable "name=$unit"
}
set_title() (
	local title="$1" tmp line
	local -a history=("$title")
	[[ -n "$title" && "$title" != *$'\n'* && "$title" != *$'\r'* ]] || usage_error
	require wayhud flock
	mkdir -p -- "$state_dir"
	# Lock the directory, leaving no second state file behind.
	exec {lock}<"$state_dir"
	flock "$lock"
	if [[ -e "$history_file" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			[[ -n "$line" && "$line" != "$title" ]] || continue
			if ((${#history[@]} < history_limit)); then history+=("$line"); fi
		done <"$history_file"
	fi
	tmp=$(mktemp "$state_dir/.history.XXXXXX")
	trap 'rm -f -- "$tmp"' EXIT
	printf '%s\n' "${history[@]}" >"$tmp"
	mv -f -- "$tmp" "$history_file"
	flock -u "$lock"
	start_title "$title"
)
edit_title() {
	local candidates='' chosen prompt clear_opt
	require fuzzel
	prompt=$(t overlay_title_prompt)
	clear_opt=$(t overlay_title_clear_history)
	if [[ -s "$history_file" ]]; then
		candidates=$(cat -- "$history_file")
		chosen=$(pick --prompt "$prompt" <<<"$clear_opt"$'\n'"$candidates")
	else
		chosen=$(pick --prompt "$prompt" </dev/null)
	fi
	[[ -n "$chosen" ]] || return 0
	if [[ "$chosen" == "$clear_opt" ]]; then
		clear_title
		return 0
	fi
	set_title "$chosen"
}
main() {
	local action="${1:-edit}" title
	if (($#)); then shift; fi
	case "$action" in
	set)
		(($# == 1)) || usage_error
		[[ -n "$1" && "$1" != *$'\n'* && "$1" != *$'\r'* ]] || usage_error
		;;
	get | history | list | edit | clear | clear-history | toggle | start | stop | status | -h | --help) (($# == 0)) || usage_error ;;
	*) usage_error ;;
	esac
	case "$action" in
	-h | --help) t help_title ;;
	get) get_title ;;
	history | list) history_title ;;
	set) set_title "$1" ;;
	clear | clear-history) clear_title ;;
	stop) stop_title ;;
	edit) edit_title ;;
	start)
		title=$(get_title)
		start_title "$title"
		;;
	toggle)
		if running; then
			stop_title
		else
			title=$(get_title)
			start_title "$title"
		fi
		;;
	status) if running; then printf 'open\n'; else printf 'closed\n'; fi ;;
	esac
}
main "$@"
