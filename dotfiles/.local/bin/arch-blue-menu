#!/usr/bin/env luajit
-- arch:summary=Interactive text-only Bluetooth connection menu driven by Fuzzel and bluetoothctl
-- arch:examples=arch blue menu

local function exec_cmd(cmd)
  local p = io.popen(cmd, "r")
  if not p then
    return ""
  end
  local output = p:read("*a") or ""
  p:close()
  return output
end

local function i18n(key, vars)
  local args = { "arch-i18n", "get", key }
  if vars then
    for k, v in pairs(vars) do
      table.insert(args, string.format("%s=%s", k, tostring(v)))
    end
  end
  local quoted = {}
  for _, arg_val in ipairs(args) do
    table.insert(quoted, string.format("%q", arg_val))
  end
  local text = exec_cmd(table.concat(quoted, " "))
  return (text:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function notify(msg)
  local title = i18n("blue_notify_title")
  os.execute(string.format("notify-send %q %q 2>/dev/null", title, msg))
end

local function is_device_connected(mac)
  local info = exec_cmd("bluetoothctl info " .. mac .. " 2>/dev/null")
  return info:find("Connected:%s*yes") ~= nil
end

-- 1. Dependency checks
if os.execute("command -v bluetoothctl >/dev/null 2>&1") ~= 0 then
  io.stderr:write("Error: bluetoothctl not found. Please install bluez-utils\n")
  os.exit(1)
end

if os.execute("command -v fuzzel >/dev/null 2>&1") ~= 0 then
  io.stderr:write("Error: fuzzel not found\n")
  os.exit(1)
end

-- 2. Detect controller & power state
local controller_info = exec_cmd("bluetoothctl show 2>/dev/null")
if controller_info == "" then
  notify(i18n("blue_no_device"))
  os.exit(1)
end

local is_powered = controller_info:match("Powered:%s*([%a]+)")
local prompt_text = i18n("blue_prompt")
local power_on_text = i18n("blue_power_on")
local power_off_text = i18n("blue_power_off")
local rescan_text = i18n("blue_rescan")

-- 3. Handle powered-off state
if is_powered ~= "yes" then
  local tmp = os.tmpname()
  local f = io.open(tmp, "w")
  if f then
    f:write("  " .. power_on_text .. "\n")
    f:close()
  end
  local p = io.popen(
    string.format("fuzzel --dmenu --prompt %q --lines 3 < %q 2>/dev/null", prompt_text, tmp),
    "r"
  )
  local chosen = p and p:read("*l") or ""
  if p then
    p:close()
  end
  os.remove(tmp)

  if chosen:find(power_on_text, 1, true) then
    os.execute("bluetoothctl power on >/dev/null 2>&1")
    os.execute(arg[0] .. " &")
  end
  os.exit(0)
end

-- 4. Collect devices into structured tables
local connected_devs = {}
local paired_devs = {}
local all_devs = {}

for line in exec_cmd("bluetoothctl devices Connected 2>/dev/null"):gmatch("[^\r\n]+") do
  local mac, name = line:match("^Device%s+([%x:]+)%s+(.*)$")
  if mac and name then
    connected_devs[mac] = name
  end
end

for line in exec_cmd("bluetoothctl devices Paired 2>/dev/null"):gmatch("[^\r\n]+") do
  local mac, name = line:match("^Device%s+([%x:]+)%s+(.*)$")
  if mac and name then
    paired_devs[mac] = name
  end
end

for line in exec_cmd("bluetoothctl devices 2>/dev/null"):gmatch("[^\r\n]+") do
  local mac, name = line:match("^Device%s+([%x:]+)%s+(.*)$")
  if mac and name then
    -- Filter out nameless BLE beacon aliases (e.g. 6A-41-9A-4E-65-19)
    local is_dummy = name:match("^%x%x%-%x%x%-%x%x%-%x%x%-%x%x%-%x%x$")
      or name:match("^%x%x:%x%x:%x%x:%x%x:%x%x:%x%x$")
    if not is_dummy then
      all_devs[mac] = name
    end
  end
end

-- 5. Build menu items
local menu_lines = {}
local seen_macs = {}

-- Top actions: disconnect currently active devices
for _, name in pairs(connected_devs) do
  local dis_action = i18n("blue_disconnect", { dev = name })
  table.insert(menu_lines, "  " .. dis_action)
end

table.insert(menu_lines, "  " .. rescan_text)
table.insert(menu_lines, "  " .. power_off_text)

local tag_connected = i18n("blue_tag_connected")
local tag_paired = i18n("blue_tag_paired")
local tag_available = i18n("blue_tag_available")

-- Add connected devices
for mac, name in pairs(connected_devs) do
  table.insert(menu_lines, string.format("* %s %s (%s)", tag_connected, name, mac))
  seen_macs[mac] = true
end

-- Add paired devices
for mac, name in pairs(paired_devs) do
  if not seen_macs[mac] then
    table.insert(menu_lines, string.format("  %s %s (%s)", tag_paired, name, mac))
    seen_macs[mac] = true
  end
end

-- Add discovered devices
for mac, name in pairs(all_devs) do
  if not seen_macs[mac] then
    table.insert(menu_lines, string.format("  %s %s (%s)", tag_available, name, mac))
    seen_macs[mac] = true
  end
end

-- 6. Open Fuzzel dmenu
local tmp = os.tmpname()
local f = io.open(tmp, "w")
if f then
  f:write(table.concat(menu_lines, "\n") .. "\n")
  f:close()
end

local p = io.popen(
  string.format("fuzzel --dmenu --prompt %q --lines 15 < %q 2>/dev/null", prompt_text, tmp),
  "r"
)
local chosen = p and p:read("*l") or ""
if p then
  p:close()
end
os.remove(tmp)

if not chosen or chosen == "" then
  os.exit(0)
end

local action_chosen = chosen:gsub("^%s+", ""):gsub("%s+$", "")

-- 7. Handle action header items
if action_chosen == power_off_text then
  os.execute("bluetoothctl power off >/dev/null 2>&1")
  os.exit(0)
end

if action_chosen == rescan_text then
  os.execute("bluetoothctl --timeout 8 scan on >/dev/null 2>&1")
  os.execute(arg[0] .. " &")
  os.exit(0)
end

for mac, name in pairs(connected_devs) do
  local dis_action = i18n("blue_disconnect", { dev = name })
  if action_chosen == dis_action then
    os.execute("bluetoothctl disconnect " .. mac .. " >/dev/null 2>&1")
    notify(i18n("blue_disconnected", { dev = name }))
    os.exit(0)
  end
end

-- 8. Handle device click (connect / disconnect)
local mac = chosen:match("(%x%x:%x%x:%x%x:%x%x:%x%x:%x%x)")
if not mac then
  os.exit(0)
end

local dev_name = chosen:match("%]%s+(.-)%s+%(") or mac

-- If already connected, disconnect
if connected_devs[mac] then
  os.execute("bluetoothctl disconnect " .. mac .. " >/dev/null 2>&1")
  notify(i18n("blue_disconnected", { dev = dev_name }))
  os.exit(0)
end

-- If already paired, connect directly
if paired_devs[mac] then
  os.execute("bluetoothctl --timeout 10 connect " .. mac .. " >/dev/null 2>&1")
  if is_device_connected(mac) then
    notify(i18n("blue_connected", { dev = dev_name }))
  else
    notify(i18n("blue_failed", { dev = dev_name }))
  end
  os.exit(0)
end

-- Otherwise (new device): trust + pair with NoInputNoOutput auto-confirm + connect
os.execute("bluetoothctl trust " .. mac .. " >/dev/null 2>&1")
os.execute("bluetoothctl --agent NoInputNoOutput --timeout 15 pair " .. mac .. " >/dev/null 2>&1")
os.execute("bluetoothctl --timeout 10 connect " .. mac .. " >/dev/null 2>&1")
if is_device_connected(mac) then
  notify(i18n("blue_connected", { dev = dev_name }))
else
  notify(i18n("blue_failed", { dev = dev_name }))
end
