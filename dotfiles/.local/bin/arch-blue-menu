#!/usr/bin/env bash
# arch:summary=Interactive text-only Bluetooth connection menu driven by Fuzzel and bluetoothctl
# arch:examples=arch blue menu
set -euo pipefail

# 1. Dependency checks
if ! command -v bluetoothctl >/dev/null 2>&1; then
	printf 'Error: bluetoothctl not found. Please install bluez-utils\n' >&2
	exit 1
fi

if ! command -v fuzzel >/dev/null 2>&1; then
	printf 'Error: fuzzel not found\n' >&2
	exit 1
fi

# 2. Notification helper
notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$(arch-i18n get blue_notify_title)" "$1"
	fi
}

# 3. Detect controller and power status
controller_info=$(bluetoothctl show 2>/dev/null || true)
if [[ -z "$controller_info" ]]; then
	notify "$(arch-i18n get blue_no_device)"
	exit 1
fi

is_powered=$(awk -F': ' '/Powered:/ {print $2; exit}' <<<"$controller_info")
prompt_text="$(arch-i18n get blue_prompt)"
power_on_text="$(arch-i18n get blue_power_on)"
power_off_text="$(arch-i18n get blue_power_off)"

# 4. Handle powered-off state
if [[ "$is_powered" != "yes" ]]; then
	chosen=$(printf '  %s\n' "$power_on_text" | fuzzel --dmenu --prompt "$prompt_text" --lines 3 || true)
	action_chosen="${chosen#"${chosen%%[![:space:]]*}"}"
	if [[ "$action_chosen" == "$power_on_text" ]]; then
		bluetoothctl power on >/dev/null 2>&1
		exec "$0"
	fi
	exit 0
fi

tag_connected="$(arch-i18n get blue_tag_connected)"
tag_paired="$(arch-i18n get blue_tag_paired)"
tag_available="$(arch-i18n get blue_tag_available)"

# 5. Continuous streaming generator: instant header + live discovery feed
stream_menu_entries() {
	local connected_raw paired_raw all_raw
	connected_raw=$(bluetoothctl devices Connected 2>/dev/null || true)
	paired_raw=$(bluetoothctl devices Paired 2>/dev/null || true)
	all_raw=$(bluetoothctl devices 2>/dev/null || true)

	local seen_macs=" "

	# Action: Disconnect currently active devices
	if [[ -n "$connected_raw" ]]; then
		while read -r _ mac dev_name; do
			[[ -n "$mac" ]] || continue
			printf '  %s\n' "$(arch-i18n get blue_disconnect "dev=$dev_name")"
		done <<<"$connected_raw"
	fi

	# Action: Power off
	printf '  %s\n' "$power_off_text"

	# Instant List: Connected devices
	if [[ -n "$connected_raw" ]]; then
		while read -r _ mac dev_name; do
			[[ -n "$mac" ]] || continue
			printf '* %s %s (%s)\n' "$tag_connected" "$dev_name" "$mac"
			seen_macs+="$mac "
		done <<<"$connected_raw"
	fi

	# Instant List: Paired but disconnected devices
	if [[ -n "$paired_raw" ]]; then
		while read -r _ mac dev_name; do
			[[ -n "$mac" ]] || continue
			[[ "$seen_macs" == *" $mac "* ]] && continue
			printf '  %s %s (%s)\n' "$tag_paired" "$dev_name" "$mac"
			seen_macs+="$mac "
		done <<<"$paired_raw"
	fi

	# Instant List: Previously discovered devices with real names
	if [[ -n "$all_raw" ]]; then
		while read -r _ mac dev_name; do
			[[ -n "$mac" ]] || continue
			[[ "$seen_macs" == *" $mac "* ]] && continue
			[[ -z "$dev_name" || "$dev_name" =~ ^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$ ]] && continue
			printf '  %s %s (%s)\n' "$tag_available" "$dev_name" "$mac"
			seen_macs+="$mac "
		done <<<"$all_raw"
	fi

	# Asynchronous Live Discovery: continuously stream into Fuzzel
	coproc BT { bluetoothctl 2>/dev/null; }
	# shellcheck disable=SC2153
	local bt_pid="$BT_PID"

	# shellcheck disable=SC2329
	cleanup_scan() {
		if [[ -n "$bt_pid" ]] && kill -0 "$bt_pid" 2>/dev/null; then
			printf 'scan off\nexit\n' >&"${BT[1]}" || true
			kill "$bt_pid" 2>/dev/null || true
		fi
	}
	trap cleanup_scan EXIT

	printf 'scan on\n' >&"${BT[1]}" || true

	while IFS= read -r -u "${BT[0]}" raw_line; do
		local line
		line=$(sed -r 's/\x1B\[[0-9;]*[a-zA-Z]//g' <<<"$raw_line")

		local mac="" name=""
		if [[ "$line" =~ \[NEW\][[:space:]]+Device[[:space:]]+([0-9A-Fa-f:]{17})[[:space:]]+(.*) ]]; then
			mac="${BASH_REMATCH[1]}"
			name="${BASH_REMATCH[2]}"
		elif [[ "$line" =~ \[CHG\][[:space:]]+Device[[:space:]]+([0-9A-Fa-f:]{17})[[:space:]]+Name:[[:space:]]+(.*) ]]; then
			mac="${BASH_REMATCH[1]}"
			name="${BASH_REMATCH[2]}"
		fi

		[[ -n "$mac" ]] || continue
		[[ "$seen_macs" == *" $mac "* ]] && continue
		# Filter out nameless BLE beacon aliases
		[[ -z "$name" || "$name" =~ ^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$ ]] && continue

		printf '  %s %s (%s)\n' "$tag_available" "$name" "$mac"
		seen_macs+="$mac "
	done
}

# 6. Stream entries into Fuzzel dmenu
chosen=$(stream_menu_entries | fuzzel --dmenu --prompt "$prompt_text" --lines 15 || true)

# 7. Stop background scanning immediately upon user selection to free radio bandwidth
bluetoothctl scan off >/dev/null 2>&1 || true

[[ -z "$chosen" ]] && exit 0

action_chosen="${chosen#"${chosen%%[![:space:]]*}"}"

# 8. Handle action header items
if [[ "$action_chosen" == "$power_off_text" ]]; then
	bluetoothctl power off >/dev/null 2>&1
	exit 0
fi

# Check if user clicked a disconnect action
connected_raw=$(bluetoothctl devices Connected 2>/dev/null || true)
if [[ -n "$connected_raw" ]]; then
	while read -r _ mac dev_name; do
		[[ -n "$mac" ]] || continue
		dis_text="$(arch-i18n get blue_disconnect "dev=$dev_name")"
		if [[ "$action_chosen" == "$dis_text" ]]; then
			bluetoothctl disconnect "$mac" >/dev/null 2>&1 || true
			notify "$(arch-i18n get blue_disconnected "dev=$dev_name")"
			exit 0
		fi
	done <<<"$connected_raw"
fi

# 9. Handle device click (connect / disconnect)
mac=$(grep -o -E '([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}' <<<"$chosen" || true)
[[ -z "$mac" ]] && exit 0

dev_name=$(sed -E 's/^[ *]*\[[^]]+\][[:space:]]+//; s/[[:space:]]+\([0-9A-Fa-f:]+\)$//' <<<"$chosen")
[[ -n "$dev_name" ]] || dev_name="$mac"

# If already connected, disconnect
if [[ -n "$connected_raw" ]] && grep -q -F "$mac" <<<"$connected_raw"; then
	bluetoothctl disconnect "$mac" >/dev/null 2>&1 || true
	notify "$(arch-i18n get blue_disconnected "dev=$dev_name")"
	exit 0
fi

# If already paired, connect directly
paired_raw=$(bluetoothctl devices Paired 2>/dev/null || true)
if [[ -n "$paired_raw" ]] && grep -q -F "$mac" <<<"$paired_raw"; then
	if bluetoothctl connect "$mac" >/dev/null 2>&1; then
		notify "$(arch-i18n get blue_connected "dev=$dev_name")"
	else
		notify "$(arch-i18n get blue_failed "dev=$dev_name")"
	fi
	exit 0
fi

# Otherwise, trust + pair + connect newly discovered device
bluetoothctl trust "$mac" >/dev/null 2>&1 || true
if bluetoothctl pair "$mac" >/dev/null 2>&1 && bluetoothctl connect "$mac" >/dev/null 2>&1; then
	notify "$(arch-i18n get blue_connected "dev=$dev_name")"
elif bluetoothctl connect "$mac" >/dev/null 2>&1; then
	notify "$(arch-i18n get blue_connected "dev=$dev_name")"
else
	notify "$(arch-i18n get blue_failed "dev=$dev_name")"
fi
