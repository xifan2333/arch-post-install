#!/usr/bin/env bash
# Universal launcher for WPS Office components with user flags
set -euo pipefail

flags_file="${XDG_CONFIG_HOME:-$HOME/.config}/wps-flags.conf"
if [[ -f "$flags_file" ]]; then
	# shellcheck source=/dev/null
	source "$flags_file"
fi

target_bin="/usr/bin/${0##*/}"
if [[ ! -x "$target_bin" ]]; then
	printf 'Error: %s not found in /usr/bin\n' "${0##*/}" >&2
	exit 1
fi

exec "$target_bin" "$@"
