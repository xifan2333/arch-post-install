#!/usr/bin/env bash
# arch:summary=Manage and control screen video recording via gpu-screen-recorder
# arch:args=[full | area | stop | toggle | status [text|waybar] | menu]
# arch:examples=arch-rec full | arch-rec stop | arch-rec status waybar
set -euo pipefail

REC_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/screenrecord"
REC_PID_FILE="$REC_STATE_DIR/pid"
REC_TARGET_FILE="$REC_STATE_DIR/current_file"
REC_VIDEOS_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}/screenrecords"
mkdir -p "$REC_STATE_DIR" "$REC_VIDEOS_DIR"

notify_rec() {
	local title body
	title="$(arch-i18n get screenrecord_notify_title 2>/dev/null || echo "Screen Recording")"
	body="$1"
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -u "${2:-normal}" "$title" "$body"
	fi
}

notify_waybar() {
	pkill -RTMIN+8 waybar 2>/dev/null || true
}

is_recording() {
	if [[ -f "$REC_PID_FILE" ]]; then
		local pid
		pid="$(cat "$REC_PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
	fi
	return 1
}

rec_stop() {
	if is_recording; then
		local pid filepath=""
		pid="$(cat "$REC_PID_FILE" 2>/dev/null || true)"
		[[ -f "$REC_TARGET_FILE" ]] && filepath="$(cat "$REC_TARGET_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]]; then
			kill -SIGINT "$pid" 2>/dev/null || true
			local timeout=50
			while kill -0 "$pid" 2>/dev/null && ((timeout > 0)); do
				sleep 0.1
				timeout=$((timeout - 1))
			done
		fi
		rm -f "$REC_PID_FILE"
		rm -f "$REC_TARGET_FILE"
		notify_rec "$(arch-i18n get screenrecord_notify_stopped 2>/dev/null || echo "Recording stopped")"
		notify_waybar
		if [[ -n "$filepath" ]]; then
			printf '%s\n' "$filepath"
		fi
	fi
}

rec_start_full() {
	rec_stop >/dev/null 2>&1 || true
	local filename filepath
	filename="screenrecord-$(date +%Y%m%d_%H%M%S).mp4"
	filepath="$REC_VIDEOS_DIR/$filename"
	printf '%s\n' "$filepath" >"$REC_TARGET_FILE"

	gpu-screen-recorder -w screen -f 60 -a default_output -c mp4 -o "$filepath" >/dev/null 2>&1 &
	local pid=$!
	printf '%s\n' "$pid" >"$REC_PID_FILE"
	notify_rec "$(arch-i18n get screenrecord_notify_started_full 2>/dev/null || echo "Started full recording")"
	notify_waybar
}

rec_start_area() {
	rec_stop >/dev/null 2>&1 || true
	local geometry filename filepath
	geometry="$(slurp 2>/dev/null || true)"
	[[ -n "$geometry" ]] || exit 0

	filename="screenrecord-$(date +%Y%m%d_%H%M%S).mp4"
	filepath="$REC_VIDEOS_DIR/$filename"
	printf '%s\n' "$filepath" >"$REC_TARGET_FILE"

	gpu-screen-recorder -w "$geometry" -f 60 -a default_output -c mp4 -o "$filepath" >/dev/null 2>&1 &
	local pid=$!
	printf '%s\n' "$pid" >"$REC_PID_FILE"
	notify_rec "$(arch-i18n get screenrecord_notify_started_area 2>/dev/null || echo "Started area recording")"
	notify_waybar
}

rec_toggle() {
	if is_recording; then
		rec_stop
	else
		rec_start_full
	fi
}

rec_status() {
	local mode="${1:-text}"
	if is_recording; then
		local pid dur
		pid="$(cat "$REC_PID_FILE" 2>/dev/null || echo 0)"
		dur=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d '[:space:]' || echo "0")
		local mins=$((dur / 60)) secs=$((dur % 60))
		local dur_fmt
		dur_fmt=$(printf "%02d:%02d" "$mins" "$secs")
		if [[ "$mode" == "waybar" || "$mode" == "--waybar" ]]; then
			printf '{"text":"%s","alt":"recording","class":"recording","tooltip":"Screen Recording: %s"}\n' "$dur_fmt" "$dur_fmt"
		else
			printf 'recording (%s)\n' "$dur_fmt"
		fi
	else
		if [[ "$mode" == "waybar" || "$mode" == "--waybar" ]]; then
			printf '{"text":"","alt":"idle","class":"idle","tooltip":"Recording Idle"}\n'
		else
			printf 'idle\n'
		fi
	fi
}

dmenu_exec() {
	local prompt="$1"
	if command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu --prompt "$prompt"
	elif command -v bemenu >/dev/null 2>&1; then
		bemenu -p "$prompt"
	else
		head -n 1
	fi
}

rec_menu() {
	local opt_full opt_area opt_stop
	opt_full="$(arch-i18n get rec_menu_full 2>/dev/null || echo "Record Fullscreen")"
	opt_area="$(arch-i18n get rec_menu_area 2>/dev/null || echo "Record Area")"
	opt_stop="$(arch-i18n get rec_menu_stop 2>/dev/null || echo "Stop Recording")"

	local menu_items=()
	if is_recording; then
		menu_items+=("$opt_stop")
	else
		menu_items+=("$opt_full" "$opt_area")
	fi

	local choice
	choice=$(printf '%s\n' "${menu_items[@]}" | dmenu_exec "$(arch-i18n get rec_menu_prompt 2>/dev/null || echo "Recording: ")")
	[[ -n "${choice:-}" ]] || exit 0

	case "$choice" in
	"$opt_full") rec_start_full ;;
	"$opt_area") rec_start_area ;;
	"$opt_stop") rec_stop ;;
	esac
}

main() {
	local act="${1:-status}"
	case "$act" in
	full) rec_start_full ;;
	area) rec_start_area ;;
	stop) rec_stop ;;
	toggle) rec_toggle ;;
	status)
		shift
		rec_status "${1:-text}"
		;;
	menu) rec_menu ;;
	-h | --help | help)
		printf 'Usage: arch-rec [full | area | stop | toggle | status [text|waybar] | menu]\n'
		;;
	*)
		rec_menu
		;;
	esac
}

main "$@"
