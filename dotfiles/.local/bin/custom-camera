#!/usr/bin/env bash
#
# @name         custom-camera
# @summary      Select and control a session-owned webcam picture-in-picture window
# @deps         custom-i18n; status/stop: systemctl; list/start/select: v4l2-ctl, awk, jq
#               start/select: systemctl, uwsm, mpv; select: fuzzel, mktemp, cat, rm
# @usage        custom-camera [status|list|start [device]|toggle|select|stop]
# @options      -h, --help  Print localized usage
# @stdin        Unused
# @stdout       open/closed status or JSON camera records
# @stderr       Diagnostics; usage=2, missing dependency=127, operation failure=1
# @examples     custom-camera list; custom-camera start /dev/video2
#               custom-camera select
#
set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT

MAX_PIP_W=1280
MAX_PIP_H=720
MJPEG_SCORE_FACTOR=1.05
USB_SCORE_FACTOR=1.25
PIP_SIZE=185x185
UNIT=custom-camera.service

t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	# A failed diagnostic must not replace the operation's exit code.
	t "$@" >&2 || :
	exit "$rc"
}
on_error() {
	local rc="$1" line="$2"
	if ((BASH_SUBSHELL == 0)); then
		t cli_failed "command=${0##*/}" "line=$line" >&2 || :
	fi
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }

# Parse only numeric mode data here; jq encodes all device-supplied text.
best_mode() {
	LC_ALL=C awk -v max_w="$MAX_PIP_W" -v max_h="$MAX_PIP_H" -v mjpeg="$MJPEG_SCORE_FACTOR" '
		BEGIN { best_score = -1 }
		/\047MJPG\047/ || tolower($0) ~ /\047mjpeg\047/ { fmt = "mjpeg"; next }
		/\047YUYV\047/ || tolower($0) ~ /\047yuv\047/ { fmt = "yuyv422"; next }
		/\[[0-9]+\]:/ { fmt = ""; w = h = 0; next }
		/Size: Discrete/ {
			if (match($0, /Size: Discrete [0-9]+x[0-9]+/)) {
				size = substr($0, RSTART, RLENGTH)
				sub(/^Size: Discrete /, "", size)
				split(size, dims, "x")
				w = dims[1] + 0; h = dims[2] + 0
			}
			next
		}
		/Interval: Discrete/ && w > 0 && fmt != "" {
			if (!match($0, /\([0-9]+(\.[0-9]+)?[[:space:]]*fps\)/)) next
			fps = substr($0, RSTART + 1, RLENGTH - 2) + 0
			if (fps <= 0) next
			score = w * h * fps * (fmt == "mjpeg" ? mjpeg : 1)
			if (w <= max_w && h <= max_h) {
				if (score > best_score) {
					best_score = score
					best = sprintf("[%d,%d,%d,\"%s\",%.17g]", w, h, int(fps), fmt, score)
				}
			} else if (fallback == "" || score < fallback_score) {
				# Keep the existing oversized-mode comparison using integer FPS.
				fallback_score = w * h * int(fps)
				fallback = sprintf("[%d,%d,%d,\"%s\",%.17g]", w, h, int(fps), fmt, fallback_score)
			}
		}
		END { if (best != "") print best; else if (fallback != "") print fallback }
	'
}
list_cameras() {
	local devices dev name formats mode
	devices=$(LC_ALL=C v4l2-ctl --list-devices)
	printf '%s\n' "$devices" | LC_ALL=C awk '
		function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
		/^[^ \t]/ { name = trim($0); sub(/:+$/, "", name); next }
		/^[ \t]+\/dev\/video/ {
			dev = trim($0)
			printf "%s%c%s%c", dev, 0, (name == "" ? dev : name), 0
		}
	' | while IFS= read -r -d '' dev && IFS= read -r -d '' name; do
		# Metadata-only nodes can reject format queries; retain their stderr.
		if formats=$(LC_ALL=C v4l2-ctl -d "$dev" --list-formats-ext); then
			mode=$(printf '%s\n' "$formats" | best_mode)
			[[ -n "$mode" ]] || continue
			jq -cn --arg device "$dev" --arg name "$name" --argjson mode "$mode" --argjson usb "$USB_SCORE_FACTOR" '
				($name | ascii_downcase | contains("usb") or contains("external")) as $is_usb |
				{device: $device, name: ($name | split("(")[0] | gsub("^\\s+|\\s+$"; "")),
				 width: $mode[0], height: $mode[1], fps: $mode[2], format: $mode[3],
				 is_usb: $is_usb, score: ($mode[4] * (if $is_usb then $usb else 1 end))}'
		fi
	done | jq -sc 'sort_by(-.score)[]'
}

camera_state() {
	local state
	state=$(systemctl --user show --property=ActiveState --value "$UNIT")
	case "$state" in
	active | activating | deactivating) printf 'open\n' ;;
	inactive | failed) printf 'closed\n' ;;
	*) die 1 cli_unavailable "name=$UNIT" ;;
	esac
}
stop_camera() {
	local state
	state=$(camera_state)
	if [[ "$state" == open ]]; then systemctl --user stop "$UNIT"; fi
}
pick_camera() (
	local prompt errors choice rc
	[[ -n "${WAYLAND_DISPLAY:-}" ]] || die 1 cli_unavailable name=WAYLAND_DISPLAY
	require fuzzel mktemp cat rm
	prompt=$(t overlay_cam_prompt)
	errors=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-camera-picker.XXXXXX")
	# The scratch file and cleanup belong only to this picker subshell.
	trap 'rm -f -- "$errors"' EXIT
	if choice=$(fuzzel --dmenu --index --log-level=error --prompt "$prompt" 2>"$errors"); then
		cat "$errors" >&2
	else
		rc=$?
		cat "$errors" >&2
		if ((rc == 1)) && [[ ! -s "$errors" ]]; then return 0; fi
		if ((rc == 130)); then die 130 cli_picker_failed; fi
		die 1 cli_picker_failed
	fi
	choice="${choice#"${choice%%[![:space:]]*}"}"
	choice="${choice%"${choice##*[![:space:]]}"}"
	[[ "$choice" =~ ^(0|[1-9][0-9]{0,5})$ ]] || die 1 cli_picker_failed
	((choice < $1)) || die 1 cli_picker_failed
	printf '%s' "$choice"
)
launch_camera() {
	local camera="$1" dev mode input_conf i state
	local -a cmd
	dev=$(jq -r '.device' <<<"$camera")
	mode=$(jq -r '"video_size=\(.width)x\(.height),input_format=\(.format),framerate=\(.fps)"' <<<"$camera")
	input_conf=$'MBTN_LEFT_DBL cycle-values vf "hflip,crop=ih:ih" "hflip,crop=ih*4/3:ih" "hflip,crop=ih*3/2:ih" "hflip"\nMBTN_MID quit\n'
	cmd=(mpv "av://v4l2:$dev" "--demuxer-lavf-o=$mode"
		--profile=low-latency --untimed --title=pip-camera --wayland-app-id=pip-camera
		--no-osc --no-osd-bar --border=no "--autofit=$PIP_SIZE"
		--keepaspect-window=no --keepaspect=yes --panscan=1.0
		'--vf=hflip,crop=ih:ih' "--input-conf=memory://$input_conf")
	# Escape systemd variable expansion while preserving each argv boundary.
	for i in "${!cmd[@]}"; do cmd[i]="${cmd[i]//\$/\$\$}"; done
	stop_camera
	uwsm app -t service -s b -u "$UNIT" -p PartOf=graphical-session.target -- "${cmd[@]}"
	state=$(camera_state)
	[[ "$state" == open ]] || die 1 cli_unavailable "name=$UNIT"
}

main() {
	local action="${1-status}" state cameras chosen index rows
	local -a records
	if (($#)); then shift; fi
	if [[ "$action" == -h || "$action" == --help || "$action" == help ]] && (($# == 0)); then
		t help_camera
		return
	fi
	case "$action" in
	start)
		(($# <= 1)) || usage_error
		if (($#)) && [[ -z "$1" ]]; then usage_error; fi
		;;
	toggle | select | stop | kill | close | hide | status | state | list) (($# == 0)) || usage_error ;;
	*) usage_error ;;
	esac
	case "$action" in
	stop | kill | close | hide)
		require systemctl
		stop_camera
		return
		;;
	status | state)
		require systemctl
		camera_state
		return
		;;
	start | toggle)
		require systemctl
		state=$(camera_state)
		if [[ "$state" == open ]]; then
			if [[ "$action" == toggle ]]; then stop_camera; fi
			return
		fi
		;;
	esac
	if [[ "$action" != list ]]; then require systemctl uwsm mpv; fi
	require v4l2-ctl awk jq
	cameras=$(list_cameras)
	if [[ "$action" == list ]]; then
		if [[ -n "$cameras" ]]; then printf '%s\n' "$cameras"; fi
		return
	fi
	[[ -n "$cameras" ]] || die 1 overlay_cam_no_device
	mapfile -t records <<<"$cameras"
	if [[ "$action" == select ]]; then
		rows=$(jq -r '"  󰄀  \(.name | gsub("\n"; " ")) (\(.device))  \(.width)x\(.height) @ \(.fps)fps"' <<<"$cameras")
		index=$(pick_camera "${#records[@]}" <<<"$rows")
		[[ -n "$index" ]] || return 0
		chosen="${records[index]}"
	elif (($#)); then
		chosen=$(jq -c --arg device "$1" 'select(.device == $device)' <<<"$cameras")
		[[ -n "$chosen" ]] || die 1 cli_unavailable "name=$1"
	else
		chosen="${records[0]}"
	fi
	launch_camera "$chosen"
}
main "$@"
