#!/usr/bin/env -S PYTHONDONTWRITEBYTECODE=1 python3
#
# @name         custom-camera
# @summary      Select and control a session-owned webcam picture-in-picture window
# @deps         systemctl; start/select: uwsm, mpv, v4l2-ctl; select: fuzzel
# @usage        custom-camera [status|list|start [device]|toggle|select|stop]
# @options      -h, --help  Print localized usage
# @stdin        Unused
# @stdout       open/closed status or JSON camera records
# @stderr       Diagnostics; usage=2, missing dependency=127, operation failure=1
# @examples     custom-camera list; custom-camera start /dev/video2
#               custom-camera select
#
"""Webcam picture-in-picture floating player with v4l2 discovery and MPV."""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True

MAX_PIP_W = 1280
MAX_PIP_H = 720
MJPEG_SCORE_FACTOR = 1.05
USB_SCORE_FACTOR = 1.25
PIP_SIZE = "185x185"
UNIT = "custom-camera.service"


def list_v4l2_cameras() -> list[dict[str, object]]:
    devices: list[tuple[str, str]] = []
    out = subprocess.check_output(["v4l2-ctl", "--list-devices"], text=True)
    cur_name = ""
    for line in out.splitlines():
        if line and not line.startswith(("\t", " ")):
            cur_name = line.strip().rstrip(":")
        elif line.strip().startswith("/dev/video"):
            dev = line.strip()
            devices.append((dev, cur_name or dev))

    cameras: list[dict[str, object]] = []
    for dev, name in devices:
        try:
            out = subprocess.check_output(
                ["v4l2-ctl", "-d", dev, "--list-formats-ext"],
                text=True,
                stderr=None,
            )
            cur_fmt = None
            cur_w, cur_h = 0, 0
            best_w, best_h, best_fps = 0, 0, 0
            best_fmt = "mjpeg"
            best_score = -1.0
            fallback_w, fallback_h, fallback_fps, fallback_fmt = 0, 0, 0, "mjpeg"

            for line in out.splitlines():
                if "'MJPG'" in line or "'mjpeg'" in line.lower():
                    cur_fmt = "mjpeg"
                elif "'YUYV'" in line or "'yuv'" in line.lower():
                    cur_fmt = "yuyv422"
                elif re.search(r"\[\d+\]:", line):
                    cur_fmt = None
                    cur_w, cur_h = 0, 0
                elif "Size: Discrete" in line:
                    m = re.search(r"Size: Discrete (\d+)x(\d+)", line)
                    if m:
                        cur_w, cur_h = int(m.group(1)), int(m.group(2))
                elif "Interval: Discrete" in line and cur_w > 0 and cur_fmt:
                    m = re.search(r"\((\d+(?:\.\d+)?)\s*fps\)", line)
                    if m:
                        fps = float(m.group(1))
                        if fps <= 0:
                            continue
                        score = float(cur_w * cur_h * fps)
                        if cur_fmt == "mjpeg":
                            score *= MJPEG_SCORE_FACTOR
                        if cur_w <= MAX_PIP_W and cur_h <= MAX_PIP_H:
                            if score > best_score:
                                best_score = score
                                best_w = cur_w
                                best_h = cur_h
                                best_fps = int(fps)
                                best_fmt = cur_fmt or "mjpeg"
                        elif fallback_w == 0 or score < (
                            fallback_w * fallback_h * fallback_fps
                        ):
                            fallback_w = cur_w
                            fallback_h = cur_h
                            fallback_fps = int(fps)
                            fallback_fmt = cur_fmt or "mjpeg"

            if best_w == 0 and fallback_w > 0:
                best_w, best_h, best_fps, best_fmt = (
                    fallback_w,
                    fallback_h,
                    fallback_fps,
                    fallback_fmt,
                )

                best_score = float(best_w * best_h * best_fps)

            if best_w > 0:
                is_usb = "usb" in name.lower() or "external" in name.lower()
                clean_name = name.split("(")[0].strip()
                cameras.append(
                    {
                        "device": dev,
                        "name": clean_name,
                        "width": best_w,
                        "height": best_h,
                        "fps": best_fps,
                        "format": best_fmt,
                        "is_usb": is_usb,
                        "score": best_score * (USB_SCORE_FACTOR if is_usb else 1.0),
                    }
                )
        except subprocess.CalledProcessError:
            # Some V4L2 nodes expose metadata only; diagnostics remain on stderr.
            continue

    cameras.sort(key=lambda c: float(c["score"]), reverse=True)
    return cameras


def tr(key: str, **values: object) -> str:
    return subprocess.check_output(
        ["custom-i18n", "get", key, *(f"{k}={v}" for k, v in values.items())],
        text=True,
    ).rstrip("\n")


def fail(code: int, key: str, **values: object) -> None:
    print(tr(key, **values), file=sys.stderr)
    raise SystemExit(code)


def require(*names: str) -> None:
    for name in names:
        if shutil.which(name) is None:
            fail(127, "cli_dependency", name=name)


def prompt_camera_selection(
    cameras: list[dict[str, object]],
) -> dict[str, object] | None:
    if not os.environ.get("WAYLAND_DISPLAY"):
        fail(1, "cli_unavailable", name="WAYLAND_DISPLAY")
    require("fuzzel")
    rows = [
        f"  󰄀  {str(cam['name']).replace(chr(10), ' ')} ({cam['device']})  "
        f"{cam['width']}x{cam['height']} @ {cam['fps']}fps"
        for cam in cameras
    ]
    proc = subprocess.run(
        [
            "fuzzel",
            "--dmenu",
            "--index",
            "--log-level=error",
            "--prompt",
            tr("overlay_cam_prompt"),
        ],
        input="\n".join(rows) + "\n",
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.stderr:
        print(proc.stderr, file=sys.stderr, end="")
    if proc.returncode == 1 and not proc.stderr:
        return None
    if proc.returncode:
        fail(130 if proc.returncode in (130, -2) else 1, "cli_picker_failed")
    index = proc.stdout.strip()
    if not re.fullmatch(r"0|[1-9][0-9]{0,5}", index) or int(index) >= len(cameras):
        fail(1, "cli_picker_failed")
    return cameras[int(index)]


def camera_running() -> bool:
    state = subprocess.check_output(
        ["systemctl", "--user", "show", "--property=ActiveState", "--value", UNIT],
        text=True,
    ).strip()
    if state not in ("active", "activating", "deactivating", "inactive", "failed"):
        fail(1, "cli_unavailable", name=UNIT)
    return state in ("active", "activating", "deactivating")


def stop_camera() -> None:
    if camera_running():
        subprocess.run(["systemctl", "--user", "stop", UNIT], check=True)


def launch_camera(cam: dict[str, object]) -> None:
    stop_camera()
    dev = str(cam["device"])
    w = int(cam["width"])
    h = int(cam["height"])
    fps = int(cam["fps"])
    fmt = str(cam["format"])

    input_conf = (
        'MBTN_LEFT_DBL cycle-values vf "hflip,crop=ih:ih" '
        '"hflip,crop=ih*4/3:ih" "hflip,crop=ih*3/2:ih" "hflip"\n'
        "MBTN_MID quit\n"
    )

    cmd = [
        "mpv",
        f"av://v4l2:{dev}",
        f"--demuxer-lavf-o=video_size={w}x{h},input_format={fmt},framerate={fps}",
        "--profile=low-latency",
        "--untimed",
        "--title=pip-camera",
        "--wayland-app-id=pip-camera",
        "--no-osc",
        "--no-osd-bar",
        "--border=no",
        f"--autofit={PIP_SIZE}",
        "--keepaspect-window=no",
        "--keepaspect=yes",
        "--panscan=1.0",
        "--vf=hflip,crop=ih:ih",
        f"--input-conf=memory://{input_conf}",
    ]

    subprocess.run(
        [
            "uwsm",
            "app",
            "-t",
            "service",
            "-s",
            "b",
            "-u",
            UNIT,
            "-p",
            "PartOf=graphical-session.target",
            "--",
            *(arg.replace("$", "$$") for arg in cmd),
        ],
        check=True,
    )


def main() -> None:
    args = sys.argv[1:]
    action = args[0] if args else "status"
    extra = args[1:]
    if action in ("-h", "--help", "help") and not extra:
        print(tr("help_camera"))
        return
    if action not in (
        "start",
        "toggle",
        "select",
        "stop",
        "kill",
        "close",
        "hide",
        "status",
        "state",
        "list",
    ) or (extra and (action != "start" or len(extra) != 1 or not extra[0])):
        fail(2, "cli_usage", command="custom-camera")
    if action in (
        "status",
        "state",
        "stop",
        "kill",
        "close",
        "hide",
        "toggle",
        "start",
    ):
        require("systemctl")
    if action in ("stop", "kill", "close", "hide"):
        stop_camera()
        return
    if action in ("status", "state"):
        print("open" if camera_running() else "closed")
        return
    if action in ("start", "toggle") and camera_running():
        if action == "toggle":
            stop_camera()
        return
    if action != "list":
        require("systemctl", "uwsm", "mpv")
    require("v4l2-ctl")
    cameras = list_v4l2_cameras()
    if action == "list":
        for camera in cameras:
            print(json.dumps(camera, ensure_ascii=False))
        return
    if not cameras:
        fail(1, "overlay_cam_no_device")
    if action == "select":
        chosen = prompt_camera_selection(cameras)
    elif extra:
        chosen = next((cam for cam in cameras if cam["device"] == extra[0]), None)
        if chosen is None:
            fail(1, "cli_unavailable", name=extra[0])
    else:
        chosen = cameras[0]
    if chosen:
        launch_camera(chosen)
        if not camera_running():
            fail(1, "cli_unavailable", name=UNIT)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except FileNotFoundError as exc:
        if exc.filename == "custom-i18n":
            print(exc.filename, file=sys.stderr)
        else:
            print(tr("cli_dependency", name=exc.filename), file=sys.stderr)
        sys.exit(127)
    except subprocess.CalledProcessError as exc:
        print(tr("cli_unavailable", name=exc.cmd[0]), file=sys.stderr)
        sys.exit(exc.returncode if exc.returncode in (127, 130) else 1)
    except OSError as exc:
        print(tr("cli_unavailable", name=exc.filename), file=sys.stderr)
        sys.exit(1)
