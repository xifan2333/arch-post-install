#!/usr/bin/env bash
#
# @name         custom-wallhaven
# @summary      Search and download wallpapers from Wallhaven API
# @version      1.0.0
# @deps         curl, jq, magick, fuzzel
#
# @description  Wallhaven.cc client for searching, previewing, and downloading desktop wallpapers.
#               Supports CLI ID/URL resolution, keyword searching, and interactive paginated picker.
#
# @usage        custom-wallhaven [options] [command] [arguments...]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   menu [query]            Open interactive fuzzy search and picker via Fuzzel (default)
#   search <query>          Search Wallhaven API and print candidate IDs to stdout
#   random <query>          Download a random matching wallpaper and print its saved path
#   download <id|url> [-o <path|->] Download to a file or byte stream
#
# @stdout       Image bytes (redirected download), saved path (menu/random/-o), or candidate IDs
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-wallhaven search anime
#   custom-wallhaven random 'pixel art'
#   custom-wallhaven download 852109
#   custom-wallhaven menu cyberpunk

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	if ((BASH_SUBSHELL == 0)); then
		custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	fi
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel uses 1 both for Esc and startup failure; errors distinguish the two.
pick() (
	local selection rc errors
	errors=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-picker.XXXXXX")
	trap 'rm -f -- "$errors"' EXIT
	if selection=$(fuzzel --dmenu --log-level=error "$@" 2>"$errors"); then
		cat "$errors" >&2
		printf '%s' "$selection"
	else
		rc=$?
		cat "$errors" >&2
		if ((rc == 1)) && [[ ! -s "$errors" ]]; then return 0; fi
		if ((rc == 127 || rc == 130)); then exit "$rc"; fi
		die 1 cli_picker_failed
	fi
)

api_base=https://wallhaven.cc/api/v1
wall_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/wallpapers"
connect_timeout=5
api_timeout=30
download_timeout=300
max_bytes=52428800
thumbnail_size=96x96
thumbnail_jobs=8

api() {
	local endpoint="$1"
	shift
	local -a args=(-fsSL --connect-timeout "$connect_timeout" --max-time "$api_timeout" -G)
	if [[ -n "${WALLHAVEN_API_KEY:-}" ]]; then args+=(--data-urlencode "apikey=$WALLHAVEN_API_KEY"); fi
	curl "${args[@]}" "$@" "$api_base/$endpoint"
}
search_json() {
	api search --data-urlencode "q=$1" --data-urlencode "page=$2" \
		--data-urlencode categories=111 --data-urlencode purity=100 \
		--data-urlencode "sorting=$3" --data-urlencode order=desc --data-urlencode atleast=1920x1080 |
		jq -ce 'if (.data | type == "array") then . else error("invalid Wallhaven response") end'
}
resolve_url() {
	local target="$1" id
	if [[ "$target" =~ ^https?://(www\.)?wallhaven\.cc/w/([A-Za-z0-9]+)/?$ ]]; then
		id="${BASH_REMATCH[2]}"
	elif [[ "$target" =~ ^[A-Za-z0-9]+$ ]]; then
		id="$target"
	elif [[ "$target" =~ ^https?:// ]]; then
		printf '%s' "$target"
		return
	else usage_error; fi
	api "w/$id" | jq -er '.data.path | select(type == "string" and test("^https?://"))'
}
download() (
	local target="$1" output="$2" url filename tmp
	require curl jq
	url=$(resolve_url "$target")
	if [[ "$output" == - ]]; then
		curl -fsSL --connect-timeout "$connect_timeout" --max-time "$download_timeout" --max-filesize "$max_bytes" "$url"
		return
	fi
	if [[ -z "$output" ]]; then
		filename="${url%%\?*}"
		filename="${filename##*/}"
		[[ -n "$filename" && "$filename" != . && "$filename" != .. ]] || die 1 cli_unavailable name=URL
		output="$wall_dir/$filename"
	fi
	mkdir -p -- "$(dirname -- "$output")"
	tmp=$(mktemp "$(dirname -- "$output")/.wallhaven.XXXXXX")
	trap 'rm -f -- "$tmp"' EXIT
	curl -fsSL --connect-timeout "$connect_timeout" --max-time "$download_timeout" --max-filesize "$max_bytes" -o "$tmp" "$url"
	[[ -s "$tmp" ]] || die 1 cli_unavailable name=download
	mv -f -- "$tmp" "$output"
	printf '%s\n' "$output"
)
random() {
	local response url
	require curl jq
	response=$(search_json "$1" 1 random)
	[[ $(jq '.data | length' <<<"$response") != 0 ]] || die 1 wallpaper_none_found
	url=$(jq -er '.data[0].path | select(type == "string" and test("^https?://"))' <<<"$response")
	download "$url" ''
}
menu() (
	local query="$1" page=1 response count last index choice prompt label tmp entry id resolution thumb i
	local -a entries=() ids=() thumbnails=()
	require fuzzel
	if [[ -z "$query" ]]; then
		prompt=$(t wallpaper_search_prompt)
		query=$(pick --prompt "$prompt" --lines 0 </dev/null)
	fi
	[[ -n "$query" ]] || return 0
	require curl jq magick xargs
	tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-wallhaven.XXXXXX")
	trap 'rm -rf -- "$tmp"' EXIT
	while :; do
		response=$(search_json "$query" "$page" date_added)
		count=$(jq '.data | length' <<<"$response")
		((count)) || return 0
		last=$(jq -er '.meta.last_page | select(type == "number" and . >= 1)' <<<"$response")
		entries=()
		ids=()
		thumbnails=()
		label=$(t wallpaper_back)
		entries+=("↩  $label")
		ids+=(back)
		if ((page > 1)); then
			label=$(t wallpaper_prev)
			entries+=("◀  $label")
			ids+=(prev)
		fi
		if ((page < last)); then
			label=$(t wallpaper_next)
			entries+=("▶  $label")
			ids+=(next)
		fi
		# Validate the whole page before scheduling thumbnail work.
		for ((i = 0; i < count; i++)); do
			entry=$(jq -c --argjson i "$i" '.data[$i]' <<<"$response")
			id=$(jq -er '.id | select(type == "string" and test("^[A-Za-z0-9]+$"))' <<<"$entry")
			resolution=$(jq -er '.resolution | strings' <<<"$entry")
			thumb=$(jq -er '.thumbs.large | select(type == "string" and test("^https?://"))' <<<"$entry")
			thumbnails+=("$thumb" "$tmp/$id.png")
			entries+=("$id  $resolution")
			ids+=("$id")
		done
		# xargs bounds concurrency, waits for workers, and fails if any pipeline fails.
		# Positional parameters expand in each worker, not in this parent shell.
		# shellcheck disable=SC2016
		printf '%s\0' "${thumbnails[@]}" | xargs -0 -r -n 2 -P "$thumbnail_jobs" bash -o pipefail -c '
            curl -fsSL --connect-timeout "$1" --max-time "$2" --max-filesize "$3" "$5" |
                magick - -thumbnail "$4" "$6"
        ' bash "$connect_timeout" "$api_timeout" "$max_bytes" "$thumbnail_size"
		prompt=$(t wallpaper_search_page_prompt "page=$page")
		choice=$(
			for i in "${!entries[@]}"; do
				case "${ids[$i]}" in
				back | prev | next) printf '%s\n' "${entries[$i]}" ;;
				*) printf '%s\0icon\x1f%s/%s.png\n' "${entries[$i]}" "$tmp" "${ids[$i]}" ;;
				esac
			done | pick --prompt "$prompt" --index
		)
		[[ -n "$choice" ]] || return 0
		[[ "$choice" =~ ^[0-9]+$ ]] || die 1 cli_picker_failed
		index=$((10#$choice))
		[[ "$index" == "$choice" ]] || die 1 cli_picker_failed
		((index < ${#ids[@]})) || die 1 cli_picker_failed
		case "${ids[$index]}" in
		back) return 0 ;;
		prev) page=$((page - 1)) ;;
		next) page=$((page + 1)) ;;
		*)
			download "${ids[$index]}" ''
			return
			;;
		esac
	done
)
main() {
	local action="${1:-menu}" output='' target response
	if (($#)); then shift; fi
	case "$action" in
	-h | --help)
		(($# == 0)) || usage_error
		t help_wallhaven
		;;
	menu)
		(($# <= 1)) || usage_error
		menu "${1:-}"
		;;
	search)
		(($# == 1)) && [[ -n "$1" ]] || usage_error
		require curl jq
		response=$(search_json "$1" 1 date_added)
		jq -r '.data[] | .id | if type == "string" then . else error("invalid wallpaper id") end' <<<"$response"
		;;
	random)
		(($# == 1)) && [[ -n "$1" ]] || usage_error
		random "$1"
		;;
	download)
		(($# == 1 || $# == 3)) || usage_error
		target="$1"
		[[ "$target" =~ ^[A-Za-z0-9]+$ || "$target" =~ ^https?:// ]] || usage_error
		if (($# == 3)); then
			[[ "$2" == -o || "$2" == --output ]] && [[ -n "$3" ]] || usage_error
			output="$3"
		elif [[ ! -t 1 ]]; then output=-; fi
		download "$target" "$output"
		;;
	*) usage_error ;;
	esac
}
main "$@"
