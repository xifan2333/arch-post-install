#!/usr/bin/env bash
# arch:summary=Show Wi-Fi frequency band and iwd roaming status
set -euo pipefail

if ! command -v iwctl >/dev/null 2>&1; then
	printf 'Error: iwctl not found. Please install iwd\n' >&2
	exit 1
fi

dev=$(iwctl device list 2>/dev/null | awk '/station/ { print $2; exit }' || true)
[[ -z "$dev" ]] && dev=$(iwctl device list 2>/dev/null | awk 'NR>4 && NF>1 { print $2; exit }' || true)

if [[ -z "$dev" ]]; then
	printf 'Error: No wireless device found\n' >&2
	exit 1
fi

station_info=$(iwctl station "$dev" show 2>/dev/null || true)
state=$(awk -F': ' '/State/ { print $2; exit }' <<<"$station_info" | xargs || true)
connected_network=$(awk -F': ' '/Connected network/ { print $2; exit }' <<<"$station_info" | xargs || true)

printf 'Wireless Device: %s\n' "$dev"
printf 'Current State:   %s\n' "${state:-disconnected}"

if [[ -n "$connected_network" ]]; then
	printf 'Connected SSID:  %s\n' "$connected_network"
	freq=$(iw dev "$dev" link 2>/dev/null | awk '/freq:/ { print $2; exit }' || true)
	if [[ -n "$freq" ]]; then
		if ((freq >= 5000)); then
			printf 'Frequency Band:  5 GHz (%s MHz)\n' "$freq"
		else
			printf 'Frequency Band:  2.4 GHz (%s MHz)\n' "$freq"
		fi
	fi
fi

printf '\nHint: iwd natively prioritizes 5GHz networks and optimizes roaming via kernel RSSI metrics.\n'
