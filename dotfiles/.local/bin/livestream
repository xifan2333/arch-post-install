#!/bin/bash
# Public livestream CLI. The Python daemon and danmaku sidecar stay internal.

set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
# shellcheck disable=SC1091
source "$SCRIPT_DIR/i18n-core"

SERVICE="$SCRIPT_DIR/livestream-service"
DANMAKU="$SCRIPT_DIR/livestream-danmaku"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/livestream"
CONFIG_FILE="$CONFIG_DIR/config.json"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/livestream-$UID}/livestream"
LOG_FILE="$RUNTIME_DIR/livestream.log"

notify() {
    local body="$1" urgency="${2:-normal}"
    if command -v notify-send > /dev/null 2>&1; then
        notify-send -u "$urgency" "$(msg livestream_notify_title)" "$body"
    fi
}

is_active() {
    "$SERVICE" is-active > /dev/null 2>&1
}

ensure_dirs() {
    install -d -m 700 "$CONFIG_DIR" "$RUNTIME_DIR"
    [ -f "$CONFIG_FILE" ] && chmod 600 "$CONFIG_FILE"
}

check_deps() {
    local cmd
    for cmd in gpu-screen-recorder ffmpeg pactl ss "$SERVICE"; do
        if ! command -v "$cmd" > /dev/null 2>&1; then
            printf 'Error: %s is not installed\n' "$cmd" >&2
            return 1
        fi
    done
}

unmute_audio() {
    command -v pactl > /dev/null 2>&1 || return 0
    local source
    source=$(pactl get-default-source 2> /dev/null || true)
    if [ -n "$source" ]; then
        pactl set-source-mute "$source" 0 2> /dev/null || true
    fi
}

open_danmaku() {
    [ -x "$DANMAKU" ] || return 0
    "$DANMAKU" start > /dev/null 2>&1 &
}

close_danmaku() {
    [ -x "$DANMAKU" ] || return 0
    "$DANMAKU" stop > /dev/null 2>&1 &
}

start_stream() {
    local target="${1:-portal}" capture_target rc

    ensure_dirs
    check_deps || return 4
    case "$target" in
        full) capture_target=screen ;;
        *) capture_target=$target ;;
    esac

    if is_active; then
        return 2
    fi
    "$SERVICE" validate --config "$CONFIG_FILE" > /dev/null 2>&1 || return 3

    unmute_audio
    setsid "$SERVICE" run \
        --config "$CONFIG_FILE" \
        --target "$capture_target" \
        --audio-source "default_output|default_input" \
        --framerate 30 \
        --keyint 2 \
        --scale-width 0 \
        --log-file "$LOG_FILE" \
        > /dev/null 2>&1 &

    "$SERVICE" wait-ready --timeout 30
    rc=$?
    case "$rc" in
        0)
            open_danmaku
            return 0
            ;;
        *)
            "$SERVICE" stop --timeout 7 > /dev/null 2>&1 || true
            return 4
            ;;
    esac
}

stop_stream() {
    local rc=0
    "$SERVICE" stop --timeout 7 || rc=$?
    if [ "$rc" -eq 0 ]; then
        close_danmaku
    fi
    return "$rc"
}

cmd_start() {
    local target="${1:-portal}" rc=0
    if is_active; then
        notify "$(msg livestream_notify_already_active)"
        return 0
    fi
    start_stream "$target" || rc=$?
    case "$rc" in
        0) notify "$(msg livestream_notify_started_full)" ;;
        2) notify "$(msg livestream_notify_already_active)" ;;
        3) notify "$(msg livestream_notify_missing_rtmp)" ;;
        *) notify "$(msg livestream_notify_start_failed)" critical ;;
    esac
    return "$rc"
}

cmd_stop() {
    local rc=0
    if ! is_active; then
        notify "$(msg livestream_notify_not_active)"
        return 0
    fi
    stop_stream || rc=$?
    if [ "$rc" -eq 0 ]; then
        notify "$(msg livestream_notify_stopped)"
    else
        notify "$(msg livestream_notify_stop_failed)" critical
    fi
    return "$rc"
}

cmd_toggle() {
    if is_active; then
        cmd_stop
    else
        cmd_start "${1:-portal}"
    fi
}

case "${1:-status}" in
    start)
        shift
        cmd_start "${1:-portal}"
        ;;
    stop)
        cmd_stop
        ;;
    toggle)
        shift
        cmd_toggle "${1:-portal}"
        ;;
    status)
        "$SERVICE" status
        ;;
    is-active)
        is_active
        ;;
    config)
        exec "${OMARCHY_PATH:-/usr/share/omarchy}"/bin/omarchy-shell xifan.livestream-config toggle
        ;;
    -h | --help)
        cat << EOF
Usage: livestream [start|stop|toggle|status|is-active|config] [portal|full]
EOF
        ;;
    *)
        echo "Unknown command: $1" >&2
        exit 1
        ;;
esac
