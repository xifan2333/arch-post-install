#!/bin/bash
# Livestream CLI: start, stop, toggle, and query multi-platform streaming.

set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
# shellcheck disable=SC1091
source "$SCRIPT_DIR/livestream-core"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/i18n-core"

notify() {
    local body="$1" urgency="${2:-normal}"
    if command -v notify-send > /dev/null 2>&1; then
        notify-send -u "$urgency" "$(msg livestream_notify_title)" "$body"
    fi
}

cmd_start() {
    local target="${1:-portal}"
    if livestream_is_active; then
        notify "$(msg livestream_notify_already_active)"
        return 0
    fi

    local rc=0
    livestream_start "$target" || rc=$?
    case "$rc" in
        0) notify "$(msg livestream_notify_started_full)" ;;
        2) notify "$(msg livestream_notify_already_active)" ;;
        3) notify "$(msg livestream_notify_missing_rtmp)" ;;
        *) notify "$(msg livestream_notify_start_failed)" critical ;;
    esac
    return "$rc"
}

cmd_stop() {
    if ! livestream_is_active; then
        notify "$(msg livestream_notify_not_active)"
        return 0
    fi

    local rc=0
    livestream_stop || rc=$?
    if [ "$rc" -eq 0 ]; then
        notify "$(msg livestream_notify_stopped)"
    else
        notify "$(msg livestream_notify_stop_failed)" critical
    fi
    return "$rc"
}

cmd_toggle() {
    local target="${1:-portal}"
    if livestream_is_active; then
        cmd_stop
    else
        cmd_start "$target"
    fi
}

cmd_status() {
    if [[ "${1:-}" == "--active" || "${1:-}" == "is-active" ]]; then
        livestream_is_active
        return $?
    fi
    livestream_status_report
}

case "${1:-status}" in
    start)
        shift
        cmd_start "${1:-portal}"
        ;;
    stop)
        cmd_stop
        ;;
    toggle)
        shift
        cmd_toggle "${1:-portal}"
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    is-active)
        livestream_is_active
        ;;
    config)
        exec "${OMARCHY_PATH:-/usr/share/omarchy}"/bin/omarchy-shell xifan.livestream-config toggle
        ;;
    -h | --help)
        cat << EOF
Usage: livestream [start|stop|toggle|status|is-active|config] [portal|full]
EOF
        ;;
    *)
        echo "Unknown command: $1" >&2
        exit 1
        ;;
esac
