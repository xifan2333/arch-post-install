#!/usr/bin/env bash
#
# @name         custom-i18n
# @summary      Query and retrieve localized UI strings based on system language
# @version      1.0.0
# @deps         jq
#
# @description  Universal internationalization query client for desktop scripts.
#               Resolves dictionary strings from XDG config with variable interpolation.
#
# @usage        custom-i18n [options] <command> [arguments...]
#
# @options
#   -h, --help  Show this help message and exit
#   -q, --quiet Suppress diagnostic logs
#   --json      Output raw JSON dictionary or result
#
# @commands
#   get <key> [var=val...]  Query localized string for key with optional variable replacements
#   get -                   Read keys line-by-line from stdin stream
#   current                 Print detected active language code (zh-cn | en-us)
#   list                    Print all available key-value pairs in active dictionary
#   env                     Generate associative array declaration for bash sourcing
#
# @stdin        Accepts key name or stream of key names when using 'get -'
# @stdout       Localized string value(s) or dictionary dump
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-i18n get domain_audio
#   custom-i18n get audio_volume_changed vol=65%
#   echo domain_wifi | custom-i18n get -
#   custom-i18n current

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1"
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?"' ERR

show_help() {
	printf '%s\n' 'Usage: custom-i18n {get <key|-> [name=value...]|current|list [--json]|env}'
}

fail() {
	printf 'custom-i18n: %s\n' "$2" >&2
	exit "$1"
}

detect_language() {
	local raw="${LC_ALL:-${LC_MESSAGES:-${LANG:-C}}}"
	case "${raw,,}" in
	zh | zh_* | zh-*) printf '%s\n' zh-cn ;;
	en | en_* | en-* | c | c.* | posix) printf '%s\n' en-us ;;
	*) fail 1 "unsupported locale: $raw" ;;
	esac
}

resolve_key() {
	local key="$1" value pair name replacement
	shift
	value=$(jq -er --arg key "$key" '.[$key] | if type == "string" then . else error("missing translation: " + $key) end' "$dict")
	for pair in "$@"; do
		name="${pair%%=*}"
		replacement="${pair#*=}"
		value="${value//\{$name\}/"$replacement"}"
	done
	printf '%s\n' "$value"
}

main() {
	(($#)) || fail 2 'missing command (see --help)'
	local command="$1" pair lang dict entries entry key value
	shift
	case "$command" in
	-h | --help)
		(($# == 0)) || fail 2 'unexpected arguments'
		show_help
		return
		;;
	current | env) (($# == 0)) || fail 2 'unexpected arguments' ;;
	list) (($# == 0)) || { (($# == 1)) && [[ "$1" == --json ]]; } || fail 2 'expected list [--json]' ;;
	get)
		(($#)) || fail 2 'missing key (use get - for stdin)'
		for pair in "${@:2}"; do
			[[ "$pair" =~ ^[a-zA-Z_][a-zA-Z_0-9]*= ]] || fail 2 "invalid replacement: $pair"
		done
		;;
	*) fail 2 "unknown command: $command" ;;
	esac
	lang=$(detect_language)
	if [[ "$command" == current ]]; then
		printf '%s\n' "$lang"
		return
	fi
	command -v jq >/dev/null || fail 127 'missing dependency: jq'
	dict="${XDG_CONFIG_HOME:-$HOME/.config}/i18n/$lang.json"
	[[ -r "$dict" ]] || fail 1 "dictionary not readable: $dict"
	jq -e 'type == "object" and all(.[]; type == "string")' "$dict" >/dev/null
	case "$command" in
	get)
		key="$1"
		shift
		if [[ "$key" == - ]]; then
			while IFS= read -r key || [[ -n "$key" ]]; do
				[[ -n "$key" ]] || continue
				resolve_key "$key" "$@"
			done
		else resolve_key "$key" "$@"; fi
		;;
	list)
		if (($#)); then
			cat -- "$dict"
		else jq -r 'to_entries[] | "\(.key): \(.value)"' "$dict"; fi
		;;
	env)
		entries=$(jq -c 'to_entries[]' "$dict")
		printf 'declare -gA i18n\n'
		while IFS= read -r entry; do
			[[ -n "$entry" ]] || continue
			key=$(jq -r '.key' <<<"$entry")
			value=$(jq -r '.value' <<<"$entry")
			printf 'i18n[%q]=%q\n' "$key" "$value"
		done <<<"$entries"
		;;
	esac
}
main "$@"
