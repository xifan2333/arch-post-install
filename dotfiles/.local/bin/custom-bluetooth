#!/usr/bin/env python3
#
# @name         custom-bluetooth
# @summary      Manage Bluetooth adapters and stream discovered devices into Fuzzel
# @deps         python3, python-gobject, custom-i18n; menu: fuzzel, notify-send
#               pairing: bluetoothctl
# @usage        custom-bluetooth [menu|scan|list|status|connect <mac|name>|
#               disconnect [mac|name]|remove <mac|name>|clear|toggle|off]
# @options      -h, --help  Print localized usage without contacting the backend
# @stdin        Unused; explicit arguments select devices
# @stdout       Escaped TSV listings, status fields, or operation results
# @stderr       Diagnostics; exits 2 for usage, 127 for missing tools, 1 for failures
# @examples     custom-bluetooth list; custom-bluetooth status; custom-bluetooth menu;
#               custom-bluetooth remove <mac|name>; custom-bluetooth clear
#
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
from collections.abc import Callable
from contextlib import suppress
from typing import NamedTuple

sys.dont_write_bytecode = True

ADAPTER = "org.bluez.Adapter1"
DEVICE = "org.bluez.Device1"
PROPERTIES = "org.freedesktop.DBus.Properties"
OBJECTS = "org.freedesktop.DBus.ObjectManager"
DBUS_TIMEOUT_MS = 25_000
SCAN_TIMEOUT_MS = 5_000
PAIR_TIMEOUT = 15
MENU_LINES = 15
ICONS = {
    "headphones": "󰋋",
    "headset": "󰋋",
    "speakers": "󰓃",
    "audio-card": "󰓃",
    "keyboard": "󰌌",
    "mouse": "󰍽",
    "phone": "󰏲",
    "computer": "󰌢",
}


def t(key, **values):
    return subprocess.check_output(
        ["custom-i18n", "get", key, *(f"{k}={v}" for k, v in values.items())],
        text=True,
    ).rstrip("\n")


def fail(key, code=1, **values):
    print(t(key, **values), file=sys.stderr)
    raise SystemExit(code)


def require(*names):
    for name in names:
        if not shutil.which(name):
            fail("cli_dependency", code=127, name=name)


def escaped(value):
    for char, replacement in (
        ("\\", "\\\\"),
        ("\t", "\\t"),
        ("\n", "\\n"),
        ("\r", "\\r"),
    ):
        value = value.replace(char, replacement)
    return value


class BluetoothDevice:
    def __init__(self, path, props):
        self.path = path
        self.props = dict(props)

    @property
    def address(self):
        return self.props.get("Address", "")

    @property
    def name(self):
        return self.props.get("Alias") or self.props.get("Name") or self.address

    @property
    def is_connected(self):
        return bool(self.props.get("Connected", False))

    @property
    def is_paired(self):
        return bool(self.props.get("Paired", False))

    @property
    def is_trusted(self):
        return bool(self.props.get("Trusted", False))

    @property
    def icon(self):
        return self.props.get("Icon", "")

    @property
    def glyph(self):
        return ICONS.get(self.icon, "󰂯")

    @property
    def is_host(self):
        return self.icon in ("phone", "computer")

    def format_row(self):
        marker = "* " if self.is_connected else "  "
        paired = "󰌷" if self.is_paired else "󰐕"
        return f"{marker}{self.glyph}  {paired}  {escaped(self.name)}"

    def format_manage_row(self):
        return f"  {self.glyph}  {escaped(self.name)}"

    def format_discover_row(self):
        return f"  {self.glyph}  󰐕  {escaped(self.name)}"

    def update(self, values, invalidated=()):
        for prop in invalidated:
            self.props.pop(prop, None)
        self.props.update(values)


class Bluetooth:
    def __init__(self):
        self.connection = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.connection.set_exit_on_close(False)
        self.adapter = None
        self.devices = {}
        self.powered = False

    def call(self, path, interface, method, args=None, timeout=DBUS_TIMEOUT_MS):
        return self.connection.call_sync(
            "org.bluez",
            path,
            interface,
            method,
            args,
            None,
            Gio.DBusCallFlags.NO_AUTO_START,
            timeout,
            None,
        ).unpack()

    def refresh(self):
        objects = self.call("/", OBJECTS, "GetManagedObjects")[0]
        if self.adapter is None:
            self.adapter = next((p for p, v in objects.items() if ADAPTER in v), None)
        if self.adapter not in objects or ADAPTER not in objects[self.adapter]:
            fail("bluetooth_no_device")
        self.powered = bool(objects[self.adapter][ADAPTER].get("Powered", False))
        self.devices = {
            p: BluetoothDevice(p, v[DEVICE])
            for p, v in objects.items()
            if p.startswith(self.adapter + "/") and DEVICE in v
        }

    def get(self, path, interface, prop):
        return self.call(
            path, PROPERTIES, "Get", GLib.Variant("(ss)", (interface, prop))
        )[0]

    def set(self, path, interface, prop, value):
        self.call(
            path,
            PROPERTIES,
            "Set",
            GLib.Variant(
                "(ssv)",
                (
                    interface,
                    prop,
                    GLib.Variant("b", value),
                ),
            ),
        )

    def set_adapter_power(self, power):
        self.set(self.adapter, ADAPTER, "Powered", power)
        self.powered = power

    def set_adapter_pairable(self, pairable):
        self.set(self.adapter, ADAPTER, "Pairable", pairable)

    def set_device_trusted(self, device, trusted):
        self.set(device.path, DEVICE, "Trusted", trusted)

    def connect_device(self, device):
        if not device.is_connected:
            self.call(device.path, DEVICE, "Connect")
            if not self.get(device.path, DEVICE, "Connected"):
                fail("bluetooth_failed", dev=device.name)

    def disconnect_device(self, device):
        if device.is_connected:
            self.call(device.path, DEVICE, "Disconnect")

    def remove_device(self, device):
        self.call(
            self.adapter,
            ADAPTER,
            "RemoveDevice",
            GLib.Variant("(o)", (device.path,)),
        )

    def clear_paired(self):
        removed = []
        for device in self.paired():
            self.remove_device(device)
            removed.append(device)
        return removed

    def ordered(self):
        return sorted(
            self.devices.values(),
            key=lambda d: (
                not d.is_connected,
                not d.is_paired,
                d.name.casefold(),
            ),
        )

    def paired(self):
        return sorted(
            [d for d in self.devices.values() if d.is_paired],
            key=lambda d: (
                not d.is_connected,
                d.name.casefold(),
            ),
        )

    def find(self, target):
        matches = [
            d for d in self.devices.values() if d.address.lower() == target.lower()
        ]
        if not matches:
            matches = [d for d in self.devices.values() if d.name == target]
        if not matches:
            fail("bluetooth_device_not_found", dev=target)
        if len(matches) != 1:
            fail("bluetooth_ambiguous_device", dev=target)
        return matches[0]


def notify(key, **values):
    subprocess.run(
        [
            "notify-send",
            "-a",
            "custom-bluetooth",
            "-h",
            "string:x-canonical-private-synchronous:bluetooth",
            t("domain_bluetooth"),
            t(key, **values),
        ],
        check=True,
    )


class MenuItem(NamedTuple):
    label: str
    action: Callable[[], None]


def toggle_device(bluetooth, device):
    if device.is_connected:
        bluetooth.disconnect_device(device)
        notify("bluetooth_disconnected", dev=device.name)
        print("disconnected", device.address, sep="\t")
    else:
        if not bluetooth.powered:
            bluetooth.set_adapter_power(True)
        bluetooth.connect_device(device)
        notify("bluetooth_connected", dev=device.name)
        print("connected", device.address, sep="\t")


def run_fuzzel(prompt, rows, lines=MENU_LINES):
    with tempfile.TemporaryFile(
        mode="w+t", dir=os.environ.get("XDG_RUNTIME_DIR")
    ) as errors:
        process = subprocess.Popen(
            [
                "fuzzel",
                "--dmenu",
                "--index",
                "--log-level=error",
                "--prompt",
                prompt,
                "--lines",
                str(lines),
            ],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=errors,
            text=True,
        )
        try:
            for row in rows:
                process.stdin.write(f"{row}\n")
            process.stdin.flush()
        except BrokenPipeError:
            pass
        out, _ = process.communicate()
        errors.seek(0)
        diagnostic = errors.read()
        if diagnostic:
            print(diagnostic, file=sys.stderr, end="")
        if process.returncode == 1 and not diagnostic:
            return None
        if process.returncode in (-signal.SIGINT, 130):
            raise SystemExit(130)
        if process.returncode != 0:
            fail("cli_picker_failed")
        selection = out.strip()
        if not re.fullmatch(r"0|[1-9][0-9]{0,5}", selection):
            fail("cli_picker_failed")
        index = int(selection)
        if index >= len(rows):
            fail("cli_picker_failed")
        return index


def manage_menu(bluetooth):
    while True:
        bluetooth.refresh()
        paired = bluetooth.paired()
        if not paired:
            return

        def remove_selected(device):
            bluetooth.remove_device(device)
            notify("bluetooth_removed", dev=device.name)
            print("removed", device.address, sep="\t")
            return True

        def clear_all():
            removed = bluetooth.clear_paired()
            if removed:
                notify("bluetooth_cleared")
                for dev in removed:
                    print("removed", dev.address, sep="\t")
            return False

        items = [
            MenuItem(f"  󰌍  {t('bluetooth_back')}", lambda: False),
            MenuItem(f"  󰃢  {t('bluetooth_clear_paired')}", clear_all),
        ]
        for dev in paired:
            items.append(
                MenuItem(dev.format_manage_row(), lambda d=dev: remove_selected(d))
            )

        index = run_fuzzel(
            prompt=t("bluetooth_manage_prompt"),
            rows=[item.label for item in items],
        )
        if index is None:
            return
        stay = items[index].action()
        if not stay:
            return


def pair_device(bluetooth, device):
    require("bluetoothctl")
    bluetooth.set_adapter_pairable(True)
    subprocess.run(
        [
            "bluetoothctl",
            "--agent",
            "DisplayYesNo",
            "pair",
            device.address,
        ],
        input="yes\n",
        text=True,
        stdout=sys.stderr,
        timeout=PAIR_TIMEOUT,
        check=True,
    )
    if not bluetooth.get(device.path, DEVICE, "Paired"):
        fail("bluetooth_failed", dev=device.name)
    bluetooth.set_device_trusted(device, True)


class DiscoverySession:
    def __init__(self, bluetooth):
        self.bluetooth = bluetooth
        self.loop = GLib.MainLoop()
        self.subscriptions = []
        self.signals = []
        self.outcome = {"code": None, "error": None}
        self.started = False
        self.process = None
        self.child_watch = None
        self.closed_handler = None
        self.errors_file = None
        self.seen = set()
        self.items = [
            MenuItem(f"  󰌍  {t('bluetooth_back')}", lambda: False),
            MenuItem(f"  󰑐  {t('bluetooth_scanning')}", lambda: True),
        ]

    def _stop(self, code=None, error=None):
        self.outcome.update(code=code, error=error)
        self.loop.quit()
        return GLib.SOURCE_CONTINUE

    def _on_child_exit(self, _pid, status):
        self.process.returncode = os.waitstatus_to_exitcode(status)
        self.loop.quit()

    def append_device(self, device):
        if device.path in self.seen or device.is_paired or not device.address:
            return
        self.seen.add(device.path)
        item = MenuItem(
            device.format_discover_row(),
            lambda d=device: pair_and_connect(self.bluetooth, d),
        )
        self.items.append(item)
        if self.process and self.process.stdin:
            with suppress(BrokenPipeError):
                self.process.stdin.write(f"{item.label}\n")
                self.process.stdin.flush()

    def _on_dbus_signal(
        self, _conn, _sender, path, interface, member, parameters, _data
    ):
        args = parameters.unpack()
        if interface == "org.freedesktop.DBus":
            self._stop(error=t("cli_unavailable", name="org.bluez"))
        elif member == "InterfacesRemoved":
            removed, interfaces = args
            if removed == self.bluetooth.adapter and ADAPTER in interfaces:
                self._stop(error=t("bluetooth_no_device"))
            elif DEVICE in interfaces:
                self.bluetooth.devices.pop(removed, None)
        elif member == "InterfacesAdded":
            added, interfaces = args
            if added.startswith(self.bluetooth.adapter + "/") and DEVICE in interfaces:
                dev = BluetoothDevice(added, interfaces[DEVICE])
                self.bluetooth.devices[added] = dev
                self.append_device(dev)
        elif member == "PropertiesChanged":
            kind, values, invalidated = args
            if path in self.bluetooth.devices and kind == DEVICE:
                dev = self.bluetooth.devices[path]
                dev.update(values, invalidated)
                self.append_device(dev)
            elif path == self.bluetooth.adapter and kind == ADAPTER:
                if values.get("Powered") is False or values.get("Discovering") is False:
                    self._stop(error=t("bluetooth_operation_failed"))

    def _on_closed(self, _connection, _vanished, error):
        self._stop(
            error=error.message if error else t("cli_unavailable", name="org.bluez")
        )

    def __enter__(self):
        if not self.bluetooth.powered:
            self.bluetooth.set_adapter_power(True)
        self.errors_file = tempfile.TemporaryFile(
            mode="w+t", dir=os.environ.get("XDG_RUNTIME_DIR")
        )
        self.closed_handler = self.bluetooth.connection.connect(
            "closed", self._on_closed
        )
        for sender, interface, member, path, arg0 in (
            ("org.bluez", OBJECTS, "InterfacesAdded", "/", None),
            ("org.bluez", OBJECTS, "InterfacesRemoved", "/", None),
            ("org.bluez", PROPERTIES, "PropertiesChanged", None, None),
            (
                "org.freedesktop.DBus",
                "org.freedesktop.DBus",
                "NameOwnerChanged",
                "/org/freedesktop/DBus",
                "org.bluez",
            ),
        ):
            self.subscriptions.append(
                self.bluetooth.connection.signal_subscribe(
                    sender,
                    interface,
                    member,
                    path,
                    arg0,
                    Gio.DBusSignalFlags.NONE,
                    self._on_dbus_signal,
                    None,
                )
            )
        self.bluetooth.refresh()
        self.bluetooth.call(
            self.bluetooth.adapter,
            ADAPTER,
            "StartDiscovery",
            timeout=SCAN_TIMEOUT_MS,
        )
        self.started = True
        return self

    def run_picker(self):
        self.process = subprocess.Popen(
            [
                "fuzzel",
                "--dmenu",
                "--index",
                "--log-level=error",
                "--prompt",
                t("bluetooth_scan_prompt"),
                "--lines",
                str(MENU_LINES),
            ],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=self.errors_file,
            text=True,
        )
        self.child_watch = GLib.child_watch_add(self.process.pid, self._on_child_exit)
        for sig, code in (
            (signal.SIGINT, 130),
            (signal.SIGTERM, 1),
            (signal.SIGHUP, 1),
        ):
            self.signals.append(
                GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, sig, self._stop, code)
            )
        try:
            for item in self.items:
                self.process.stdin.write(f"{item.label}\n")
            for dev in self.bluetooth.devices.values():
                self.append_device(dev)
            self.process.stdin.flush()
        except BrokenPipeError:
            pass

        self.loop.run()

        if self.outcome["error"]:
            print(self.outcome["error"], file=sys.stderr)
            raise SystemExit(1)
        if self.outcome["code"] is not None:
            raise SystemExit(self.outcome["code"])

        self.errors_file.seek(0)
        diagnostic = self.errors_file.read()
        if diagnostic:
            print(diagnostic, file=sys.stderr, end="")
        if self.process.returncode == 1 and not diagnostic:
            return None
        if self.process.returncode in (-signal.SIGINT, 130):
            raise SystemExit(130)
        if self.process.returncode != 0:
            fail("cli_picker_failed")

        with suppress(BrokenPipeError):
            self.process.stdin.close()
        selection = self.process.stdout.read().strip()
        self.process.stdout.close()

        if not re.fullmatch(r"0|[1-9][0-9]{0,5}", selection):
            fail("cli_picker_failed")
        return int(selection)

    def __exit__(self, _exc_type, _exc_val, _exc_tb):
        if self.child_watch and self.process and self.process.returncode is None:
            GLib.source_remove(self.child_watch)
            self.process.terminate()
            self.process.wait()
        for sub in self.subscriptions:
            self.bluetooth.connection.signal_unsubscribe(sub)
        for sig in self.signals:
            GLib.source_remove(sig)
        if self.closed_handler:
            self.bluetooth.connection.disconnect(self.closed_handler)
        if self.started and not self.bluetooth.connection.is_closed():
            with suppress(GLib.Error):
                self.bluetooth.call(
                    self.bluetooth.adapter,
                    ADAPTER,
                    "StopDiscovery",
                    timeout=SCAN_TIMEOUT_MS,
                )
        if self.errors_file:
            self.errors_file.close()


def pair_and_connect(bluetooth, device):
    pair_device(bluetooth, device)
    if device.is_host:
        notify("bluetooth_paired", dev=device.name)
        print("paired", device.address, sep="\t")
    else:
        bluetooth.connect_device(device)
        notify("bluetooth_connected", dev=device.name)
        print("connected", device.address, sep="\t")
    return False


def scan_menu(bluetooth):
    while True:
        with DiscoverySession(bluetooth) as session:
            index = session.run_picker()
            if index is None or index >= len(session.items):
                return False
            stay = session.items[index].action()
            if not stay:
                return False


def main_menu(bluetooth):
    while True:
        bluetooth.refresh()
        paired = bluetooth.paired()

        items = [
            MenuItem(
                f"  󰍉  {t('bluetooth_scan')}",
                lambda: scan_menu(bluetooth) or True,
            ),
        ]
        if paired:
            items.append(
                MenuItem(
                    f"  󰒓  {t('bluetooth_manage')}",
                    lambda: manage_menu(bluetooth) or True,
                )
            )
        for dev in paired:
            items.append(
                MenuItem(dev.format_row(), lambda d=dev: toggle_device(bluetooth, d))
            )

        index = run_fuzzel(
            prompt=t("bluetooth_prompt"),
            rows=[item.label for item in items],
        )
        if index is None:
            return
        stay = items[index].action()
        if not stay:
            return


def menu(bluetooth):
    main_menu(bluetooth)


def cmd_menu(bluetooth, _args):
    menu(bluetooth)


def cmd_scan(bluetooth, _args):
    scan_menu(bluetooth)


def cmd_list(bluetooth, _args):
    for device in bluetooth.ordered():
        print(
            device.address,
            escaped(device.name),
            "connected" if device.is_connected else "disconnected",
            "paired" if device.is_paired else "unpaired",
            sep="\t",
        )


def cmd_status(bluetooth, _args):
    names = [escaped(d.name) for d in bluetooth.ordered() if d.is_connected]
    print("powered: " + ("on" if bluetooth.powered else "off"))
    print("connected: " + (", ".join(names) if names else "none"))


def cmd_toggle(bluetooth, _args):
    bluetooth.set_adapter_power(not bluetooth.powered)


def cmd_off(bluetooth, _args):
    bluetooth.set_adapter_power(False)


def cmd_connect(bluetooth, args):
    device = bluetooth.find(args[0])
    bluetooth.connect_device(device)
    print("connected", device.address, sep="\t")


def cmd_disconnect(bluetooth, args):
    if args:
        device = bluetooth.find(args[0])
        bluetooth.disconnect_device(device)
        print("disconnected", device.address, sep="\t")
    else:
        for device in bluetooth.ordered():
            if device.is_connected:
                bluetooth.disconnect_device(device)
                print("disconnected", device.address, sep="\t")


def cmd_remove(bluetooth, args):
    device = bluetooth.find(args[0])
    bluetooth.remove_device(device)
    print("removed", device.address, sep="\t")


def cmd_clear(bluetooth, _args):
    for device in bluetooth.clear_paired():
        print("removed", device.address, sep="\t")


COMMANDS = {
    "menu": (cmd_menu, 0, 0),
    "scan": (cmd_scan, 0, 0),
    "list": (cmd_list, 0, 0),
    "devices": (cmd_list, 0, 0),
    "status": (cmd_status, 0, 0),
    "toggle": (cmd_toggle, 0, 0),
    "off": (cmd_off, 0, 0),
    "power-off": (cmd_off, 0, 0),
    "connect": (cmd_connect, 1, 1),
    "disconnect": (cmd_disconnect, 0, 1),
    "remove": (cmd_remove, 1, 1),
    "unpair": (cmd_remove, 1, 1),
    "clear": (cmd_clear, 0, 0),
}


def main():
    args = sys.argv[1:]
    action = args.pop(0) if args else "menu"
    if action in ("-h", "--help", "help") and not args:
        print(t("bluetooth_usage"))
        return
    if action not in COMMANDS:
        fail("cli_usage", code=2, command="custom-bluetooth")
    handler, min_args, max_args = COMMANDS[action]
    if not (min_args <= len(args) <= max_args):
        fail("cli_usage", code=2, command="custom-bluetooth")
    if action in ("menu", "scan"):
        if not os.environ.get("WAYLAND_DISPLAY"):
            fail("cli_unavailable", name="WAYLAND_DISPLAY")
        require("fuzzel", "notify-send")
    global Gio, GLib, GLibUnix
    try:
        from gi.repository import Gio, GLib, GLibUnix
    except ImportError:
        fail("cli_dependency", code=127, name="python-gobject")
    bluetooth = Bluetooth()
    try:
        bluetooth.refresh()
        handler(bluetooth, args)
    except GLib.Error as error:
        print(error.message, file=sys.stderr)
        sys.exit(1)
    finally:
        if not bluetooth.connection.is_closed():
            bluetooth.connection.close_sync(None)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except FileNotFoundError as error:
        fail("cli_dependency", code=127, name=error.filename)
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
        fail("bluetooth_operation_failed")
    except OSError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
