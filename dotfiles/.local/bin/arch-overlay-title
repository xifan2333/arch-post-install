#!/usr/bin/env bash
# arch:summary=Manage live stream / recording title with history and wayhud display
# arch:args=[get | set <text> | edit | clear | clear-history | toggle | start | stop | status [--hud]]
# arch:examples=arch overlay title edit | arch overlay title set "Linux Kernel" | arch overlay title toggle
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wayhud"
HISTORY_FILE="$STATE_DIR/title_history.txt"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/wayhud"
PID_FILE="$RUNTIME_DIR/title.pid"

notify() {
	local title body
	title="$(arch-i18n get overlay_title_edit_title)"
	body="$1"
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$title" "$body"
	fi
}

is_hud_running() {
	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(cat "$PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
	fi
	pgrep -f "wayhud[[:space:]]+-n[[:space:]]+title\b" >/dev/null 2>&1
}

stop_title_hud() {
	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(cat "$PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			kill -TERM "$pid" 2>/dev/null || true
		fi
		rm -f "$PID_FILE"
	fi
	pkill -f "wayhud[[:space:]]+-n[[:space:]]+title\b" 2>/dev/null || true
}

start_title_hud() {
	local text="$1"
	[[ -n "$text" ]] || return 0
	if ! command -v wayhud >/dev/null 2>&1; then
		return 0
	fi

	stop_title_hud
	mkdir -p "$RUNTIME_DIR"

	printf '%s\n' "$text" | nohup wayhud -n title >/dev/null 2>&1 &
	local pid=$!
	printf '%s\n' "$pid" >"$PID_FILE"
}

get_title() {
	if [[ -f "$HISTORY_FILE" ]]; then
		head -n 1 "$HISTORY_FILE" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
	fi
}

set_title() {
	local new_title="$1"
	if [[ -z "$new_title" ]]; then
		stop_title_hud
		return 0
	fi

	mkdir -p "$STATE_DIR"
	local tmp_file="$STATE_DIR/title_history.tmp.$$"
	{
		printf '%s\n' "$new_title"
		if [[ -f "$HISTORY_FILE" ]]; then
			grep -v -F -x "$new_title" "$HISTORY_FILE" 2>/dev/null || true
		fi
	} | head -n 30 >"$tmp_file"
	mv -f "$tmp_file" "$HISTORY_FILE"

	start_title_hud "$new_title"
}

clear_history() {
	rm -f "$HISTORY_FILE"
	stop_title_hud
	notify "$(arch-i18n get overlay_title_history_cleared)"
}

clear_title() {
	set_title ""
}

edit_title() {
	local prompt clear_opt
	prompt="$(arch-i18n get overlay_title_prompt)"
	clear_opt="$(arch-i18n get overlay_title_clear_history)"

	local candidates=""
	if [[ -f "$HISTORY_FILE" ]]; then
		candidates="$(grep -v '^[[:space:]]*$' "$HISTORY_FILE" 2>/dev/null || true)"
	fi

	local chosen
	chosen=$({
		if [[ -n "$candidates" ]]; then
			printf '  %s\n' "$clear_opt"
			printf '%s\n' "$candidates"
		fi
	} | fuzzel --dmenu --prompt "$prompt" || true)

	[[ -n "$chosen" ]] || exit 0

	if [[ "$chosen" == *" $clear_opt" || "$chosen" == "$clear_opt" ]]; then
		clear_history
		return 0
	fi

	set_title "$chosen"
}

toggle_title() {
	if is_hud_running; then
		stop_title_hud
	else
		local current
		current="$(get_title)"
		if [[ -n "$current" ]]; then
			start_title_hud "$current"
		else
			edit_title
		fi
	fi
}

action="${1:-edit}"

case "$action" in
get)
	get_title
	;;
set)
	shift
	set_title "$*"
	;;
clear)
	clear_title
	;;
clear-history)
	clear_history
	;;
edit)
	edit_title
	;;
toggle)
	toggle_title
	;;
start)
	current="$(get_title)"
	if [[ -n "$current" ]]; then
		start_title_hud "$current"
	else
		edit_title
	fi
	;;
stop | close | hide | kill)
	stop_title_hud
	;;
status)
	shift
	mode="${1:-}"
	if [[ "$mode" == "--hud" ]]; then
		if is_hud_running; then
			echo "open"
		else
			echo "closed"
		fi
	else
		get_title
	fi
	;;
*)
	echo "Usage: arch-overlay-title [get | set <text> | edit | clear | clear-history | toggle | start | stop | status [--hud]]" >&2
	exit 1
	;;
esac
