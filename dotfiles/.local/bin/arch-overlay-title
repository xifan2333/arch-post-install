#!/usr/bin/env bash
# arch:summary=Manage live stream / recording title with Waybar integration and Fuzzel input
# arch:args=[get | set <text> | edit | clear | toggle | status [--waybar]]
# arch:examples=arch overlay title edit | arch overlay title set "Linux Kernel"
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/screenrecord"
TITLE_FILE="$STATE_DIR/title.txt"

mkdir -p "$STATE_DIR"
[[ -f "$TITLE_FILE" ]] || touch "$TITLE_FILE"

signal_waybar() {
	pkill -RTMIN+9 waybar 2>/dev/null || true
}

get_title() {
	if [[ -f "$TITLE_FILE" ]]; then
		head -n 1 "$TITLE_FILE" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
	fi
}

set_title() {
	local new_title="$1"
	printf '%s\n' "$new_title" >"$TITLE_FILE"
	signal_waybar
	if command -v notify-send >/dev/null 2>&1; then
		if [[ -n "$new_title" ]]; then
			notify-send -u low "直播/录屏主题" "已更新: $new_title"
		else
			notify-send -u low "直播/录屏主题" "已清空主题"
		fi
	fi
}

clear_title() {
	set_title ""
}

edit_title() {
	local current
	current="$(get_title)"

	local chosen
	if [[ -n "$current" ]]; then
		chosen=$(printf '%s\n' "$current" | fuzzel --dmenu --prompt "󰑋 直播主题: " || true)
	else
		chosen=$(fuzzel --dmenu --prompt "󰑋 直播主题: " </dev/null || true)
	fi

	if [[ -n "$chosen" ]]; then
		set_title "$chosen"
	fi
}

status_waybar() {
	local title
	title="$(get_title)"

	if [[ -n "$title" ]]; then
		jq -n -c \
			--arg t "󰑋 $title" \
			--arg tip "$(printf '当前主题: %s\n左键点击: 修改\n右键点击: 清空' "$title")" \
			--arg c "active" \
			'{text: $t, tooltip: $tip, class: $c}'
	else
		printf '{"text": "", "tooltip": "", "class": "empty"}\n'
	fi
}

action="${1:-edit}"

case "$action" in
get)
	get_title
	;;
set)
	shift
	set_title "$*"
	;;
clear)
	clear_title
	;;
edit | toggle)
	edit_title
	;;
status)
	if [[ "${2:-}" == "--waybar" ]]; then
		status_waybar
	else
		get_title
	fi
	;;
*)
	echo "Usage: arch-overlay-title [get | set <text> | edit | clear | toggle | status [--waybar]]" >&2
	exit 1
	;;
esac
