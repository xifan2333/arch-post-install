#!/usr/bin/env bash
# arch:summary=Capture selected screen area, save to Pictures/screenshots, and copy to clipboard
# arch:examples=arch cap area
set -euo pipefail

save_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots"
mkdir -p "$save_dir"

filename="screenshot-$(date +%Y%m%d_%H%M%S).png"
filepath="$save_dir/$filename"

geometry="$(slurp 2>/dev/null || true)"
[[ -n "$geometry" ]] || exit 0

grim -g "$geometry" "$filepath"
wl-copy <"$filepath"
