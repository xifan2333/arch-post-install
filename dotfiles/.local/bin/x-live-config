#!/usr/bin/env -S PYTHONDONTWRITEBYTECODE=1 python3
# arch:summary=Graphical livestream configuration dialog
# arch:examples=arch live config
"""Live stream configurator — single-destination RTMP server, key, and bitrates."""

from __future__ import annotations

import json
import subprocess
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

CONFIG_DIR = Path(GLib.get_user_config_dir()) / "livestream"
CONFIG_FILE = CONFIG_DIR / "config.json"
DEFAULT_SERVER = "rtmp://live-push.bilivideo.com/live-bvc/"
DEFAULT_VIDEO_BITRATE = 4500
DEFAULT_AUDIO_BITRATE = 160


def tr_msg(key: str, fallback: str) -> str:
    try:
        res = subprocess.run(
            ["arch-i18n", "get", key],
            capture_output=True,
            text=True,
            timeout=1,
            check=False,
        )
        msg = res.stdout.strip()
        if res.returncode == 0 and msg and msg != f"[{key}]":
            return msg
    except (OSError, subprocess.TimeoutExpired):
        pass
    return fallback


def bounded_int(value: object, default: int, minimum: int, maximum: int) -> int:
    try:
        number = int(value)  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return default
    return number if minimum <= number <= maximum else default


def load_config() -> tuple[str, str, int, int]:
    server = DEFAULT_SERVER
    key = ""
    video = DEFAULT_VIDEO_BITRATE
    audio = DEFAULT_AUDIO_BITRATE

    if not CONFIG_FILE.is_file():
        return server, key, video, audio

    try:
        data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return server, key, video, audio

    if not isinstance(data, dict):
        return server, key, video, audio

    video = bounded_int(data.get("bitrate"), DEFAULT_VIDEO_BITRATE, 500, 30000)
    audio = bounded_int(data.get("audio_bitrate"), DEFAULT_AUDIO_BITRATE, 32, 320)

    server = str(data.get("server") or DEFAULT_SERVER).strip()
    key = str(data.get("key") or "").strip()

    return server, key, video, audio


def save_config(server: str, key: str, video: int, audio: int) -> None:
    payload = {
        "server": server.strip(),
        "key": key.strip(),
        "bitrate": int(video),
        "audio_bitrate": int(audio),
    }
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n")


class LivestreamConfigDialog(Gtk.Dialog):
    """Focused single-destination modal settings window for livestreaming."""

    def __init__(self, server: str, key: str, video: int, audio: int) -> None:
        super().__init__(
            title=tr_msg("livestream_cfg_title", "直播推流配置"),
            modal=True,
        )
        self.set_default_size(620, 280)
        self.set_border_width(14)
        self.set_resizable(False)

        content = self.get_content_area()
        content.set_spacing(12)

        grid = Gtk.Grid(column_spacing=10, row_spacing=12)
        grid.set_hexpand(True)

        # 1. Server URL Entry
        server_label = Gtk.Label(
            label=tr_msg("livestream_cfg_server", "推流服务器:"),
            xalign=0.0,
        )
        self.server_entry = Gtk.Entry()
        self.server_entry.set_text(server)
        self.server_entry.set_placeholder_text(DEFAULT_SERVER)
        self.server_entry.set_hexpand(True)
        grid.attach(server_label, 0, 0, 1, 1)
        grid.attach(self.server_entry, 1, 0, 2, 1)

        # 2. Stream Key Entry with reveal button
        key_label = Gtk.Label(
            label=tr_msg("livestream_cfg_key", "推流密钥 (Key):"),
            xalign=0.0,
        )
        self.key_entry = Gtk.Entry()
        self.key_entry.set_text(key)
        self.key_entry.set_visibility(False)
        self.key_entry.set_placeholder_text("?streamname=live_... 或密钥串")
        self.key_entry.set_hexpand(True)

        self.reveal_btn = Gtk.Button.new_from_icon_name(
            "view-reveal", Gtk.IconSize.BUTTON
        )
        self.reveal_btn.set_tooltip_text("显示/隐藏推流码")
        self.reveal_btn.connect("clicked", self._toggle_key_visibility)

        grid.attach(key_label, 0, 1, 1, 1)
        grid.attach(self.key_entry, 1, 1, 1, 1)
        grid.attach(self.reveal_btn, 2, 1, 1, 1)

        # 3. Video Bitrate
        video_label = Gtk.Label(
            label=tr_msg("livestream_cfg_video_kbps", "视频码率 (kbps):"),
            xalign=0.0,
        )
        self.video_bitrate = Gtk.SpinButton.new_with_range(500, 30000, 250)
        self.video_bitrate.set_value(video)
        self.video_bitrate.set_numeric(True)
        grid.attach(video_label, 0, 2, 1, 1)
        grid.attach(self.video_bitrate, 1, 2, 2, 1)

        # 4. Audio Bitrate
        audio_label = Gtk.Label(
            label=tr_msg("livestream_cfg_audio_kbps", "音频码率 (kbps):"),
            xalign=0.0,
        )
        self.audio_bitrate = Gtk.SpinButton.new_with_range(32, 320, 16)
        self.audio_bitrate.set_value(audio)
        self.audio_bitrate.set_numeric(True)
        grid.attach(audio_label, 0, 3, 1, 1)
        grid.attach(self.audio_bitrate, 1, 3, 2, 1)

        content.pack_start(grid, True, True, 0)

        # Action Buttons
        self.add_button(tr_msg("cancel", "取消"), Gtk.ResponseType.CANCEL)
        confirm_btn = self.add_button(
            tr_msg("confirm", "确认保存"), Gtk.ResponseType.OK
        )
        confirm_btn.get_style_context().add_class("suggested-action")

        content.show_all()

    def _toggle_key_visibility(self, _button: Gtk.Button) -> None:
        self.key_entry.set_visibility(not self.key_entry.get_visibility())

    def get_values(self) -> tuple[str, str, int, int]:
        return (
            self.server_entry.get_text(),
            self.key_entry.get_text(),
            self.video_bitrate.get_value_as_int(),
            self.audio_bitrate.get_value_as_int(),
        )


def main() -> None:
    GLib.set_prgname("arch-live-config")
    server, key, video, audio = load_config()
    dialog = LivestreamConfigDialog(server, key, video, audio)
    response = dialog.run()

    if response == Gtk.ResponseType.OK:
        save_config(*dialog.get_values())

    dialog.destroy()


if __name__ == "__main__":
    main()
