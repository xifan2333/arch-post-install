#!/usr/bin/env bash
# arch:summary=Pick color from screen pixel and copy hex value to clipboard
# arch:examples=arch cap color
set -euo pipefail

pos="$(slurp -p 2>/dev/null || true)"
[[ -n "$pos" ]] || exit 0

hex=$(grim -g "$pos" -t ppm - | magick - -format '#%[hex:p{0,0}]\n' info: 2>/dev/null || true)
if [[ -z "$hex" ]]; then
	# Fallback without imagemagick: python standard library / raw PPM reader
	hex=$(grim -g "$pos" -t ppm - | python3 -c '
import sys
data = sys.stdin.buffer.read()
lines = data.split(b"\n")
# PPM format: P6 width height maxval binary_data
# find the pixel bytes
payload = lines[-1] if len(lines[-1]) >= 3 else lines[-2]
r, g, b = payload[0], payload[1], payload[2]
print(f"#{r:02x}{g:02x}{b:02x}")
' 2>/dev/null || true)
fi

[[ -n "$hex" ]] || exit 0

printf '%s' "$hex" | wl-copy

if command -v notify-send >/dev/null 2>&1; then
	notify-send "屏幕取色" "颜色代码已复制到剪贴板: $hex"
fi
