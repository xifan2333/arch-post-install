#!/usr/bin/env bash
# arch:summary=Capture and annotate screen region using satty
# arch:examples=arch cap edit
set -euo pipefail

save_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots"
mkdir -p "$save_dir"

timestamp="$(date +%Y%m%d_%H%M%S)"
output_path="$save_dir/annotated-$timestamp.png"

geometry="$(slurp 2>/dev/null || true)"
[[ -n "$geometry" ]] || exit 0

if command -v satty >/dev/null 2>&1; then
	grim -g "$geometry" - | satty --filename - --output-filename "$output_path" --early-exit
else
	grim -g "$geometry" - | wl-copy
fi
