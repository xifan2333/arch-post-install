#!/usr/bin/env bash
# arch:summary=Toggle on-screen key HUD using native wayhud
# arch:args=[toggle | start | stop | status]
# arch:examples=arch overlay keys | arch overlay keys toggle
set -euo pipefail

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/wayhud"
PID_FILE="$RUNTIME_DIR/keys.pid"

is_running() {
	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(cat "$PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			return 0
		fi
	fi
	pgrep -f "wayhud[[:space:]]+-n[[:space:]]+keys\b" >/dev/null 2>&1
}

stop_keys() {
	if [[ -f "$PID_FILE" ]]; then
		local pid
		pid="$(cat "$PID_FILE" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
			kill -TERM "$pid" 2>/dev/null || true
		fi
		rm -f "$PID_FILE"
	fi
	pkill -f "wayhud[[:space:]]+-n[[:space:]]+keys\b" 2>/dev/null || true
}

start_keys() {
	if ! command -v wayhud >/dev/null 2>&1; then
		echo "Error: wayhud is not installed" >&2
		exit 1
	fi

	stop_keys
	mkdir -p "$RUNTIME_DIR"

	nohup wayhud -n keys >/dev/null 2>&1 &
	local pid=$!
	printf '%s\n' "$pid" >"$PID_FILE"
}

action="${1:-toggle}"

case "$action" in
start)
	start_keys
	;;
stop | close | hide | kill)
	stop_keys
	;;
status | state)
	if is_running; then
		echo "open"
	else
		echo "closed"
	fi
	;;
toggle)
	if is_running; then
		stop_keys
	else
		start_keys
	fi
	;;
*)
	echo "Usage: arch-overlay-keys [toggle | start | stop | status]" >&2
	exit 1
	;;
esac
