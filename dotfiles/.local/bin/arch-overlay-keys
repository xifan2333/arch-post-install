#!/usr/bin/env bash
# arch:summary=Toggle on-screen key HUD using native wshowkeys
# arch:args=[toggle | start | stop | status]
# arch:examples=arch overlay keys | arch overlay keys toggle
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
THEME_FILE="$STATE_DIR/theme/colors.toml"

get_color() {
	local key="$1"
	local fallback="$2"
	if [[ -f "$THEME_FILE" ]]; then
		local val
		val=$(grep -E "^${key}[[:space:]]*=" "$THEME_FILE" | head -n 1 | cut -d'=' -f2- | tr -d ' "' || true)
		if [[ -n "$val" ]]; then
			printf '%s' "$val"
			return
		fi
	fi
	printf '%s' "$fallback"
}

is_running() {
	pgrep -x wshowkeys >/dev/null 2>&1
}

stop_keys() {
	pkill -x wshowkeys 2>/dev/null || true
}

start_keys() {
	if ! command -v wshowkeys >/dev/null 2>&1; then
		echo "Error: wshowkeys is not installed" >&2
		exit 1
	fi

	stop_keys

	local bg_color
	local fg_color
	local accent_color

	bg_color="$(get_color "background" "#1a1b26")"
	fg_color="$(get_color "foreground" "#cfc9c2")"
	accent_color="$(get_color "accent" "#7aa2f7")"

	bg_color="${bg_color}dd"

	nohup wshowkeys \
		-a bottom \
		-m 60 \
		-t 1500 \
		-M \
		-F "JetBrainsMono Nerd Font 22" \
		-b "$bg_color" \
		-f "$fg_color" \
		-s "$accent_color" >/dev/null 2>&1 &
}

action="${1:-toggle}"

case "$action" in
start)
	start_keys
	;;
stop | close | hide | kill)
	stop_keys
	;;
status | state)
	if is_running; then
		echo "open"
	else
		echo "closed"
	fi
	;;
toggle)
	if is_running; then
		stop_keys
	else
		start_keys
	fi
	;;
*)
	echo "Usage: arch-overlay-keys [toggle | start | stop | status]" >&2
	exit 1
	;;
esac
