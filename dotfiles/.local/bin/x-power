#!/usr/bin/env bash
# arch:summary=Manage session power actions or interactively select power menu options
# arch:args=[menu | off | shutdown | reboot | suspend | lock | logout]
# arch:examples=arch power | arch power off | arch power reboot
set -euo pipefail

action="${1:-menu}"

case "$action" in
off | shutdown | poweroff)
	systemctl poweroff
	exit 0
	;;
reboot)
	systemctl reboot
	exit 0
	;;
suspend)
	systemctl suspend
	exit 0
	;;
lock)
	if command -v hyprlock >/dev/null 2>&1; then
		hyprlock
	fi
	exit 0
	;;
logout)
	if command -v xrwm >/dev/null 2>&1; then
		xrwm exit
	elif command -v riverctl >/dev/null 2>&1; then
		riverctl exit
	fi
	exit 0
	;;
menu | *)
	dmenu_exec() {
		local prompt="$1"
		if command -v fuzzel >/dev/null 2>&1; then
			fuzzel --dmenu --prompt "$prompt"
		elif command -v bemenu >/dev/null 2>&1; then
			bemenu -p "$prompt"
		else
			head -n 1
		fi
	}

	opt_lock="$(arch-i18n get power_lock)"
	opt_suspend="$(arch-i18n get power_suspend)"
	opt_logout="$(arch-i18n get power_logout)"
	opt_reboot="$(arch-i18n get power_reboot)"
	opt_shutdown="$(arch-i18n get power_shutdown)"

	menu_items=(
		"$opt_lock"
		"$opt_suspend"
		"$opt_logout"
		"$opt_reboot"
		"$opt_shutdown"
	)

	choice=$(printf '%s\n' "${menu_items[@]}" | dmenu_exec "$(arch-i18n get power_menu_prompt)")
	[[ -n "${choice:-}" ]] || exit 0

	case "$choice" in
	"$opt_lock")
		if command -v hyprlock >/dev/null 2>&1; then
			hyprlock
		fi
		;;
	"$opt_suspend")
		systemctl suspend
		;;
	"$opt_logout")
		if command -v xrwm >/dev/null 2>&1; then
			xrwm exit
		elif command -v riverctl >/dev/null 2>&1; then
			riverctl exit
		fi
		;;
	"$opt_reboot")
		systemctl reboot
		;;
	"$opt_shutdown")
		systemctl poweroff
		;;
	esac
	;;
esac
