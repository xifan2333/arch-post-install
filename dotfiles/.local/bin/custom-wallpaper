#!/usr/bin/env bash
#
# @name         custom-wallpaper
# @summary      Manage, switch, or select desktop wallpapers
# @version      1.0.0
# @deps         swaybg, fuzzel
#
# @description  Universal desktop wallpaper manager for River WM.
#               Supports random selection, local browsing, and remote search via Wallhaven.
#
# @usage        custom-wallpaper [options] [command] [arguments...]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   menu                    Open interactive wallpaper picker via Fuzzel (default)
#   current | get           Print path of active wallpaper
#   list                    List all local wallpaper image files
#   random                  Select and apply a random wallpaper from local directory
#   search [query]          Search and select wallpaper via custom-wallhaven
#   set <path|url|-|id>     Set wallpaper from path, URL, stdin stream (-), or ID
#
# @stdin        Accepts file path or URL stream when using 'set -'
# @stdout       Path of selected or active wallpaper
# @stderr       Diagnostic errors and non-zero exit reason
#
# @examples
#   custom-wallpaper current
#   custom-wallpaper random
#   custom-wallpaper set ~/Pictures/wallpapers/a.jpg
#   find ~/Pictures -name '*.png' | custom-wallpaper set -

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel reports Esc as 1; every other unsuccessful exit is an error.
pick() {
	local selection rc
	if selection=$(fuzzel --dmenu "$@"); then
		printf '%s' "$selection"
	else
		rc=$?
		((rc == 1)) || {
			((rc == 130)) && exit 130
			die 1 cli_picker_failed
		}
	fi
}

wall_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/wallpapers"
startup_delay=0.2
thumbnail_size=96x96

swaybg_pids() {
	local pids rc
	require pgrep
	if pids=$(pgrep -u "$UID" -x swaybg); then
		printf '%s\n' "$pids"
	else
		rc=$?
		((rc == 1)) || die 1 cli_unavailable name=pgrep
	fi
}
get_current() {
	local pids pid i arg path current=''
	local -a argv=()
	pids=$(swaybg_pids)
	[[ -n "$pids" ]] || return 0
	while IFS= read -r pid; do
		[[ -e "/proc/$pid/cmdline" ]] || continue
		mapfile -d '' -t argv <"/proc/$pid/cmdline"
		for ((i = 1; i < ${#argv[@]}; i++)); do
			arg="${argv[$i]}"
			path=''
			case "$arg" in
			-i | --image)
				i=$((i + 1))
				((i < ${#argv[@]})) || die 1 cli_unavailable name=swaybg
				path="${argv[$i]}"
				;;
			--image=*) path="${arg#--image=}" ;;
			-i?*) path="${arg#-i}" ;;
			esac
			[[ -n "$path" ]] || continue
			if [[ "$path" != /* ]]; then path=$(realpath -m -- "/proc/$pid/cwd/$path"); fi
			[[ -z "$current" || "$current" == "$path" ]] || die 1 cli_unavailable name=multiple-wallpapers
			current="$path"
		done
	done <<<"$pids"
	if [[ -n "$current" ]]; then printf '%s\n' "$current"; fi
}
list_local() {
	if [[ -e "$wall_dir" ]]; then
		find "$wall_dir" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print | sort
	fi
}
set_wallpaper() (
	local image="$1" format digest target tmp='' pids pid unit
	local -a old_pids=()
	require swaybg uwsm systemctl magick sha256sum
	[[ -f "$image" ]] || die 1 cli_unavailable "name=$image"
	image=$(realpath -- "$image")
	format=$(magick identify -format '%m' "${image}[0]")
	case "$format" in JPEG) format=jpg ;; PNG) format=png ;; WEBP) format=webp ;; *) die 1 cli_unavailable "name=$format" ;; esac
	if [[ "$image" != "$wall_dir/"* ]]; then
		digest=$(sha256sum -- "$image")
		digest="${digest%% *}"
		target="$wall_dir/wallpaper-$digest.$format"
		mkdir -p -- "$wall_dir"
		tmp=$(mktemp "$wall_dir/.wallpaper.XXXXXX")
		trap 'if [[ -n "$tmp" ]]; then rm -f -- "$tmp"; fi' EXIT
		cp -- "$image" "$tmp"
		mv -f -- "$tmp" "$target"
		image="$target"
	fi
	pids=$(swaybg_pids)
	if [[ -n "$pids" ]]; then mapfile -t old_pids <<<"$pids"; fi
	unit="custom-wallpaper-${BASHPID}-${RANDOM}.service"
	uwsm app -s b -t service -u "$unit" -p Type=exec -- swaybg -i "$image" -m fill >/dev/null
	sleep "$startup_delay"
	systemctl --user is-active --quiet "$unit"
	for pid in "${old_pids[@]}"; do
		if [[ -d "/proc/$pid" ]]; then kill "$pid"; fi
	done
	printf '%s\n' "$image"
)
apply_target() (
	local target="$1" tmp path
	case "$target" in
	-)
		while IFS= read -r path || [[ -n "$path" ]]; do
			[[ -n "$path" ]] || continue
			[[ "$path" != - && "$path" != --image-stdin ]] || usage_error
			apply_target "$path"
		done
		return
		;;
	--image-stdin)
		tmp=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-wallpaper.XXXXXX")
		trap 'rm -f -- "$tmp"' EXIT
		cat >"$tmp"
		set_wallpaper "$tmp"
		return
		;;
	esac
	if [[ -f "$target" ]]; then
		set_wallpaper "$target"
		return
	fi
	[[ "$target" =~ ^https?:// || "$target" =~ ^[A-Za-z0-9]+$ ]] || usage_error
	require custom-wallhaven
	tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-wallpaper.XXXXXX")
	trap 'rm -rf -- "$tmp"' EXIT
	# Explicit file output; never interpret a redirected image byte stream as a path.
	path=$(custom-wallhaven download "$target" -o "$tmp/image")
	[[ "$path" == "$tmp/image" ]] || die 1 cli_unavailable name=download
	set_wallpaper "$path"
)
random_local() {
	local files image
	files=$(list_local)
	[[ -n "$files" ]] || return 0
	image=$(shuf -n 1 <<<"$files")
	set_wallpaper "$image"
}
select_local() (
	local files current file tmp i=0 prompt choice index prefix
	local -a paths=() labels=()
	require fuzzel magick
	files=$(list_local)
	[[ -n "$files" ]] || return 0
	current=$(get_current)
	tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-wallpaper.XXXXXX")
	trap 'rm -rf -- "$tmp"' EXIT
	while IFS= read -r file; do
		paths+=("$file")
		prefix='  '
		if [[ "$file" == "$current" ]]; then prefix='* '; fi
		labels+=("${prefix}󰋩  ${file#"$wall_dir/"}")
		magick "${file}[0]" -thumbnail "$thumbnail_size" "$tmp/$i.png"
		i=$((i + 1))
	done <<<"$files"
	prompt=$(t wallpaper_pick_prompt)
	choice=$(
		for i in "${!paths[@]}"; do printf '%s\0icon\x1f%s/%s.png\n' "${labels[$i]}" "$tmp" "$i"; done |
			pick --prompt "$prompt" --index
	)
	[[ -n "$choice" ]] || return 0
	[[ "$choice" =~ ^[0-9]+$ ]] || die 1 cli_picker_failed
	index=$((10#$choice))
	((index < ${#paths[@]})) || die 1 cli_picker_failed
	set_wallpaper "${paths[$index]}"
)
search() {
	local path
	require custom-wallhaven
	path=$(custom-wallhaven menu "$1")
	[[ -n "$path" ]] || return 0
	set_wallpaper "$path"
}
menu() {
	local prompt label choice action index
	local -a actions=(local random search) rows=()
	require fuzzel
	prompt=$(t wallpaper_mode_prompt)
	for action in "${actions[@]}"; do
		label=$(t "wallpaper_mode_$action")
		rows+=("$label")
	done
	choice=$(printf '%s\n' "${rows[@]}" | pick --prompt "$prompt" --index)
	[[ -n "$choice" ]] || return 0
	[[ "$choice" =~ ^[0-9]+$ ]] || die 1 cli_picker_failed
	index=$((10#$choice))
	((index < ${#actions[@]})) || die 1 cli_picker_failed
	case "${actions[$index]}" in local) select_local ;; random) random_local ;; search) search '' ;; esac
}
main() {
	local action="${1:-menu}"
	if (($#)); then shift; fi
	case "$action" in
	-h | --help | menu | current | get | list | random) (($# == 0)) || usage_error ;;
	search) (($# <= 1)) || usage_error ;;
	set) (($# == 1)) && [[ -n "$1" ]] || usage_error ;;
	*) usage_error ;;
	esac
	case "$action" in
	-h | --help) t help_wallpaper ;; menu) menu ;; current | get) get_current ;; list) list_local ;;
	random) random_local ;; search) search "${1:-}" ;; set) apply_target "$1" ;;
	esac
}
main "$@"
