#!/usr/bin/env luajit
-- arch:summary=Manage Bluetooth devices through explicit CLI operations or an interactive menu
-- arch:args=[menu | list | status | connect <mac|name> | disconnect [mac|name] | toggle | off]
-- arch:examples=x-blue list | x-blue status | x-blue connect "Pixel 8" | x-blue menu

local function quote(value)
  return "'" .. tostring(value):gsub("'", "'\\''") .. "'"
end

local function command(...)
  local args = { ... }
  for i, value in ipairs(args) do
    args[i] = quote(value)
  end
  return table.concat(args, " ")
end

local function capture(cmd)
  -- LuaJIT's Lua 5.1 pclose discards the child status. Frame it explicitly;
  -- pipefail also preserves failures from busctl before jq in query pipelines.
  local pipe =
    io.popen(command("bash", "-o", "pipefail", "-c", cmd .. "\nrc=$?\nprintf '\\n%d' \"$rc\""), "r")
  if not pipe then
    return "", 1
  end
  local output = pipe:read("*a") or ""
  pipe:close()
  local body, status = output:match("^(.*)\n(%d+)$")
  return body or "", tonumber(status) or 1
end

local function i18n(key, vars)
  local cmd = command("x-i18n", "get", key)
  for k, v in pairs(vars or {}) do
    cmd = cmd .. " " .. quote(k .. "=" .. v)
  end
  local text, status = capture(cmd .. " 2>/dev/null")
  return status == 0 and text ~= "" and text:gsub("\n$", "") or key
end

local function fail(key, vars, status)
  io.stderr:write(i18n(key, vars) .. "\n")
  os.exit(status or 1)
end

local function checked(cmd)
  local output, status = capture(cmd)
  if status ~= 0 then
    fail("blue_operation_failed")
  end
  return output
end

local function require_tool(name)
  local _, status = capture(command("command", "-v", name) .. " >/dev/null")
  if status ~= 0 then
    fail("blue_missing_tool", { tool = name })
  end
end

local action = arg[1] or "menu"
if action == "-h" or action == "--help" or action == "help" then
  io.stdout:write(i18n("blue_usage") .. "\n")
  os.exit(0)
end
local valid = {
  menu = true,
  list = true,
  devices = true,
  status = true,
  connect = true,
  disconnect = true,
  toggle = true,
  off = true,
  ["power-off"] = true,
}
if
  not valid[action]
  or arg[3]
  or (arg[2] and action ~= "connect" and action ~= "disconnect")
  or (action == "connect" and (not arg[2] or arg[2] == ""))
  or arg[2] == ""
then
  fail("blue_usage", nil, 2)
end
require_tool("busctl")
require_tool("jq")
if action == "menu" then
  require_tool("fuzzel")
end

local function notify(key, vars)
  if action == "menu" then
    capture(command("notify-send", i18n("blue_notify_title"), i18n(key, vars)) .. " 2>/dev/null")
  end
end

local function decode(value)
  return (value:gsub("\\([\\tnr])", { ["\\"] = "\\", t = "\t", n = "\n", r = "\r" }))
end

local function tsv(value)
  return (value:gsub("\\", "\\\\"):gsub("\t", "\\t"):gsub("\n", "\\n"):gsub("\r", "\\r"))
end

local adapter, powered
local devices = {}
local query = [[
.data[0] | to_entries[] |
if .value["org.bluez.Adapter1"] then
  ["adapter", .key, (.value["org.bluez.Adapter1"].Powered.data | tostring)]
elif .value["org.bluez.Device1"] then
  .key as $path | .value["org.bluez.Device1"] |
  ["device", $path, (.Address.data // ""), (.Alias.data // .Name.data // .Address.data),
   (.Connected.data | tostring), (.Paired.data | tostring), (.Icon.data // "")]
else empty end | @tsv
]]
local rows = checked(
  command(
    "busctl",
    "--auto-start=no",
    "call",
    "org.bluez",
    "/",
    "org.freedesktop.DBus.ObjectManager",
    "GetManagedObjects",
    "--json=short"
  )
    .. " | "
    .. command("jq", "-r", query)
)
for line in rows:gmatch("[^\n]+") do
  local fields = {}
  for field in (line .. "\t"):gmatch("(.-)\t") do
    table.insert(fields, decode(field))
  end
  if fields[1] == "adapter" and not adapter then
    adapter, powered = fields[2], fields[3] == "true"
  elseif fields[1] == "device" then
    table.insert(devices, {
      path = fields[2],
      mac = fields[3],
      name = fields[4],
      connected = fields[5] == "true",
      paired = fields[6] == "true",
      icon = fields[7],
    })
  end
end
if not adapter then
  fail("blue_no_device")
end
for i = #devices, 1, -1 do
  if devices[i].path:sub(1, #adapter + 1) ~= adapter .. "/" then
    table.remove(devices, i)
  end
end
table.sort(devices, function(a, b)
  if a.connected ~= b.connected then
    return a.connected
  end
  if a.paired ~= b.paired then
    return a.paired
  end
  return a.name:lower() < b.name:lower()
end)

local function set_property(path, interface, property, value)
  checked(
    command("busctl", "set-property", "org.bluez", path, interface, property, "b", tostring(value))
  )
end

local function device_call(dev, method)
  checked(command("busctl", "call", "org.bluez", dev.path, "org.bluez.Device1", method))
end

local function connected(dev)
  return checked(
    command("busctl", "get-property", "org.bluez", dev.path, "org.bluez.Device1", "Connected")
  ):match("^b true%s*$") ~= nil
end

local function connect(dev)
  if not dev.connected then
    device_call(dev, "Connect")
    if not connected(dev) then
      fail("blue_failed", { dev = dev.name })
    end
  end
  notify("blue_connected", { dev = dev.name })
  io.stdout:write("connected\t" .. dev.mac .. "\n")
end

local function disconnect(dev)
  if dev.connected then
    device_call(dev, "Disconnect")
  end
  notify("blue_disconnected", { dev = dev.name })
  io.stdout:write("disconnected\t" .. dev.mac .. "\n")
end

local function find_device(target)
  local found
  for _, dev in ipairs(devices) do
    if dev.mac:lower() == target:lower() then
      return dev
    end
    if dev.name == target then
      if found then
        fail("blue_ambiguous_device", { dev = target })
      end
      found = dev
    end
  end
  if not found then
    fail("blue_device_not_found", { dev = target })
  end
  return found
end

if action == "list" or action == "devices" then
  for _, dev in ipairs(devices) do
    io.stdout:write(
      string.format(
        "%s\t%s\t%s\t%s\n",
        dev.mac,
        tsv(dev.name),
        dev.connected and "connected" or "disconnected",
        dev.paired and "paired" or "unpaired"
      )
    )
  end
elseif action == "status" then
  local names = {}
  for _, dev in ipairs(devices) do
    if dev.connected then
      table.insert(names, tsv(dev.name))
    end
  end
  io.stdout:write(
    string.format(
      "powered: %s\nconnected: %s\n",
      powered and "on" or "off",
      #names > 0 and table.concat(names, ", ") or "none"
    )
  )
elseif action == "toggle" or action == "off" or action == "power-off" then
  set_property(adapter, "org.bluez.Adapter1", "Powered", action == "toggle" and not powered)
elseif action == "connect" then
  connect(find_device(arg[2]))
elseif action == "disconnect" then
  if arg[2] then
    disconnect(find_device(arg[2]))
  else
    for _, dev in ipairs(devices) do
      if dev.connected then
        disconnect(dev)
      end
    end
  end
else
  -- Pairability and phone-specific pairing are policies of the desktop menu.
  if not powered then
    set_property(adapter, "org.bluez.Adapter1", "Powered", true)
  end
  set_property(adapter, "org.bluez.Adapter1", "Pairable", true)
  local entries = { "  󰑐  " .. i18n("blue_rescan") }
  local icons = {
    headphones = "󰋋",
    headset = "󰋋",
    speakers = "󰓃",
    ["audio-card"] = "󰓃",
    keyboard = "󰌌",
    mouse = "󰍽",
    phone = "󰏲",
    computer = "󰌢",
  }
  for _, dev in ipairs(devices) do
    table.insert(
      entries,
      string.format(
        "%s%s  %s  %s",
        dev.connected and "* " or "  ",
        icons[dev.icon] or "󰂯",
        dev.paired and "󰌷" or "󰐕",
        tsv(dev.name)
      )
    )
  end
  local selection, status = capture(
    command("printf", "%s", table.concat(entries, "\n") .. "\n")
      .. " | "
      .. command("fuzzel", "--dmenu", "--index", "--prompt", i18n("blue_prompt"), "--lines", "15")
  )
  if status == 1 then
    os.exit(0)
  end -- Fuzzel cancellation.
  if status ~= 0 then
    fail("blue_operation_failed")
  end
  local index = tonumber(selection)
  if not index then
    fail("blue_operation_failed")
  end
  if index == 0 then
    checked(command("busctl", "call", "org.bluez", adapter, "org.bluez.Adapter1", "StartDiscovery"))
    capture(command("sleep", "6"))
    checked(command("busctl", "call", "org.bluez", adapter, "org.bluez.Adapter1", "StopDiscovery"))
    checked(command(arg[0], "menu"))
  else
    local dev = devices[index]
    if not dev then
      fail("blue_operation_failed")
    end
    if dev.connected then
      disconnect(dev)
    else
      if not dev.paired then
        require_tool("bluetoothctl")
        checked(
          command("printf", "yes\n")
            .. " | "
            .. command("timeout", "15", "bluetoothctl", "--agent", "DisplayYesNo", "pair", dev.mac)
        )
        local paired = checked(
          command("busctl", "get-property", "org.bluez", dev.path, "org.bluez.Device1", "Paired")
        )
        if not paired:match("^b true%s*$") then
          fail("blue_failed", { dev = dev.name })
        end
        set_property(dev.path, "org.bluez.Device1", "Trusted", true)
      end
      if dev.icon == "phone" or dev.icon == "computer" then
        notify("blue_paired", { dev = dev.name })
        io.stdout:write("paired\t" .. dev.mac .. "\n")
      else
        connect(dev)
      end
    end
  end
end
