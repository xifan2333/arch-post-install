#!/usr/bin/env bash
#
# @name         custom-power
# @summary      Manage session power actions or interactively select power menu options
# @version      1.0.0
# @deps         fuzzel, systemctl
#
# @description  Session power actions dispatcher for River WM desktop.
#               Provides direct CLI actions (lock, suspend, logout, reboot, shutdown) and Fuzzel menu.
#
# @usage        custom-power [options] [command]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   menu        Open interactive power actions launcher via Fuzzel (default)
#   lock        Lock session via hyprlock
#   suspend     Suspend system via systemctl
#   logout      Exit current Wayland compositor session
#   reboot      Reboot system via systemctl
#   shutdown    Power off system via systemctl
#
# @examples
#   custom-power
#   custom-power lock
#   custom-power reboot

set -euo pipefail

show_help() {
	cat <<'EOF'
Usage: custom-power [options] [command]

Options:
  -h, --help  Show this help message and exit

Commands:
  menu        Open interactive power actions launcher via Fuzzel (default)
  lock        Lock session via hyprlock
  suspend     Suspend system via systemctl
  logout      Exit current Wayland compositor session
  reboot      Reboot system via systemctl
  shutdown    Power off system via systemctl
EOF
}

dmenu_exec() {
	local prompt="$1"
	if command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu --prompt "$prompt"
	elif command -v bemenu >/dev/null 2>&1; then
		bemenu -p "$prompt"
	else
		head -n 1
	fi
}

lock_session() {
	if command -v hyprlock >/dev/null 2>&1; then
		hyprlock
	fi
}

logout_session() {
	if command -v xrwm >/dev/null 2>&1; then
		xrwm exit
	elif command -v riverctl >/dev/null 2>&1; then
		riverctl exit
	fi
}

interactive_menu() {
	local opt_lock opt_suspend opt_logout opt_reboot opt_shutdown prompt
	opt_lock="$(custom-i18n get power_lock 2>/dev/null || echo "Lock")"
	opt_suspend="$(custom-i18n get power_suspend 2>/dev/null || echo "Suspend")"
	opt_logout="$(custom-i18n get power_logout 2>/dev/null || echo "Logout")"
	opt_reboot="$(custom-i18n get power_reboot 2>/dev/null || echo "Reboot")"
	opt_shutdown="$(custom-i18n get power_shutdown 2>/dev/null || echo "Shutdown")"
	prompt="$(custom-i18n get power_menu_prompt 2>/dev/null || echo "Power: ")"

	local menu_items=(
		"$opt_lock"
		"$opt_suspend"
		"$opt_logout"
		"$opt_reboot"
		"$opt_shutdown"
	)

	local choice
	choice=$(printf '%s\n' "${menu_items[@]}" | dmenu_exec "$prompt")
	[[ -n "${choice:-}" ]] || exit 0

	case "$choice" in
	"$opt_lock")
		lock_session
		;;
	"$opt_suspend")
		systemctl suspend
		;;
	"$opt_logout")
		logout_session
		;;
	"$opt_reboot")
		systemctl reboot
		;;
	"$opt_shutdown")
		systemctl poweroff
		;;
	esac
}

main() {
	local action="${1:-menu}"

	case "$action" in
	-h | --help)
		show_help
		exit 0
		;;
	menu)
		interactive_menu
		;;
	lock)
		lock_session
		;;
	suspend)
		systemctl suspend
		;;
	logout)
		logout_session
		;;
	reboot)
		systemctl reboot
		;;
	off | shutdown | poweroff)
		systemctl poweroff
		;;
	*)
		printf 'Error: Unknown command "%s" (run custom-power --help for usage)\n' "$action" >&2
		exit 2
		;;
	esac
}

main "$@"
