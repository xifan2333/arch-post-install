#!/usr/bin/env bash
#
# @name         custom-power
# @summary      Manage session power actions or interactively select power menu options
# @version      1.0.0
# @deps         fuzzel, systemctl
#
# @description  Session power actions dispatcher for River WM desktop.
#               Provides direct CLI actions (lock, suspend, logout, reboot, shutdown) and Fuzzel menu.
#
# @usage        custom-power [options] [command]
#
# @options
#   -h, --help  Show this help message and exit
#
# @commands
#   menu        Open interactive power actions launcher via Fuzzel (default)
#   lock        Lock session via hyprlock
#   suspend     Suspend system via systemctl
#   logout      Exit current Wayland compositor session
#   reboot      Reboot system via systemctl
#   shutdown    Power off system via systemctl
#
# @examples
#   custom-power
#   custom-power lock
#   custom-power reboot

set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel reports Esc as 1; every other unsuccessful exit is an error.
pick() {
	local selection rc
	if selection=$(fuzzel --dmenu "$@"); then
		printf '%s' "$selection"
	else
		rc=$?
		((rc == 1)) || {
			((rc == 130)) && exit 130
			die 1 cli_picker_failed
		}
	fi
}

action() {
	case "$1" in
	lock)
		require hyprlock
		hyprlock
		;;
	logout)
		require xrwm
		xrwm exit
		;;
	suspend | reboot)
		require systemctl
		systemctl "$1"
		;;
	shutdown | off | poweroff)
		require systemctl
		systemctl poweroff
		;;
	esac
}
menu() {
	local choice prompt label command index
	local -a commands=(lock suspend logout reboot shutdown) rows=()
	require fuzzel
	prompt=$(t power_menu_prompt)
	for command in "${commands[@]}"; do
		label=$(t "power_$command")
		rows+=("$label")
	done
	choice=$(printf '%s\n' "${rows[@]}" | pick --prompt "$prompt" --index)
	[[ -n "$choice" ]] || return 0
	[[ "$choice" =~ ^[0-9]+$ ]] || die 1 cli_picker_failed
	index=$((10#$choice))
	((index < ${#commands[@]})) || die 1 cli_picker_failed
	action "${commands[$index]}"
}
main() {
	(($# <= 1)) || usage_error
	case "${1:-menu}" in
	-h | --help) t help_power ;;
	menu) menu ;;
	lock | logout | suspend | reboot | shutdown | off | poweroff) action "$1" ;;
	*) usage_error ;;
	esac
}
main "$@"
