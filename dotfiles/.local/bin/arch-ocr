#!/usr/bin/env bash
# arch:summary=Extract text from image file or stdin stream using newbee-ocr
# arch:args=[<image-path> | -]
# arch:examples=arch-ocr image.png | grim -g "$(slurp)" - | arch-ocr | wl-copy
set -euo pipefail

input_src="${1:--}"

tmp_dir="$(mktemp -d)"
img="$tmp_dir/input.png"
result="$tmp_dir/result.json"

cleanup() {
	rm -rf "$tmp_dir"
}
trap cleanup EXIT

if [[ "$input_src" == "-" ]]; then
	cat >"$img"
else
	if [[ ! -f "$input_src" ]]; then
		printf 'Error: image file not found: %s\n' "$input_src" >&2
		exit 1
	fi
	cp "$input_src" "$img"
fi

# Locate nbocr executable
nbocr="$(command -v nbocr 2>/dev/null || true)"
if [[ -z "$nbocr" ]] && command -v mise >/dev/null 2>&1; then
	nbocr_root="$(mise where github:zibo-chen/newbee-ocr-cli 2>/dev/null || true)"
	[[ -x "$nbocr_root/nbocr" ]] && nbocr="$nbocr_root/nbocr"
fi

if [[ -z "$nbocr" ]]; then
	printf 'Error: nbocr binary not found\n' >&2
	exit 1
fi

"$nbocr" recognize "$img" --language zh --format json --output "$result" >/dev/null 2>&1 || exit 1

text="$(jq -r --argjson minimum 0.60 '
	def median: sort as $sorted
		| $sorted[(($sorted | length) / 2 | floor)];
	[.results[] | select(.confidence >= $minimum)] as $items
	| if ($items | length) == 0 then ""
	  else ($items | map(.bbox.height) | median) as $height
	  | (($height * 0.65) | if . < 8 then 8 else . end) as $row_height
	  | ($items | sort_by(.bbox.y, .bbox.x)) as $sorted
	  | reduce $sorted[] as $it (
		  [];
		  if length == 0 then [[$it]]
		  elif ($it.bbox.y - (.[-1][0].bbox.y)) <= $row_height then .[-1] += [$it]
		  else . + [[$it]]
		  end
		)
	  | map(sort_by(.bbox.x) | map(.text) | join(" "))
	  | join("\n")
	  end
' "$result" 2>/dev/null || true)"

if [[ -n "$text" ]]; then
	printf '%s\n' "$text"
fi
