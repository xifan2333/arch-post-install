#!/usr/bin/env bash
#
# @name         custom-blue
# @summary      Manage Bluetooth adapters and devices
# @deps         busctl, jq; menu: fuzzel, notify-send, bluetoothctl, timeout
# @usage        custom-blue [menu|list|status|connect <mac|name>|disconnect [mac|name]|toggle|off]
# @options      -h, --help  Print localized usage without contacting the backend
# @stdin        Unused; explicit arguments select devices
# @stdout       Escaped TSV listings, status fields, or operation results
# @stderr       Diagnostics; exits 2 for usage, 127 for missing tools, 1 for failures
# @examples     custom-blue list; custom-blue status; custom-blue menu
#
set -Eeuo pipefail
shopt -s inherit_errexit
trap 'exit 130' INT
on_error() {
	local rc="$1" line="$2"
	if ((BASH_SUBSHELL == 0)); then
		custom-i18n get cli_failed "command=${0##*/}" "line=$line" >&2
	fi
	if ((rc == 127 || rc == 130)); then exit "$rc"; fi
	exit 1
}
trap 'on_error "$?" "$LINENO"' ERR
t() { custom-i18n get "$@"; }
die() {
	local rc="$1"
	shift
	t "$@" >&2
	exit "$rc"
}
require() {
	local dependency
	for dependency in "$@"; do
		command -v "$dependency" >/dev/null || die 127 cli_dependency "name=$dependency"
	done
}
usage_error() { die 2 cli_usage "command=${0##*/}"; }
# Fuzzel uses 1 both for Esc and startup failure; errors distinguish the two.
pick() (
	local selection rc errors
	errors=$(mktemp "${XDG_RUNTIME_DIR:-/run/user/$UID}/custom-picker.XXXXXX")
	trap 'rm -f -- "$errors"' EXIT
	if selection=$(fuzzel --dmenu --log-level=error "$@" 2>"$errors"); then
		cat "$errors" >&2
		printf '%s' "$selection"
	else
		rc=$?
		cat "$errors" >&2
		if ((rc == 1)) && [[ ! -s "$errors" ]]; then return 0; fi
		if ((rc == 127 || rc == 130)); then exit "$rc"; fi
		die 1 cli_picker_failed
	fi
)

notify() {
	local title body
	[[ "$action" == menu ]] || return 0
	title=$(t "domain_${DOMAIN}")
	body=$(t "$@")
	notify-send -a "custom-${DOMAIN}" -h "string:x-canonical-private-synchronous:${DOMAIN}" "$title" "$body"
}
check_menu() {
	[[ -n "${WAYLAND_DISPLAY:-}" ]] || die 1 cli_unavailable name=WAYLAND_DISPLAY
	require fuzzel notify-send
}
DOMAIN=blue
DISCOVERY_SECS=6
PAIR_TIMEOUT=15
MENU_LINES=15

load_devices() {
	local objects
	objects=$(busctl --auto-start=no call org.bluez / org.freedesktop.DBus.ObjectManager GetManagedObjects --json=short)
	adapter=$(jq -r '.data[0] | to_entries | map(select(.value["org.bluez.Adapter1"])) | .[0].key // empty' <<<"$objects")
	[[ -n "$adapter" ]] || die 1 blue_no_device
	powered=$(jq -er --arg path "$adapter" '.data[0][$path]["org.bluez.Adapter1"].Powered.data | tostring' <<<"$objects")
	devices=$(jq -ce --arg adapter "$adapter/" '[.data[0] | to_entries[] |
        select(.key | startswith($adapter)) | select(.value["org.bluez.Device1"]) |
        .key as $path | .value["org.bluez.Device1"] |
        {path: $path, mac: .Address.data, name: (.Alias.data // .Name.data // .Address.data),
         connected: .Connected.data, paired: .Paired.data, icon: (.Icon.data // "")}] |
        sort_by([(.connected | not), (.paired | not), (.name | ascii_downcase)])' <<<"$objects")
}
property() { busctl set-property org.bluez "$1" "$2" "$3" b "$4"; }
device_call() { busctl --quiet call org.bluez "$path" org.bluez.Device1 "$1"; }
select_device() {
	path=$(jq -er '.path' <<<"$1")
	mac=$(jq -er '.mac' <<<"$1")
	name=$(jq -r '.name' <<<"$1")
	connected=$(jq -r '.connected' <<<"$1")
	paired=$(jq -r '.paired' <<<"$1")
	icon=$(jq -r '.icon' <<<"$1")
}
find_device() {
	local matches count
	matches=$(jq -c --arg target "$1" '[.[] | select((.mac | ascii_downcase) == ($target | ascii_downcase))] |
        if length > 0 then . else empty end' <<<"$devices")
	if [[ -z "$matches" ]]; then
		matches=$(jq -c --arg target "$1" '[.[] | select(.name == $target)]' <<<"$devices")
	fi
	count=$(jq length <<<"$matches")
	((count > 0)) || die 1 blue_device_not_found "dev=$1"
	((count == 1)) || die 1 blue_ambiguous_device "dev=$1"
	select_device "$(jq -c '.[0]' <<<"$matches")"
}
connect_device() {
	local actual
	if [[ "$connected" != true ]]; then
		device_call Connect
		actual=$(busctl get-property org.bluez "$path" org.bluez.Device1 Connected)
		[[ "$actual" == 'b true' ]] || die 1 blue_failed "dev=$name"
	fi
	notify blue_connected "dev=$name"
	printf 'connected\t%s\n' "$mac"
}
disconnect_device() {
	if [[ "$connected" == true ]]; then device_call Disconnect; fi
	notify blue_disconnected "dev=$name"
	printf 'disconnected\t%s\n' "$mac"
}
discover() (
	property "$adapter" org.bluez.Adapter1 Powered true
	busctl --quiet call org.bluez "$adapter" org.bluez.Adapter1 StartDiscovery
	trap 'busctl --quiet call org.bluez "$adapter" org.bluez.Adapter1 StopDiscovery' EXIT
	trap 'exit 130' INT
	trap 'exit 1' TERM HUP
	sleep "$DISCOVERY_SECS"
)
menu() {
	local rows prompt choice count selected actual
	while :; do
		load_devices
		rows=$(jq -r '.[] | [(if .connected then "* " else "  " end) +
            ({headphones:"󰋋",headset:"󰋋",speakers:"󰓃","audio-card":"󰓃",keyboard:"󰌌",mouse:"󰍽",phone:"󰏲",computer:"󰌢"}[.icon] // "󰂯") +
            "  " + (if .paired then "󰌷" else "󰐕" end) + "  " + ([.name] | @tsv)] | .[]' <<<"$devices")
		prompt=$(t blue_prompt)
		choice=$({
			printf '  󰑐  %s\n' "$(t blue_rescan)"
			if [[ -n "$rows" ]]; then printf '%s\n' "$rows"; fi
		} |
			pick --index --prompt "$prompt" --lines "$MENU_LINES")
		[[ -n "$choice" ]] || return 0
		count=$(jq length <<<"$devices")
		[[ "$choice" =~ ^(0|[1-9][0-9]{0,5})$ ]] || die 1 cli_picker_failed
		((choice <= count)) || die 1 cli_picker_failed
		if [[ "$choice" == 0 ]]; then
			discover
			continue
		fi
		selected=$(jq -ce --argjson index "$((choice - 1))" '.[$index]' <<<"$devices")
		select_device "$selected"
		if [[ "$connected" == true ]]; then
			disconnect_device
			return
		fi
		if [[ "$paired" != true ]]; then
			require bluetoothctl timeout
			property "$adapter" org.bluez.Adapter1 Powered true
			property "$adapter" org.bluez.Adapter1 Pairable true
			printf 'yes\n' | timeout "$PAIR_TIMEOUT" bluetoothctl --agent DisplayYesNo pair "$mac" >&2
			actual=$(busctl get-property org.bluez "$path" org.bluez.Device1 Paired)
			[[ "$actual" == 'b true' ]] || die 1 blue_failed "dev=$name"
			property "$path" org.bluez.Device1 Trusted true
		fi
		if [[ "$icon" == phone || "$icon" == computer ]]; then
			notify blue_paired "dev=$name"
			printf 'paired\t%s\n' "$mac"
		else connect_device; fi
		return
	done
}
main() {
	local action="${1:-menu}" adapter powered devices path mac name connected paired icon row rows value
	if (($#)); then shift; fi
	case "$action" in
	-h | --help | help)
		(($# == 0)) || usage_error
		t blue_usage
		return
		;;
	menu | list | devices | status | toggle | off | power-off) (($# == 0)) || usage_error ;;
	connect) (($# == 1)) && [[ -n "$1" ]] || usage_error ;;
	disconnect) (($# <= 1)) && [[ "${1-nonempty}" != '' ]] || usage_error ;;
	*) usage_error ;;
	esac
	require busctl jq
	if [[ "$action" == menu ]]; then
		check_menu
		menu
		return
	fi
	load_devices
	case "$action" in
	list | devices) jq -r '.[] | [.mac,.name,(if .connected then "connected" else "disconnected" end),(if .paired then "paired" else "unpaired" end)] | @tsv' <<<"$devices" ;;
	status)
		value=off
		if [[ "$powered" == true ]]; then value=on; fi
		printf 'powered: %s\n' "$value"
		jq -r '[.[] | select(.connected) | [.name] | @tsv] | "connected: " + (if length == 0 then "none" else join(", ") end)' <<<"$devices"
		;;
	toggle | off | power-off)
		value=false
		if [[ "$action" == toggle && "$powered" == false ]]; then value=true; fi
		property "$adapter" org.bluez.Adapter1 Powered "$value"
		;;
	connect)
		find_device "$1"
		connect_device
		;;
	disconnect)
		if (($#)); then
			find_device "$1"
			disconnect_device
		else
			rows=$(jq -c '.[] | select(.connected)' <<<"$devices")
			while IFS= read -r row; do
				[[ -n "$row" ]] || continue
				select_device "$row"
				disconnect_device
			done <<<"$rows"
		fi
		;;
	esac
}
main "$@"
