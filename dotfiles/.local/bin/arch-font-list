#!/usr/bin/env bash
# arch:summary=List available monospace and CJK fonts
# arch:examples=arch font list | arch font list --mono | arch font list --cjk
set -euo pipefail

curr_mono="$(arch-font-current --mono 2>/dev/null || echo "")"
curr_cjk="$(arch-font-current --cjk 2>/dev/null || echo "")"

get_mono_fonts() {
	fc-list : family 2>/dev/null |
		tr ',' '\n' |
		grep -iE "(Nerd Font|Maple Mono|Fira Code|Hack|Iosevka|JetBrains|Source Code|Cascadia)" |
		sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
		grep -vE "(Extra|Semi|Light|Thin|Medium|Bold|Black|Italic|NL)" |
		grep -vE "(CJK|Chinese|SC|TC|HK|JP|KR)" |
		sort -u || true
}

get_cjk_fonts() {
	fc-list : family 2>/dev/null |
		tr ',' '\n' |
		grep -E "^(Sarasa|Noto Sans Mono CJK|Noto Sans CJK|Source Han|WenKai|PingFang|Microsoft YaHei)" |
		sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
		grep -vE "(Extra|Semi|Light|Thin|Medium|Bold|Black|Italic)" |
		sort -u || true
}

case "${1:-}" in
--mono | -m | --nerd)
	get_mono_fonts
	;;
--cjk | -c)
	get_cjk_fonts
	;;
*)
	printf 'Available Monospace / Nerd Fonts:\n'
	while IFS= read -r f; do
		[[ -z "$f" ]] && continue
		prefix="  "
		[[ "$f" == "$curr_mono" ]] && prefix="* "
		printf '%s%s\n' "$prefix" "$f"
	done < <(get_mono_fonts)

	printf '\nAvailable CJK Fallback Fonts:\n'
	while IFS= read -r f; do
		[[ -z "$f" ]] && continue
		prefix="  "
		[[ "$f" == "$curr_cjk" ]] && prefix="* "
		printf '%s%s\n' "$prefix" "$f"
	done < <(get_cjk_fonts)
	;;
esac
