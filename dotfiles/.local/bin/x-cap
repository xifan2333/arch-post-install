#!/usr/bin/env bash
# arch:summary=Capture screenshots, OCR text, or pick colors on screen
# arch:args=[menu | area [-o path] | full [-o path] | edit | ocr | color | preview | scroll | rec [args...]]
# arch:examples=x-cap area | x-cap edit | x-cap color | x-cap rec toggle
set -euo pipefail

save_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots"
mkdir -p "$save_dir"

dmenu_exec() {
	local prompt="$1"
	if command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu --prompt "$prompt"
	elif command -v bemenu >/dev/null 2>&1; then
		bemenu -p "$prompt"
	else
		head -n 1
	fi
}

notify_cap() {
	local title="$1" body="$2"
	if command -v notify-send >/dev/null 2>&1; then
		notify-send "$title" "$body"
	fi
}

cap_area() {
	local out_target="${1:-}"
	local geometry
	geometry="$(slurp 2>/dev/null || true)"
	[[ -n "$geometry" ]] || exit 0

	if [[ "$out_target" == "-" || "$out_target" == "-o -" ]]; then
		grim -g "$geometry" -
		return 0
	fi

	local filepath
	if [[ -n "$out_target" && "$out_target" != "-o" ]]; then
		filepath="$out_target"
	else
		local filename
		filename="screenshot-$(date +%Y%m%d_%H%M%S).png"
		filepath="$save_dir/$filename"
	fi

	grim -g "$geometry" "$filepath"
	wl-copy <"$filepath"
	printf '%s\n' "$filepath"
}

cap_full() {
	local out_target="${1:-}"
	if [[ "$out_target" == "-" || "$out_target" == "-o -" ]]; then
		grim -
		return 0
	fi

	local filepath
	if [[ -n "$out_target" && "$out_target" != "-o" ]]; then
		filepath="$out_target"
	else
		local filename
		filename="screenshot-$(date +%Y%m%d_%H%M%S).png"
		filepath="$save_dir/$filename"
	fi

	grim "$filepath"
	wl-copy <"$filepath"
	printf '%s\n' "$filepath"
}

cap_edit() {
	local output_path geometry
	output_path="$save_dir/screenshot-$(date +%Y%m%d_%H%M%S).png"
	geometry="$(slurp 2>/dev/null || true)"
	[[ -n "$geometry" ]] || exit 0
	grim -g "$geometry" - | satty --filename - --output-filename "$output_path" --early-exit
}

cap_color() {
	if ! command -v hyprpicker >/dev/null 2>&1; then
		printf 'Error: hyprpicker not found\n' >&2
		exit 1
	fi
	local color
	color="$(hyprpicker -n 2>/dev/null || true)"
	if [[ -n "$color" ]]; then
		printf '%s' "$color" | wl-copy
		printf '%s\n' "$color"
	fi
}

cap_preview() {
	local geometry
	geometry="$(slurp 2>/dev/null || true)"
	[[ -n "$geometry" ]] || exit 0
	local preview_path="/tmp/screenshot-preview-$$.png"
	grim -g "$geometry" "$preview_path"
	wl-copy <"$preview_path"
	imv "$preview_path" 2>/dev/null &
	(
		sleep 60
		rm -f "$preview_path"
	) &
}

cap_scroll() {
	if ! command -v wayscrollshot >/dev/null 2>&1; then
		printf 'Error: wayscrollshot is not installed\n' >&2
		exit 1
	fi
	wayscrollshot -c "$@"
}

cap_ocr() {
	local geometry
	geometry="$(slurp 2>/dev/null || true)"
	[[ -n "$geometry" ]] || exit 0

	local text
	text="$(grim -g "$geometry" - | x-ocr - 2>/dev/null || true)"
	if [[ -n "$text" ]]; then
		printf '%s' "$text" | wl-copy
		notify_cap "$(x-i18n get ocr_notify_title 2>/dev/null || echo "OCR")" "$text"
		printf '%s\n' "$text"
	fi
}

interactive_menu() {
	local opt_area opt_full opt_edit opt_preview opt_ocr opt_color opt_scroll opt_rec
	opt_area="$(x-i18n get cap_menu_area 2>/dev/null || echo "Area Screenshot")"
	opt_full="$(x-i18n get cap_menu_full 2>/dev/null || echo "Fullscreen")"
	opt_edit="$(x-i18n get cap_menu_edit 2>/dev/null || echo "Annotate & Edit")"
	opt_preview="$(x-i18n get cap_menu_preview 2>/dev/null || echo "Preview & Pin")"
	opt_ocr="$(x-i18n get cap_menu_ocr 2>/dev/null || echo "Extract Text (OCR)")"
	opt_color="$(x-i18n get cap_menu_color 2>/dev/null || echo "Pick Color")"
	opt_scroll="$(x-i18n get cap_menu_scroll 2>/dev/null || echo "Scroll Shot")"
	opt_rec="Record Video..."

	local menu_items=(
		"󰹑  $opt_area"
		"󰍹  $opt_full"
		"󰻿  $opt_edit"
		"󰋩  $opt_preview"
		"󰚥  $opt_ocr"
		"󰈊  $opt_color"
		"󰝹  $opt_scroll"
		"󰑋  $opt_rec"
	)

	local choice
	choice=$(printf '%s\n' "${menu_items[@]}" | dmenu_exec "$(x-i18n get cap_menu_prompt 2>/dev/null || echo "Screen Capture: ")")
	[[ -n "${choice:-}" ]] || return 0

	case "$choice" in
	*"$opt_area") cap_area ;;
	*"$opt_full") cap_full ;;
	*"$opt_edit") cap_edit ;;
	*"$opt_preview") cap_preview ;;
	*"$opt_ocr") cap_ocr ;;
	*"$opt_color") cap_color ;;
	*"$opt_scroll") cap_scroll ;;
	*"$opt_rec") x-rec menu ;;
	esac
}

main() {
	local cmd="${1:-menu}"
	case "$cmd" in
	menu) interactive_menu ;;
	area)
		shift
		cap_area "$@"
		;;
	full)
		shift
		cap_full "$@"
		;;
	edit) cap_edit ;;
	ocr) cap_ocr ;;
	color) cap_color ;;
	preview) cap_preview ;;
	scroll)
		shift
		cap_scroll "$@"
		;;
	rec)
		shift
		exec x-rec "$@"
		;;
	-h | --help | help)
		printf 'Usage: x-cap [menu | area [-o path] | full [-o path] | edit | ocr | color | preview | scroll | rec ...]\n'
		;;
	*)
		interactive_menu
		;;
	esac
}

main "$@"
