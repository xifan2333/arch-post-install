#!/usr/bin/env bash
# arch:summary=Display active wireless station status, SSID, and IP via iwctl
set -euo pipefail

if ! command -v iwctl >/dev/null 2>&1; then
	printf 'Error: iwctl not found. Please install iwd\n' >&2
	exit 1
fi

dev=$(iwctl device list 2>/dev/null | awk '/station/ { print $2; exit }' || true)
[[ -z "$dev" ]] && dev=$(iwctl device list 2>/dev/null | awk 'NR>4 && NF>1 { print $2; exit }' || true)

if [[ -z "$dev" ]]; then
	printf 'Error: No wireless device found\n' >&2
	exit 1
fi

station_info=$(iwctl station "$dev" show 2>/dev/null || true)
state=$(awk -F': ' '/State/ { print $2; exit }' <<<"$station_info" | xargs || true)
connected_network=$(awk -F': ' '/Connected network/ { print $2; exit }' <<<"$station_info" | xargs || true)
ip_addr=$(ip -4 addr show dev "$dev" 2>/dev/null | awk '/inet / { print $2 }' | cut -d/ -f1 | head -1 || true)

printf 'Backend:   iwd (iwctl)\n'
printf 'Device:    %s (wireless)\n' "$dev"
printf 'State:     %s\n' "${state:-disconnected}"
[[ -n "$connected_network" ]] && printf 'SSID:      %s\n' "$connected_network"
[[ -n "$ip_addr" ]] && printf 'IP Address: %s\n' "$ip_addr"
