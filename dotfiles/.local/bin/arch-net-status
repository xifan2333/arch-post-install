#!/usr/bin/env bash
# arch:summary=Display active network status and IP address
set -euo pipefail

# Detect wireless interface directly from kernel sysfs
dev=""
for d in /sys/class/net/*/wireless; do
	if [[ -d "$d" ]]; then
		dev=$(basename "$(dirname "$d")")
		break
	fi
done

if [[ -z "$dev" ]]; then
	dev=$(ip route show default 2>/dev/null | awk '{ for (i=1; i<=NF; i++) if ($i=="dev") { print $(i+1); exit } }' || true)
fi

if [[ -z "$dev" ]]; then
	printf 'Network: Disconnected\n'
	exit 0
fi

state=$(cat "/sys/class/net/$dev/operstate" 2>/dev/null || echo "unknown")
ip_addr=$(ip -4 addr show dev "$dev" 2>/dev/null | awk '/inet / { print $2 }' | cut -d/ -f1 | head -1 || true)

printf 'Device:     %s\n' "$dev"
printf 'State:      %s\n' "$state"
[[ -n "$ip_addr" ]] && printf 'IP Address: %s\n' "$ip_addr"

# If iwd station show is available, print station details
if command -v iwctl >/dev/null 2>&1 && [[ -d "/sys/class/net/$dev/wireless" ]]; then
	printf '\nStation details (iwctl):\n'
	iwctl station "$dev" show || true
fi
