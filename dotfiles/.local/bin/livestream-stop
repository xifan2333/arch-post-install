#!/bin/bash
# Stop Live stream push

set -e
source livestream-core
source i18n-core

if ! livestream_is_active; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_not_active)"
    fi
    exit 1
fi

livestream_stop || true

if command -v notify-send >/dev/null 2>&1; then
    notify-send "$(msg livestream_notify_title)" "$(msg livestream_notify_stopped)"
fi
