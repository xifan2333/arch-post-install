#!/usr/bin/env bash
# Run every repository lint and syntax check without modifying files.

set -euo pipefail

python_files=()
bash_files=()
shellcheck_files=()
zsh_files=()
lua_files=()
toml_files=()
structured_files=()

while IFS= read -r -d '' file; do
    first_line=$(head -n 1 -- "$file" 2>/dev/null || true)

    if [[ "$file" == *.py || "$first_line" == *python* ]]; then
        python_files+=("$file")
    fi

    if [[ "$file" == *.sh || "$first_line" == *bash* ]]; then
        bash_files+=("$file")
        case "$file" in
            dotfiles/.local/bin/i18n-en-us | dotfiles/.local/bin/i18n-zh-cn) ;;
            *) shellcheck_files+=("$file") ;;
        esac
    fi

    if [[ "$file" == *.zsh || "$file" == */.zshrc ]]; then
        zsh_files+=("$file")
    fi

    case "$file" in
        *.lua) lua_files+=("$file") ;;
        *.toml) toml_files+=("$file") ;;
        dotfiles/.config/nvim/lazy-lock.json) ;;
        *.json | *.jsonc | *.yaml | *.yml) structured_files+=("$file") ;;
    esac
done < <(git ls-files --cached --others --exclude-standard -z)

printf '%s\n' '==> Python: Ruff lint + format check'
ruff check "${python_files[@]}"
ruff format --check "${python_files[@]}"

printf '%s\n' '==> Bash: ShellCheck + parser'
shellcheck --rcfile=.shellcheckrc "${shellcheck_files[@]}"
bash -n "${bash_files[@]}"

printf '%s\n' '==> Zsh: parser'
for file in "${zsh_files[@]}"; do
    zsh -n "$file"
done

printf '%s\n' '==> Lua: parser'
luac -p "${lua_files[@]}"

printf '%s\n' '==> TOML: Taplo'
taplo lint --no-schema "${toml_files[@]}"

printf '%s\n' '==> JSON/JSONC/YAML: Prettier'
prettier --check "${structured_files[@]}"

printf '%s\n' 'All checks passed.'
