#!/usr/bin/env bash
# Apply the repository's formatters. Static-only checks remain in scripts/lint.

set -euo pipefail

python_files=()
bash_files=()
lua_files=()
toml_files=()
structured_files=()
qml_files=()

while IFS= read -r -d '' file; do
    [[ -f "$file" ]] || continue
    first_line=$(head -n 1 -- "$file" 2> /dev/null || true)

    if [[ "$file" == *.py || "$first_line" == *python* ]]; then
        python_files+=("$file")
    fi
    if [[ "$file" == *.sh || "$first_line" == *bash* ]]; then
        bash_files+=("$file")
    fi

    case "$file" in
        *.lua) lua_files+=("$file") ;;
        *.qml) qml_files+=("$file") ;;
        *.toml) toml_files+=("$file") ;;
        dotfiles/.config/nvim/lazy-lock.json) ;;
        *.json | *.jsonc | *.yaml | *.yml) structured_files+=("$file") ;;
    esac
done < <(git ls-files --cached --others --exclude-standard -z)

ruff check --fix "${python_files[@]}"
ruff format "${python_files[@]}"
shfmt -w -i 4 -ci -sr "${bash_files[@]}"
stylua "${lua_files[@]}"
taplo format "${toml_files[@]}"
prettier --write "${structured_files[@]}"

qmlformat_bin=/usr/lib/qt6/bin/qmlformat
if ((${#qml_files[@]} > 0)); then
    if [[ -x $qmlformat_bin ]]; then
        "$qmlformat_bin" -s .qmlformat.ini -i "${qml_files[@]}"
    else
        printf '%s\n' 'skip QML format (Qt6 qmlformat not installed)'
    fi
fi

printf '%s\n' 'Formatting complete. Run mise run lint before committing.'
