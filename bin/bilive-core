#!/bin/bash
# Bilibili live streaming library - shared functions
# Source this file in bilive scripts

# XDG paths
BILIVE_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bilive"
BILIVE_RTMP_FILE="$BILIVE_CONFIG_DIR/rtmp.url"
BILIVE_CONFIG_FILE="$BILIVE_CONFIG_DIR/config"
BILIVE_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/bilive-$UID}/bilive"
BILIVE_PID_FILE="$BILIVE_RUNTIME_DIR/pgid"
BILIVE_MODE_FILE="$BILIVE_RUNTIME_DIR/mode"
BILIVE_LOG_FILE="$BILIVE_RUNTIME_DIR/bilive.log"
BILIVE_RUNNER="$BILIVE_RUNTIME_DIR/run.sh"
BILIVE_EXTRA_ARGS="$BILIVE_RUNTIME_DIR/wf-extra.args"

# Defaults tuned for low-power CPUs (e.g. Sandy Bridge i5)
# Prefer record_mix.monitor when available (mic + system + optional ducking)
AUDIO_SOURCE="rnnoise_source"
FRAMERATE="25"
VIDEO_BITRATE="1800k"
MAXRATE="2200k"
BUFSIZE="3600k"
AUDIO_BITRATE="128k"
PRESET="ultrafast"
# Max output width; 0 = keep native desktop/area resolution
SCALE_WIDTH="0"

bilive_ensure_dirs() {
    mkdir -p "$BILIVE_CONFIG_DIR" "$BILIVE_RUNTIME_DIR"
}

# Load optional key=value config (does not override non-empty env)
bilive_load_config() {
    bilive_ensure_dirs

    if [ -f "$BILIVE_CONFIG_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ''|\#*) continue ;;
                *=*)
                    key="${line%%=*}"
                    val="${line#*=}"
                    key="${key// /}"
                    case "$key" in
                        RTMP_URL|AUDIO_SOURCE|FRAMERATE|VIDEO_BITRATE|MAXRATE|BUFSIZE|AUDIO_BITRATE|PRESET|SCALE_WIDTH)
                            eval "current=\${$key-}"
                            if [ -z "$current" ]; then
                                export "$key=$val"
                            fi
                            ;;
                    esac
                    ;;
            esac
        done < "$BILIVE_CONFIG_FILE"
    fi

    AUDIO_SOURCE="${AUDIO_SOURCE:-rnnoise_source}"
    # Prefer virtual record mix when enabled
    if command -v record-audio-core >/dev/null 2>&1 || [ -f "$HOME/.local/bin/record-audio-core" ]; then
        # shellcheck disable=SC1091
        source record-audio-core 2>/dev/null || source "$HOME/.local/bin/record-audio-core" 2>/dev/null || true
        if declare -F record_audio_capture_source >/dev/null 2>&1; then
            _cap=$(record_audio_capture_source 2>/dev/null || true)
            [ -n "$_cap" ] && AUDIO_SOURCE="$_cap"
        fi
    fi
    FRAMERATE="${FRAMERATE:-25}"
    VIDEO_BITRATE="${VIDEO_BITRATE:-1800k}"
    MAXRATE="${MAXRATE:-2200k}"
    BUFSIZE="${BUFSIZE:-3600k}"
    AUDIO_BITRATE="${AUDIO_BITRATE:-128k}"
    PRESET="${PRESET:-ultrafast}"
    SCALE_WIDTH="${SCALE_WIDTH:-0}"
}

bilive_check_deps() {
    for cmd in wf-recorder ffmpeg; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            echo "Error: $cmd is not installed" >&2
            exit 1
        fi
    done
}

# Resolve RTMP URL: env > rtmp.url file
bilive_get_rtmp_url() {
    if [ -n "${BILIVE_RTMP_URL:-}" ]; then
        printf '%s' "$BILIVE_RTMP_URL"
        return 0
    fi

    if [ -n "${RTMP_URL:-}" ]; then
        printf '%s' "$RTMP_URL"
        return 0
    fi

    if [ -f "$BILIVE_RTMP_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ''|\#*) continue ;;
                *)
                    printf '%s' "$line"
                    return 0
                    ;;
            esac
        done < "$BILIVE_RTMP_FILE"
    fi

    return 1
}

bilive_require_rtmp_url() {
    local url
    if ! url=$(bilive_get_rtmp_url); then
        return 1
    fi
    if [ -z "$url" ]; then
        return 1
    fi
    printf '%s' "$url"
}

bilive_set_rtmp_url() {
    local url="$1"
    bilive_ensure_dirs
    printf '%s\n' "$url" > "$BILIVE_RTMP_FILE"
    chmod 600 "$BILIVE_RTMP_FILE"
}

bilive_is_active() {
    local pgid
    [ -f "$BILIVE_PID_FILE" ] || return 1
    pgid=$(tr -d '[:space:]' < "$BILIVE_PID_FILE")
    [ -n "$pgid" ] || return 1

    if kill -0 -- "-$pgid" 2>/dev/null; then
        return 0
    fi
    if kill -0 "$pgid" 2>/dev/null; then
        return 0
    fi
    return 1
}

bilive_get_mode() {
    if [ -f "$BILIVE_MODE_FILE" ]; then
        tr -d '[:space:]' < "$BILIVE_MODE_FILE"
    fi
}

bilive_get_duration_seconds() {
    local pgid duration
    [ -f "$BILIVE_PID_FILE" ] || return 1
    pgid=$(tr -d '[:space:]' < "$BILIVE_PID_FILE")
    [ -n "$pgid" ] || return 1

    duration=$(ps -o etimes= -p "$pgid" 2>/dev/null | tr -d '[:space:]')
    if [ -z "$duration" ]; then
        # Fallback: first wf-recorder owned by this user while live
        duration=$(ps -o etimes= -C wf-recorder 2>/dev/null | head -1 | tr -d '[:space:]')
    fi
    [ -n "$duration" ] || return 1
    echo "$duration"
}

bilive_unmute_audio() {
    if command -v pactl >/dev/null 2>&1; then
        if pactl list sources 2>/dev/null | grep -A 10 "Name: $AUDIO_SOURCE" | grep -q "Mute: yes"; then
            pactl set-source-mute "$AUDIO_SOURCE" 0
        fi
    fi
}

# Reuse screenrecord waybar module (signal 8)
bilive_notify_waybar() {
    pkill -SIGRTMIN+8 waybar 2>/dev/null || true
}

# True when local file recording owns wf-recorder (not bilive)
bilive_local_recording_active() {
    if bilive_is_active; then
        return 1
    fi
    pgrep -u "$(id -u)" -x wf-recorder >/dev/null 2>&1
}

# Build video filter for wf-recorder -F
# SCALE_WIDTH=0 keeps native desktop/area geometry (only ensure yuv420p)
bilive_video_filter() {
    if [ -n "$SCALE_WIDTH" ] && [ "$SCALE_WIDTH" != "0" ]; then
        printf 'scale=w=%s:h=-2:force_original_aspect_ratio=decrease,format=yuv420p' "$SCALE_WIDTH"
    else
        printf 'format=yuv420p'
    fi
}

# Start streaming pipeline.
# Args: mode (full|area) [extra wf-recorder args, e.g. -g geometry]
bilive_start() {
    local mode="$1"
    shift
    local rtmp_url
    local filter
    local gop
    local geo_args=()

    bilive_load_config
    bilive_check_deps
    bilive_ensure_dirs

    if bilive_is_active; then
        return 2
    fi

    if bilive_local_recording_active; then
        return 5
    fi

    if ! rtmp_url=$(bilive_require_rtmp_url); then
        return 3
    fi

    while [ $# -gt 0 ]; do
        geo_args+=("$1")
        shift
    done

    bilive_unmute_audio
    filter=$(bilive_video_filter)
    gop=$((FRAMERATE * 2))

    : > "$BILIVE_LOG_FILE"
    printf '%s\n' "$mode" > "$BILIVE_MODE_FILE"

    # Optional geometry: store as shell-safe NUL-separated args
    : > "$BILIVE_EXTRA_ARGS"
    if [ ${#geo_args[@]} -gt 0 ]; then
        printf '%s\0' "${geo_args[@]}" > "$BILIVE_EXTRA_ARGS"
    fi

    cat > "$BILIVE_RUNNER" <<'RUNNER'
#!/bin/bash
set -e
exec >>"$BILIVE_LOG_FILE" 2>&1

cleanup() {
    pkill -INT -P $$ 2>/dev/null || true
    wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

extra_args=()
if [ -n "${BILIVE_RUNTIME_DIR:-}" ] && [ -s "$BILIVE_RUNTIME_DIR/wf-extra.args" ]; then
    while IFS= read -r -d '' item; do
        extra_args+=("$item")
    done < "$BILIVE_RUNTIME_DIR/wf-extra.args"
fi

# IMPORTANT: wf-recorder treats "-f -" as a file named "-", not stdout.
# Use /dev/stdout so the pipe to ffmpeg actually works.
wf-recorder \
    "${extra_args[@]}" \
    --audio="$BILIVE_AUDIO_SOURCE" \
    -m flv \
    -c libx264 \
    -C aac \
    -r "$BILIVE_FRAMERATE" \
    -x yuv420p \
    -D \
    -b 0 \
    -F "$BILIVE_FILTER" \
    -p "preset=$BILIVE_PRESET" \
    -p "tune=zerolatency" \
    -p "b=$BILIVE_VIDEO_BITRATE" \
    -p "maxrate=$BILIVE_MAXRATE" \
    -p "bufsize=$BILIVE_BUFSIZE" \
    -p "g=$BILIVE_GOP" \
    -P "b=$BILIVE_AUDIO_BITRATE" \
    -f /dev/stdout \
| ffmpeg -hide_banner -loglevel warning \
    -i - \
    -c copy \
    -f flv \
    "$BILIVE_RTMP_TARGET"
RUNNER
    chmod +x "$BILIVE_RUNNER"

    # New session so bilive_stop can signal the whole pipeline
    setsid env \
        BILIVE_LOG_FILE="$BILIVE_LOG_FILE" \
        BILIVE_RUNTIME_DIR="$BILIVE_RUNTIME_DIR" \
        BILIVE_AUDIO_SOURCE="$AUDIO_SOURCE" \
        BILIVE_FRAMERATE="$FRAMERATE" \
        BILIVE_PRESET="$PRESET" \
        BILIVE_VIDEO_BITRATE="$VIDEO_BITRATE" \
        BILIVE_MAXRATE="$MAXRATE" \
        BILIVE_BUFSIZE="$BUFSIZE" \
        BILIVE_AUDIO_BITRATE="$AUDIO_BITRATE" \
        BILIVE_FILTER="$filter" \
        BILIVE_GOP="$gop" \
        BILIVE_RTMP_TARGET="$rtmp_url" \
        "$BILIVE_RUNNER" &

    echo $! > "$BILIVE_PID_FILE"

    # Brief settle: fail fast if pipeline died immediately
    sleep 1.5
    if ! bilive_is_active; then
        return 4
    fi

    # Must actually be talking to the RTMP server, not just sitting on a local pipe
    if ! pgrep -u "$(id -u)" -af 'ffmpeg.*live-push|ffmpeg.*rtmp://' >/dev/null 2>&1; then
        # still ok if host is not bilivideo (custom RTMP); check any ffmpeg child of our group
        local pgid
        pgid=$(tr -d '[:space:]' < "$BILIVE_PID_FILE")
        if ! pgrep -u "$(id -u)" -P "$pgid" -a ffmpeg >/dev/null 2>&1 \
            && ! pgrep -u "$(id -u)" -g "$pgid" -a ffmpeg >/dev/null 2>&1; then
            bilive_stop || true
            return 4
        fi
    fi

    bilive_notify_waybar
    return 0
}

bilive_stop() {
    local pgid
    local i

    bilive_ensure_dirs

    if [ ! -f "$BILIVE_PID_FILE" ]; then
        return 1
    fi

    pgid=$(tr -d '[:space:]' < "$BILIVE_PID_FILE")
    if [ -z "$pgid" ]; then
        rm -f "$BILIVE_PID_FILE" "$BILIVE_MODE_FILE"
        return 1
    fi

    kill -INT -- "-$pgid" 2>/dev/null || kill -INT "$pgid" 2>/dev/null || true
    # Also interrupt recorder directly (it may ignore group signal timing)
    pkill -INT -u "$(id -u)" -x wf-recorder 2>/dev/null || true

    for i in $(seq 1 30); do
        if ! bilive_is_active; then
            break
        fi
        sleep 0.1
    done

    if bilive_is_active; then
        kill -TERM -- "-$pgid" 2>/dev/null || kill -TERM "$pgid" 2>/dev/null || true
        pkill -TERM -u "$(id -u)" -x wf-recorder 2>/dev/null || true
        for i in $(seq 1 20); do
            if ! bilive_is_active; then
                break
            fi
            sleep 0.1
        done
    fi

    if bilive_is_active; then
        kill -KILL -- "-$pgid" 2>/dev/null || kill -KILL "$pgid" 2>/dev/null || true
        pkill -KILL -u "$(id -u)" -x wf-recorder 2>/dev/null || true
        pkill -KILL -u "$(id -u)" -f 'ffmpeg.*live-push|ffmpeg.*rtmp://' 2>/dev/null || true
        for i in $(seq 1 10); do
            if ! bilive_is_active; then
                break
            fi
            sleep 0.1
        done
    fi

    rm -f "$BILIVE_PID_FILE" "$BILIVE_MODE_FILE"
    bilive_notify_waybar
    return 0
}
