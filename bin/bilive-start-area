#!/bin/bash
# Start area Bilibili live push (slurp + wf-recorder + ffmpeg RTMP)

set -e
source bilive-core
source i18n-core

bilive_load_config
bilive_check_deps

if ! command -v slurp >/dev/null 2>&1; then
    echo "Error: slurp is not installed" >&2
    exit 1
fi

if bilive_is_active; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_already_active)"
    fi
    exit 1
fi

if ! bilive_require_rtmp_url >/dev/null; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_missing_rtmp)"
    fi
    exit 1
fi

geometry=$(slurp) || exit 1

set +e
bilive_start area -g "$geometry"
rc=$?
set -e

case "$rc" in
    0)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_started_area)"
        fi
        ;;
    2)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_already_active)"
        fi
        exit 1
        ;;
    3)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_missing_rtmp)"
        fi
        exit 1
        ;;
    *)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_start_failed)"
        fi
        exit 1
        ;;
esac
