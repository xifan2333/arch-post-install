#!/bin/bash
# fcitx5-tray-watch: 确保 fcitx5 始终带托盘图标（notificationitem 插件）运行。
#
# Omarchy 默认 autostart 和 omarchy-restart-xcompose 都会以
# `--disable notificationitem` 启动 fcitx5（隐藏托盘图标）。
# 本守护进程轮询发现这种实例时，用 `fcitx5 -r` 无损替换为正常实例。
# 一个机制同时覆盖：开机自启、xcompose 重启、以及未来任何 omarchy 的同类操作。

while true; do
    if pgrep -f "fcitx5 --disable" >/dev/null 2>&1; then
        uwsm-app -- fcitx5 -r
        # 等旧实例退出、新实例接管（XIM/DBus 交接需要几秒）
        sleep 5
    fi
    sleep 5
done
