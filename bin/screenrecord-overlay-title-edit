#!/bin/bash
# Edit floating title overlay settings (text / font / color / position)
# Saves to ~/.config/screenrecord/title.conf and live-reloads if overlay is running.

set -e
source i18n-core

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/screenrecord"
CONFIG_FILE="$CONFIG_DIR/title.conf"

mkdir -p "$CONFIG_DIR"

if [ ! -f "$CONFIG_FILE" ]; then
    cat > "$CONFIG_FILE" <<'EOF'
[title]
text = 直播标题
font_family = sans-serif
font_size = 36
font_weight = 700
text_color = #ffffff
background = rgba(0, 0, 0, 0.55)
text_shadow = -1px -1px 0 black, 1px -1px 0 black, -1px 1px 0 black, 1px 1px 0 black
anchor_x = left
anchor_y = top
margin_x = 24
margin_y = 24
padding_x = 16
padding_y = 10
max_width = 900
opacity = 1.0
EOF
fi

cfg_get() {
    local key="$1"
    local default="$2"
    local value
    value=$(awk -F' *= *' -v k="$key" '
        $1 == k { sub(/\r$/, "", $2); print $2; found=1; exit }
        END { if (!found) exit 1 }
    ' "$CONFIG_FILE" 2>/dev/null) || true
    if [ -n "$value" ]; then
        printf '%s' "$value"
    else
        printf '%s' "$default"
    fi
}

cfg_set() {
    local key="$1"
    local value="$2"
    python3 - "$CONFIG_FILE" "$key" "$value" <<'PY'
import configparser
import sys

path, key, value = sys.argv[1], sys.argv[2], sys.argv[3]
cfg = configparser.ConfigParser()
cfg.read(path, encoding="utf-8")
if not cfg.has_section("title"):
    cfg.add_section("title")
cfg.set("title", key, value)
with open(path, "w", encoding="utf-8") as fh:
    cfg.write(fh)
PY
}

if ! command -v zenity >/dev/null 2>&1; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg screenrecord_notify_title)" "$(msg screenrecord_overlay_title_zenity_missing)"
    fi
    exit 1
fi

# Main edit menu loop
while true; do
    text=$(cfg_get text "直播标题")
    font_family=$(cfg_get font_family "sans-serif")
    font_size=$(cfg_get font_size "36")
    text_color=$(cfg_get text_color "#ffffff")
    background=$(cfg_get background "rgba(0, 0, 0, 0.55)")
    anchor_x=$(cfg_get anchor_x "left")
    anchor_y=$(cfg_get anchor_y "top")
    margin_x=$(cfg_get margin_x "24")
    margin_y=$(cfg_get margin_y "24")

    choice=$(zenity --list \
        --title="$(msg screenrecord_overlay_title_edit_title)" \
        --text="$(msg screenrecord_overlay_title_edit_text)" \
        --column="$(msg screenrecord_overlay_title_edit_column)" \
        --hide-header \
        --width=420 --height=360 \
        "$(msg screenrecord_overlay_title_edit_text_item)" \
        "$(msg screenrecord_overlay_title_edit_font_item)" \
        "$(msg screenrecord_overlay_title_edit_size_item)" \
        "$(msg screenrecord_overlay_title_edit_color_item)" \
        "$(msg screenrecord_overlay_title_edit_bg_item)" \
        "$(msg screenrecord_overlay_title_edit_pos_item)" \
        "$(msg screenrecord_overlay_title_edit_toggle_item)" \
        "$(msg screenrecord_overlay_title_edit_done_item)" \
        || true)

    [ -z "$choice" ] && exit 0

    case "$choice" in
        "$(msg screenrecord_overlay_title_edit_text_item)")
            new=$(zenity --entry \
                --title="$(msg screenrecord_overlay_title_edit_title)" \
                --text="$(msg screenrecord_overlay_title_prompt_text)" \
                --entry-text="$text" \
                --width=520 || true)
            [ -n "$new" ] && cfg_set text "$new"
            ;;
        "$(msg screenrecord_overlay_title_edit_font_item)")
            new=$(zenity --entry \
                --title="$(msg screenrecord_overlay_title_edit_title)" \
                --text="$(msg screenrecord_overlay_title_prompt_font)" \
                --entry-text="$font_family" \
                --width=420 || true)
            [ -n "$new" ] && cfg_set font_family "$new"
            ;;
        "$(msg screenrecord_overlay_title_edit_size_item)")
            new=$(zenity --scale \
                --title="$(msg screenrecord_overlay_title_edit_title)" \
                --text="$(msg screenrecord_overlay_title_prompt_size)" \
                --min-value=12 --max-value=120 --step=1 \
                --value="$font_size" || true)
            [ -n "$new" ] && cfg_set font_size "$new"
            ;;
        "$(msg screenrecord_overlay_title_edit_color_item)")
            # zenity --color-selection returns rgb(r,g,b) or #rrggbb depending on version
            new=$(zenity --color-selection \
                --title="$(msg screenrecord_overlay_title_prompt_color)" \
                --color="$text_color" || true)
            if [ -n "$new" ]; then
                # normalize rgb(255,255,255) -> #ffffff when possible
                if printf '%s' "$new" | grep -Eq '^rgb\('; then
                    new=$(python3 - "$new" <<'PY'
import re,sys
m=re.match(r'rgb\((\d+),(\d+),(\d+)\)', sys.argv[1].replace(' ',''))
if m:
    print('#{:02x}{:02x}{:02x}'.format(*map(int,m.groups())))
else:
    print(sys.argv[1])
PY
)
                fi
                cfg_set text_color "$new"
            fi
            ;;
        "$(msg screenrecord_overlay_title_edit_bg_item)")
            new=$(zenity --entry \
                --title="$(msg screenrecord_overlay_title_edit_title)" \
                --text="$(msg screenrecord_overlay_title_prompt_bg)" \
                --entry-text="$background" \
                --width=480 || true)
            [ -n "$new" ] && cfg_set background "$new"
            ;;
        "$(msg screenrecord_overlay_title_edit_pos_item)")
            pos=$(zenity --list \
                --title="$(msg screenrecord_overlay_title_edit_title)" \
                --text="$(msg screenrecord_overlay_title_prompt_pos)" \
                --column=pos --hide-header \
                --width=360 --height=280 \
                "left-top" "right-top" "left-bottom" "right-bottom" \
                || true)
            case "$pos" in
                left-top) cfg_set anchor_x left; cfg_set anchor_y top ;;
                right-top) cfg_set anchor_x right; cfg_set anchor_y top ;;
                left-bottom) cfg_set anchor_x left; cfg_set anchor_y bottom ;;
                right-bottom) cfg_set anchor_x right; cfg_set anchor_y bottom ;;
            esac
            mx=$(zenity --scale \
                --title="$(msg screenrecord_overlay_title_edit_title)" \
                --text="$(msg screenrecord_overlay_title_prompt_margin_x)" \
                --min-value=0 --max-value=400 --step=1 \
                --value="$margin_x" || true)
            [ -n "$mx" ] && cfg_set margin_x "$mx"
            my=$(zenity --scale \
                --title="$(msg screenrecord_overlay_title_edit_title)" \
                --text="$(msg screenrecord_overlay_title_prompt_margin_y)" \
                --min-value=0 --max-value=400 --step=1 \
                --value="$margin_y" || true)
            [ -n "$my" ] && cfg_set margin_y "$my"
            ;;
        "$(msg screenrecord_overlay_title_edit_toggle_item)")
            screenrecord-overlay-title-toggle
            ;;
        "$(msg screenrecord_overlay_title_edit_done_item)")
            if command -v notify-send >/dev/null 2>&1; then
                notify-send "$(msg screenrecord_notify_title)" "$(msg screenrecord_overlay_title_saved)"
            fi
            # Ensure overlay is visible after editing so user sees result
            if ! pgrep -f "python3 .*/screenrecord-overlay-title$" >/dev/null 2>&1; then
                nohup screenrecord-overlay-title &>/dev/null &
            fi
            exit 0
            ;;
    esac
done
