#!/bin/bash
# Start full-screen Bilibili live push (wf-recorder + ffmpeg RTMP)

set -e
source bilive-core
source i18n-core

bilive_load_config
bilive_check_deps

if bilive_is_active; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_already_active)"
    fi
    exit 1
fi

if ! bilive_require_rtmp_url >/dev/null; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_missing_rtmp)"
    fi
    exit 1
fi

set +e
bilive_start full
rc=$?
set -e

case "$rc" in
    0)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_started_full)"
        fi
        ;;
    2)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_already_active)"
        fi
        exit 1
        ;;
    3)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_missing_rtmp)"
        fi
        exit 1
        ;;
    *)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_start_failed)"
        fi
        exit 1
        ;;
esac
