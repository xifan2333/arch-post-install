#!/bin/bash
# Enable record_mix and start ducking daemon
set -e
source record-audio-core
source i18n-core 2>/dev/null || true

record_audio_write_default_config
record_audio_up

if pgrep -f "python3 .*/record-audio-daemon$" >/dev/null 2>&1; then
    echo "record-audio daemon already running"
else
    nohup record-audio-daemon >/tmp/record-audio-daemon.log 2>&1 &
    sleep 0.4
fi

if command -v notify-send >/dev/null 2>&1; then
    notify-send "Record Audio" "已启用：麦克风 + 系统声混音${RECORD_DUCKING:+（含避让）}"
fi

record_audio_status
