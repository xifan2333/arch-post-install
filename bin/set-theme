#!/bin/bash
# Apply a theme: render templates from colors.toml, atomic swap, hot-reload apps.
# Usage: set-theme <theme-name>

set -euo pipefail

THEME_NAME="${1:-}"
if [[ -z $THEME_NAME ]]; then
  echo "Usage: set-theme <theme-name>" >&2
  exit 1
fi

THEMES_DIR="$HOME/.config/themes"
TEMPLATES_DIR="$THEMES_DIR/templates"
STATE_DIR="$HOME/.local/state/themes"
STAGING="$STATE_DIR/next"
CURRENT="$STATE_DIR/current"
CURRENT_LINK="$HOME/.config/current"

THEME_DIR="$THEMES_DIR/$THEME_NAME"
if [[ ! -d $THEME_DIR ]]; then
  echo "Theme '$THEME_NAME' not found in $THEMES_DIR" >&2
  exit 1
fi

# ── helpers ──────────────────────────────────────────────────────

hex_strip() { printf '%s' "${1#\#}"; }

hex_to_rgba() {
  local hex="${1#\#}"
  printf '0x%sff' "$hex"
}

sipc() {
  # Send IPC to waybar
  if pgrep -x waybar >/dev/null 2>&1; then
    pkill -SIGUSR2 waybar 2>/dev/null || true
  fi
}

# ── parse colors.toml ────────────────────────────────────────────

declare -A COLORS
COLORS_FILE="$THEME_DIR/colors.toml"

if [[ -f $COLORS_FILE ]]; then
  while IFS='=' read -r key val; do
    key="${key// /}"
    val="${val// /}"
    val="${val//\"/}"
    [[ -z $key || $key == \[* ]] && continue
    COLORS["$key"]="$val"
  done < "$COLORS_FILE"

  # Derived values
  for key in "${!COLORS[@]}"; do
    val="${COLORS[$key]}"
    COLORS["${key}_strip"]=$(hex_strip "$val")
    COLORS["${key}_rgba"]=$(hex_to_rgba "$val")
  done
fi

# ── staging ──────────────────────────────────────────────────────

rm -rf "$STAGING"
mkdir -p "$STAGING"

# ── render templates first (theme-specific files override later) ──

sed_script=$(mktemp)
for key in "${!COLORS[@]}"; do
  printf 's|{{ %s }}|%s|g\n' "$key" "${COLORS[$key]}" >> "$sed_script"
done

shopt -s nullglob
for tpl in "$TEMPLATES_DIR"/*.tpl; do
  name=$(basename "$tpl" .tpl)
  sed -f "$sed_script" "$tpl" > "$STAGING/$name"
  # Clean up unreplaced placeholders (missing keys)
  sed -i 's|{{ [^}]* }}||g' "$STAGING/$name"
done
rm "$sed_script"

# Copy ALL theme files on top — theme-specific files override templates
for f in "$THEME_DIR"/*; do
  name=$(basename "$f")
  [[ $name == colors.toml ]] && continue
  if [[ -f $f ]]; then
    cp "$f" "$STAGING/$name"
  fi
done

# ── atomic swap ──────────────────────────────────────────────────

mkdir -p "$STATE_DIR"
if [[ -d $CURRENT ]]; then
  rm -rf "$CURRENT"
fi
mv "$STAGING" "$CURRENT"

# Update legacy symlink for backwards compat
ln -nsf "$CURRENT" "$CURRENT_LINK"

# Store theme name
echo "$THEME_NAME" > "$STATE_DIR/theme.name"

# ── hot-reload apps ──────────────────────────────────────────────

# waybar: SIGUSR2 triggers config reload
if pgrep -x waybar >/dev/null 2>&1; then
  pkill -SIGUSR2 waybar 2>/dev/null || true
fi

# dunst: copy theme config to drop-in + reload
if [[ -f $CURRENT/dunstrc ]]; then
  mkdir -p "$HOME/.config/dunst/dunstrc.d"
  cp "$CURRENT/dunstrc" "$HOME/.config/dunst/dunstrc.d/90-theme.conf"
fi
if pgrep -x dunst >/dev/null 2>&1; then
  killall -SIGUSR1 dunst 2>/dev/null || true
fi

# swaylock
if [[ -f $CURRENT/swaylock.conf ]]; then
  mkdir -p "$HOME/.config/swaylock"
  cp "$CURRENT/swaylock.conf" "$HOME/.config/swaylock/config"
fi

# swayosd
if [[ -f $CURRENT/swayosd.css ]]; then
  mkdir -p "$HOME/.config/swayosd"
  cp "$CURRENT/swayosd.css" "$HOME/.config/swayosd/style.css"
fi

# btop
if [[ -f $CURRENT/btop.theme ]]; then
  mkdir -p "$HOME/.config/btop/themes"
  cp "$CURRENT/btop.theme" "$HOME/.config/btop/themes/$THEME_NAME.theme"
  if [[ -f $HOME/.config/btop/btop.conf ]]; then
    sed -i --follow-symlinks "s/^color_theme = .*/color_theme = \"$THEME_NAME\"/" "$HOME/.config/btop/btop.conf"
  fi
  if pgrep -x btop >/dev/null 2>&1; then
    pkill -SIGUSR2 btop 2>/dev/null || true
  fi
fi

# Run legacy theme-sync scripts for other apps
for sync_script in theme-sync-gtk theme-sync-herdr theme-sync-eza theme-sync-vscode; do
  if command -v "$sync_script" >/dev/null 2>&1; then
    "$sync_script" 2>/dev/null || true
  fi
done

# wezterm: touch config to trigger auto-reload
if [[ -f $HOME/.config/wezterm/wezterm.lua ]]; then
  touch "$HOME/.config/wezterm/wezterm.lua" 2>/dev/null || true
fi

# alacritty: touch config
if [[ -f $HOME/.config/alacritty/alacritty.toml ]]; then
  touch "$HOME/.config/alacritty/alacritty.toml" 2>/dev/null || true
fi

# kitty: SIGUSR1
if pgrep -x kitty >/dev/null 2>&1; then
  killall -SIGUSR1 kitty 2>/dev/null || true
fi

# River border colors
if [[ -f $CURRENT/riverrc ]]; then
  source "$CURRENT/riverrc"
  if command -v riverctl >/dev/null 2>&1 && pgrep -x river >/dev/null 2>&1; then
    riverctl border-color-focused "${RIVER_BORDER_FOCUSED:-0xd8a657ff}" 2>/dev/null || true
    riverctl border-color-unfocused "${RIVER_BORDER_UNFOCUSED:-0x504945ff}" 2>/dev/null || true
  fi
fi

# fcitx5 — copy theme config and restart
if [[ -f $CURRENT/fcitx5.conf ]]; then
  mkdir -p "$HOME/.local/share/fcitx5/themes/custom"
  cp "$CURRENT/fcitx5.conf" "$HOME/.local/share/fcitx5/themes/custom/theme.conf"
  mkdir -p "$(dirname "$HOME/.config/fcitx5/conf/classicui.conf")"
  cat > "$HOME/.config/fcitx5/conf/classicui.conf" <<'EOF'
Theme=custom
EOF
  if pgrep -x fcitx5 >/dev/null 2>&1; then
    killall fcitx5 2>/dev/null || true
    sleep 0.3
    command -v riverctl >/dev/null 2>&1 && riverctl spawn fcitx5 2>/dev/null &
  fi
elif [[ -f $STAGING/fcitx5.conf || -f $CURRENT/fcitx5.conf ]]; then
  : # theme-specific fcitx5.conf was already copied as a non-template file
fi

echo "Theme set to: $THEME_NAME"
