#!/bin/bash
# Interactive Bilibili live menu with wofi
# Usage: ui-bilive

set -e

source bilive-core
source i18n-core

bilive_load_config

# Show menu (disable cache to preserve order)
CHOICE=$(printf "%s\n%s\n%s\n%s" \
    "${i18n[bilive_start_full]}" \
    "${i18n[bilive_start_area]}" \
    "${i18n[bilive_stop]}" \
    "${i18n[bilive_set_rtmp]}" \
    | ui-wofi --dmenu --cache-file=/dev/null -p "${i18n[bilive_prompt]}")

# User cancelled
[ -z "$CHOICE" ] && exit 0

case "$CHOICE" in
    "${i18n[bilive_start_full]}")
        bilive-start-full
        ;;
    "${i18n[bilive_start_area]}")
        bilive-start-area
        ;;
    "${i18n[bilive_stop]}")
        bilive-stop
        ;;
    "${i18n[bilive_set_rtmp]}")
        current=""
        if current=$(bilive_get_rtmp_url 2>/dev/null); then
            :
        else
            current=""
        fi

        if ! command -v zenity >/dev/null 2>&1; then
            if command -v notify-send >/dev/null 2>&1; then
                notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_zenity_missing)"
            fi
            exit 1
        fi

        # Use a password-style entry so the stream key is not shown in clear text by default
        new_url=$(zenity --entry \
            --title="$(msg bilive_notify_title)" \
            --text="$(msg bilive_set_rtmp_text)" \
            --entry-text="$current" \
            --width=640) || exit 0

        [ -z "$new_url" ] && exit 0

        bilive_set_rtmp_url "$new_url"

        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_rtmp_saved)"
        fi
        ;;
esac
