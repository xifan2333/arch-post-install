#!/bin/bash
# Lightweight askpass using ui-wofi with current theme and i18n.
# Usage: SUDO_ASKPASS=/path/to/this-script sudo -A <command>
#
# The disabled label entry identifies the dialog purpose
# without being selectable. User types password and presses Enter.

source i18n-core

printf '%s\0non-selectable\n' "${i18n[askpass_prompt]:-Password}" |
  ui-wofi --dmenu --password --lines=1 2>/dev/null
