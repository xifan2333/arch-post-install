#!/bin/bash
# Toggle title overlay on/off
set -e
source i18n-core

PID=$(pgrep -f "[s]creenrecord-overlay-title($| )" | head -1)
if [ -z "$PID" ]; then
    PID=$(pgrep -f "[p]ython3.*screenrecord-overlay-title" | head -1)
fi

if [ -n "$PID" ]; then
    kill "$PID" 2>/dev/null || true
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg screenrecord_notify_title)" "$(msg screenrecord_overlay_title_off)"
    fi
    echo "$(msg screenrecord_overlay_title_off)"
else
    # Ensure default config exists before first show
    nohup screenrecord-overlay-title &>/dev/null &
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg screenrecord_notify_title)" "$(msg screenrecord_overlay_title_on)"
    fi
    echo "$(msg screenrecord_overlay_title_on)"
fi
