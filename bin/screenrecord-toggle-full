#!/bin/bash
# Toggle full screen recording (start/stop)
# If bilive is active, refuse to start local recording.

source screenrecord-core
source i18n-core

if screenrecord_is_live; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg screenrecord_notify_title)" "$(msg screenrecord_notify_live_active)"
    fi
    exit 1
fi

if screenrecord_is_active; then
    exec screenrecord-stop
else
    exec screenrecord-start-full
fi
