#!/usr/bin/env python3
"""
Extract colors from a theme's alacritty.toml and output colors.toml format.
Also reads existing colors.toml if present and merges.

Usage: theme-colors-extract <theme-dir>
Output: colors.toml content to stdout
"""
import sys, os, re

def parse_alacritty(path):
    """Parse alacritty.toml and extract all color values."""
    colors = {}
    try:
        with open(path) as f:
            content = f.read()
    except FileNotFoundError:
        return colors

    # Match: key = "value" or key = 'value' or key = 0xVALUE
    # Also match dotted keys like colors.primary.background
    current_section = []
    for line in content.splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        # Section header
        m = re.match(r'\[([^\]]+)\]', line)
        if m:
            current_section = [s.strip() for s in m.group(1).split('.')]
            continue
        # Key-value
        m = re.match(r'(\w+)\s*=\s*(.+)', line)
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        # Strip quotes: "val" or 'val'
        if (val.startswith('"') and val.endswith('"')) or \
           (val.startswith("'") and val.endswith("'")):
            val = val[1:-1]
        # Convert 0x prefix to #
        if val.startswith('0x') and len(val) == 8:
            val = '#' + val[2:]
        elif val.startswith('0x'):
            val = '#' + val[2:]
        if not re.match(r'^#[0-9A-Fa-f]{6}$', val):
            continue
        full_key = '.'.join(current_section + [key])
        colors[full_key] = val
    return colors

def translate(alacritty_colors):
    """Map alacritty color keys to semantic color keys."""
    c = alacritty_colors
    result = {}

    # Primary
    result['bg'] = c.get('colors.primary.background', '')
    result['fg'] = c.get('colors.primary.foreground', '')
    result['fg_dim'] = c.get('colors.primary.dim_foreground', c.get('colors.primary.foreground', ''))
    result['bg_dim'] = c.get('colors.normal.black', '')

    # Normal ANSI
    result['ansi0']  = c.get('colors.normal.black', '')
    result['ansi1']  = c.get('colors.normal.red', '')
    result['ansi2']  = c.get('colors.normal.green', '')
    result['ansi3']  = c.get('colors.normal.yellow', '')
    result['ansi4']  = c.get('colors.normal.blue', '')
    result['ansi5']  = c.get('colors.normal.magenta', '')
    result['ansi6']  = c.get('colors.normal.cyan', '')
    result['ansi7']  = c.get('colors.normal.white', '')

    # Bright ANSI
    result['ansi8']  = c.get('colors.bright.black', '')
    result['ansi9']  = c.get('colors.bright.red', '')
    result['ansi10'] = c.get('colors.bright.green', '')
    result['ansi11'] = c.get('colors.bright.yellow', '')
    result['ansi12'] = c.get('colors.bright.blue', '')
    result['ansi13'] = c.get('colors.bright.magenta', '')
    result['ansi14'] = c.get('colors.bright.cyan', '')
    result['ansi15'] = c.get('colors.bright.white', '')

    # Semantic accent colors (prefer bright variants for visibility)
    result['red']    = c.get('colors.bright.red', c.get('colors.normal.red', ''))
    result['green']  = c.get('colors.bright.green', c.get('colors.normal.green', ''))
    result['yellow'] = c.get('colors.bright.yellow', c.get('colors.normal.yellow', ''))
    result['blue']   = c.get('colors.bright.blue', c.get('colors.normal.blue', ''))
    result['purple'] = c.get('colors.bright.magenta', c.get('colors.normal.magenta', ''))
    result['aqua']   = c.get('colors.bright.cyan', c.get('colors.normal.cyan', ''))
    result['orange'] = c.get('colors.indexed_colors.16', result.get('yellow', ''))
    result['gray']   = result.get('ansi8', result.get('fg_dim', ''))

    # Cursor and selection — with sensible fallbacks
    result['cursor']    = c.get('colors.cursor.cursor', result.get('fg', ''))
    result['selection'] = c.get('colors.selection.background',
                                c.get('colors.primary.bright_foreground',
                                      result.get('gray', result.get('fg_dim', ''))))

    # Border derived from accent
    result['border']     = result.get('yellow', '')
    result['border_dim'] = result.get('gray', '')

    # Indexed color 17 as secondary accent
    color17 = c.get('colors.indexed_colors.17', '')
    if color17:
        result['accent2'] = color17

    # Ensure critical keys always have values
    if not result.get('selection'):
        result['selection'] = result.get('gray', result.get('fg_dim', result.get('fg', '#888888')))
    if not result.get('cursor'):
        result['cursor'] = result.get('fg', '#ffffff')

    return {k: v for k, v in result.items() if v}


def write_colors_toml(colors):
    """Output in colors.toml format."""
    print("[colors]")
    for key in sorted(colors.keys()):
        print(f'{key} = "{colors[key]}"')


def main():
    theme_dir = sys.argv[1] if len(sys.argv) > 1 else '.'

    # Try to parse alacritty.toml
    alacritty_path = os.path.join(theme_dir, 'alacritty.toml')
    if os.path.exists(alacritty_path):
        ac = parse_alacritty(alacritty_path)
        colors = translate(ac)
        write_colors_toml(colors)
    else:
        print("# No alacritty.toml found", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
