#!/bin/bash
# Interactive theme switcher with wofi
# Usage: ui-theme

set -e

source i18n-core

THEMES_DIR="$HOME/.config/themes"

# Get available themes
get_themes() {
    for theme_dir in "$THEMES_DIR"/*/; do
        [ -d "$theme_dir" ] || continue
        theme_name=$(basename "$theme_dir")
        [ "$theme_name" = "templates" ] && continue
        echo "$theme_name"
    done
}

# Show wofi selector
SELECTED=$(get_themes | ui-wofi --dmenu -p "${i18n[theme_prompt]}")

# User cancelled
[ -z "$SELECTED" ] && exit 0

# Delegate to set-theme for rendering and hot-reload
exec set-theme "$SELECTED"
