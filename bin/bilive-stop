#!/bin/bash
# Stop Bilibili live push

set -e
source bilive-core
source i18n-core

if ! bilive_is_active; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_not_active)"
    fi
    exit 1
fi

bilive_stop || true

if command -v notify-send >/dev/null 2>&1; then
    notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_stopped)"
fi
