#!/bin/bash
# Toggle full-screen Bilibili live push (start/stop)

set -e
source bilive-core
source i18n-core

# Refuse to start live while local file recording is active
if ! bilive_is_active; then
    # shellcheck disable=SC1091
    source screenrecord-core
    if screenrecord_is_active; then
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$(msg bilive_notify_title)" "$(msg bilive_notify_recording_active)"
        fi
        exit 1
    fi
    exec bilive-start-full
fi

exec bilive-stop
